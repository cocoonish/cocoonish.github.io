// Bu indikatör TTO Trading'in "Fiyat Hareketi: Al Brooks Yöntemiyle Bar Bar
// Okuma" dersinden türetilmiştir.
//
// EŞİKLER İKİ KÜMEDİR VE KARIŞTIRILMAZ.
//   · g1–g8 grupları: dersin kendi SAYISAL SABİTLER TABLOSUNDAN gelir.
//     Hiçbiri kalibre edilmemiş, geçmişe uydurulmamıştır.
//   · gT grubu: dersin SAYI VERMEDİĞİ kurallar için bizim TANIM SEÇİMİMİZ
//     ("kabaca eşit", "belirgin altında", "neredeyse aynı"). Ayrı grupta
//     durur ki dersin eşiğiyle karışmasın; her biri girdi olarak açıktır.
//
// KAPSAM UYARISI. Brooks sisteminin çekirdeği BAĞLAM okumasıdır ve bağlam
// mekanik olarak hesaplanamaz. Bu indikatör yalnız OHLC'den ÖLÇÜLEBİLEN
// kısmı çizer: bar anatomisi ve sınıfı, kapanışın yeri, tıraşlı uç, çevirme
// sayaçları, trendleşme, göreli gövde, gövde boşluğu, iç/dış bar kalıpları
// ve kırılım modu, always-in yönü, sinyal barı kalitesi (canlı 0–4), orta
// nokta ölçütü, örtüşme, iki barlık dönüş, bar boyu, mikro çift, mikro
// kanal, bar sayımı, ortalama ilişkisi, beş bar iptal kuralı.
//
// Kurulum seçmez, işlem önermez, hedef vermez. Kalıpları GÖSTERİR, hükmü
// VERMEZ — hüküm bağlamdan gelir. Dersin kendi cümlesiyle: liste okunur,
// sayılmaz.
//
//@version=6
indicator("Brooks · Fiyat Hareketi", shorttitle="Brooks FH", overlay = true,
   max_labels_count = 500, max_lines_count = 500, max_bars_back = 300)

// ─────────────────────────────────────────────────────────────────────────
//  Girdiler — varsayılanlar dersin sabitler tablosundan
// ─────────────────────────────────────────────────────────────────────────
g1 = "Bar sınıfı (Bölüm 1)"
trendGovde   = input.float(0.50, "Trend barı: gövde/menzil ≥",        minval = 0.1, maxval = 0.9, step = 0.05, group = g1, tooltip = "Ders: gövde ≥ menzilin ~%50'si")
gucluGovde   = input.float(0.75, "Güçlü trend barı: gövde/menzil ≥",  minval = 0.5, maxval = 1.0, step = 0.05, group = g1, tooltip = "Ders: güçlüsünde ~%75+")
dojiGovde    = input.float(0.10, "Doji: gövde/menzil ≤",              minval = 0.01, maxval = 0.3, step = 0.01, group = g1, tooltip = "Ders: gövde ≈ menzilin %0–10'u")

g2 = "Hareketli ortalama (Bölüm 7)"
maUzunluk    = input.int(20, "EMA uzunluğu", minval = 2, group = g2, tooltip = "Ders: 20 barlık EMA. Brooks bu seçimin sihirli olmadığını söyler; önemli olan çoğunluğun AYNI çizgiye bakmasıdır.")
gapEsik      = input.int(20, "Gap bar sayacı eşiği", minval = 5, group = g2, tooltip = "Ders: ortalamaya dokunmayan ≥ 20 ardışık bar bir kurulumdur")
yonPencere   = input.int(10, "Yön filtresi penceresi", minval = 4, group = g2)
yonEsik      = input.int(7,  "Yön filtresi eşiği",     minval = 2, group = g2, tooltip = "Ders: son 10 barın 7'si ortalamanın bir yanındaysa KARŞI yön işlemi aranmaz")

g3 = "Sinyal barı (Bölüm 2)"
kapanisPenc  = input.int(8, "Kapanış tersine çevirme penceresi", minval = 2, group = g3, tooltip = "Ders: kapanış son ~8 barın kapanışının ötesinde")
ucPenc       = input.int(5, "Uç tersine çevirme penceresi",      minval = 2, group = g3, tooltip = "Ders: uç son ~5 barın ucunun ötesinde")
ortusmeEsik  = input.float(0.75, "Örtüşme eşiği", minval = 0.3, maxval = 0.95, step = 0.05, group = g3, tooltip = "Ders: önceki barın %75'inden fazlası örtülüyorsa tek bar değil İKİ BARLIK dönüş okunur")
asgariKalite = input.int(0, "Etiketlenecek asgari kalite (0–4)", minval = 0, maxval = 4, group = g3)

g5 = "Bölüm 1.3 · trendleşme ve göreli gövde"
trendlesmeEsik = input.int(3, "Trendleşme asgari bar sayısı", minval = 2, group = g5, tooltip = "Ders: 'Asgari eşik her üçünde de üç bar veya üç salınımdır.'")

g6 = "Bölüm 1.10b · çevirme sayacı"
cevirmeSiradan = input.int(3,  "Sıradan bar: çevirme <", minval = 1, group = g6)
cevirmeRejim   = input.int(5,  "Rejim iddiası: çevirme >", minval = 2, group = g6)
cevirmeKirilim = input.int(15, "En üst kademe: çevirme >", minval = 5, group = g6, tooltip = "Ders bu kademeyi 'büyük olasılıkla always-in yönünü çeviren kırılım' diye adlandırır. O HÜKÜM sınandı ve tutmadı (kesinlik %1,05, taban oran %0,46); kutu bu yüzden sayıyı ve büyüklüğü yazar, hükmü yazmaz.")

g7 = "Bölüm 2.6 · bar boyu ve tükeniş"
tukenisTrendBar = input.int(10, "Tükeniş için asgari trend barı", minval = 3, group = g7, tooltip = "Ders: '10 veya daha fazla bar süren bir trendin içinde alışılmadık büyüklükte bir bar.'")

g9 = "Bölüm 2.9 · ikinci giriş momentum eşiği"
momentumBar = input.int(6, "Karşı kapanış görülmeyen bar sayısı ≥", minval = 2, group = g9, tooltip = "Ders: 'Günün yeni dibinde ilk alış girişi ama ALTI BAR boyunca boğa kapanışı yok → ikinci alış girişini bekleyin.' Ölçü burada; ikinci giriş KURULUMU indikatörde yok, o bir kurulum takibi ister.")

g8 = "Bölüm 8A.6 · beş bar iptal kuralı"
iptalKapanis = input.int(5, "İptal için gereken KAPANIŞ sayısı", minval = 2, group = g8, tooltip = "Eski ucun ötesinde bu kadar KAPANIŞ görülürse dönüş arayışı iptal. Üst sınırdır: geçmek kurulumu öldürür.")

gT = "Tanım seçimleri — DERS SAYI VERMİYOR"
esitGovdeOran = input.float(0.50, "İki barlık dönüş: gövde eşitliği ≥", minval = 0.1, maxval = 1.0, step = 0.05, group = gT, tooltip = "Ders 'kabaca eşit' der, sayı vermez. Bu bir TANIM SEÇİMİDİR.")
kucukBarOran  = input.float(0.50, "Küçük bar: menzil < ortalamanın",    minval = 0.1, maxval = 1.0, step = 0.05, group = gT, tooltip = "Ders 'belirgin altında' der, sayı vermez.")
tukenisOran   = input.float(2.00, "Büyük bar: menzil > ortalamanın",    minval = 1.1, maxval = 5.0, step = 0.1,  group = gT, tooltip = "Ders 'alışılmadık büyüklükte' der, sayı vermez.")
mikroTolerans = input.float(0.05, "Mikro çift: 'neredeyse aynı' payı",  minval = 0.0, maxval = 0.3, step = 0.01, group = gT, tooltip = "Ders 'aynı ya da neredeyse aynı' der, sayı vermez.")
cevirmeTavan  = input.int(100, "Çevirme sayacı tarama tavanı", minval = 20, maxval = 300, group = gT, tooltip = "Başarım tavanı. Ölçülen p99 tam buraya oturuyor, yani sayı SANSÜRLÜ.")
medyanPencere = input.int(10, "Göreli gövde/menzil penceresi", minval = 3, group = gT, tooltip = "Ders 'son 5–10 bar' der; 10 o aralığın içinden bir seçimdir.")

g4 = "Gösterim"
barBoya      = input.bool(true,  "Barları sınıfına göre boya",   group = g4)
aiZemin      = input.bool(true,  "Always-in zemini",             group = g4)
sinyalGoster = input.bool(true,  "Sinyal barı ve kalite skoru",  group = g4)
sayimGoster  = input.bool(true,  "Bar sayımı (H1–H4 / L1–L4)",   group = g4)
maGoster     = input.bool(true,  "EMA ve gap bar sayacı",        group = g4)
kalipGoster  = input.bool(true,  "Kırılım modu kalıpları (ii·iii·ioi·oio·oo)", group = g4)

// Ev paleti
cMurekkep = color.new(#1a1a1a, 0)
cClaret   = color.new(#8c2f39, 0)
cMavi     = color.new(#2f5d8c, 0)
cGri      = color.new(#8a8a8a, 0)

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 1 · Bar anatomisi
// ─────────────────────────────────────────────────────────────────────────
menzil    = high - low
govde     = math.abs(close - open)
govdeOran = menzil > 0 ? govde / menzil : 0.0
ortaNokta = (high + low) / 2
altKuyruk = math.min(open, close) - low
ustKuyruk = high - math.max(open, close)

bogaGovde = close > open
ayiGovde  = close < open

trendBari      = govdeOran >= trendGovde
gucluTrendBari = govdeOran >= gucluGovde
doji           = govdeOran <= dojiGovde

gucluBoga = gucluTrendBari and bogaGovde
gucluAyi  = gucluTrendBari and ayiGovde

icBar  = high <= high[1] and low >= low[1]
disBar = high >= high[1] and low <= low[1]

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 12 · Always-in
//
//  Ders: "Always-in yönünün döndüğüne çoğunluğun inanması için genellikle
//  AYNI YÖNDE İKİ ARDIŞIK GÜÇLÜ TREND BARI gerekir." + "Kritik ayrıntı:
//  ikinci trend barının kapanışı" + takip barının ASGARİ ölçütü bir
//  YOKLUK olarak tanımlanır: short'a dönüş için takip barının boğa
//  kapanışı OLMAMASI, long'a dönüş için ayı kapanışı OLMAMASI.
//
//  Dersin hesaplanamayan kısmı adıyla dışarıda: "tek bir ortalama boyutlu
//  trend barı, BAĞLAM çok uygunsa yeterli olabilir" — bağlam ölçülemez.
// ─────────────────────────────────────────────────────────────────────────
ikiBoga = gucluBoga and gucluBoga[1]
ikiAyi  = gucluAyi  and gucluAyi[1]

// Takip barı: iki barlık diziden SONRAKİ bar. Ölçüt yokluk.
flipLong  = ikiBoga[1] and close >= open
flipShort = ikiAyi[1]  and close <= open

var int ai = 0                      // 1 long · −1 short · 0 henüz belirsiz
if flipLong
    ai := 1
else if flipShort
    ai := -1

aiLong  = ai ==  1
aiShort = ai == -1
aiDondu = ai != ai[1] and not na(ai[1])

bgcolor(aiZemin and aiLong  ? color.new(cMavi,   94) : aiZemin and aiShort ? color.new(cClaret, 94) : na, title = "Always-in zemini")

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 7 · Hareketli ortalama
// ─────────────────────────────────────────────────────────────────────────
ema = ta.ema(close, maUzunluk)
plot(maGoster ? ema : na, "EMA", color = cGri, linewidth = 2)

maDokundu = low <= ema and high >= ema

// Gap barı: tamamen ortalamanın diğer tarafında kalan bar (Ders 7.2)
var int gapSayac = 0
gapSayac := maDokundu ? 0 : gapSayac + 1

// Yön filtresi (Ders 7.5②): son N barın K'sı ortalamanın bir yanındaysa
// KARŞI yön işlemi aranmaz. Bu bir sinyal değil, bir YASAKTIR.
ustteSayi = math.sum(close > ema ? 1 : 0, yonPencere)
altta     = math.sum(close < ema ? 1 : 0, yonPencere)
yalnizAl  = ustteSayi >= yonEsik
yalnizSat = altta     >= yonEsik

// Ters tarafta ardışık iki kapanış (Ders 7.5①) — güçlü trendin imzasının BOZULMASI
tersIkiKapanis = (aiLong and close < ema and close[1] < ema) or (aiShort and close > ema and close[1] > ema)

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 2 · Sinyal barı ve kalite
//
//  Asgari koşul (bunun altı dönüş barı DEĞİLDİR):
//    boğa: kapanış açılışın üstünde YA DA orta noktanın üstünde
//    ayı : kapanış açılışın altında YA DA orta noktanın altında
//
//  KALİTE: ders beş ideal nitelik sayar ve şunu açıkça söyler —
//  "Kalite skoru GERÇEK ZAMANDA hiçbir zaman beş üzerinden beş olmaz;
//  en fazla dörttür ve beşincisi girişten sonra öğrenilir."
//  Dördüncü nitelik (sinyalden sonraki barın doji iç bar OLMAMASI) bir
//  sonraki bara bakar; bu yüzden canlı skor 0–4'tür ve o nitelik burada
//  HESAPLANMAZ. Skoru 5'e tamamlamak, indikatörü geleceğe baktırmak olurdu.
// ─────────────────────────────────────────────────────────────────────────
bogaDonus = close > open or close > ortaNokta
ayiDonus  = close < open or close < ortaNokta

// Örtüşme: dersin Şekil 15'te ölçtüğü büyüklük (kabul %67 · ret %92)
ortKesisim = math.min(high, high[1]) - math.max(low, low[1])
ortusme    = menzil[1] > 0 ? math.max(0, ortKesisim) / menzil[1] : 0.0
ikiBarlikDonus = ortusme > ortusmeEsik

// Nitelik 1 · açılış önceki kapanışta/altında, kapanış hem kendi açılışının
//             hem önceki kapanışın ötesinde
n1Boga = open <= close[1] and close > open and close > close[1]
n1Ayi  = open >= close[1] and close < open and close < close[1]

// Nitelik 2 · karşı kuyruk menzilin 1/3–1/2'si, aynı yön kuyruğu küçük
n2Boga = menzil > 0 and altKuyruk >= menzil / 3 and altKuyruk <= menzil / 2 and ustKuyruk <= menzil * 0.15
n2Ayi  = menzil > 0 and ustKuyruk >= menzil / 3 and ustKuyruk <= menzil / 2 and altKuyruk <= menzil * 0.15

// Nitelik 3 · önceki barla az örtüşme
n3 = ortusme <= ortusmeEsik

// Nitelik 5 · BİRDEN FAZLA barın kapanışını ve ucunu tersine çevirme
n5Boga = close > ta.highest(close[1], kapanisPenc) and high > ta.highest(high[1], ucPenc)
n5Ayi  = close < ta.lowest(close[1],  kapanisPenc) and low  < ta.lowest(low[1],   ucPenc)

kaliteBoga = (n1Boga ? 1 : 0) + (n2Boga ? 1 : 0) + (n3 ? 1 : 0) + (n5Boga ? 1 : 0)
kaliteAyi  = (n1Ayi  ? 1 : 0) + (n2Ayi  ? 1 : 0) + (n3 ? 1 : 0) + (n5Ayi  ? 1 : 0)

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 6 · Bar sayma
//
//  Ders: "Boğa trendinde veya yatay bantta yatay/aşağı bir harekette,
//  zirvesi önceki barın zirvesinin en az bir tick üstüne çıkan ilk bar
//  'high 1'dir." Rejim filtresi: boğa trendinde low sayılmaz, ayıda high.
//
//  DIŞARIDA KALAN: "high 1 ile high 2 arasında en az küçücük bir trend
//  çizgisi kırılımı olmalıdır." Trend çizgisi çizimi bir yorum işidir;
//  sayaç bu koşulu SORMAZ, o yüzden sayaç bir kurulum değil bir SAYAÇTIR.
// ─────────────────────────────────────────────────────────────────────────
var int  hSayac = 0
var int  lSayac = 0
var float gcZirve = na          // geri çekilmenin başladığı zirve
var float gcDip   = na

if aiDondu
    hSayac := 0
    lSayac := 0
    gcZirve := na
    gcDip   := na

if aiLong
    if na(gcZirve) or high > gcZirve
        gcZirve := high          // trend sürüyor, sayım sıfırlanır
        hSayac  := 0
    else if high > high[1]
        hSayac := hSayac + 1     // geri çekilme içinde bir bacak bitti
if aiShort
    if na(gcDip) or low < gcDip
        gcDip  := low
        lSayac := 0
    else if low < low[1]
        lSayac := lSayac + 1

hEtiket = hSayac > 0 and high > high[1] and aiLong  ? "H" + str.tostring(math.min(hSayac, 4)) : na
lEtiket = lSayac > 0 and low  < low[1]  and aiShort ? "L" + str.tostring(math.min(lSayac, 4)) : na


// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 1.2 · Kapanışın menzil içindeki yeri
//
//  Ders: "Kapanışın menzil içindeki yeri, gövdenin büyüklüğünden bile daha
//  bilgi vericidir — çünkü kapanış, mücadelenin nihai skorudur." %50 berabere.
// ─────────────────────────────────────────────────────────────────────────
kapanisYeri = menzil > 0 ? (close - low) / menzil : 0.5

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 1.1 · Tıraşlı bar
//
//  Kuyruğu olmayan uç. Ders 2.6: "Tepede bir tick kuyruk … hâlâ güçlüdür" —
//  ölçü bu yüzden tam sıfır değil, BİR TİCK toleranslı.
// ─────────────────────────────────────────────────────────────────────────
tirasliTepe = ustKuyruk <= syminfo.mintick
tirasliDip  = altKuyruk <= syminfo.mintick
tirasAd = tirasliTepe and tirasliDip ? "marubozu" : tirasliTepe ? "tıraşlı tepe" : tirasliDip ? "tıraşlı dip" : "—"

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 1.10b · Çevirme sayaçları
//
//  "Bir barın gücünü ölçmenin en ekonomik yolu, o barın KAÇ ÖNCEKİ BARIN
//  KAPANIŞINI tersine çevirdiğini saymaktır." Uç sayacı ile kapanış sayacı
//  AYRI tutulur; ders ikincisinin ağır bastığını söyler — "bir seviyeyi
//  kuyrukla aşan bar reddedilmiştir; kapanışla aşan bar o emirleri
//  tüketmiştir."
//
//  Sayım ARDIŞIKTIR: ilk aşılamayan barda durur. Toplam sayım bir pencere
//  seçimi isterdi ve ders pencere vermiyor.
// ─────────────────────────────────────────────────────────────────────────
f_cevirmeKapanis(bool boga, int tavan) =>
    int n = 0
    for j = 1 to tavan
        gecti = not na(close[j]) and (boga ? close > close[j] : close < close[j])
        if not gecti
            break
        n += 1
    n

f_cevirmeUc(bool boga, int tavan) =>
    int n = 0
    for j = 1 to tavan
        gecti = boga ? (not na(high[j]) and close > high[j]) : (not na(low[j]) and close < low[j])
        if not gecti
            break
        n += 1
    n

cevirmeKap    = f_cevirmeKapanis(bogaGovde, cevirmeTavan)
cevirmeUcSay  = f_cevirmeUc(bogaGovde, cevirmeTavan)
cevirmeKademe = cevirmeKap > cevirmeKirilim ? "çok güçlü çevirme" :
   cevirmeKap > cevirmeRejim ? "rejim iddiası" :
   cevirmeKap < cevirmeSiradan ? "sıradan" : "ara"

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 1.3 · Trendleşme ve göreli gövde gücü
//
//  "Trendleşen kapanışlar: üç veya daha fazla barda her kapanış bir
//  öncekinin üzerinde (boğa) veya altında (ayı)." Aynı ölçüt zirve ve dip
//  için de geçerli; asgari eşik üçtür.
//
//  Gövde gücü GÖRECELİ ölçülür: "Bir gövde, son 5–10 barın MEDYAN gövdesi
//  kadar veya daha büyükse güçlüdür." Mutlak gövde eşiği kullanılmaz.
// ─────────────────────────────────────────────────────────────────────────
//  NOT: fonksiyon seriyi PARAMETRE olarak almaz. Pine, bir fonksiyonun
//  yerel değişkeninin geçmişine bakmaya izin vermez; seriyi argüman yapıp
//  gövdede src[j] demek tam o kısıta çarpar. Seçici bir int alıp globalleri
//  okumak kısıtı yapısal olarak dışarıda bırakır.
f_dizi(int hangi) =>
    int yukari = 0
    for j = 0 to 200
        float a = hangi == 0 ? close[j] : hangi == 1 ? high[j] : low[j]
        float b = hangi == 0 ? close[j + 1] : hangi == 1 ? high[j + 1] : low[j + 1]
        if na(b) or not (a > b)
            break
        yukari += 1
    int asagi = 0
    for j = 0 to 200
        float a = hangi == 0 ? close[j] : hangi == 1 ? high[j] : low[j]
        float b = hangi == 0 ? close[j + 1] : hangi == 1 ? high[j + 1] : low[j + 1]
        if na(b) or not (a < b)
            break
        asagi += 1
    yukari >= asagi ? yukari : -asagi

diziKapanis = f_dizi(0)
diziZirve   = f_dizi(1)
diziDip     = f_dizi(2)
trendlesiyor = math.abs(diziKapanis) >= trendlesmeEsik

medyanGovde = ta.median(govde[1], medyanPencere)
govdeGuclu  = not na(medyanGovde) and govde >= medyanGovde

// Bölüm 2.5 · "Yalnızca gövdeler ii" — kuyruklar yok sayılır. Ders bunu
// ii'nin DAHA AZ GÜVENİLİR bir çeşidi sayar, o yüzden ii ile aynı ada girmez.
govdeUst  = math.max(open, close)
govdeAlt  = math.min(open, close)
govdeIcBar = not icBar and govdeUst <= math.max(open[1], close[1]) and govdeAlt >= math.min(open[1], close[1])

// Bölüm 2.9 · Momentum yokluğu — kaç bardır karşı kapanış görülmedi
f_momentum() =>
    int boga = 0
    for j = 0 to 200
        if na(close[j]) or close[j] > open[j]
            break
        boga += 1
    int ayi = 0
    for j = 0 to 200
        if na(close[j]) or close[j] < open[j]
            break
        ayi += 1
    boga >= ayi ? boga : -ayi

momentumYok = f_momentum()

// Bölüm 1.6 · Gövde boşluğu — kuyruklar örtüşebilir, ölçülen GÖVDELERDİR.
govdeBosluk = open > close[1] ? 1 : open < close[1] ? -1 : 0

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 1.8 · 2.5 · ii · iii · ioi · oio · oo ve KIRILIM MODU
//
//  Dersin ortak dili: "Bu dört kalıbın hepsi aynı şeyi söyler: KALIP BİR
//  YATAY BANTTIR. Yön bilinmez." Bu yüzden çıktı bir yön değil, iki taraflı
//  bir EMİR MİMARİSİDİR: üstüne alış stop, altına satış stop; biri
//  tetiklenince öbürü iptal ve fiilen koruyucu stop olur.
// ─────────────────────────────────────────────────────────────────────────
kalipAd = (icBar and icBar[1] and icBar[2]) ? "iii" :
   (icBar and disBar[1] and icBar[2]) ? "ioi" :
   (disBar and icBar[1] and disBar[2]) ? "oio" :
   (icBar and icBar[1]) ? "ii" :
   (disBar and disBar[1] and menzil > menzil[1]) ? "oo" : ""
//  ta.highest/ta.lowest UZUNLUĞU simple int ister; kalıbın bar sayısı ise
//  bara göre değişen bir SERİ int. İkisi ayrı ayrı hesaplanıp seçilir.
kalipBar   = kalipAd == "iii" or kalipAd == "ioi" or kalipAd == "oio" ? 3 : 2
tepe3 = ta.highest(high, 3)
tepe2 = ta.highest(high, 2)
dip3  = ta.lowest(low, 3)
dip2  = ta.lowest(low, 2)
kalipTepe  = kalipBar == 3 ? tepe3 : tepe2
kalipDip   = kalipBar == 3 ? dip3  : dip2

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 2.3 · ORTA NOKTA ÖLÇÜTÜ
//
//  Örtüşme kuralının ADI OLAN hâli; sabitler tablosunda böyle geçer:
//  "Sinyal barında örtüşme kuralı — kapanış, önceki barın ORTA NOKTASININ
//  ötesinde." Dersin Şekil 15'i iki paneli tam buradan ayırır: kabul edilen
//  bar orta noktanın üstünde, reddedilen altında kapanıyor.
//
//  %75'lik örtüşme eşiği AYRI bir ölçüttür ve "iki barlık dönüş oku" der;
//  bu ise barın KABUL/RET sınırıdır. İkisi aynı şey değildir.
// ─────────────────────────────────────────────────────────────────────────
oncekiOrta   = (high[1] + low[1]) / 2
ortaNoktaBoga = close > oncekiOrta
ortaNoktaAyi  = close < oncekiOrta

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 2.4 · İki barlık dönüş
//
//  "Yaklaşık aynı boyda, zıt yönlü iki trend barı." Giriş HER İKİ barın
//  ötesine konur: dibi önceki barın bir tick üstünde olan bir ayı dönüş
//  barı sık sık ayı tuzağıdır.
// ─────────────────────────────────────────────────────────────────────────
govdeIm     = close - open
zitYon      = govdeIm * govdeIm[1] < 0
buyukGovde  = math.max(math.abs(govdeIm), math.abs(govdeIm[1]))
kucukGovde  = math.min(math.abs(govdeIm), math.abs(govdeIm[1]))
esitGovde   = buyukGovde > 0 and kucukGovde / buyukGovde >= esitGovdeOran
ikiBarDonus = trendBari and trendBari[1] and zitYon and esitGovde
ikiBarAd    = not ikiBarDonus ? "—" : govdeIm > 0 ? "iki barlık dönüş (boğa)" : "iki barlık dönüş (ayı)"
ikiBarTepe  = math.max(high, high[1])
ikiBarDip   = math.min(low, low[1])

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 2.6 · Küçük bar · tükeniş barı · mikro çift dip/tepe
//
//  İkisinin de ölçüsü GÖRECELİdir. Dersin verdiği tek sayı tükenişin
//  BAĞLAMIDIR: "10 veya daha fazla bar süren bir trendin içinde alışılmadık
//  büyüklükte bir bar."
//
//  Mikro çift dip/tepe için dersin uyarısı koda değil OKUMAYA aittir: bu
//  kalıbın bağlama göre İKİ TAMAMEN ZIT anlamı vardır — ayı spike'ı içinde
//  tek barlık bayrak (devam), başka her yerde dönüş. İndikatör kalıbı
//  gösterir, hükmü vermez.
// ─────────────────────────────────────────────────────────────────────────
ortMenzil  = ta.sma(menzil[1], medyanPencere)
kucukBar   = not na(ortMenzil) and ortMenzil > 0 and menzil < ortMenzil * kucukBarOran
buyukBar   = not na(ortMenzil) and ortMenzil > 0 and menzil > ortMenzil * tukenisOran
tukenis    = buyukBar and math.abs(diziKapanis) >= tukenisTrendBar
barBoyuAd  = kucukBar ? "küçük bar" : tukenis ? "tükeniş barı" : buyukBar ? "alışılmadık büyük" : "—"

mikroTol   = menzil * mikroTolerans
mikroCift  = mikroTol <= 0 ? "—" :
   math.abs(low - low[1]) <= mikroTol ? "mikro çift dip" :
   math.abs(high - high[1]) <= mikroTol ? "mikro çift tepe" : "—"

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 3.8 · Mikro kanal — geri çekilmesiz ardışık bar
// ─────────────────────────────────────────────────────────────────────────
f_mikroKanal() =>
    int yukari = 0
    for j = 0 to 200
        if na(low[j + 1]) or not (low[j] >= low[j + 1])
            break
        yukari += 1
    int asagi = 0
    for j = 0 to 200
        if na(high[j + 1]) or not (high[j] <= high[j + 1])
            break
        asagi += 1
    yukari >= asagi ? yukari : -asagi

mikroKanal = f_mikroKanal()

// ─────────────────────────────────────────────────────────────────────────
//  Bölüm 8A.6 · Beş bar iptal kuralı
//
//  "Eski ucun ötesinde ≥ 5 KAPANIŞ" → dönüş arayışı iptal. Eşik bir ÜST
//  SINIRDIR: geçmek kurulumu ÖLDÜRÜR. Ölçü kapanışla yapılır, uçla değil —
//  ucun aşılması bir deneme, kapanışın aşılması bir sonuçtur.
// ─────────────────────────────────────────────────────────────────────────
eskiTepe = ta.highest(high, 40)[iptalKapanis]
eskiDip  = ta.lowest(low, 40)[iptalKapanis]
ustKapanis = math.sum(not na(eskiTepe) and close > eskiTepe ? 1 : 0, iptalKapanis)
altKapanis = math.sum(not na(eskiDip)  and close < eskiDip  ? 1 : 0, iptalKapanis)
iptalAd = ustKapanis >= iptalKapanis ? "ayı dönüşü arayışı İPTAL" :
   altKapanis >= iptalKapanis ? "boğa dönüşü arayışı İPTAL" : "—"

// ─────────────────────────────────────────────────────────────────────────
//  Çizim
// ─────────────────────────────────────────────────────────────────────────
barrenk = not barBoya ? na :
   gucluBoga ? cMavi :
   gucluAyi  ? cClaret :
   doji      ? cGri :
   bogaGovde ? color.new(cMavi, 55) :
   ayiGovde  ? color.new(cClaret, 55) : cGri
barcolor(barrenk, title = "Bar sınıfı")

if sinyalGoster and bogaDonus and kaliteBoga >= asgariKalite and kaliteBoga > 0 and not yalnizSat
    label.new(bar_index, low, str.tostring(kaliteBoga) + "/4", yloc = yloc.belowbar,
       style = label.style_label_up, color = color.new(cMavi, 80), textcolor = cMurekkep, size = size.tiny,
       tooltip = "Boğa sinyal barı · canlı kalite " + str.tostring(kaliteBoga) + "/4" +
       "\nÖrtüşme: %" + str.tostring(math.round(ortusme * 100)) + (ikiBarlikDonus ? " → İKİ BARLIK dönüş oku" : ""))

if sinyalGoster and ayiDonus and kaliteAyi >= asgariKalite and kaliteAyi > 0 and not yalnizAl
    label.new(bar_index, high, str.tostring(kaliteAyi) + "/4", yloc = yloc.abovebar,
       style = label.style_label_down, color = color.new(cClaret, 80), textcolor = cMurekkep, size = size.tiny,
       tooltip = "Ayı sinyal barı · canlı kalite " + str.tostring(kaliteAyi) + "/4" +
       "\nÖrtüşme: %" + str.tostring(math.round(ortusme * 100)) + (ikiBarlikDonus ? " → İKİ BARLIK dönüş oku" : ""))

if sayimGoster and not na(hEtiket)
    label.new(bar_index, high, hEtiket, yloc = yloc.abovebar, style = label.style_none,
       textcolor = cMavi, size = size.tiny)
if sayimGoster and not na(lEtiket)
    label.new(bar_index, low, lEtiket, yloc = yloc.belowbar, style = label.style_none,
       textcolor = cClaret, size = size.tiny)

if kalipGoster and kalipAd != ""
    label.new(bar_index, high, kalipAd, yloc = yloc.abovebar, style = label.style_label_down,
       color = color.new(cGri, 80), textcolor = cMurekkep, size = size.tiny,
       tooltip = "Kırılım modu · kalıp bir YATAY BANTTIR, yön bilinmez." +
       "\nAlış stop " + str.tostring(kalipTepe, format.mintick) +
       " · satış stop " + str.tostring(kalipDip, format.mintick) +
       "\nYükseklik " + str.tostring(kalipTepe - kalipDip, format.mintick) +
       "\nBiri tetiklenince öbürü iptal; dolmamış emir koruyucu stop olur.")
    line.new(bar_index - kalipBar + 1, kalipTepe, bar_index + 2, kalipTepe, color = color.new(cMavi, 40), style = line.style_dotted)
    line.new(bar_index - kalipBar + 1, kalipDip,  bar_index + 2, kalipDip,  color = color.new(cClaret, 40), style = line.style_dotted)

plotshape(aiDondu and aiLong,  "Always-in → long",  shape.triangleup,   location.belowbar, cMavi,   size = size.small)
plotshape(aiDondu and aiShort, "Always-in → short", shape.triangledown, location.abovebar, cClaret, size = size.small)

if maGoster and gapSayac == gapEsik
    label.new(bar_index, aiLong ? low : high, str.tostring(gapEsik) + " gap bar",
       yloc = aiLong ? yloc.belowbar : yloc.abovebar, style = label.style_none,
       textcolor = cGri, size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────
//  Durum kutusu
// ─────────────────────────────────────────────────────────────────────────
var table kutu = table.new(position.top_right, 2, 14, border_width = 1)
if barstate.islast
    table.cell(kutu, 0, 0, "Always-in", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 0, aiLong ? "LONG" : aiShort ? "SHORT" : "—", text_size = size.small,
       text_color = aiLong ? cMavi : aiShort ? cClaret : cGri)
    table.cell(kutu, 0, 1, "Yön filtresi", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 1, yalnizAl ? "yalnız AL" : yalnizSat ? "yalnız SAT" : "serbest", text_size = size.small,
       text_color = yalnizAl ? cMavi : yalnizSat ? cClaret : cGri)
    table.cell(kutu, 0, 2, "Gap bar", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 2, str.tostring(gapSayac) + (gapSayac >= gapEsik ? " ⚑" : ""), text_size = size.small, text_color = cMurekkep)
    table.cell(kutu, 0, 3, "Bar sayımı", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 3, aiLong ? "H" + str.tostring(math.min(hSayac, 4)) : aiShort ? "L" + str.tostring(math.min(lSayac, 4)) : "—",
       text_size = size.small, text_color = cMurekkep)
    table.cell(kutu, 0, 4, "Ters iki kapanış", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 4, tersIkiKapanis ? "VAR" : "yok", text_size = size.small,
       text_color = tersIkiKapanis ? cClaret : cGri)
    table.cell(kutu, 0, 5, "Bar sınıfı", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 5, (gucluTrendBari ? "güçlü trend" : trendBari ? "trend" : doji ? "doji" : "ara")
       + (govdeGuclu ? " · gövde güçlü" : "") + (tirasAd != "—" ? " · " + tirasAd : ""),
       text_size = size.small, text_color = cMurekkep)

    // Bölüm 1.2 — kapanışın yeri: gövdeden bile bilgi verici
    table.cell(kutu, 0, 6, "Kapanışın yeri", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 6, "%" + str.tostring(math.round(kapanisYeri * 100)), text_size = size.small,
       text_color = kapanisYeri > 0.5 ? cMavi : kapanisYeri < 0.5 ? cClaret : cGri)

    // Bölüm 1.10b — SAYI basılır, hüküm basılmaz (kademenin hükmü sınandı ve tutmadı)
    table.cell(kutu, 0, 7, "Çevirme (kapanış · uç)", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 7, str.tostring(cevirmeKap) + " · " + str.tostring(cevirmeUcSay) + "  (" + cevirmeKademe + ")",
       text_size = size.small, text_color = cMurekkep)

    // Bölüm 1.3 — trendleşme: kapanış / zirve / dip
    table.cell(kutu, 0, 8, "Trendleşme (k·z·d)", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 8, str.tostring(diziKapanis) + " · " + str.tostring(diziZirve) + " · " + str.tostring(diziDip)
       + (trendlesiyor ? " ⚑" : ""), text_size = size.small, text_color = cMurekkep)

    // Bölüm 2.3 — örtüşme kuralının ADI OLAN hâli
    table.cell(kutu, 0, 9, "Orta nokta ölçütü", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 9, ortaNoktaBoga ? "boğa ✓" : ortaNoktaAyi ? "ayı ✓" : "—", text_size = size.small,
       text_color = ortaNoktaBoga ? cMavi : ortaNoktaAyi ? cClaret : cGri)

    // Bölüm 1.8 · 2.5 — kırılım modu
    table.cell(kutu, 0, 10, "Kalıp", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 10, (kalipAd == "" ? (govdeIcBar ? "yalnız gövdeler ii" : "—") : kalipAd + " · kırılım modu")
       + (math.abs(momentumYok) >= momentumBar ? "  · " + str.tostring(math.abs(momentumYok)) + " bardır "
          + (momentumYok > 0 ? "boğa" : "ayı") + " kapanışı yok" : ""),
       text_size = size.small, text_color = kalipAd == "" and not govdeIcBar ? cGri : cMurekkep)

    // Bölüm 2.4 · 2.6 — iki barlık dönüş, bar boyu, mikro çift
    table.cell(kutu, 0, 11, "Kalıp (2 bar)", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 11, ikiBarAd, text_size = size.small, text_color = ikiBarDonus ? cMurekkep : cGri)
    table.cell(kutu, 0, 12, "Bar boyu · mikro", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 12, barBoyuAd + " · " + mikroCift, text_size = size.small, text_color = cMurekkep)

    // Bölüm 3.8 · 8A.6 — mikro kanal ve iptal kuralı
    table.cell(kutu, 0, 13, "Mikro kanal · iptal", text_size = size.small, text_color = cGri, text_halign = text.align_left)
    table.cell(kutu, 1, 13, str.tostring(mikroKanal) + " bar · " + iptalAd, text_size = size.small,
       text_color = iptalAd != "—" ? cClaret : cMurekkep)

// ─────────────────────────────────────────────────────────────────────────
//  Uyarılar — hepsi KAPANMIŞ bar üzerinden
// ─────────────────────────────────────────────────────────────────────────
alertcondition(aiDondu and aiLong,  "Always-in long'a döndü",  "Brooks FH: always-in LONG")
alertcondition(aiDondu and aiShort, "Always-in short'a döndü", "Brooks FH: always-in SHORT")
alertcondition(gapSayac == gapEsik, "Gap bar eşiği",           "Brooks FH: ortalamaya dokunmayan bar sayısı eşiğe ulaştı")
alertcondition(tersIkiKapanis,      "Ters tarafta iki kapanış","Brooks FH: trendin karakteri değişmiş olabilir")
alertcondition(kalipAd != "",       "Kırılım modu kalıbı",     "Brooks FH: ii/iii/ioi/oio/oo — iki tarafa da emir")
alertcondition(ikiBarDonus,         "İki barlık dönüş",        "Brooks FH: giriş HER İKİ barın ötesine konur")
alertcondition(iptalAd != "—",      "Beş bar iptal kuralı",    "Brooks FH: eski ucun ötesinde beş kapanış — dönüş arayışı iptal")
