// Bu indikatör TTO Trading'in "Fiyat Hareketi: Al Brooks Yöntemiyle Bar Bar
// Okuma" dersinden türetilmiştir. Alt panele konur; fiyat paneline konan
// "Brooks · Fiyat Hareketi" indikatörünün eşidir.
//
// NE ÖLÇER. Dersin Bölüm 4.2'deki yatay bant tanı listesi 19 maddedir ve
// çoğu GÖZLE okunur ("belirsizlik hissi", "aynı anda hem boğa hem ayı
// kurulumu"). Dersin Şekil 30'u o listenin ÖLÇÜLEBİLİR dört maddesini
// gerçek veride sayıyla verir: örtüşme oranı, doji oranı, ortalama kesişme
// sayısı ve net/aralık. Bu pano tam olarak o dört sayıyı canlı hesaplar.
//
// EŞİK NEREDEN GELİR — ÖLÇÜLDÜ (15.09.2026). Şekil 30'un dört sayısı tek bir
// seride, tek bir günde ölçülmüş SEVİYELERDİR. Aynı eşikler başka enstrümana
// taşınınca ne oluyor, on üç 1 saatlik/4 saatlik/günlük seride ve beş Yahoo
// 5–15 dakikalık FX serisinde sayıldı: örtüşme işareti 1 saatlik serilerin
// 9'unda %100 açık, 5 dk EUR/USD'de %3, USD/CHF'de %100, GBP/USD'de %9; doji
// işareti 1 saatlik 13 serinin 13'ünde %0. Sabit bir eşik bir enstrümanda hep
// "bant", öbüründe hiç "bant" der — ikisi de rejim ölçmez. Bu yüzden öntanımlı
// kip GÖRELİ: her ölçü, kendi son `tarihce` bardaki değerlerine göre yüzdelik
// sırasına çevrilir (Pine `ta.percentrank`), sıra %60'ı geçerse o ölçü bant
// tarafındadır. Dersin mutlak eşikleri seçenek olarak durur.
//
// GÖRELİ HÜKÜM DE BİR TAHMİN DEĞİLDİR. Ölçüldü: BANT ve trend pencerelerinin
// sonraki 35 barının net/aralık'ı ayrışmıyor (5 seri × 2 tarihçe, permütasyon
// p 0,19–0,94; mutlak hükümde de aynı). Pano son 70 barı TARİF eder, hangi
// kurulum ailesinin geçerli olduğunu söyler; yön ya da kenar ilan etmez.
//
// NE ÖLÇMEZ — VE BU BİLEREK. Dersin Bölüm 3.5'teki güçlü trend kontrol
// listesi 24 maddedir ve ders onu puana çevirmeyi ADIYLA yasaklar:
// "Maddeler eşit ağırlıklı değildir ve sayılmaz; okunur." Bu yüzden burada
// bir "trend gücü skoru" YOKTUR. Bant tarafında sayım meşrudur, çünkü ders
// orada açıkça "beş veya daha fazla madde işaretliyse" der; trend tarafında
// değildir.
//
//@version=6
indicator("Brooks · Rejim Panosu", shorttitle="Brooks RP", overlay = false)

g1 = "Pencere"
pencere    = input.int(70, "Ölçüm penceresi (bar)", minval = 10, maxval = 300, tooltip = "Ders Şekil 30'da bant 70 bar sürüyor ve dört tanı sayısı o pencerede ölçülüyor.", group = g1)
maUzunluk  = input.int(20, "EMA uzunluğu", minval = 2, group = g1)

g2 = "Bant eşikleri — dersin Şekil 30'da ölçtüğü değerler"
ortusmeEsik = input.float(0.50, "Bir bar 'örtüşüyor' sayılır: örtüşme ≥", minval = 0.2, maxval = 0.9, step = 0.05, group = g2, tooltip = "Madde 10: 'Birçok bar bir öncekiyle %50 veya daha fazla örtüşüyor'")
ortusmePay  = input.float(0.50, "Bant işareti: örtüşen bar payı ≥",       minval = 0.2, maxval = 0.9, step = 0.05, group = g2, tooltip = "Ders Şekil 30'da bant gününde ölçülen: 0,725")
dojiGovde   = input.float(0.10, "Doji: gövde/menzil ≤",                   minval = 0.02, maxval = 0.3, step = 0.01, group = g2)
dojiPay     = input.float(0.25, "Bant işareti: doji payı ≥",              minval = 0.05, maxval = 0.6, step = 0.05, group = g2, tooltip = "Ders Şekil 30'da bant gününde ölçülen: 0,314")
kesismeEsik = input.int(5, "Bant işareti: ortalama kesişme ≥",            minval = 2, group = g2, tooltip = "Ders: trend gününde bu sayı 'bir elin parmaklarını geçmez'. Şekil 30'da bant gününde 17.")
netEsik     = input.float(0.50, "Bant işareti: net/aralık ≤",             minval = 0.05, maxval = 0.95, step = 0.05, group = g2, tooltip = "Ders: trend penceresinde 1,00; Şekil 30'un bant gününde 0,037.")
diziEsik    = input.int(3, "Bant işareti: azami ardışık trend barı <",     minval = 2, maxval = 6, group = g2, tooltip = "Madde 8: 'üç-dört ardışık aynı yönlü trend barı ENDER'")

g2b = "Göreli eşik — ölçüm kendi tarihçesine göre (öntanımlı)"
esikKipi  = input.string("Göreli", "Eşik kipi", options = ["Göreli", "Ders (mutlak)"], group = g2b, tooltip = "Göreli: her ölçü son `tarihçe` bardaki kendi değerlerine göre yüzdelik sıraya çevrilir; sıra eşiği geçerse bant işareti. Ders (mutlak): Şekil 30'un sabit eşikleri — ölçüldü, enstrümana göre %3–%100 arasında açık kalıyor.")
tarihce   = input.int(280, "Tarihçe (bar)", minval = 70, maxval = 2000, group = g2b, tooltip = "Sıra bu kadar önceki barın değerine göre kurulur. 5 dakikalık 24 saat FX'te 280 bar ≈ 1 gün. Tarihçe dolana kadar pano hüküm vermez.")
goreliPay = input.float(0.60, "Bant işareti: sıra ≥", minval = 0.5, maxval = 0.95, step = 0.05, group = g2b, tooltip = "Ölçü, tarihçesinin bu payından daha bantlıysa işaret. 0,60 ile her ölçü her seride ortalama %40 dolayında açık kalır (ölçüldü: %40–67).")

g3 = "Bölüm 4.9 · Barbwire (dikenli tel)"
bwBar     = input.int(3, "Asgari örtüşen bar", minval = 3, maxval = 6, group = g3, tooltip = "Ders: 'Üç veya daha fazla bar büyük ölçüde örtüşüyorsa…'")
bwOrtaPay = input.float(0.50, "Ortadaki barın komşularında kalan payı >", minval = 0.2, maxval = 0.9, step = 0.05, group = g3, tooltip = "Dersin SAYISAL ölçütü: 'üç barın ortadakine bak; yüksekliğinin yarısından fazlası önceki ve sonraki barın aralığı içindeyse üç barı barbwire say.'")
bwDoji    = input.int(1, "Asgari doji sayısı", minval = 1, maxval = 3, group = g3, tooltip = "Ders: '…bunlardan en az biri çok küçük gövdeliyse (doji)'")

g4 = "Gösterim"
kutuYeri  = input.string("Sağ üst", "Kutunun yeri", options = ["Sağ üst", "Sağ alt", "Sol üst", "Sol alt", "Orta sağ"], group = g4)
kutuBoyut = input.string("Küçük",   "Kutu yazı boyutu", options = ["Minik", "Küçük", "Normal"], group = g4)
kutuKip   = input.string("Tam",     "Durum kutusu", options = ["Tam", "Özet", "Kapalı"], group = g4, tooltip = "Özet kipi yalnız HÜKMÜ gösterir (BANT · ara · trend) ve beş ölçünün ayrıntısını gizler.")

cMurekkep = color.new(#1a1a1a, 0)
cClaret   = color.new(#8c2f39, 0)
cMavi     = color.new(#2f5d8c, 0)
cGri      = color.new(#8a8a8a, 0)

// ── TEMA · KUTU METNİ ZEMİNE GÖRE SEÇİLİR ────────────────────────────────
//  Palet siteden kopyalanmıştı: kâğıt beyaz, mürekkep #1a1a1a. TradingView'in
//  KOYU temasında o mürekkep zeminle 1,03:1 kontrast veriyor — yani metin
//  GÖRÜNMÜYOR. Kusur sessiz, çünkü satırın ETİKETİ gri (#8a8a8a, koyu zeminde
//  5,18:1) ve okunuyor: okur satırı görüyor, değerini boş sanıyor. Ölçüldü ve
//  kutunun on üç satırının BEŞİ (Sınıf · Boy·mikro · Çevirme · Trendleşme ·
//  Sayım) yalnız bu mürekkeple yazıldığı için koyu temada tamamen kayboluyordu.
//
//  Açık temada da bir kusur vardı ve ters yönde: etiket grisi beyaz zeminde
//  3,45:1, WCAG AA gövde eşiğinin (4,5) ALTINDA. Kutunun kendi etiketleri
//  okunabilir en soluk mürekkepten daha soluktu.
//
//  GRAFİK PALETİ DEĞİŞMEZ. Bar rengi, zemin, üçgen ve EMA sayfadaki
//  figürlerle aynı kalmalı; değişen yalnız TABLO metninin rengidir.
tema = input.string("Otomatik", "Kutu renk teması", options = ["Otomatik", "Açık", "Koyu"],
   group = g4, tooltip = "Otomatik, grafiğin zemin rengine bakar. Koyu temada near-black metin görünmez.")
zeminIsik = (color.r(chart.bg_color) * 0.299 + color.g(chart.bg_color) * 0.587 +
   color.b(chart.bg_color) * 0.114) / 255
koyuTema = tema == "Koyu" or (tema == "Otomatik" and zeminIsik < 0.5)

cYaziAna  = koyuTema ? color.new(#dcd9d2, 0) : cMurekkep
cYaziGri  = koyuTema ? color.new(#a0a6ad, 0) : color.new(#6f6f6f, 0)
cYaziKzl  = koyuTema ? color.new(#e0919a, 0) : cClaret
cYaziMavi = koyuTema ? color.new(#8ab6e8, 0) : cMavi

// ── Ölçüler ──────────────────────────────────────────────────────────────
menzil    = high - low
govdeOran = menzil > 0 ? math.abs(close - open) / menzil : 0.0
doji      = govdeOran <= dojiGovde
ema       = ta.ema(close, maUzunluk)

// ① Örtüşme oranı — barların kaçı bir öncekiyle eşikten fazla örtüşüyor
kesisim     = math.min(high, high[1]) - math.max(low, low[1])
ortusmeBar  = menzil[1] > 0 ? (math.max(0, kesisim) / menzil[1]) >= ortusmeEsik : false
ortusmeOran = math.sum(ortusmeBar ? 1 : 0, pencere) / pencere

// ② Doji oranı
dojiOran = math.sum(doji ? 1 : 0, pencere) / pencere

// ③ Ortalama kesişme sayısı
kesti    = (close > ema and close[1] <= ema) or (close < ema and close[1] >= ema)
kesisme  = math.sum(kesti ? 1 : 0, pencere)

// ④ Net / aralık
enYuksek = ta.highest(high, pencere)
enDusuk  = ta.lowest(low, pencere)
toplamAralik = enYuksek - enDusuk
netDegisim   = math.abs(close - close[pencere - 1])
netAralik    = toplamAralik > 0 ? netDegisim / toplamAralik : 0.0

// ⑤ Azami ardışık aynı yönlü trend barı (madde 8)
trendBari = govdeOran >= 0.50
var int bogaDizi = 0
var int ayiDizi  = 0
bogaDizi := trendBari and close > open ? bogaDizi + 1 : 0
ayiDizi  := trendBari and close < open ? ayiDizi  + 1 : 0
dizi     = math.max(bogaDizi, ayiDizi)
azamiDizi = ta.highest(dizi, pencere)

// ── Bölüm 4.9 · Barbwire ─────────────────────────────────────────────────
//
//  Dersin bu kalıp için verdiği ölçüt SAYISALDIR ve gözle teşhisin yerine
//  geçer: "üç barın ORTADAKİNE bak; yüksekliğinin yarısından fazlası önceki
//  VE sonraki barın aralığı içindeyse üç barı barbwire say."
//
//  "Sonraki bar" geleceğe bakmak DEĞİL: kalıp üçüncü barında adlandırılır,
//  yani ortadaki bar [1], komşuları [2] ve [0]. Üçü de kapanmıştır.
//
//  NİÇİN ÖNEMLİ — dersin en sinsi tuzağı: "Barbwire içindeki bir dönüş
//  barını gerçek dönüş barı sanmak." Dar bantta dönüş barının TERS
//  ÇEVİRECEK BİR ŞEYİ YOKTUR; bir doji gibi davranır. Pano bu yüzden
//  barbwire'ı ayrıca işaretler: fiyat panelindeki kalite skoru orada
//  okunmaz.
// ─────────────────────────────────────────────────────────────────────────
bwOrtaMenzil = high[1] - low[1]
bwKesOnce    = math.min(high[1], high[2]) - math.max(low[1], low[2])
bwKesSonra   = math.min(high[1], high[0]) - math.max(low[1], low[0])
bwOrtusme    = bwOrtaMenzil > 0 and
   math.max(0.0, bwKesOnce)  / bwOrtaMenzil > bwOrtaPay and
   math.max(0.0, bwKesSonra) / bwOrtaMenzil > bwOrtaPay
bwDojiSay    = math.sum(doji ? 1 : 0, bwBar)
barbwire     = bwOrtusme and bwDojiSay >= bwDoji

// ── Göreli sıra: önceki `tarihce` barın kaçı bugünkü değerden ≤ ─────────
//  `ta.percentrank(x, n)`: önceki n değerin yüzde kaçı ≤ bugünkü değer (bugün
//  hariç, payda n). ≤-tipi ölçülerde (net/aralık · dizi) "daha bantlı" =
//  daha küçük, o yüzden sıra −x üzerinden alınır: kaçı ≥ bugünkü değer.
//  Python replikasyonu (brooks_referans.RejimPanosu.olcu_goreli) aynı
//  sözleşmeyi taşır; kapı ikisini eşikte karşılaştırır.
siraOrtusme = ta.percentrank(ortusmeOran, tarihce) / 100
siraDoji    = ta.percentrank(dojiOran,    tarihce) / 100
siraKesisme = ta.percentrank(kesisme,     tarihce) / 100
siraNet     = ta.percentrank(-netAralik,  tarihce) / 100
siraDizi    = ta.percentrank(-azamiDizi,  tarihce) / 100
goreli = esikKipi == "Göreli"
hazir  = not goreli or not na(siraOrtusme)   // tarihçe dolmadan hüküm yok

// ── Bant işaretleri (yalnız ÖLÇÜLEBİLİR maddeler) ────────────────────────
i1 = goreli ? siraOrtusme >= goreliPay : ortusmeOran >= ortusmePay
i2 = goreli ? siraDoji    >= goreliPay : dojiOran    >= dojiPay
i3 = goreli ? siraKesisme >= goreliPay : kesisme     >= kesismeEsik
i4 = goreli ? siraNet     >= goreliPay : netAralik   <= netEsik
i5 = goreli ? siraDizi    >= goreliPay : azamiDizi   <  diziEsik
bantIsareti = (i1 ? 1 : 0) + (i2 ? 1 : 0) + (i3 ? 1 : 0) + (i4 ? 1 : 0) + (i5 ? 1 : 0)

// ── Çizim ────────────────────────────────────────────────────────────────
//  Göreli kipte üç çizgi SIRADIR (0–1) ve tek eşik var: goreliPay. Çizgi
//  eşiğin üstündeyse o ölçü "son tarihçeye göre bantlı". Mutlak kipte ham
//  değerler ve dersin üç eşiği çizilir (eskisi gibi). Net/aralık sırası
//  ters ölçüdür: yüksek sıra = düşük net/aralık = bant.
plot(goreli ? siraOrtusme : ortusmeOran, "Örtüşme (göreli: sıra)", color = cClaret,   linewidth = 2)
plot(goreli ? siraDoji    : dojiOran,    "Doji (göreli: sıra)",    color = cMavi,     linewidth = 2)
plot(goreli ? siraNet     : netAralik,   "Net/aralık (göreli: bantlılık sırası)", color = cMurekkep, linewidth = 2)
plot(goreli ? goreliPay : na, "göreli eşik", color = color.new(cGri, 40), linewidth = 1)
plot(goreli ? na : ortusmePay, "örtüşme eşiği (mutlak)", color = color.new(cClaret, 60), linewidth = 1)
plot(goreli ? na : dojiPay,    "doji eşiği (mutlak)",    color = color.new(cMavi, 60),   linewidth = 1)
plot(goreli ? na : netEsik,    "net/aralık eşiği (mutlak)", color = color.new(cMurekkep, 70), linewidth = 1)

bgcolor(hazir and bantIsareti >= 4 ? color.new(cGri, 82) : hazir and bantIsareti >= 3 ? color.new(cGri, 91) : na,
   title = "Bant rejimi zemini")
plotshape(barbwire, "Barbwire", shape.xcross, location.top, cClaret, size = size.tiny)

// ── Durum tablosu ────────────────────────────────────────────────────────
//  HÜKÜM EN ÜSTTE. Okuma sırasının birinci adımı bu panodur ve panonun
//  cevabı tek sözcüktür. Eski dizilişte o sözcük sekiz satırın alttan
//  ikincisindeydi: okurun gözü önce beş ham ölçüye, sonra hükme gidiyordu.
//  Ölçüler hükmün GEREKÇESİDİR; gerekçe hükmün altına yazılır.
f_yer(string s) =>
    s == "Sağ alt" ? position.bottom_right : s == "Sol üst" ? position.top_left :
       s == "Sol alt" ? position.bottom_left : s == "Orta sağ" ? position.middle_right : position.top_right

f_boyut(string s) =>
    s == "Minik" ? size.tiny : s == "Normal" ? size.normal : size.small

// Pine bir fonksiyonu yalnız GENEL kapsamda tanımlar; `if` bloğunun içinde
// tanımlanan fonksiyon derlenmez (pine_denetle 8. ölçüt).
f_sira(float sira) => goreli and not na(sira) ? " · " + str.tostring(sira, "0.00") : ""

var table t = table.new(f_yer(kutuYeri), 3, 9, border_width = 1)

f_satir(int satir, string ad, string deger, string isaret, color renk) =>
    table.cell(t, 0, satir, ad,     text_size = f_boyut(kutuBoyut), text_color = cYaziGri, text_halign = text.align_left)
    table.cell(t, 1, satir, deger,  text_size = f_boyut(kutuBoyut), text_color = cYaziAna, text_halign = text.align_right)
    table.cell(t, 2, satir, isaret, text_size = f_boyut(kutuBoyut), text_color = renk)

if barstate.islast and kutuKip != "Kapalı"
    table.clear(t, 0, 0, 2, 8)

    rejimAd  = not hazir ? "—" : bantIsareti >= 4 ? "BANT" : bantIsareti <= 1 ? "trend" : "ara"
    rejimUst = not hazir ? cYaziGri : bantIsareti >= 4 ? cYaziKzl : bantIsareti <= 1 ? cYaziMavi : cYaziGri
    // Ders bu üç hâle ayrı ayrı NE YAPILACAĞINI söyler; kutu o cümleyi taşır,
    // yoksa okur "4/5" sayısından kendi kuralını uydurur.
    rejimNot = not hazir ? "tarihçe doluyor · " + str.tostring(tarihce) + " bar gerekir" :
       bantIsareti >= 4 ? "uçlarda bant kenarı · ortada emir yok · H2/L2 yalnız uçta" :
       bantIsareti <= 1 ? "geri çekilme kurulumları (H2/L2, dönüş barı) · fade edilmez" :
       "pano karar vermez · hangi tarafa yakın olduğunu söyler"

    table.cell(t, 0, 0, "① REJİM", text_size = f_boyut(kutuBoyut), text_color = cYaziGri,
       text_halign = text.align_left, bgcolor = color.new(cYaziGri, 82))
    table.cell(t, 1, 0, rejimAd, text_size = f_boyut(kutuBoyut), text_color = rejimUst,
       text_halign = text.align_right, bgcolor = color.new(cYaziGri, 82))
    table.cell(t, 2, 0, (hazir ? str.tostring(bantIsareti) : "—") + "/5" + (goreli ? " g" : " d"), text_size = f_boyut(kutuBoyut),
       text_color = rejimUst, bgcolor = color.new(cYaziGri, 82))
    table.cell(t, 0, 1, rejimNot, text_size = f_boyut(kutuBoyut), text_color = rejimUst,
       text_halign = text.align_left)
    table.cell(t, 1, 1, "", text_size = f_boyut(kutuBoyut))
    table.cell(t, 2, 1, "", text_size = f_boyut(kutuBoyut))

    if kutuKip == "Tam"
        table.cell(t, 0, 2, goreli ? "Ölçü · (Şekil 30 değeri)" : "Ölçü · dersin Şekil 30'u", text_size = f_boyut(kutuBoyut), text_color = cYaziGri,
           text_halign = text.align_left, bgcolor = color.new(cYaziGri, 88))
        table.cell(t, 1, 2, goreli ? "değer · sıra" : "bu pencere", text_size = f_boyut(kutuBoyut), text_color = cYaziGri,
           text_halign = text.align_right, bgcolor = color.new(cYaziGri, 88))
        table.cell(t, 2, 2, "bant?", text_size = f_boyut(kutuBoyut), text_color = cYaziGri,
           bgcolor = color.new(cYaziGri, 88))

        // Göreli kipte değerin yanına SIRA yazılır: okur "0,61 örtüşme" sayısını
        // tek başına yorumlayamaz (hangi enstrümanda normal olduğunu bilmez);
        // "sıra 0,78" onu tarihçeye yerleştirir.
        f_satir(3, "Örtüşme oranı  (0,725)", str.tostring(ortusmeOran, "0.000") + f_sira(siraOrtusme), i1 ? "✓" : "—", i1 ? cYaziKzl : cYaziGri)
        f_satir(4, "Doji oranı  (0,314)",    str.tostring(dojiOran,    "0.000") + f_sira(siraDoji),    i2 ? "✓" : "—", i2 ? cYaziKzl : cYaziGri)
        f_satir(5, "Ortalama kesişme  (17)", str.tostring(kesisme) + f_sira(siraKesisme),              i3 ? "✓" : "—", i3 ? cYaziKzl : cYaziGri)
        f_satir(6, "Net / aralık  (0,037)",  str.tostring(netAralik,  "0.000") + f_sira(siraNet),      i4 ? "✓" : "—", i4 ? cYaziKzl : cYaziGri)
        f_satir(7, "Azami ardışık trend barı", str.tostring(azamiDizi) + f_sira(siraDizi),             i5 ? "✓" : "—", i5 ? cYaziKzl : cYaziGri)
        // Barbwire bir REJİM ölçüsü değil, tekil bir bar kalıbıdır: bant
        // işaretine girmez ve sayılmaz. Sayıya karışmasın diye ayrı satırda.
        f_satir(8, "Barbwire (4.9) — sayıya girmez",
           str.tostring(math.round(math.max(0.0, math.min(bwKesOnce, bwKesSonra)) / math.max(bwOrtaMenzil, syminfo.mintick), 2)),
           barbwire ? "VAR ⚠" : "—", barbwire ? cYaziKzl : cYaziGri)

alertcondition(ta.crossover(bantIsareti, 3.5),  "Bant rejimine geçiş",  "Brooks RP: ölçülebilir bant işaretleri 4'e çıktı")
alertcondition(ta.crossunder(bantIsareti, 1.5), "Bant rejiminden çıkış","Brooks RP: ölçülebilir bant işaretleri 1'e indi")
alertcondition(barbwire, "Barbwire", "Brooks RP: barbwire — dönüş barı burada dönüş barı gibi işlev GÖRMEZ")
