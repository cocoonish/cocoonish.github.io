---
/**
 * Masthead — marka, tarih satırı ve bölüm gezinmesi.
 *
 * Gezinme listesi lib/bolumler.ts'ten gelir: başlıktaki numaralar, liste
 * sayfalarının kicker'ları ve alt bilgi aynı kaynağı okur, ayrışamaz.
 *
 * Tarih satırı iki şey söyler ve ikisi de DOĞRU olmak zorunda: bugünün tarihi
 * ve son bültenin tarihi. Eskiden tek bir "bugün" vardı ve DERLEME anında
 * yazılıyordu — site birkaç gün derlenmese sayfa eski bir günü "bugün" diye
 * gösterirdi. Şimdi bugünün tarihi sayfa açılınca okurun saatinden yazılır;
 * son bülten tarihi ise derleme anında dosyadan okunur ve zaten bir olgu.
 */
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import { BOLUMLER } from '../lib/bolumler';
import { bultenler, teknikler } from '../lib/yayinlar';


const yol = Astro.url.pathname;
const linkler = BOLUMLER.filter((b) => b.gezinme);
const son = bultenler()[0];
const sonTeknik = teknikler()[0];
---

<header class="masthead">
  <div class="sarici">
    <div class="dateline etiket">
      <span data-bugun hidden></span>
      <span class="orta">İstanbul</span>
      {son ? (
        <span class="son-yayinlar">
          <a class="son-bulten" href={son.href}>
            {son.haftalik ? 'Son haftaya bakış' : 'Son bülten'} · {son.trTarih}
          </a>
          {sonTeknik && (
            <a class="son-bulten son-teknik" href={sonTeknik.href}>Son teknik · {sonTeknik.trTarih}</a>
          )}
        </span>
      ) : (
        <span>Veri · Makro · Faiz</span>
      )}
    </div>
    <div class="baslik-satir">
      <a href="/" class="marka" aria-label={`${SITE_TITLE} — ana sayfa`}>
        <span class="marka-ad">{SITE_TITLE}</span>
        <span class="marka-alt">{SITE_TAGLINE}</span>
      </a>
      <nav aria-label="Bölümler">
        {
          linkler.map((l) => {
            const aktif = yol.startsWith(l.href);
            return (
              <a
                href={l.href}
                class:list={['nav-link', { aktif }]}
                aria-current={aktif ? 'page' : undefined}
              >
                <span class="nav-no">{l.no}</span>
                {l.ad}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</header>

<script>
  // Bugünün tarihi okurun saatinden — derleme gününden değil. Derlenmiş HTML
  // günü taşımaz: birkaç gün derlenmemiş bir site eski günü "bugün" diye
  // göstermesin; betik çalışmazsa satır boş kalır, yanlış kalmaz.
  import { bugunUzun } from '../lib/bicim';
  const el = document.querySelector<HTMLElement>('[data-bugun]');
  if (el) {
    el.textContent = bugunUzun();
    el.hidden = false;
  }
</script>

<style>
  .masthead {
    border-bottom: 4px double var(--ink);
  }
  .dateline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--ink-30);
    color: var(--ink-70);
  }
  .dateline .orta {
    color: var(--claret);
  }
  .son-bulten {
    text-decoration: none;
    color: var(--ink-70);
    white-space: nowrap;
  }
  .son-bulten:hover {
    color: var(--claret);
  }
  .son-yayinlar { display: inline-flex; gap: 1.2rem; }
  @media (max-width: 760px) {
    .son-teknik { display: none; }
  }
  .baslik-satir {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    padding: 1.3rem 0 1rem;
  }
  .marka {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .marka:hover {
    color: inherit;
  }
  .marka-ad {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 620;
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .marka-ad::after {
    content: '.';
    color: var(--claret);
  }
  .marka-alt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  /* Dar ekranda gezinme taşmaz: yedi bağlantı tek satırda yana kaydırılır,
     kaydırma çubuğu gizlidir, aktif bölüm bordo alt çizgiyle görünür kalır. */
  nav {
    display: flex;
    gap: 1.6rem;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .nav-link.aktif {
    border-bottom-color: var(--claret);
    color: var(--claret);
  }
  .nav-link:focus-visible {
    outline: 2px solid var(--claret);
    outline-offset: 3px;
  }
  .nav-no {
    color: var(--claret);
    font-size: 0.6rem;
    vertical-align: super;
    margin-right: 0.15rem;
  }
  @media (max-width: 640px) {
    .dateline {
      flex-wrap: wrap;
      gap: 0.2rem 0.9rem;
    }
    .dateline .orta {
      display: none;
    }
    nav {
      gap: 1.1rem;
    }
    .nav-no {
      display: none;
    }
  }
</style>
