---
/**
 * Hatlar tablosu — on yedi hat, on yedi ayrı saat.
 *
 * Bu tablonun asıl işi bir dizin sunmak değil, sitenin en temel disiplinini
 * TEK BAKIŞTA göstermek: her sayının kendi tarihi vardır. On yedi satırda
 * on yedi farklı tarih görmek, "veriler günceldir" cümlesinden çok daha
 * fazlasını söyler — hangi hattın günlük, hangisinin aylık, hangisinin iki
 * ay gecikmeli olduğunu okur kendi görür.
 *
 * Tarih sütunundaki büyüklüğün saati, hattın ANA saati değil o anahtarın
 * kendi saatidir (bkz. CLAUDE.md "Kurucu ilke — saat"). Net rezervin
 * günlük tahmini ile haftalık resmî serisi aynı dosyada durur ve farklı
 * günlere aittir; burada gösterilen, tabloda yazan büyüklüğün tarihidir.
 */
import { hatManseti } from '../lib/anaSayfa';

interface Giris {
  slug: string;
  baslik: string;
  durum: 'aktif' | 'taslak' | 'arsiv';
}
interface Props {
  hatlar: Giris[];
}
const { hatlar } = Astro.props;

const satirlar = hatlar
  .map((h) => ({ ...h, ...hatManseti(h.slug) }))
  // Ölçüsü tanımlı olmayan (henüz manşet büyüklüğü seçilmemiş) hat tabloya
  // girmez; boş bir satır, olmayan bir satırdan daha kötü bilgi verir.
  .filter((h) => h.olcu)
  .sort((a, b) => (a.yas ?? 9e9) - (b.yas ?? 9e9));
---

<div class="ht-sarici">
  <table class="ht-tablo">
    <thead>
      <tr>
        <th class="ht-hat">Hat</th>
        <th class="ht-olcu">Manşet büyüklüğü</th>
        <th class="ht-deger">Değer</th>
        <th class="ht-tarih">Veri tarihi</th>
      </tr>
    </thead>
    <tbody>
      {
        satirlar.map((h) => (
          <tr>
            <td class="ht-hat">
              <a href={`/projeler/${h.slug}/`}>{h.baslik}</a>
              {h.durum === 'taslak' && <span class="ht-rozet">taslak</span>}
            </td>
            <td class="ht-olcu">{h.olcu}</td>
            <td class="ht-deger">
              {h.deger ?? <span class="ht-yok">veri yok</span>}
              {h.deger && h.birim && <span class="ht-birim">{h.birim}</span>}
            </td>
            <td class="ht-tarih">
              {h.tarih || '—'}
              {h.yas !== null && h.yas >= 0 && (
                <span class="ht-yas">{h.yas === 0 ? 'bugün' : `${h.yas} gün`}</span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Dar ekranda tablo SAYFAYI değil kendini kaydırır. */
  .ht-sarici {
    overflow-x: auto;
    border-top: 1px solid var(--ink);
  }
  .ht-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-50);
    text-align: left;
    padding: 0.5rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--ink-30);
    white-space: nowrap;
  }
  tbody td {
    padding: 0.58rem 1rem 0.58rem 0;
    border-bottom: 1px dotted var(--ink-15);
    vertical-align: baseline;
  }
  tbody tr:hover td {
    background: color-mix(in srgb, var(--paper-2) 60%, transparent);
  }

  .ht-hat a {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 20;
    font-size: 1rem;
    font-weight: 560;
    text-decoration: none;
    white-space: nowrap;
  }
  .ht-rozet {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  .ht-olcu {
    color: var(--ink-70);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .ht-deger,
  .ht-tarih {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ht-deger {
    text-align: right;
    font-size: 1rem;
    font-weight: 500;
    padding-right: 1.4rem;
  }
  .ht-birim {
    font-size: 0.64rem;
    color: var(--ink-50);
    margin-left: 0.35rem;
    letter-spacing: 0.04em;
  }
  .ht-yok {
    font-size: 0.7rem;
    color: var(--ink-50);
    letter-spacing: 0.05em;
  }
  .ht-tarih {
    font-size: 0.82rem;
    color: var(--ink-70);
  }
  /* Yaş, tarihin YANINDA ve daha soluk: tarih olgu, yaş yorumdur. */
  .ht-yas {
    display: block;
    font-size: 0.62rem;
    color: var(--ink-50);
    letter-spacing: 0.05em;
  }

  @media (max-width: 700px) {
    .ht-olcu {
      display: none;
    }
  }
</style>
