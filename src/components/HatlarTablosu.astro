---
/**
 * Hatlar tablosu — on yedi hat, on yedi ayrı saat.
 *
 * Bu tablonun asıl işi bir dizin sunmak değil, sitenin en temel disiplinini
 * TEK BAKIŞTA göstermek: her sayının kendi tarihi vardır. On yedi satırda
 * on yedi farklı tarih görmek, "veriler günceldir" cümlesinden çok daha
 * fazlasını söyler — hangi hattın günlük, hangisinin aylık, hangisinin iki
 * ay gecikmeli olduğunu okur kendi görür.
 *
 * Tarih sütunundaki büyüklüğün saati, hattın ANA saati değil o anahtarın
 * kendi saatidir (bkz. CLAUDE.md "Kurucu ilke — saat"). Net rezervin
 * günlük tahmini ile haftalık resmî serisi aynı dosyada durur ve farklı
 * günlere aittir; burada gösterilen, tabloda yazan büyüklüğün tarihidir.
 */
import { hatManseti } from '../lib/anaSayfa';
import { tariheCevir, yasMetni } from '../lib/bicim';
import { tazelikSirasi } from '../lib/projeDizini';

interface Giris {
  slug: string;
  baslik: string;
  durum: 'aktif' | 'taslak' | 'arsiv';
}
interface Props {
  hatlar: Giris[];
}
const { hatlar } = Astro.props;

const satirlar = hatlar
  .map((h) => ({ ...h, ...hatManseti(h.slug) }))
  // Ölçüsü tanımlı olmayan (henüz manşet büyüklüğü seçilmemiş) hat tabloya
  // girmez; boş bir satır, olmayan bir satırdan daha kötü bilgi verir.
  .filter((h) => h.olcu)
  // Projeler sayfasıyla AYNI karşılaştırıcı: verisi en yeni olan üstte, eşit
  // tarihte başlık sırası (lib/projeDizini). Ayrı bir kural iki yerde eşit
  // tarihli hatları farklı sırada basıyordu.
  .sort((a, b) =>
    tazelikSirasi({ gun: tariheCevir(a.tarih), baslik: a.baslik }, { gun: tariheCevir(b.tarih), baslik: b.baslik }),
  );

// Tarayıcı yaşı yalnız GÜN damgasında yeniden hesaplar (aylık damgada yaş yok).
// Düzenli ifade burada durur: şablonun öznitelik ifadesindeki `{2}` gibi
// süslü parantezleri Astro derleyicisi ifade sınırı sanıyor.
const TAM_GUN = /^\d{2}\.\d{2}\.\d{4}$/;

// Değer ile birim ayrı öğe: telefonda birim değerin ALTINA iner. Tek nowrap
// dizge ("230,8 mlr USD") 390 pikselde değer sütununu 142 piksele çıkarıyor,
// tarih sütunu kabın dışına düşüp "29.09.202" diye kesiliyordu (320 px'te
// 98 piksel gizli). olcuYaz sayıyı boşluksuz yazar; ilk boşluk birimi ayırır.
const parca = (m: string) => {
  const i = m.indexOf(' ');
  return i < 0 ? { sayi: m, birim: '' } : { sayi: m.slice(0, i), birim: m.slice(i + 1) };
};
---

<div class="ht-sarici" tabindex="0" role="region" aria-label="Kaydırılabilir tablo" data-kaydir>
  <table class="ht-tablo">
    <caption class="gorunmez">Veri hatları: manşet büyüklüğü, değeri ve o değerin kendi tarihi</caption>
    <thead>
      <tr>
        <th class="ht-hat" scope="col">Hat</th>
        <th class="ht-olcu" scope="col">Manşet büyüklüğü</th>
        <th class="ht-deger sag" scope="col">Değer</th>
        <th class="ht-tarih" scope="col">Veri tarihi</th>
      </tr>
    </thead>
    <tbody>
      {
        satirlar.map((h) => (
          <tr>
            <td class="ht-hat">
              <a href={`/projeler/${h.slug}/`}>{h.baslik}</a>
              {h.durum === 'taslak' && <span class="ht-rozet">taslak</span>}
              {/* Telefonda ölçü sütunu yok; değerin NEYİN değeri olduğu adın altında kalır. */}
              <span class="ht-olcu-ic">{h.olcu}</span>
            </td>
            <td class="ht-olcu">{h.olcu}</td>
            <td class="ht-deger">
              {h.metin
                ? <>{parca(h.metin).sayi}{parca(h.metin).birim && <span class="ht-birim"> {parca(h.metin).birim}</span>}</>
                : <span class="ht-yok">veri yok</span>}
            </td>
            <td class="ht-tarih">
              {h.tarih || '—'}
              {yasMetni(h.yas) && (
                <span class="ht-yas"
                  data-ht-yas={TAM_GUN.test(h.tarih ?? '') ? h.tarih : undefined}>
                  {yasMetni(h.yas)}
                </span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Dar ekranda tablo SAYFAYI değil kendini kaydırır. */
  .ht-sarici {
    overflow-x: auto;
    position: relative;
    border-top: 1px solid var(--ink);
  }
  .ht-sarici:focus-visible { outline: 2px solid var(--claret); outline-offset: 2px; }
  .ht-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-50);
    text-align: left;
    padding: 0.5rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--ink-30);
    white-space: nowrap;
  }
  tbody td {
    padding: 0.58rem 1rem 0.58rem 0;
    border-bottom: 1px dotted var(--ink-15);
    vertical-align: baseline;
  }
  tbody tr:hover td {
    background: color-mix(in srgb, var(--paper-2) 60%, transparent);
  }

  .ht-hat a {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 20;
    font-size: 1rem;
    font-weight: 560;
    text-decoration: none;
    white-space: nowrap;
  }
  .ht-rozet {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  .ht-olcu {
    color: var(--ink-70);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .ht-deger,
  .ht-tarih {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Değer ve birim TEK hücrede ve sözleşmeyle yazılır ("%30,19", "82,6
     endeks"); başlık da değerle aynı yana yaslanır. Başlık sola, değer sağa
     yaslıyken sütun taranamıyordu. */
  .ht-deger {
    text-align: right;
    font-size: 1rem;
    font-weight: 500;
    padding-right: 1.4rem;
  }
  thead th.sag { text-align: right; padding-right: 1.4rem; }
  .ht-olcu-ic { display: none; }
  .ht-yok {
    font-size: 0.7rem;
    color: var(--ink-50);
    letter-spacing: 0.05em;
  }
  .ht-tarih {
    font-size: 0.82rem;
    color: var(--ink-70);
  }
  /* Yaş, tarihin YANINDA ve daha soluk: tarih olgu, yaş yorumdur. */
  .ht-yas {
    display: block;
    font-size: 0.62rem;
    color: var(--ink-50);
    letter-spacing: 0.05em;
  }

  /* Telefonda üç sütun da kırılmaz olunca değer ekran dışına düşüyordu;
     kaydırma son çare, önce hat adı kırılır ve tarih küçülür. */
  /* 768 pikselde kırılmayan hat adı tabloyu kabından 28 piksel taşırıyor ve
     tarih "29.09.202" diye kesiliyordu. */
  @media (max-width: 900px) {
    .ht-hat a { white-space: normal; }
  }
  @media (max-width: 640px) {
    .ht-olcu { display: none; }
    .ht-olcu-ic {
      display: block; margin-top: 0.15rem;
      font-size: 0.78rem; line-height: 1.3; color: var(--ink-70);
    }
    .ht-hat a { white-space: normal; }
    thead th.sag { padding-right: 0.8rem; }
    .ht-deger { padding-right: 0.8rem; font-size: 0.92rem; }
    .ht-birim { display: block; font-size: 0.75rem; color: var(--ink-70); line-height: 1.2; }
    .ht-tarih { font-size: 0.72rem; }
  }
  /* TELEFON TABANI (≤640 px): meta etiket en az 0,75rem, sayı en az 0,8125rem.
     Ölçüldü (390 px): 12 pikselin altındaki karakter payı ana sayfada %24,1 — en yoğun
     katmanlar not, tarih ve konum satırlarıydı; sayı hücreleri zaten 13,4 px. */
  @media (max-width: 640px) {
    .ht-tarih { font-size: 0.8125rem; }
    .ht-yas, .ht-olcu-ic, .ht-rozet { font-size: 0.75rem; }
  }
  /* En dar telefonlar (≤360 px): sütun arası boşluk yarıya iner. 320
     pikselde tarih sütunu kabın 33 piksel dışında kalıyordu. */
  @media (max-width: 360px) {
    thead th, tbody td { padding-right: 0.5rem; }
    thead th.sag, .ht-deger { padding-right: 0.5rem; }
  }
</style>

<script>
  // Yaş derleme anında yazılır ve yeniden derleme olmayan günlerde (hafta
  // sonu) kayar; sayfa açılınca aynı tarihten aynı kuralla yeniden hesaplanır
  // (KayitKarti ile aynı yol). Aylık damgada gün cinsinden yaş yazılmaz.
  import { tariheCevir, gunFarki, yasMetni } from '../lib/bicim';
  document.querySelectorAll<HTMLElement>('[data-ht-yas]').forEach((el) => {
    const d = tariheCevir(el.dataset.htYas);
    const y = d ? yasMetni(gunFarki(d)) : '';
    if (y) el.textContent = y;
    else el.remove();
  });
</script>
