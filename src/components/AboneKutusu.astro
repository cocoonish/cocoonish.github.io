---
/**
 * Bülten aboneliği çağrısı (29.10.2026). Bülten sayfalarının sonunda; form
 * /abone/ sayfasında (arka ucu ttotrading.com/api/abone, eposta/abone_sunucu.py).
 * Kurulum bitene kadar kapalı: site/src/data/abone.json `acik`.
 */
import abone from '../data/abone.json';
---
{abone.acik && <aside class="abone-kutu" aria-label="E-posta aboneliği">
  <p class="abone-baslik">Sabah notunu e-postayla al</p>
  <p class="abone-metin">Hafta içi her sabah notun tamamı, pazar akşamı haftaya bakış. Hangisini alacağını sen seçersin; her e-postada tek tıkla çıkabilirsin.</p>
  <a class="abone-dugme" href="/abone/">Abone ol</a>
</aside>}

<style>
  .abone-kutu {
    margin: 2.4rem 0 1.2rem; padding: 1.1rem 1.2rem; border: 1px solid var(--ink-15);
    border-left: 3px solid var(--claret); background: var(--paper);
  }
  .abone-baslik { margin: 0 0 0.3rem; font-weight: 600; font-size: 1.05rem; }
  .abone-metin { margin: 0 0 0.8rem; max-width: var(--olcu-metin, 32rem); line-height: 1.5; }
  .abone-dugme {
    display: inline-block; padding: 0.45rem 0.9rem; background: var(--claret); color: var(--paper);
    text-decoration: none; font-family: var(--font-mono); font-size: 0.85rem;
  }
  .abone-dugme:hover { opacity: 0.9; }
</style>
