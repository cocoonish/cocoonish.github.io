---
/**
 * İTO → TÜFE eşleme aracı.
 *
 * Soru: "İTO şu geldi, TÜFE'den ne beklerim?" Araç üç kuralı YAN YANA basar,
 * çünkü ölçüm hiçbirinin diğerinden ölçülebilir biçimde iyi olmadığını
 * söylüyor (bkz. ozet.json → itp_siralama_metin). Tek bir sayı basmak,
 * veride olmayan bir kesinlik uydurmak olurdu.
 *
 * Veri: /projeler/<proje>/ozet.json
 *   itp_esleme  — [{ito, tufe, alt, ust, sabit_kural}] koşullu eşleme tablosu
 *   itp_sabit / itp_egim / itp_ort / itp_medyan — kuralların katsayıları
 *   itp_s_sabit / itp_s_egim / itp_s_uyum — sürpriz regresyonu
 * Sabit sayı GÖMÜLMEZ: hat tazelendiğinde araç da tazelenir. JSON yüklenemezse
 * araç sayı uydurmaz, görünür biçimde devre dışı kalır.
 *
 * Saf istemci tarafı, kütüphanesiz vanilla JS (TahvilHesaplayici kalıbı).
 */
interface Props { proje?: string }
const { proje = 'enflasyon' } = Astro.props;
---

<div class="hesap ito-hesap" id="ito-hesap" data-proje={proje}>
  <div class="hesap-ust">
    <span class="etiket">Hesap Aracı</span>
    <span class="hesap-ad">İTO okuması → TÜFE beklentisi</span>
    <span class="etiket ih-kaynak" id="ih-kaynak">…</span>
  </div>

  <div class="ih-uyari" id="ih-uyari" hidden></div>

  <div class="ih-govde">
    <div class="ih-sol">
      <label class="ih-alan">
        <span class="etiket">İTO İstanbul, aylık değişim %</span>
        <input type="number" id="ih-ito" value="2.00" step="0.05" min="-5" max="12" />
      </label>
      <label class="ih-alan">
        <span class="etiket">Piyasa beklentisi (anket medyanı), aylık % — isteğe bağlı</span>
        <input type="number" id="ih-anket" value="" step="0.05" min="-5" max="12"
               placeholder="boş bırakılabilir" />
      </label>
      <p class="ih-not">İTO ayın sonunda oluşur ve ertesi ayın başında, TÜİK'ten
      birkaç gün önce yayımlanır. Anket ise ayın ilk yarısında yapılır — yani
      İTO, ankete göre gerçekten yeni bilgidir.</p>
    </div>

    <div class="ih-sag">
      <div class="ih-kutu">
        <span class="etiket">Naif kural — TÜFE = İTO</span>
        <output id="ih-naif">—</output>
      </div>
      <div class="ih-kutu">
        <span class="etiket">Sabit kaydırma — İTO − ortalama fark</span>
        <output id="ih-sabit">—</output>
      </div>
      <div class="ih-kutu">
        <span class="etiket">Regresyon</span>
        <output id="ih-reg">—</output>
      </div>
      <div class="ih-kutu genis">
        <span class="etiket">%95 öngörü aralığı (tek bir ayın düşeceği bant)</span>
        <output id="ih-aralik">—</output>
      </div>
      <div class="ih-kutu genis" id="ih-surpriz-kutu" hidden>
        <span class="etiket">Sürpriz kanalı — ankete göre beklenen sapma</span>
        <output id="ih-surpriz">—</output>
      </div>
    </div>
  </div>

  <p class="ih-hukum" id="ih-hukum"></p>
</div>

<script>
  const kap = document.getElementById('ito-hesap');
  if (kap) {
    type Satir = { ito: number; tufe: number; alt: number; ust: number; sabit_kural: number };
    const proje = (kap as HTMLElement).dataset.proje!;
    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const tr = (x: number, b = 2) => {
      const y = Math.round(x * 10 ** b) / 10 ** b || 0;
      return y.toLocaleString('tr-TR', { minimumFractionDigits: b, maximumFractionDigits: b })
              .replace('-', '−');
    };
    const trI = (x: number, b = 2) => {
      const y = Math.round(x * 10 ** b) / 10 ** b || 0;
      return (y > 0 ? '+' : '') + tr(y, b);
    };

    let tablo: Satir[] = [];
    let sabit = 0, egim = 1, ortFark = 0, sSabit = 0, sEgim = 0, sUyum = 0;

    const uyariGoster = (m: string) => {
      const u = el<HTMLElement>('ih-uyari');
      u.textContent = m;
      u.hidden = false;
      kap.classList.add('bozuk');
      kap.querySelectorAll('input').forEach((i) => ((i as HTMLInputElement).disabled = true));
    };

    /** Aralık tablodan DOĞRUSAL ARA DEĞERLE okunur; tablonun dışına çıkılırsa
     *  en yakın iki satırın eğimiyle uzatılır ve bu durum ayrıca etiketlenir. */
    const aralik = (x: number): { alt: number; ust: number; disi: boolean } => {
      if (tablo.length < 2) return { alt: NaN, ust: NaN, disi: true };
      const ilk = tablo[0], son = tablo[tablo.length - 1];
      const disi = x < ilk.ito || x > son.ito;
      let a = tablo[0], b = tablo[1];
      for (let i = 0; i < tablo.length - 1; i++) {
        if (x >= tablo[i].ito && x <= tablo[i + 1].ito) { a = tablo[i]; b = tablo[i + 1]; break; }
        if (x > son.ito) { a = tablo[tablo.length - 2]; b = son; }
      }
      const w = (x - a.ito) / (b.ito - a.ito);
      return { alt: a.alt + w * (b.alt - a.alt), ust: a.ust + w * (b.ust - a.ust), disi };
    };

    const hesapla = () => {
      const x = parseFloat((el<HTMLInputElement>('ih-ito')).value);
      if (!isFinite(x)) return;
      el<HTMLElement>('ih-naif').textContent = '%' + tr(x);
      el<HTMLElement>('ih-sabit').textContent = '%' + tr(x - ortFark);
      el<HTMLElement>('ih-reg').textContent = '%' + tr(sabit + egim * x);
      const ar = aralik(x);
      el<HTMLElement>('ih-aralik').textContent = isFinite(ar.alt)
        ? `%${tr(ar.alt)} – %${tr(ar.ust)}` + (ar.disi ? '  (tablo dışı, uzatıldı)' : '')
        : '—';

      const ham = (el<HTMLInputElement>('ih-anket')).value.trim();
      const kutu = el<HTMLElement>('ih-surpriz-kutu');
      if (ham === '' || !isFinite(parseFloat(ham))) { kutu.hidden = true; return; }
      const bek = parseFloat(ham);
      const isu = x - bek;                       // İTO'nun ankete göre sapması
      const bekSurpriz = sSabit + sEgim * isu;   // ölçülen geçiş
      kutu.hidden = false;
      el<HTMLElement>('ih-surpriz').textContent =
        `İTO ankete göre ${trI(isu)} puan · buradan beklenen TÜFE sürprizi ` +
        `${trI(bekSurpriz)} puan → TÜFE ≈ %${tr(bek + bekSurpriz)}` +
        (Math.abs(isu) >= 0.25
          ? `  (bu genlikte işaret uyumu geçmişte %${tr(sUyum, 0)})`
          : '  (sapma küçük — işaret bilgisi zayıf)');
    };

    const kur = async () => {
      let oz: any;
      try {
        const r = await fetch(`/projeler/${proje}/ozet.json`, { cache: 'no-cache' });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        oz = await r.json();
      } catch {
        uyariGoster('Veri dosyası (ozet.json) yüklenemedi; araç devre dışı. ' +
                    'Sayfadaki katsayılar yazının metnindedir.');
        return;
      }
      if (!Array.isArray(oz.itp_esleme) || oz.itp_egim == null) {
        uyariGoster('ozet.json içinde `itp_esleme` / `itp_egim` alanları yok; ' +
                    'hattın ozet_uret.py adımı bu anahtarları henüz yazmamış.');
        return;
      }
      tablo = oz.itp_esleme as Satir[];
      sabit = Number(oz.itp_sabit); egim = Number(oz.itp_egim);
      ortFark = Number(oz.itp_ort);
      sSabit = Number(oz.itp_s_sabit ?? 0); sEgim = Number(oz.itp_s_egim ?? 0);
      sUyum = Number(oz.itp_s_uyum ?? 0);
      el<HTMLElement>('ih-kaynak').textContent =
        `${oz.itp_ilk_ay ?? ''}–${oz.itp_son_ay ?? ''} · n=${oz.itp_n ?? '?'} ay`;
      el<HTMLElement>('ih-hukum').textContent =
        `Üç kural yan yana duruyor çünkü ölçüm birini seçtirmiyor: ${oz.itp_siralama_metin ?? ''}. ` +
        `Örneklem dışı ortalama mutlak hata her kuralda 0,4–0,5 puan bandında.`;
      if (sEgim === 0) el<HTMLElement>('ih-surpriz-kutu').hidden = true;
      ['ih-ito', 'ih-anket'].forEach((i) =>
        el<HTMLInputElement>(i).addEventListener('input', hesapla));
      hesapla();
    };
    kur();
  }
</script>

<style>
  .ito-hesap { margin: 2rem 0; }
  .ito-hesap.bozuk { opacity: 0.72; }
  .ih-uyari {
    margin: 0.6rem 0 0; padding: 0.6rem 0.8rem;
    border-left: 3px solid var(--claret); background: #fbf7f5;
    font-size: 0.86rem; line-height: 1.5;
  }
  .ih-govde { display: grid; grid-template-columns: 1fr 1.15fr; gap: 1.4rem; margin-top: 0.9rem; }
  .ih-alan { display: block; margin-bottom: 0.8rem; }
  .ih-alan input {
    width: 100%; margin-top: 0.25rem; padding: 0.42rem 0.55rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.95rem;
    border: 1px solid var(--rule, #d8d2c6); background: #fff; color: var(--ink);
  }
  .ih-not { font-size: 0.82rem; line-height: 1.55; color: #5a5a5a; margin: 0.6rem 0 0; }
  .ih-sag { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; align-content: start; }
  .ih-kutu {
    border: 1px solid var(--rule, #e8e4dc); padding: 0.55rem 0.65rem; background: #fdfcfa;
  }
  .ih-kutu.genis { grid-column: 1 / -1; }
  .ih-kutu output {
    display: block; margin-top: 0.2rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 1.02rem;
    color: var(--ink);
  }
  .ih-kutu.genis output { font-size: 0.92rem; line-height: 1.5; }
  .ih-hukum { font-size: 0.82rem; line-height: 1.6; color: #5a5a5a; margin: 0.9rem 0 0; }
  .ih-kaynak { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  @media (max-width: 720px) {
    .ih-govde { grid-template-columns: 1fr; }
    .ih-sag { grid-template-columns: 1fr 1fr; }
    .ito-hesap .ih-kaynak { display: none; }
  }
</style>
