---
/**
 * Günün grafiği — yazarın seçtiği seri grafiği (karar 29.10.2026, bulten/grafik_sec.py).
 *
 * Veri sayının KENDİSİNDEN okunur: yazma anında Grafikler kataloğundan dondurulan
 * noktalar (`gorseller[i].seriler`). X görseli (tweet/gorsel.seri_png) aynı
 * noktalardan çizer; seri sonradan tazelense de geçmiş sayının grafiği kaymaz.
 * Satır içi SVG, istemci kodu yok (EgriGrafik ile aynı gerekçe). Tek eksen: bir
 * grafikteki seriler aynı birimdedir (çözücü dayatır). Kimlik ikincil kodlamayla da
 * okunur: ilk seri düz, sonrakiler kesik; uç değer seri renginde ve doğrudan etiketli.
 * Sayı ve tarih biçimi lib/bicim'den.
 */
import { AYLAR_TR, olcuYaz, tarihUzun } from '../lib/bicim';
import EgriGrafik from './EgriGrafik.astro';

interface Props {
  gorsel: any;
  no: number;
  /** `tur: 'egri'` kaydı sayının kendi DİBS eğrisini çizer (`grafikler.egri`). */
  egri?: any;
}
const { gorsel: g, no, egri } = Astro.props;

const W = 640, H = 236;
const G = { sol: 50, sag: 78, ust: 12, alt: 26 };
const ic = { g: W - G.sol - G.sag, y: H - G.ust - G.alt };
const renk = ['var(--claret)', 'var(--teal)', 'var(--gold)'];

const ms = (t: string) => Date.UTC(+t.slice(0, 4), +t.slice(5, 7) - 1, +t.slice(8, 10));
const seriler = ((g?.seriler ?? []) as any[]).filter((s) => Array.isArray(s.t) && s.t.length >= 2);
const tumT = seriler.flatMap((s) => s.t.map(ms));
const tumV: number[] = seriler.flatMap((s) => s.v as number[]);
const x0 = Math.min(...tumT), x1 = Math.max(...tumT);
let y0 = Math.min(...tumV), y1 = Math.max(...tumV);
if (!(y1 > y0)) { const p = Math.abs(y0) || 1; y0 -= p * 0.05; y1 += p * 0.05; }

// "Güzel" adım: 1, 2, 2,5, 5 × 10^k; beş-altı ızgara çizgisi (dörde bölünce adım
// sınırda bir üst kademeye kaçıp veriyi eksenin yarısına sıkıştırıyordu).
const hamAdim = (y1 - y0) / 5;
const us = Math.pow(10, Math.floor(Math.log10(hamAdim)));
const adim = [1, 2, 2.5, 5, 10].map((k) => k * us).find((a) => a >= hamAdim) ?? 10 * us;
y0 = Math.floor(y0 / adim) * adim;
y1 = Math.ceil(y1 / adim) * adim;
const izgara: number[] = [];
for (let v = y0; v <= y1 + adim / 2; v += adim) izgara.push(+v.toFixed(10));
const adimOndalik = Math.max(0, Math.min(3, -Math.floor(Math.log10(adim) + 1e-9) + (adim / us === 2.5 ? 1 : 0)));

const px = (t: number) => G.sol + (x1 > x0 ? ((t - x0) / (x1 - x0)) * ic.g : ic.g / 2);
const py = (v: number) => G.ust + (1 - (v - y0) / (y1 - y0)) * ic.y;

// Zaman işaretleri: ay başları; adım 1/2/3/6/12/24 ay, en çok altı etiket.
const ayAdim = [1, 2, 3, 6, 12, 24, 60].find((a) => (x1 - x0) / (a * 30.44 * 864e5) <= 6) ?? 60;
const isaretler: { t: number; etiket: string }[] = [];
{
  const b = new Date(x0);
  let y = b.getUTCFullYear(), m = b.getUTCMonth() + 1;
  for (let k = 0; k < 400; k++, m++) {
    if (m > 11) { m = 0; y++; }
    const t = Date.UTC(y, m, 1);
    if (t > x1) break;
    if (((y * 12 + m) % ayAdim) !== 0) continue;
    isaretler.push({ t, etiket: ayAdim >= 12 ? String(y) : (m === 0 ? `${AYLAR_TR[m].slice(0, 3)} ${y}` : AYLAR_TR[m].slice(0, 3)) });
  }
}

const yol = (s: any) => s.t.map((t: string, i: number) =>
  `${i === 0 ? 'M' : 'L'}${px(ms(t)).toFixed(1)} ${py(s.v[i]).toFixed(1)}`).join(' ');
// UÇ ETİKETLERİ ÇAKIŞMAZ (EgriGrafik'in kuralı): dikey sıraya dizilir.
const ETIKET_ARA = 12;
const uclar = seriler.map((s, i) => ({
  i, x: px(ms(s.t[s.t.length - 1])) + 6, y: py(s.v[s.v.length - 1]) + 3.5,
  // Uç etiketi yalnız değer; birim lejantın yanında (uzun birim sağ boşluğa sığmıyordu).
  deger: olcuYaz(s.v[s.v.length - 1], g.birim === '%' ? '%' : '', g.ondalik ?? 1),
}));
[...uclar].sort((a, b) => a.y - b.y).forEach((u, k, d) => {
  if (k > 0 && u.y - d[k - 1].y < ETIKET_ARA) u.y = d[k - 1].y + ETIKET_ARA;
});
const kaynak = String(g.kaynak || [...new Set(seriler.map((s) => String(s.kaynak || '').trim()).filter(Boolean))].join(' · '));
const birimEtiketi = g.birim && g.birim !== '%' ? g.birim : '';
---

{g?.tur === 'egri' && egri && (
  <div class="gorsel-figur" data-gorsel={no}>
    <p class="gorsel-no">Grafik {no}</p>
    <p class="gorsel-baslik">{g.baslik}</p>
    <EgriGrafik egri={egri} />
    {g.not && <p class="gorsel-not">{g.not}</p>}
  </div>
)}
{g?.tur !== 'egri' && seriler.length > 0 && (
  <figure class="gorsel-figur" data-gorsel={no}>
    <figcaption>
      <span class="gorsel-no">Grafik {no}</span>
      <span class="gorsel-baslik">{g.baslik}</span>
      <span class="gorsel-lejant-dizi">
        {seriler.map((s, i) => (
          <span class="gorsel-lejant">
            <svg width="18" height="8" aria-hidden="true">
              <line x1="0" y1="4" x2="18" y2="4" stroke={renk[i % renk.length]} stroke-width="2"
                    stroke-dasharray={i === 0 ? undefined : '5 3'} />
            </svg>
            {s.ad}
          </span>
        ))}
        {birimEtiketi && <span class="gorsel-birim">{birimEtiketi}</span>}
      </span>
    </figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} class="gorsel-svg" role="img"
         aria-label={`${g.baslik}: ${seriler.map((s, i) => `${s.ad} ${uclar[i].deger}`).join(', ')}, son gözlem ${tarihUzun(g.son)}`}>
      {izgara.map((v) => (
        <>
          <line x1={G.sol} y1={py(v)} x2={W - G.sag} y2={py(v)} class="gorsel-izgara" />
          <text x={G.sol - 7} y={py(v) + 3.5} class="gorsel-eksen sag-hiza">{olcuYaz(v, g.birim === '%' ? '%' : '', adimOndalik)}</text>
        </>
      ))}
      {isaretler.map((m) => (
        <text x={px(m.t)} y={H - 8} class="gorsel-eksen orta-hiza">{m.etiket}</text>
      ))}
      {seriler.map((s, i) => (
        <path d={yol(s)} fill="none" stroke={renk[i % renk.length]} stroke-width="2"
              stroke-dasharray={i === 0 ? undefined : '5 3'} stroke-linejoin="round" stroke-linecap="round" />
      ))}
      {uclar.map((u) => (
        <>
          <circle cx={u.x - 6} cy={u.y - 3.5} r="3" fill={renk[u.i % renk.length]} />
          <text x={u.x} y={u.y} class="gorsel-etiket" fill={renk[u.i % renk.length]}>{u.deger}</text>
        </>
      ))}
    </svg>
    {g.not && <p class="gorsel-not">{g.not}</p>}
    <p class="gorsel-kaynak">{kaynak && `Kaynak: ${kaynak} · `}son gözlem {tarihUzun(g.son)}</p>
  </figure>
)}

<style>
  .gorsel-figur { margin: 0 0 1.6rem; }
  .gorsel-figur figcaption { margin-bottom: 0.4rem; }
  .gorsel-no {
    display: block; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-60);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .gorsel-baslik { display: block; font-weight: 600; font-size: 1.02rem; line-height: 1.35; margin: 0.15rem 0 0.35rem; }
  .gorsel-lejant-dizi {
    display: flex; flex-wrap: wrap; gap: 0.9rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-70);
  }
  .gorsel-lejant { display: inline-flex; align-items: center; gap: 0.32rem; }
  .gorsel-birim { color: var(--ink-60); }
  .gorsel-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .gorsel-izgara { stroke: var(--ink-15); stroke-width: 1; }
  .gorsel-eksen { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-60); }
  .gorsel-etiket { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; }
  .sag-hiza { text-anchor: end; }
  .orta-hiza { text-anchor: middle; }
  .gorsel-not { margin: 0.45rem 0 0.2rem; font-size: 0.95rem; line-height: 1.5; max-width: var(--olcu-metin, 32rem); }
  .gorsel-kaynak { margin: 0; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-60); }
</style>
