---
/**
 * Günün hareketleri, kendi oynaklığına göre — ıraksayan yatay çubuk.
 *
 * Ölçü z-skoru: günlük hareket / son yirmi günün standart sapması. Birimsiz
 * olduğu için baz puanla yüzde aynı çubukta kıyaslanabiliyor.
 *
 * Kutupluluk üç ayrı işaretle taşınıyor — çubuğun yönü, sayının işareti ve
 * renk — yani hiçbir okur için yalnız renge bağlı değil. Nötr orta eksen gri.
 */
interface Props {
  hareketler: any[];
  esik?: number;
}
const { hareketler = [], esik = 2 } = Astro.props;

const veri = hareketler.filter((x: any) => typeof x?.sigma === 'number');
const enCok = Math.max(1.5, ...veri.map((x: any) => Math.abs(x.sigma)));
const SATIR = 26, BAR = 13, AD = 190, EKSEN = 34;
const W = 640, H = veri.length * SATIR + 22;
const yariGenislik = (W - AD - EKSEN) / 2;
const merkez = AD + yariGenislik;
const uzunluk = (z: number) => (Math.abs(z) / enCok) * (yariGenislik - 6);
---

{veri.length > 0 && (
  <figure class="sigma-figur">
    <figcaption>
      Hareketin olağandışılığı — günlük değişim / 20 günlük standart sapma
    </figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} class="sigma-svg" role="img"
         aria-label="Enstrümanların günlük hareketinin standart sapma cinsinden büyüklüğü">
      {[-esik, esik].map((z) => (
        <line x1={merkez + Math.sign(z) * uzunluk(z)} y1="4"
              x2={merkez + Math.sign(z) * uzunluk(z)} y2={H - 18} class="sigma-esik" />
      ))}
      <line x1={merkez} y1="4" x2={merkez} y2={H - 18} class="sigma-merkez" />
      {veri.map((x: any, i: number) => {
        const y = 8 + i * SATIR;
        const u = uzunluk(x.sigma);
        const negatif = x.sigma < 0;
        return (
          <>
            <text x={AD - 12} y={y + BAR / 2 + 3.5} class="sigma-ad">{x.ad}</text>
            <rect x={negatif ? merkez - u : merkez} y={y} width={Math.max(u, 1)} height={BAR} rx="4"
                  fill={negatif ? 'var(--claret)' : 'var(--teal)'}>
              <title>{`${x.ad}: ${x.deger > 0 ? '+' : ''}${x.deger}${x.birim} · ${x.sigma}σ (günlük σ ${x.oynaklik}${x.birim})`}</title>
            </rect>
            <text x={negatif ? merkez - u - 7 : merkez + u + 7} y={y + BAR / 2 + 3.5}
                  class:list={['sigma-deger', { sag: negatif }]}>
              {`${x.sigma > 0 ? '+' : '−'}${Math.abs(x.sigma).toLocaleString('tr-TR')}σ`}
            </text>
          </>
        );
      })}
      <text x={merkez} y={H - 5} class="sigma-eksen orta">0</text>
      <text x={merkez + uzunluk(esik)} y={H - 5} class="sigma-eksen orta">{`+${esik}σ`}</text>
      <text x={merkez - uzunluk(esik)} y={H - 5} class="sigma-eksen orta">{`−${esik}σ`}</text>
    </svg>
  </figure>
)}

<style>
  .sigma-figur { margin: 0 0 1.2rem; }
  .sigma-figur figcaption {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-70);
    text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.4rem;
  }
  .sigma-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .sigma-merkez { stroke: var(--ink-30); stroke-width: 1.5; }
  .sigma-esik { stroke: var(--ink-15); stroke-width: 1; stroke-dasharray: 3 3; }
  .sigma-ad { font-family: var(--font-mono); font-size: 11px; fill: var(--ink); text-anchor: end; }
  .sigma-deger { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-70); }
  .sigma-deger.sag { text-anchor: end; }
  .sigma-eksen { font-family: var(--font-mono); font-size: 9.5px; fill: var(--ink-30); }
  .orta { text-anchor: middle; }
</style>
