---
/**
 * Hareketler, kendi oynaklığına göre — ıraksayan yatay çubuk.
 *
 * Ölçü z-skoru: hareket / aynı pencerenin standart sapması. Birimsiz olduğu
 * için baz puanla yüzde aynı çubukta kıyaslanabiliyor.
 *
 * PENCERE SABİT DEĞİL. Günlük bültende gün, haftaya bakışta HAFTA. Başlık bir
 * zamanlar "günlük değişim / 20 günlük standart sapma" diye sabit yazıyordu ve
 * haftalık bültende haftalık σ'yı günlük diye etiketliyordu (30.08.2026).
 *
 * Kutupluluk üç ayrı işaretle taşınıyor — çubuğun yönü, sayının işareti ve
 * renk — yani hiçbir okur için yalnız renge bağlı değil. Nötr orta eksen gri.
 */
import { sayi, degisim, olcuYaz } from '../lib/bicim';

interface Props {
  hareketler: any[];
  esik?: number;
  /** 'gunluk' | 'haftalik' — ölçüm katmanının bildirdiği kıyas penceresi. */
  kip?: string;
}
const { hareketler = [], esik = 2, kip = 'gunluk' } = Astro.props;
const haftalik = kip === 'haftalik';
const pencereAd = haftalik ? 'haftalık' : 'günlük';
const tabanAd = haftalik ? '20 haftalık' : '20 günlük';

const veri = hareketler.filter((x: any) => typeof x?.sigma === 'number');
// EKSEN EŞİĞİ İÇERİR: en büyük |σ| eşiğin altındayken ±2σ çizgisi çizim
// alanının, hatta sütunun dışına düşüyordu. Ölçek en az eşiğin biraz ötesine
// kadar uzanır; eşik çizgisi her sayıda görünür.
const enCok = Math.max(esik * 1.1, ...veri.map((x: any) => Math.abs(x.sigma)));
// ETİKET PAYI ÇUBUĞUN DIŞINDA AYRILIR: en uzun eksi çubuğun değer etiketi
// enstrüman adının üstüne biniyordu ("BIST Sınai" ile "−1,5σ" iç içe).
const SATIR = 26, BAR = 13, AD = 190, EKSEN = 34, ETIKET = 44;
const W = 640, H = veri.length * SATIR + 22;
const yariGenislik = (W - AD - EKSEN) / 2;
const merkez = AD + yariGenislik;
const uzunluk = (z: number) => (Math.abs(z) / enCok) * (yariGenislik - ETIKET);
---

{veri.length > 0 && (
  <figure class="sigma-figur">
    <figcaption>
      Hareketin olağandışılığı — {pencereAd} değişim / {tabanAd} standart sapma
    </figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} class="sigma-svg" role="img"
         aria-label={`Enstrümanların ${pencereAd} hareketinin standart sapma cinsinden büyüklüğü`}>
      {[-esik, esik].map((z) => (
        <line x1={merkez + Math.sign(z) * uzunluk(z)} y1="4"
              x2={merkez + Math.sign(z) * uzunluk(z)} y2={H - 18} class="sigma-esik" />
      ))}
      <line x1={merkez} y1="4" x2={merkez} y2={H - 18} class="sigma-merkez" />
      {veri.map((x: any, i: number) => {
        const y = 8 + i * SATIR;
        const u = uzunluk(x.sigma);
        const negatif = x.sigma < 0;
        return (
          <>
            <text x={AD - 12} y={y + BAR / 2 + 3.5} class="sigma-ad">{x.ad}</text>
            <rect x={negatif ? merkez - u : merkez} y={y} width={Math.max(u, 1)} height={BAR} rx="4"
                  fill={negatif ? 'var(--negatif)' : 'var(--pozitif)'}>
              {/* İpucu da biçim sözleşmesiyle: "−2,40%" değil "−%2,40". */}
              <title>{`${x.ad}: ${degisim(x.deger, x.birim, x.birim === 'bp' ? 1 : 2)} · ${sayi(x.sigma, 1, true)}σ (${pencereAd} σ ${olcuYaz(x.oynaklik, x.birim, 2)})`}</title>
            </rect>
            <text x={negatif ? merkez - u - 7 : merkez + u + 7} y={y + BAR / 2 + 3.5}
                  class:list={['sigma-deger', { sag: negatif }]}>
              {`${sayi(x.sigma, 1, true)}σ`}
            </text>
          </>
        );
      })}
      <text x={merkez} y={H - 5} class="sigma-eksen orta">0</text>
      <text x={merkez + uzunluk(esik)} y={H - 5} class="sigma-eksen orta">{`+${esik}σ`}</text>
      <text x={merkez - uzunluk(esik)} y={H - 5} class="sigma-eksen orta">{`−${esik}σ`}</text>
    </svg>
  </figure>
)}

<style>
  .sigma-figur { margin: 0 0 1.2rem; }
  /* Telefonda 640 birimlik çizim 355 piksele ölçekleniyor ve yazılar ~6 pikselde
     okunmuyordu; altındaki tablo aynı satırları σ ile birlikte veriyor. */
  @media (max-width: 640px) { .sigma-figur { display: none; } }
  .sigma-figur figcaption {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-70);
    letter-spacing: 0.02em; margin-bottom: 0.4rem;
  }
  .sigma-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .sigma-merkez { stroke: var(--ink-30); stroke-width: 1.5; }
  .sigma-esik { stroke: var(--ink-30); stroke-width: 1; stroke-dasharray: 3 3; }
  .sigma-ad { font-family: var(--font-mono); font-size: 11px; fill: var(--ink); text-anchor: end; }
  .sigma-deger { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-70); }
  .sigma-deger.sag { text-anchor: end; }
  /* Eksen yazısı METİNDİR: --ink-30 metinde kullanılmaz (1,90:1). */
  .sigma-eksen { font-family: var(--font-mono); font-size: 9.5px; fill: var(--ink-60); }
  .orta { text-anchor: middle; }
</style>
