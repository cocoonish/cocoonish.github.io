---
import { SITE_TITLE } from '../consts';
const yil = new Date().getFullYear();
---

<footer>
  <div class="sarici ic">
    <div>
      <span class="etiket marka">{SITE_TITLE}</span>
      <p class="aciklama">
        Buradaki içerik kişisel araştırma amaçlıdır; yatırım tavsiyesi değildir.
      </p>
    </div>
    <div class="kolon etiket">
      <a href="/projeler/">Projeler</a>
      <a href="/arastirma/">Araştırma</a>
      <a href="/hakkinda/">Hakkında</a>
      <a href="/arama/">Arama</a>
    </div>
    <div class="kolon etiket sag">
      <span>© {yil}</span>
      <span>Markdown → Astro → Statik</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 4px double var(--ink);
    margin-top: 4rem;
  }
  .ic {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding-top: 1.6rem;
    padding-bottom: 2.2rem;
  }
  .marka {
    color: var(--claret);
  }
  .aciklama {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--ink-50);
    max-width: 34ch;
    margin: 0.4rem 0 0;
  }
  .kolon {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--ink-70);
  }
  .kolon a {
    text-decoration: none;
  }
  .sag {
    margin-left: auto;
    text-align: right;
    color: var(--ink-50);
  }
</style>
