---
/**
 * Fransa'da kim kimi seçer, atar, düşürebilir, feshedebilir — Beşinci
 * Cumhuriyet anayasasının ilgili maddeleri (6, 8, 12, 24, 45, 49, 89).
 * Yalnız anayasanın kendisinden okunan ilişkiler çizilir; sayılar (577,
 * 289, 5 yıl, 1 yıl kuralı) anayasa ve seçim kanununun sabitleridir, günün
 * verisi değildir.
 *
 * Renk tek başına anlam taşımaz: "seçer · atar" düz ok, "düşürebilir ·
 * feshedebilir" kesik ok, yasa yapımı iki uçlu ince çizgi; her okun yanında
 * ayrıca adı yazar. viewBox 360 birim geniş, yani telefonda ölçek ~1.
 */
import Diyagram from './Diyagram.astro';

interface Props {
  no?: string;
}
const { no } = Astro.props;
---

<Diyagram no={no} baslik="Fransız siyasi sistemi: kim kimi seçer, atar, düşürebilir, feshedebilir" kaynak="Fransa Anayasası, md. 6, 8, 12, 24, 45, 49, 89; seçim kanunu (meclisin süresi)">
  <svg viewBox="0 0 360 446" role="img" aria-labelledby="fs-baslik" aria-describedby="fs-aciklama">
    <title id="fs-baslik">Fransız siyasi sistemi</title>
    <desc id="fs-aciklama">Seçmenler cumhurbaşkanını ve Ulusal Meclis'i beş yıllığına doğrudan seçer. Cumhurbaşkanı başbakanı atar ve Ulusal Meclis'i feshedebilir; fesihten sonra yapılan meclis seçiminin ardından bir yıl geçmeden yeniden feshedemez (yeni seçilen bir cumhurbaşkanı için ayrıca bir bekleme süresi yoktur). Ulusal Meclis hükümeti gensoruyla, üye tamsayısının salt çoğunluğuyla, yani 577 sandalyede 289 oyla düşürebilir (boş sandalye varsa eşik biraz düşer). Senato'nun 348 üyesi dolaylı seçilir; yasalarda iki meclis anlaşamazsa hükümet son sözü Ulusal Meclis'e verebilir, ama anayasa değişikliği olağan yolda (89. madde) Senato'nun onayı olmadan yapılamaz; Senato'yu atlayan halk oylaması yolu (11. madde) tartışmalıdır.</desc>
    <defs>
      <marker id="fs-uc-teal" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="uc-teal" />
      </marker>
      <marker id="fs-uc-claret" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="uc-claret" />
      </marker>
      <marker id="fs-uc-gri" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="uc-gri" />
      </marker>
    </defs>

    <!-- Seçmenler -->
    <rect x="90" y="6" width="180" height="34" rx="3" class="kutu ust" />
    <text x="180" y="28" class="ad" text-anchor="middle">Seçmenler</text>

    <line x1="132" y1="40" x2="78" y2="102" class="ok teal" marker-end="url(#fs-uc-teal)" />
    <line x1="228" y1="40" x2="282" y2="102" class="ok teal" marker-end="url(#fs-uc-teal)" />
    <text x="180" y="72" class="etk teal-y" text-anchor="middle">doğrudan seçer</text>
    <text x="180" y="87" class="kucuk" text-anchor="middle">ikisi de 5 yıllık</text>

    <!-- Cumhurbaşkanı -->
    <rect x="8" y="104" width="134" height="84" rx="3" class="kutu" />
    <text x="75" y="126" class="ad" text-anchor="middle">Cumhurbaşkanı</text>
    <text x="75" y="144" class="benzetme" text-anchor="middle">arabanın sahibi</text>
    <text x="75" y="161" class="kucuk" text-anchor="middle">5 yıl · en çok</text>
    <text x="75" y="176" class="kucuk" text-anchor="middle">üst üste 2 dönem</text>

    <!-- Ulusal Meclis -->
    <rect x="218" y="104" width="134" height="84" rx="3" class="kutu" />
    <text x="285" y="126" class="ad" text-anchor="middle">Ulusal Meclis</text>
    <text x="285" y="144" class="benzetme" text-anchor="middle">benzini verir, keser</text>
    <text x="285" y="161" class="kucuk" text-anchor="middle">577 sandalye</text>
    <text x="285" y="176" class="kucuk" text-anchor="middle">çoğunluk: 289</text>

    <!-- Cumhurbaşkanı → Meclis: fesih -->
    <line x1="142" y1="146" x2="216" y2="146" class="ok claret kesik" marker-end="url(#fs-uc-claret)" />
    <text x="180" y="139" class="etk claret-y" text-anchor="middle">feshedebilir</text>
    <text x="180" y="161" class="kucuk" text-anchor="middle">1 yıl içinde</text>
    <text x="180" y="175" class="kucuk" text-anchor="middle">yeniden olmaz</text>

    <!-- Cumhurbaşkanı → Hükümet: atama -->
    <line x1="56" y1="188" x2="56" y2="294" class="ok teal" marker-end="url(#fs-uc-teal)" />
    <text x="64" y="245" class="etk teal-y">atar</text>

    <!-- Meclis → Hükümet: gensoru -->
    <line x1="236" y1="188" x2="142" y2="294" class="ok claret kesik" marker-end="url(#fs-uc-claret)" />
    <rect x="146" y="217" width="84" height="48" class="zemin" />
    <text x="188" y="231" class="etk claret-y" text-anchor="middle">gensoruyla</text>
    <text x="188" y="245" class="etk claret-y" text-anchor="middle">düşürebilir</text>
    <text x="188" y="260" class="kucuk" text-anchor="middle">289 oy gerekir</text>

    <!-- Meclis ↔ Senato: yasa yapımı -->
    <line x1="305" y1="190" x2="305" y2="294" class="ok gri" marker-start="url(#fs-uc-gri)" marker-end="url(#fs-uc-gri)" />
    <text x="298" y="233" class="kucuk" text-anchor="end">yasada</text>
    <text x="298" y="247" class="kucuk" text-anchor="end">son söz</text>
    <text x="298" y="261" class="kucuk" text-anchor="end">Meclis'e</text>
    <text x="298" y="275" class="kucuk" text-anchor="end">verilebilir</text>

    <!-- Başbakan ve hükümet -->
    <rect x="8" y="296" width="134" height="84" rx="3" class="kutu" />
    <text x="75" y="316" class="ad" text-anchor="middle">Başbakan ve</text>
    <text x="75" y="332" class="ad" text-anchor="middle">hükümet</text>
    <text x="75" y="350" class="benzetme" text-anchor="middle">direksiyonda</text>
    <text x="75" y="368" class="kucuk" text-anchor="middle">bütçeyi hazırlar</text>

    <!-- Senato -->
    <rect x="218" y="296" width="134" height="84" rx="3" class="kutu" />
    <text x="285" y="318" class="ad" text-anchor="middle">Senato</text>
    <text x="285" y="336" class="kucuk" text-anchor="middle">348 sandalye · dolaylı</text>
    <text x="285" y="354" class="kucuk claret-y" text-anchor="middle">anayasa değişikliğinde</text>
    <text x="285" y="369" class="kucuk claret-y" text-anchor="middle">olağan yolda onayı şart</text>

    <!-- Lejant -->
    <line x1="8" y1="406" x2="40" y2="406" class="ok teal" marker-end="url(#fs-uc-teal)" />
    <text x="48" y="410" class="kucuk">seçer · atar</text>
    <line x1="160" y1="406" x2="192" y2="406" class="ok claret kesik" marker-end="url(#fs-uc-claret)" />
    <text x="200" y="410" class="kucuk">düşürebilir · feshedebilir</text>
    <line x1="10" y1="430" x2="40" y2="430" class="ok gri" marker-start="url(#fs-uc-gri)" marker-end="url(#fs-uc-gri)" />
    <text x="48" y="434" class="kucuk">yasa: anlaşmazlıkta hükümet son sözü Meclis'e verebilir</text>
  </svg>
</Diyagram>

<style>
  .kutu {
    fill: var(--paper-2);
    stroke: var(--ink-30);
    stroke-width: 1;
  }
  .kutu.ust {
    fill: var(--paper-3);
  }
  .zemin {
    fill: var(--paper);
  }
  .ad {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    fill: var(--ink);
  }
  .benzetme {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 12.5px;
    fill: var(--ink-70);
  }
  .etk {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }
  .kucuk {
    font-family: var(--font-body);
    font-size: 11.5px;
    fill: var(--ink-60);
  }
  .teal-y {
    fill: var(--teal);
  }
  .claret-y {
    fill: var(--claret);
  }
  .ok {
    fill: none;
    stroke-width: 1.8;
  }
  .ok.teal {
    stroke: var(--teal);
  }
  .ok.claret {
    stroke: var(--claret);
  }
  .ok.gri {
    stroke: var(--ink-50);
    stroke-width: 1.3;
  }
  .kesik {
    stroke-dasharray: 5 4;
  }
  .uc-teal {
    fill: var(--teal);
  }
  .uc-claret {
    fill: var(--claret);
  }
  .uc-gri {
    fill: var(--ink-50);
  }
</style>
