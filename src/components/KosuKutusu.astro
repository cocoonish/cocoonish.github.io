---
/**
 * Koşu kutusu: bir veri hattının SON KOŞUSUNUN durumu — tazelik + uyarılar.
 *
 * İki hat da aynı kalıbı kullanır ve kutu sayfanın BAŞINDA durur: "kaynak
 * düşerse GÖRÜNÜR uyarı" ilkesi, uyarıyı 800. satıra gömen bir sayfada
 * karşılanmış sayılmaz.
 *
 * Değerler /projeler/<proje>/ozet.json'dan istemci tarafında okunur:
 *   bayat          → true ise kutu kırmızıya döner ve başlığı "BAYAT VERİ" olur
 *   bayat_cumlesi  → bayatlığın gerekçesi (ya da "veri taze" cümlesi)
 *   uyari_sayisi / uyari_cumlesi / uyari_metni → bu koşuda düşen uyarılar
 *
 * Statik yedek (JSON yüklenemezse) slot içeriğinde durur.
 */
import fs from 'node:fs';
import path from 'node:path';
import { tarihYaz } from '../lib/bicim';

interface Props {
  proje: string;
  /** Statik yedek: son bilinen uyarı sayısı (dosya okunamazsa). */
  sayi?: number;
}
const { proje, sayi = 0 } = Astro.props;

// İlk değerler DERLEME anında dosyadan: JS kapalı okur da bu koşunun
// durumunu görür; elle yazılan yedek yalnız dosya yokken kalır.
let o: Record<string, any> | null = null;
try {
  o = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'projeler', proje, 'ozet.json'), 'utf-8'));
} catch {
  o = null;
}
const bayat = o?.bayat === true;
const baslik = bayat
  ? 'BAYAT VERİ — bu koşuda sayılar ilerlemedi'
  : o?._tarih ? `Bu koşunun durumu · veri ${tarihYaz(String(o._tarih))}` : 'Bu koşunun durumu';
const tazelik = o?.bayat_cumlesi ?? '';
const cumle = o?.uyari_cumlesi ?? `Bu koşuda ${sayi} uyarı düştü:`;
const metin: string | null = typeof o?.uyari_metni === 'string' ? o.uyari_metni : null;
---

<div class:list={['not', 'kosu', { bayat }]} data-kosu-proje={proje}>
  <span class="etiket" data-kosu-baslik>{baslik}</span>
  {tazelik && <p class="kosu-tazelik" data-kosu-tazelik>{tazelik}</p>}
  <!-- div, p DEĞİL: MDX slot içeriğini kendi <p>'sine sarar; <p> içinde <p>
       geçersizdir ve tarayıcı dış paragrafı erkenden kapatır. -->
  <div class="kosu-uyari">
    <strong data-kosu-cumle>{cumle}</strong>{' '}
    <span data-kosu-metin>{metin ?? <slot />}</span>
  </div>
  <p class="kosu-kaynak">
    <a href={`/projeler/${proje}/uyarilar.json`}>Uyarı listesi</a> ·
    <a href={`/projeler/${proje}/ozet.json`}>sayfadaki canlı değerler</a>
  </p>
</div><script>
  import { tarihYaz } from '../lib/bicim';
  const kutular = [...document.querySelectorAll('[data-kosu-proje]')] as HTMLElement[];
  kutular.forEach(async (kutu) => {
    const proje = kutu.dataset.kosuProje!;
    try {
      const r = await fetch(`/projeler/${proje}/ozet.json`, { cache: 'no-cache' });
      if (!r.ok) return;
      const o = await r.json();
      const taze = kutu.querySelector('[data-kosu-tazelik]') as HTMLElement | null;
      const baslik = kutu.querySelector('[data-kosu-baslik]') as HTMLElement | null;
      const cumle = kutu.querySelector('[data-kosu-cumle]') as HTMLElement | null;
      const metin = kutu.querySelector('[data-kosu-metin]') as HTMLElement | null;
      if (taze && o.bayat_cumlesi) taze.textContent = o.bayat_cumlesi;
      if (cumle && o.uyari_cumlesi) cumle.textContent = o.uyari_cumlesi;
      if (metin && o.uyari_metni) metin.textContent = o.uyari_metni;
      if (o.bayat === true) {
        kutu.classList.add('bayat');
        if (baslik) baslik.textContent = 'BAYAT VERİ — bu koşuda sayılar ilerlemedi';
      } else if (baslik && o._tarih) {
        baslik.textContent = `Bu koşunun durumu · veri ${tarihYaz(String(o._tarih))}`;
      }
    } catch {
      /* statik yedek kalır */
    }
  });
</script><style>
  .not.kosu p,
  .not.kosu .kosu-uyari {
    margin: 0.35rem 0;
  }
  /* MDX slot içeriği bir <p> ile gelir; kutuda satır içi akmalı. */
  .not.kosu .kosu-uyari span > p {
    display: inline;
    margin: 0;
  }
  .not.kosu .kosu-kaynak {
    font-size: 0.86rem;
    color: var(--ink-70);
  }
  .not.kosu.bayat {
    border-left-color: var(--claret);
    border-color: var(--claret);
  }
  .not.kosu.bayat .etiket {
    color: var(--claret);
    font-weight: 600;
  }
</style>
