---
/**
 * Koşu kutusu: bir veri hattının SON KOŞUSUNUN AYRINTISI — uyarı listesi ve
 * doğrulama özeti. Sayfa başındaki veri durumu şeridi hükmü verir ("N uyarı",
 * bayat/taze); bu kutu o hükmün gerekçesini açar. İkisi aynı dosyadan
 * (public/projeler/<proje>/uyarilar.json + ozet.json) DERLEME anında okunur:
 * elle yazılmış özet yok, JS kapalıyken de dolu. Sayfa açılınca aynı dosya
 * yeniden okunur; derleme ile ziyaret arasında hat koşmuşsa liste tazelenir.
 *
 * Slot isteğe bağlı: yazarın koşu hakkında yorumu (kural, tolerans, bağlam);
 * uyarıların kendisi slot'a yazılmaz — dosya söyler.
 */
import fs from 'node:fs';
import path from 'node:path';
import { tarihYaz } from '../lib/bicim';

interface Props {
  proje: string;
}
const { proje } = Astro.props;

const oku = (ad: string): Record<string, any> | null => {
  try {
    return JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'projeler', proje, ad), 'utf-8'));
  } catch {
    return null;
  }
};
const o = oku('ozet.json');
const u = oku('uyarilar.json');

const bayat = o?.bayat === true || String(o?.bayat) === 'True';
const uyarilar: string[] = Array.isArray(u?.uyarilar) ? u!.uyarilar.map(String) : [];
const dogrulama = u?.dogrulama && typeof u.dogrulama === 'object' ? Object.keys(u.dogrulama) : [];
const kosum = tarihYaz(String(u?.kosum ?? o?.kosum_tarihi ?? ''));
const veri = tarihYaz(String(u?.tarih ?? o?._tarih ?? ''));
const baslik = bayat ? 'BAYAT VERİ — bu koşuda sayılar ilerlemedi' : 'Bu koşunun durumu';
// Şerit özetteki sayıyı basar (uyarı listesi ∪ veri durumu); kutu koşu kaydını.
// Bugün eşitler; ayrıştığı gün fark burada yazılır, sessizce iki sayı dolaşmaz.
const seritSayisi = typeof o?.uyari_sayisi === 'number' ? o.uyari_sayisi : null;
const uyumsuz = u && seritSayisi !== null && seritSayisi !== uyarilar.length;
const tazelik = typeof o?.bayat_cumlesi === 'string' ? o.bayat_cumlesi : '';
---

<div class:list={['not', 'kosu', { bayat }]} id="kosu" data-kosu-proje={proje}>
  <span class="etiket" data-kosu-baslik>{baslik}</span>
  <p class="kosu-meta">
    {kosum && <>koşu {kosum}</>}{kosum && veri && ' · '}{veri && <>veri {veri}</>}
    {dogrulama.length > 0 && <> · {dogrulama.length} kimlik denetimi</>}
  </p>
  {tazelik && <p class="kosu-tazelik" data-kosu-tazelik>{tazelik}</p>}
  {u ? (
    uyarilar.length > 0 ? (
      <>
        <p class="kosu-cumle"><strong data-kosu-cumle>Bu koşuda {uyarilar.length} uyarı düştü:</strong></p>
        <ol class="kosu-liste" data-kosu-liste>
          {uyarilar.map((x) => <li>{x}</li>)}
        </ol>
      </>
    ) : (
      <p class="kosu-cumle"><strong data-kosu-cumle>Bu koşuda uyarı yok.</strong></p>
    )
  ) : (
    <p class="kosu-cumle"><strong data-kosu-cumle>Koşu kaydı bulunamadı.</strong></p>
  )}
  {uyumsuz && (
    <p class="kosu-uyumsuz">
      Sayfa başındaki özet {seritSayisi} uyarı sayıyor, koşu kaydında {uyarilar.length} kayıt var;
      fark veri durumu denetiminden gelir{typeof o?.uyari_metni === 'string' && o.uyari_metni ? `: ${o.uyari_metni}` : '.'}
    </p>
  )}
  <div class="kosu-not"><slot /></div>
  <p class="kosu-kaynak">
    <a href={`/projeler/${proje}/uyarilar.json`}>Koşu kaydı</a> ·
    <a href={`/projeler/${proje}/ozet.json`}>sayfadaki canlı değerler</a>
  </p>
</div><script>
  // Sayfa açılınca aynı dosya yeniden okunur; liste ve hüküm tazelenir.
  const kutular = [...document.querySelectorAll('[data-kosu-proje]')] as HTMLElement[];
  kutular.forEach(async (kutu) => {
    const proje = kutu.dataset.kosuProje!;
    try {
      const [r1, r2] = await Promise.all([
        fetch(`/projeler/${proje}/uyarilar.json`, { cache: 'no-cache' }),
        fetch(`/projeler/${proje}/ozet.json`, { cache: 'no-cache' }),
      ]);
      if (!r1.ok) return;
      const u = await r1.json();
      const o = r2.ok ? await r2.json() : {};
      const liste = Array.isArray(u.uyarilar) ? u.uyarilar.map(String) : [];
      const cumle = kutu.querySelector('[data-kosu-cumle]');
      if (cumle) cumle.textContent = liste.length ? `Bu koşuda ${liste.length} uyarı düştü:` : 'Bu koşuda uyarı yok.';
      const ol = kutu.querySelector('[data-kosu-liste]');
      if (ol) ol.innerHTML = liste.map((x: string) => `<li>${x.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!)}</li>`).join('');
      const taze = kutu.querySelector('[data-kosu-tazelik]');
      if (taze && o.bayat_cumlesi) taze.textContent = o.bayat_cumlesi;
      const bayat = o.bayat === true || String(o.bayat) === 'True';
      kutu.classList.toggle('bayat', bayat);
      const baslik = kutu.querySelector('[data-kosu-baslik]');
      if (baslik) baslik.textContent = bayat ? 'BAYAT VERİ — bu koşuda sayılar ilerlemedi' : 'Bu koşunun durumu';
    } catch {
      /* derleme anındaki değerler kalır */
    }
  });
</script><style>
  .not.kosu p, .not.kosu .kosu-not { margin: 0.35rem 0; }
  .not.kosu .kosu-meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-60); }
  .not.kosu .kosu-liste { margin: 0.3rem 0 0.4rem 1.2rem; padding: 0; font-size: 0.9rem; }
  .not.kosu .kosu-liste li { margin: 0.2rem 0; }
  .not.kosu .kosu-not:empty { display: none; }
  .not.kosu .kosu-uyumsuz { font-size: 0.86rem; color: var(--uyari); }
  .not.kosu .kosu-not p { margin: 0.35rem 0; }
  .not.kosu .kosu-kaynak { font-size: 0.86rem; color: var(--ink-70); }
  .not.kosu.bayat { border-left-color: var(--claret); border-color: var(--claret); }
  .not.kosu.bayat .etiket { color: var(--claret); font-weight: 600; }
</style>
