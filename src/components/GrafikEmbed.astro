---
/**
 * Python projelerinin ürettiği interaktif (Plotly vb.) HTML çıktısını
 * makale içine gömer. Dosyalar site/public/ altında durur;
 * güncelleme akışı yeni HTML'i aynı yola kopyalayınca grafik de yenilenir.
 * Kopyalama sonrası ev stili: python3 site/tools/plotly_stil.py --hepsi
 */
import fs from 'node:fs';
import path from 'node:path';
import { cerceveYuksekligi } from '../lib/grafikOlcu';
import { tarihYaz } from '../lib/bicim';

interface Props {
  src: string; // ör. /projeler/tcmb-net-rezerv/grafik.html
  baslik: string;
  no?: string; // ör. "01"
  /**
   * Şeklin serisinin tarih anahtarı (ör. "ak_tarih"). Verilmezse hattın
   * `_tarih`i. Aynı panoda bacaklar farklı saatte olabilir; şeklin altında
   * kendi serisinin günü yazsın — "her sayı kendi tarihini taşır".
   */
  tarihAnahtari?: string;
  /** Kısa kaynak adı, altyazıda ("TCMB EVDS"). */
  kaynak?: string;
  /**
   * Açıkça verilirse KAZANIR. Verilmezse figürün kendi ilan ettiği yükseklik
   * kullanılır — sabit 540px, kendi yüksekliğini yazan figürleri alttan
   * kırpıyordu ve bunu hiçbir şey ölçmüyordu (bkz. lib/grafikOlcu.ts).
   */
  yukseklik?: number;
}

const { src, baslik, no, yukseklik, tarihAnahtari, kaynak } = Astro.props;
const cerceveYuk = cerceveYuksekligi(src, yukseklik);

// Proje şekli ise veri tarihi derleme anında hattın özetinden okunur.
// Uydurma yok: özet ya da tarih yoksa altyazıda tarih satırı hiç çıkmaz.
let veriTarihi = '';
const proje = src.match(/^\/projeler\/([^/]+)\//)?.[1];
if (proje) {
  try {
    const o = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'projeler', proje, 'ozet.json'), 'utf-8'));
    const ham = (tarihAnahtari && typeof o[tarihAnahtari] === 'string' ? o[tarihAnahtari] : '') || (typeof o._tarih === 'string' ? o._tarih : '');
    veriTarihi = ham ? tarihYaz(ham) : '';
  } catch {
    veriTarihi = '';
  }
}
---

<figure class="grafik">
  <figcaption>
    <span class="etiket grafik-no">{no ? `Şekil ${no}` : 'Şekil'}</span>
    <span class="grafik-baslik">{baslik}</span>
    {(veriTarihi || kaynak) && (
      <span class="etiket grafik-veri">
        {veriTarihi && `veri ${veriTarihi}`}{veriTarihi && kaynak && ' · '}{kaynak}
      </span>
    )}
    <a class="etiket tam-ekran" href={src} target="_blank" rel="noopener">Tam ekran ↗</a>
  </figcaption>
  <div class="cerceve" style={`height:${cerceveYuk}px`}>
    <div class="yukleniyor etiket">Grafik yükleniyor…</div>
    <iframe
      src={src}
      title={baslik}
      loading="lazy"
      onload="this.parentElement.classList.add('hazir')"></iframe>
  </div>
</figure>

<style>
  .grafik {
    margin: 2.2em 0;
    border: 1px solid var(--ink-30);
    background: #fff;
    box-shadow: 0 1px 0 var(--ink-15);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--ink-15);
    background: var(--paper-2);
  }
  .grafik-no {
    color: var(--claret);
    white-space: nowrap;
  }
  .grafik-baslik {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-70);
  }
  .grafik-veri {
    margin-left: auto;
    white-space: nowrap;
    color: var(--ink-50);
    font-variant-numeric: tabular-nums;
  }
  .grafik-veri + .tam-ekran { margin-left: 0; }
  .tam-ekran {
    margin-left: auto;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-50);
  }
  .tam-ekran:hover {
    color: var(--claret);
  }
  .cerceve {
    position: relative;
    background:
      linear-gradient(100deg, transparent 30%, rgba(33, 27, 18, 0.05) 50%, transparent 70%)
        no-repeat 0 0 / 300% 100%,
      #fff;
    animation: parilti 1.6s linear infinite;
  }
  @keyframes parilti {
    to {
      background-position: -300% 0, 0 0;
    }
  }
  .yukleniyor {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-30);
  }
  iframe {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .cerceve.hazir {
    animation: none;
    background: #fff;
  }
  .cerceve.hazir iframe {
    opacity: 1;
  }
  .cerceve.hazir .yukleniyor {
    display: none;
  }
</style>
