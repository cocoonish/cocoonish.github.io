---
/**
 * Günlük bültenin gövdesi. Veri, bulten/uret.py'nin yazdığı JSON'dan gelir
 * (site/src/data/bulten/YYYY-MM-DD.json) ve DERLEME sırasında okunur — sayfada
 * istemci tarafı veri çekme yoktur, bülten statik ve arşivlenebilir.
 *
 * Bölüm sırası bilinçli: önce sayılar (gösterge şeridi), sonra eşiği aşan olaylar,
 * sonra takvim, en sonda haber. Sabah üç saniyede bakan biri ilk iki bölümden
 * gerekli her şeyi almalı.
 */
import EgriGrafik from './EgriGrafik.astro';
import SigmaSerit from './SigmaSerit.astro';
import Kunye from './Kunye.astro';
import { sayi, yuzde, degisim, ondalikSay, istanbulSaat, tarihUzun, tarihYaz } from '../lib/bicim';
import type { BultenKaydi } from '../lib/yayinlar';
import { xBulten } from '../lib/x';
import { FERAGAT } from '../consts';

interface Props {
  b: any;
  /** Sayı numarası, ölçüm saati, sayımlar — lib/yayinlar.ts kaydı. */
  kayit?: BultenKaydi;
  /** Hat slug'ı → okura görünen ad (proje sayfası başlığı). */
  hatAd?: Record<string, string>;
}
const { b: ham, kayit, hatAd = {} } = Astro.props;
// ŞEMA TEK YERDE TOPARLANIR: eksik bir liste bütün /bulten/* sayfalarını ve ana
// sayfayı düşürüp sitenin tamamının yayınını durdururdu. Yokluk boş listedir;
// bölüm başlıkları zaten 'liste doluysa' koşuluyla basılır.
const b: any = {
  gostergeler: [], rejim: [], one_cikanlar: [], sonuclar: [], gruplar: [], veri_gunlugu: [],
  ...(ham ?? {}),
  piyasa: { gruplar: [], turetilmis: [], tr_faizleri: [], ...(ham?.piyasa ?? {}),
            en_cok_hareket: { sigma: [], ...(ham?.piyasa?.en_cok_hareket ?? {}) } },
  haberler: { bolumler: [], okunamayan: [], ...(ham?.haberler ?? {}) },
  izleme: { acik: [], kapanan: [], karne: {}, ...(ham?.izleme ?? {}) },
};
const ad = (slug: string) => hatAd[slug] ?? slug;
const tz = (t: unknown) => (typeof t === 'string' ? tarihYaz(t) : '');
// Kipe bağlı etiketler tek yerde: günlük ve haftaya bakış farklı sözcükler kullanır.
const kip = b.haftalik
  ? { gundemNot: 'Geçen haftanın öne çıkanları: Türkiye ve global taraf, makro ve politika ayrımıyla.' }
  : { gundemNot: 'Dün ve bu sabah öne çıkanlar: Türkiye ve global taraf, makro ve politika ayrımıyla.' };

// Sayı biçimi tek yerden (lib/bicim): eksi işareti U+2212, ondalık virgül,
// yüzde işareti sayının ÖNÜNDE ("−%1,88"), bp sayının ardında ("−6,5 bp").
// Ondalık verilmezse kaynağın kendi hanesi korunur (ölçüm katmanı yuvarlar).
const tr = (v: number | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : sayi(v, ondalik ?? ondalikSay(v));
const isaretli = (v: number | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : sayi(v, ondalik ?? ondalikSay(v), true);
/** Birimli değişim: "%" ise yuzde önde, değilse "sayı birim". */
const degisimli = (v: number | null | undefined, birim: string | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : degisim(v, birim ?? '', ondalik ?? ondalikSay(v));
/** Ölçüm katmanının yazdığı hazır metin: eski sayılarda ASCII tire kalmış olabilir. */
const eksiDuzelt = (s: unknown): string => String(s ?? '').replace(/(^|[\s(])-(?=\d)/g, '$1−');
/** Gösterge farkı: "%" birimde işaret önde, yüzde sayının önünde ("+%4,2"); bp arkada. */
const gostergeFark = (fark: unknown, birim: unknown): string => {
  const f = eksiDuzelt(fark);
  const bir = String(birim ?? '').trim();
  if (!f) return '—';
  if (bir === '%') return f.replace(/^([+−]?)/, '$1%');
  return bir ? `${f} ${bir}` : f;
};
/** Birimli seviye (işaretsiz): "%1,20" ya da "6,5 bp". */
const birimli = (v: number | null | undefined, birim: string | null | undefined, ondalik?: number): string => {
  if (v === null || v === undefined || typeof v !== 'number') return '—';
  const b = (birim ?? '').trim();
  const n = ondalik ?? ondalikSay(v);
  return b === '%' ? yuzde(v, n) : `${sayi(v, n)}${b ? ` ${b}` : ''}`;
};

// ── Künye: sayının ölçülen kimliği
const enstruman = kayit?.enstruman
  ?? (b?.piyasa?.gruplar ?? []).reduce((n: number, g: any) => n + (g?.satirlar?.length ?? 0), 0);
const haberSayisi = kayit?.haber ?? (b?.haberler?.haber?.length ?? 0);
const olcumSaati = kayit?.olcumSaati || istanbulSaat(b.olusturma);
const xGonderi = xBulten(b.tarih);
const kunye = [
  kayit ? { deger: `No ${kayit.sayiNo}`, etiket: 'Sayı', vurgu: true } : null,
  { deger: olcumSaati, etiket: 'Ölçüm', alt: olcumSaati ? 'İstanbul saati' : undefined },
  b.yorum_zamani ? { deger: tarihUzun(b.yorum_zamani), etiket: 'Yazı' } : null,
  { deger: String(enstruman), etiket: 'Enstrüman' },
  haberSayisi ? { deger: String(haberSayisi), etiket: 'Taranan haber' } : null,
  b.piyasa?.kapanis_seansi ? { deger: String(b.piyasa.kapanis_seansi), etiket: 'Ölçülen seans' } : null,
  b.duzeltmeler?.length ? { deger: String(b.duzeltmeler.length), etiket: 'Düzeltme', href: '#duzeltmeler', vurgu: true } : null,
  xGonderi ? { deger: 'X gönderisi ↗', etiket: 'Paylaşım', href: xGonderi.url } : null,
].filter(Boolean) as any[];


// Takvim eskiden iki kez yazılıyordu: "Kritik takvim" birinci derece verilerin
// geri sayımı, "Takvim" ise haftalara bölünmüş tam liste — aynı olay iki
// bölümde birden görünüyordu. Artık tek bölüm: önce geri sayım, sonra tam
// listenin GERİ KALANI. Eşleştirme olay adı + tarih üzerinden yapılır.
const kritikler = b.kritik_takvim ?? [];
const kritikAnahtar = new Set(kritikler.map((k: any) => `${k.olay}|${k.tr_tarih}`));
const takvimGruplari = (b.takvim ?? [])
  .map((t: any) => ({
    ...t,
    kayitlar: t.kayitlar.filter((k: any) => !kritikAnahtar.has(`${k.olay}|${k.tr_tarih}`)),
  }))
  .filter((t: any) => t.kayitlar.length > 0);
const takvimVar = kritikler.length > 0 || takvimGruplari.length > 0;

// İçindekiler: yalnız GERÇEKTEN basılan bölümler listelenir. Koşulları
// bölümlerin kendi koşullarıyla birebir aynı tutmak şart — yoksa boşa çıkan
// bir bağlantı okuru hiçbir yere götürmez.
// Olağandışılık bölümünün penceresi bültenin kipini izler: günlük bültende gün,
// haftaya bakışta HAFTA. Ölçüm katmanı hangi pencereyi kullandığını
// `en_cok_hareket.sigma_kip` ile söylüyor; başlık ve sütun adları ondan türetilir.
// (Eski sürüm haftalık bültende de "Günün olağandışı hareketleri" yazıyor ve
// haftalık σ'yı "günlük σ" diye etiketliyordu.)
const sigmaHaftalik = b.piyasa?.en_cok_hareket?.sigma_kip === 'haftalik';
const sigmaBaslik = sigmaHaftalik
  ? 'Haftanın olağandışı hareketleri'
  : 'Günün olağandışı hareketleri';

const bolumler = [
  b.yorum && { id: 'yorum', ad: b.haftalik ? 'Haftanın okuması' : 'Günün okuması' },
  b.duzeltmeler?.length > 0 && { id: 'duzeltmeler', ad: 'Düzeltmeler' },
  b.ozet && (b.ozet.ne_oldu || b.ozet.ne_bekleniyor) &&
    { id: 'ozet', ad: b.haftalik ? 'Geçen hafta / önümüzdeki hafta' : 'Ne oldu / ne bekleniyor' },
  b.gostergeler?.length > 0 && { id: 'gostergeler', ad: 'Gösterge şeridi' },
  b.rejim?.length > 0 && { id: 'rejim', ad: 'Rejim panosu' },
  b.piyasa?.en_cok_hareket?.sigma?.length > 0 &&
    { id: 'olagandisi', ad: sigmaBaslik },
  b.one_cikanlar?.length > 0 && { id: 'one-cikanlar', ad: 'Öne çıkanlar' },
  b.sonuclar?.length > 0 && { id: 'sonuclar', ad: 'Ne bekleniyordu, ne geldi' },
  takvimVar && { id: 'takvim', ad: 'Takvim' },
  b.gruplar?.length > 0 && { id: 'hat-hat', ad: 'Hat hat değişim' },
  (b.izleme?.acik?.length > 0 || b.izleme?.kapanan?.length > 0) &&
    { id: 'soz-defteri', ad: 'Söz defteri' },
  b.haberler?.bolumler?.length > 0 && { id: 'gundem', ad: 'Gündem' },
  b.temalar?.temalar?.length > 0 && { id: 'temalar', ad: 'İzlenen temalar' },
  b.veri_gunlugu?.length > 0 && { id: 'veri-gunlugu', ad: 'Veri günlüğü' },
  b.piyasa?.gruplar?.length > 0 && { id: 'piyasa', ad: 'Piyasa fotoğrafı' },
].filter(Boolean) as { id: string; ad: string }[];
---

<article class="bulten">
  <header class="ust">
    <p class="etiket kicker">
      {b.haftalik ? 'Haftaya bakış' : 'Günlük bülten'}
      {kayit && <span class="kicker-sayi"> · Sayı {kayit.sayiNo}</span>}
    </p>
    <h1>{b.tr_tarih} <span class="gun">{b.gun}</span></h1>
    {b.haftalik && <p class="haftalik-rozet">geçen hafta ve önümüzdeki hafta</p>}
    <p class="alt">
      {b.haftalik
        ? 'Geçen hafta Türkiye makro verisinde ne değişti, önümüzdeki hafta hangi veriler ve kararlar var. Her sayının altında hangi tarihli veriden geldiği yazar.'
        : 'Türkiye makro verisinde son yayımdan bu yana ne değişti, bugün ve önümüzdeki haftalarda ne bekleniyor. Her sayının altında hangi tarihli veriden geldiği yazar.'}
    </p>
    <Kunye hucreler={kunye} genis etiket="Sayı künyesi" />
  </header>

  {bolumler.length > 2 && (
    <nav class="icindekiler" aria-label="Bülten bölümleri">
      <p class="ic-baslik">İçindekiler</p>
      <ol>
        {bolumler.map((x) => (
          <li><a href={`#${x.id}`}>{x.ad}</a></li>
        ))}
      </ol>
    </nav>
  )}

  {b.yorum && (
    <section class="yorum" id="yorum">
      <p class="etiket">{b.haftalik ? 'Haftanın okuması' : 'Günün okuması'}</p>
      <div set:html={b.yorum} />
    </section>
  )}

  {b.duzeltmeler?.length > 0 && (
    <section class="blok duzeltmeler" id="duzeltmeler">
      <h2>Düzeltmeler</h2>
      <p class="alt-not">
        Daha önce yayımlanan bir sayı yanlış çıktıysa sessizce değiştirilmez: neyin,
        neden ve neye düzeltildiği burada tarihiyle yazar. Bütün yayınların düzeltmeleri
        <a href="/duzeltmeler/">tek listede</a> toplanır.
      </p>
      <ul class="duzeltme-liste">
        {b.duzeltmeler.map((d: any) => (
          <li>
            <span class="d-tarih">{tarihUzun(d.tarih)}</span>
            <span class="d-govde">
              <strong>{d.alan}</strong>
              <span class="d-degerler">
                yayımlanan <s>{d.eski}</s> yerine <b>{d.yeni}</b>
              </span>
              {d.sebep && <span class="d-sebep">{d.sebep}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {b.ozet && (b.ozet.ne_oldu || b.ozet.ne_bekleniyor) && (
    <section class="ozet" id="ozet">
      {b.ozet.ne_oldu && (
        <div class="ozet-parca">
          <h2>{b.haftalik ? 'Geçen hafta ne oldu' : 'Ne oldu'}</h2>
          <p>{b.ozet.ne_oldu}</p>
        </div>
      )}
      {b.ozet.ne_bekleniyor && (
        <div class="ozet-parca">
          <h2>{b.haftalik ? 'Önümüzdeki hafta ne bekleniyor' : 'Ne bekleniyor'}</h2>
          <p>{b.ozet.ne_bekleniyor}</p>
        </div>
      )}
    </section>
  )}

  <section class="gosterge-serit" id="gostergeler" aria-label="Gösterge şeridi">
    {b.gostergeler.map((g: any) => (
      <div class="gosterge">
        <span class="g-ad">{g.ad}</span>
        <span class="g-deger">
          {String(g.birim ?? '').trim() === '%'
            ? <>{'%'}{eksiDuzelt(g.metin)}</>
            : <>{eksiDuzelt(g.metin)}<span class="g-birim">{g.birim}</span></>}
        </span>
        <span class:list={['g-fark', { arti: (g.fark ?? 0) > 0, eksi: (g.fark ?? 0) < 0 }]}>
          {gostergeFark(g.fark_metin, g.birim)}
        </span>
        <span class="g-tarih">
          {tz(g.veri_tarihi)}
          {g.kiyas && g.kiyas !== 'son yayım' && <span class="g-kiyas">{g.kiyas}</span>}
        </span>
      </div>
    ))}
  </section>


  {b.rejim?.length > 0 && (
    <section class="blok rejim" id="rejim">
      <h2>Rejim panosu</h2>
      <p class="alt-not">
        Gösterge şeridi seviyeyi verir; bu pano seviyelerin birlikte ne anlama
        geldiğini. Her satır iki ölçülen büyüklüğün farkıdır ve hesabı yanında
        yazar. Etiketler açıkça yazılmış bir eşikten gelir — okur katılmadığı yerde
        kendi çizgisini çekebilsin diye eşik de görünür.
      </p>
      <ul class="rejim-liste">
        {b.rejim.map((r: any) => (
          <li>
            <div class="rejim-ust">
              <span class="rejim-ad">{r.ad}</span>
              <span class="rejim-deger">
                {r.deger === null ? '—'
                  : r.birim === 'puan' ? sayi(r.deger, String(r.ad).includes('eğim') ? 2 : 1, true)
                  : r.birim === '%' ? yuzde(r.deger, 1)
                  : sayi(r.deger, 1)}
                {r.birim !== '%' && <span class="rejim-birim">{r.birim}</span>}
              </span>
              {r.etiket && <span class="rejim-etiket">{r.etiket}</span>}
            </div>
            <p class="rejim-hesap">{r.hesap}</p>
            {r.konum && <p class="rejim-konum">{r.konum}</p>}
            {r.aciklama && <p class="rejim-aciklama">{r.aciklama}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {b.piyasa.en_cok_hareket?.sigma?.length > 0 && (
    <section class="blok sigma-blok" id="olagandisi">
        <h2>{sigmaBaslik}</h2>
        <p class="alt-not">
          Hareketin büyüklüğü ile olağandışılığı ayrı şeylerdir. Aşağıdaki sıralama
          {sigmaHaftalik
            ? ' haftalık hareketi her enstrümanın kendi son yirmi haftalık oynaklığına bölerek kurulur: σ, o enstrüman için normal bir haftanın ölçüsüdür.'
            : ' günlük hareketi her enstrümanın kendi son yirmi günlük oynaklığına bölerek kurulur: σ, o enstrüman için normal bir günün ölçüsüdür.'}
          Böylece baz puanla yüzde aynı ölçekte kıyaslanır ve yüzdesi küçük ama kendi
          normaline göre büyük hareketler görünür olur.
          {b.piyasa.kapanis_seansi && (
            <> Ölçülen seans: <strong>{b.piyasa.kapanis_seansi}</strong>. Kapanıştan
            kapanışa hareket, arada hafta sonu ya da tatil olsa da tek seanslık
            risktir; σ bu yüzden boşluğa göre ölçeklenmez.</>
          )}
        </p>
        <SigmaSerit hareketler={b.piyasa.en_cok_hareket.sigma}
                    kip={b.piyasa.en_cok_hareket.sigma_kip} />
        <div class="p-kaydir">
          <table class="p-tablo">
            <caption class="gorunmez">En çok hareket edenler: değişim, oynaklık ve kaç standart sapma</caption>
            <thead>
              <tr><th scope="col">enstrüman</th><th class="sag" scope="col">{sigmaHaftalik ? '1 hafta' : '1 gün'}</th><th class="sag" scope="col">{sigmaHaftalik ? 'haftalık σ' : 'günlük σ'}</th><th class="sag" scope="col">kaç σ</th></tr>
            </thead>
            <tbody>
              {b.piyasa.en_cok_hareket.sigma.map((x: any) => (
                <tr>
                  <td class="p-ad">{x.ad}</td>
                  <td class:list={['sag', 'p-degisim', { arti: x.deger > 0, eksi: x.deger < 0 }]}>
                    {degisimli(x.deger, x.birim)}
                  </td>
                  <td class="sag p-son">{birimli(x.oynaklik, x.birim)}</td>
                  <td class:list={['sag', 'p-sigma', { olagandisi: Math.abs(x.sigma) >= 2 }]}>
                    {`${isaretli(x.sigma)}σ`}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
    </section>
  )}

  {b.one_cikanlar.length > 0 && (
    <section class="blok" id="one-cikanlar">
      <h2>Öne çıkanlar</h2>
      <ul class="olay-liste onemli">
        {b.one_cikanlar.map((o: any) => (
          <li>
            <span class="metin">{o.metin}</span>
            {o.aciklama && <span class="dipnot">{o.aciklama}</span>}
            <span class="kaynak-not"><a href={`/projeler/${o.hat}/`}>{ad(o.hat)}</a> · veri {tz(o.tarih)}{o.onceki_tarih ? ` (kıyas: ${tz(o.onceki_tarih)})` : ''}</span>
          </li>
        ))}
      </ul>
    </section>
  )}


  {b.sonuclar?.length > 0 && (
    <section class="blok sonuclar" id="sonuclar">
      <h2>Ne bekleniyordu, ne geldi</h2>
      <p class="alt-not">
        Vakti geçmiş takvim olayları. Beklenti sütunu o gün yayımladığımız
        beklentidir — sonradan güncellenmiş bir anket değil. Sürpriz yalnız sayısal
        bir beklenti varsa hesaplanır; serbest metin beklenti sayıya çevrilmez.
        Piyasa tepkisinin penceresi olayın yaşına göre seçilir ve hücrede yazar.
      </p>
      <ul class="sonuc-liste">
        {b.sonuclar.map((x: any) => (
          <li>
            <div class="sonuc-ust">
              <span class="sonuc-olay">{x.olay}</span>
              <span class="kaynak-not">{tz(x.tarih)}{x.yas_gun > 0 ? ` · ${x.yas_gun} gün önce` : ' · bugün'}</span>
            </div>
            {x.beklenti && <p class="sonuc-beklenti"><strong>Bekleniyordu.</strong> {x.beklenti}</p>}
            {x.durum === 'geldi' ? (
              <p class="sonuc-geldi">
                <strong>Geldi.</strong> {x.ad}: <span class="sonuc-sayi">{tr(x.gerceklesme)}{x.birim && ` ${x.birim}`}</span>
                {x.onceki !== null && x.onceki !== undefined && ` (önceki ${tr(x.onceki)})`}
                {x.surpriz !== null && x.surpriz !== undefined && (
                  <span class:list={['sonuc-surpriz', { arti: x.surpriz > 0, eksi: x.surpriz < 0 }]}>
                    {` sürpriz ${isaretli(x.surpriz)}`}
                  </span>
                )}
                <span class="kaynak-not"> · veri {tz(x.veri_tarihi)}</span>
              </p>
            ) : (
              <p class="sonuc-bekliyor">
                <strong>Henüz yok.</strong> {x.durum}
                {x.veri_tarihi && ` — elimizdeki son veri ${tz(x.veri_tarihi)}`}
              </p>
            )}
            {x.tepki?.kalemler?.length > 0 && (
              <p class="sonuc-tepki">
                <strong>Piyasa ({x.tepki.pencere}).</strong>{' '}
                {x.tepki.kalemler.map((t: any, i: number) => (
                  <>
                    {i > 0 && ' · '}
                    {t.ad}{' '}
                    <span class:list={['sonuc-hareket', { arti: t.deger > 0, eksi: t.deger < 0 }]}>
                      {degisimli(t.deger, t.birim)}
                    </span>
                    {t.sigma !== null && t.sigma !== undefined && ` (${isaretli(t.sigma)}σ)`}
                  </>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {takvimVar && (
    <section class="blok kritik-blok" id="takvim">
      <h2>Takvim</h2>
      <p class="alt-not">
        Önce birinci derece veriler geri sayımla, sonra izlenen diğer kayıtlar hafta
        hafta. Beklenti satırında “anket” piyasanın beklentisidir (TCMB Piyasa
        Katılımcıları Anketi); “model”, bu sitedeki hesabın kendi tahminidir.
      </p>

      {kritikler.length > 0 && (
        <ol class="kritik">
          {kritikler.map((k: any) => (
            <li>
              <span class="k-sayac">{k.kalan_gun === 0 ? 'bugün' : `+${k.kalan_gun} gün`}</span>
              <span class="k-govde">
                <span class="k-olay">{k.olay}</span>
                <span class="k-zaman">{k.tr_tarih} {k.gun}{k.saat ? ` · ${k.saat}` : ''} · {k.ulke}</span>
                {k.beklenti && <span class="k-beklenti">{k.beklenti}</span>}
              </span>
            </li>
          ))}
        </ol>
      )}

      {takvimGruplari.map((t: any) => (
        <div class="takvim-blok">
          <h3>{t.baslik} <span class="adet">{t.kayitlar.length}</span></h3>
          <table class="takvim">
            <caption class="gorunmez">{t.baslik}: tarih, saat, ülke ve olay</caption>
            <thead class="gorunmez">
              <tr><th scope="col">tarih</th><th scope="col">saat</th><th scope="col">ülke</th><th scope="col">olay</th></tr>
            </thead>
            <tbody>
              {t.kayitlar.map((k: any) => (
                <tr class:list={[{ kritik: k.onem === 1 }]}>
                  <td class="t-tarih">{k.tr_tarih}<span class="t-gun">{k.gun}</span></td>
                  <td class="t-saat">{k.saat || '—'}</td>
                  <td class="t-ulke">{k.ulke}</td>
                  <td class="t-olay">
                    {k.olay}
                    {k.kesinlik !== 'kesin' && <span class="damga">tarih kesinleşmedi</span>}
                    {k.beklenti && <span class="beklenti">{k.beklenti}</span>}
                    {k.not_ && <span class="dipnot">{k.not_}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>
  )}

  {b.gruplar.length > 0 && (
    <section class="blok" id="hat-hat">
      <h2>Hat hat değişim</h2>
      {b.gruplar.map((g: any) => (
        <div class="grup">
          <h3>{g.baslik}</h3>
          <ul class="olay-liste">
            {g.olaylar.map((o: any) => (
              <li class:list={[o.seviye]}>
                <span class="metin">{o.metin}</span>
                {o.aciklama && <span class="dipnot">{o.aciklama}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {(b.izleme?.acik?.length > 0 || b.izleme?.kapanan?.length > 0) && (
    <section class="blok soz" id="soz-defteri">
      <h2>
        Söz defteri
        <span class="adet">
          {b.izleme.karne.acik} açık · {b.izleme.karne.kapandi} kapandı
          {b.izleme.karne.vadesi_gecmis > 0 && ` · ${b.izleme.karne.vadesi_gecmis} vadesi geçti`}
        </span>
      </h2>
      <p class="alt-not">
        Bültenin verdiği sözlerin kaydı. "Şunu izleyeceğiz", "yarın belli olacak",
        "sebebi anlaşılmıyor" dendiği an buraya bir kayıt düşer ve vadesi geldiğinde
        hesabı verilir. Bir sabah notunun değeri, bir gün önce ne dediğinin
        hatırlanabilmesindedir.
        {b.izleme.karne.isabet_orani !== null && b.izleme.karne.isabet_orani !== undefined
          ? ` Notlanan ${b.izleme.karne.notlanan} kayıtta isabet: ${yuzde(Number(b.izleme.karne.isabet_orani), 0)}.`
          : ' Kapanan kayıtlar henüz tuttu/tutmadı diye notlanmadığı için isabet oranı verilmiyor.'}
      </p>

      {b.izleme.acik.length > 0 && (
        <>
          <h3>Açık sözler</h3>
          <ul class="soz-liste">
            {b.izleme.acik.map((k: any) => (
              <li class:list={{ gecikti: k.gun_kalan !== null && k.gun_kalan < 0 }}>
                <span class="soz-vade">
                  {k.gun_kalan === null
                    ? 'vadesiz'
                    : k.gun_kalan < 0
                      ? `${-k.gun_kalan} gün gecikti`
                      : k.gun_kalan === 0
                        ? 'bugün'
                        : `${k.gun_kalan} gün`}
                </span>
                <span class="soz-govde">
                  <strong class="soz-konu">{k.konu}</strong>
                  {k.soz && <span class="soz-metin">{k.soz}</span>}
                  {k.ne_bakilacak && <span class="soz-bakis">Ne bakılacak: {k.ne_bakilacak}</span>}
                  <span class="kaynak-not">açılış {tz(k.acilis)}{k.vade ? ` · vade ${tz(k.vade)}` : ''}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      )}

      {b.izleme.kapanan.length > 0 && (
        <>
          <h3>Yakın zamanda kapananlar</h3>
          <ul class="soz-liste kapanan">
            {b.izleme.kapanan.map((k: any) => (
              <li>
                <span class="soz-vade">{k.isabet || 'kapandı'}</span>
                <span class="soz-govde">
                  <strong class="soz-konu">{k.konu}</strong>
                  {k.soz && <span class="soz-metin">Ne demiştik: {k.soz}</span>}
                  {k.sonuc && <span class="soz-sonuc">Ne oldu: {k.sonuc}</span>}
                  <span class="kaynak-not">açılış {tz(k.acilis)}{k.vade ? ` · vade ${tz(k.vade)}` : ''}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}

  {b.haberler.bolumler && b.haberler.bolumler.length > 0 && (
    <section class="blok gundem" id="gundem">
      <h2>Gündem</h2>
      <p class="alt-not">
        {kip.gundemNot} Her bölümün altında haberin geldiği kaynaklar listelenir.
      </p>
      {b.haberler.bolumler.map((bol: any) => (
        <div class:list={['gundem-bolum', { kilit: bol.id === 'kilit' }]}>
          <h3>{bol.baslik}</h3>
          {bol.id === 'kilit' && (
            <p class="kilit-not">
              Piyasayı fiilen hareket ettiren gelişmeler: konu ağırlığı, kaynak itibarı
              ve kaç yayının haberi taşıdığı birlikte değerlendirilerek seçildi.
            </p>
          )}
          {b.gundem && b.gundem[bol.id] && (
            <div class="gundem-metin" set:html={b.gundem[bol.id]} />
          )}
          <ul class="haber-liste">
            {bol.maddeler.map((m: any) => (
              <li>
                <a href={m.baglanti} target="_blank" rel="noopener">{m.baslik}</a>
                {m.ozet && <span class="h-ozet">{m.ozet}</span>}
                <span class="kaynak-not">
                  {m.kaynak}
                  {bol.id === 'kilit' && m.kaynak_sayisi > 1 && ` · ${m.kaynak_sayisi} yayın taşıdı`}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {b.gundem_yazi_bolumleri && b.gundem_yazi_bolumleri.map((bol: any) => (
        b.gundem && b.gundem[bol.id] ? (
          <div class="gundem-bolum yazi-bolum">
            <h3>{bol.baslik}</h3>
            <div class="gundem-metin" set:html={b.gundem[bol.id]} />
          </div>
        ) : null
      ))}
      {b.haberler.okunamayan.length > 0 && (
        <p class="uyari">Okunamayan kaynak: {b.haberler.okunamayan.join(', ')}</p>
      )}
    </section>
  )}

  {b.temalar && b.temalar.temalar && b.temalar.temalar.length > 0 && (
    <section class="blok temalar" id="temalar">
      <h2>İzlenen temalar</h2>
      <p class="alt-not">
        Haftalarca süren ve birden çok varlığı aynı anda hareket ettiren anlatılar.
        Her temanın altında onu doğrulayacak ve çürütecek işaretler, izlenecek tek
        gösterge ve o temaya bağlı varlıkların güncel hareketi var.
      </p>
      {b.temalar.temalar.map((t: any) => (
        <div class:list={['tema', t.durum]}>
          <h3>
            {t.ad}
            <span class="tema-durum">{t.durum}</span>
          </h3>
          {t.gelisme && (
            <div class="tema-gelisme">
              <span class="etiket">Bu bültende</span>
              <div set:html={t.gelisme} />
            </div>
          )}
          <p class="tema-tez"><strong>Tez.</strong> {t.tez}</p>
          {t.son_gozlem && <p class="tema-gozlem"><strong>Son durum.</strong> {t.son_gozlem}</p>}
          {t.olculer && t.olculer.length > 0 && (
            <div class="p-kaydir">
              <table class="p-tablo">
                <caption class="gorunmez">{t.baslik ?? 'Tema'} ölçüleri: son değer, 1 hafta ve yılbaşından değişim</caption>
                <thead>
                  <tr><th scope="col">ölçü</th><th class="sag" scope="col">son</th><th class="sag" scope="col">1 hafta</th><th class="sag" scope="col">yılbaşından</th></tr>
                </thead>
                <tbody>
                  {t.olculer.map((r: any) => (
                    <tr>
                      <td class="p-ad">{r.ad}</td>
                      <td class="sag p-son">{tr(r.son)}<span class="p-birim">{r.birim}</span></td>
                      {['h1', 'ybb'].map((alan) => (
                        <td class:list={['sag', 'p-degisim', { arti: (r[alan] ?? 0) > 0, eksi: (r[alan] ?? 0) < 0 }]}>
                          {r[alan] === null || r[alan] === undefined
                            ? '—'
                            : degisimli(r[alan], r.degisim_birim)}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="tema-sutun">sütunlar: son · 1 hafta · yılbaşından</p>
            </div>
          )}
          <div class="tema-isaret">
            {t.dogrulayan && t.dogrulayan.length > 0 && (
              <div>
                <span class="isaret-baslik">Doğrularsa</span>
                <ul>{t.dogrulayan.map((x: string) => <li>{x}</li>)}</ul>
              </div>
            )}
            {t.curuten && t.curuten.length > 0 && (
              <div>
                <span class="isaret-baslik">Çürütürse</span>
                <ul>{t.curuten.map((x: string) => <li>{x}</li>)}</ul>
              </div>
            )}
          </div>
          {t.izlenecek_gosterge && (
            <p class="tema-gosterge">İzlenecek tek gösterge: <strong>{t.izlenecek_gosterge}</strong></p>
          )}
        </div>
      ))}
    </section>
  )}

  {b.veri_gunlugu.length > 0 && (
    <section class="blok" id="veri-gunlugu">
      <h2>Veri günlüğü</h2>
      <ul class="olay-liste kucuk">
        {b.veri_gunlugu.map((o: any) => (
          <li class:list={[o.seviye]}>
            <span class="metin">{o.metin}</span>
            {o.aciklama && <span class="dipnot">{o.aciklama}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {b.piyasa && b.piyasa.gruplar && b.piyasa.gruplar.length > 0 && (
    <section class="blok piyasa" id="piyasa">
      <h2>Piyasa fotoğrafı</h2>
      <p class="alt-not">
        Son kapanışlar ve değişimler. Fiyatlarda yüzde, tahvil getirilerinde baz puan.
        Piyasanın kapalı olduğu günlerde “1 gün” son iki işlem gününün farkıdır; her
        satırın tarihi kendi hücresinde yazar.
        {b.piyasa.kapanis_seansi && (
          <> Anlık görüntünün seansı: <strong>{b.piyasa.kapanis_seansi}</strong> —
          bülten daha sonraki bir günde okunuyorsa değişimler bu seansa aittir.</>
        )}
      </p>

      {b.piyasa.tr_faizleri && b.piyasa.tr_faizleri.length > 0 && (
        <div class="p-grup">
          <h3>Türk lirası faizleri ve DİBS eğrisi</h3>
          {b.grafikler?.egri && <EgriGrafik egri={b.grafikler.egri} />}
          <div class="p-kaydir">
          <table class="p-tablo tl">
            <caption class="gorunmez">Türk lirası faizleri ve DİBS eğrisi: büyüklük, değer, veri tarihi</caption>
            <tbody>
              {b.piyasa.tr_faizleri.map((t: any) => (
                <tr class:list={[{ gecersiz: t.gecerli === false }]}>
                  <td class="p-ad">
                    {t.ad}
                    {t.gecerli === false && <span class="p-bayrak">güncel değil</span>}
                    {t.aciklama && <span class="p-not">{t.aciklama}</span>}
                  </td>
                  <td class="p-son">{tr(t.deger, 2)}<span class="p-birim">{t.birim}</span></td>
                  <td class="p-tarih">{tz(t.tarih)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </div>
      )}

      {b.piyasa.gruplar.map((g: any) => (
        <div class="p-grup">
          <h3>{g.baslik}</h3>
          <div class="p-kaydir">
            <table class="p-tablo">
              <caption class="gorunmez">{g.baslik}: son değer ve dönemsel değişimler</caption>
              <thead>
                <tr>
                  <th scope="col">enstrüman</th><th class="sag" scope="col">son</th><th class="sag" scope="col">1 gün</th>
                  <th class="sag" scope="col">1 hafta</th><th class="sag" scope="col">1 ay</th><th class="sag" scope="col">yılbaşından</th>
                  <th class="sag" scope="col">52h aralık</th><th class="sag" scope="col">1 gün σ</th>
                </tr>
              </thead>
              <tbody>
                {g.satirlar.map((r: any) => (
                  <tr>
                    <td class="p-ad">
                      {r.ad}
                      {r.not && <span class="p-not">{r.not}</span>}
                      <span class="p-tarih-ic">{tz(r.tarih)}</span>
                    </td>
                    <td class="sag p-son">
                      {tr(r.son, r.ondalik)}
                      {r.birim && <span class="p-birim">{r.birim}</span>}
                    </td>
                    {['d1', 'h1', 'a1', 'ybb'].map((alan) => (
                      <td class:list={['sag', 'p-degisim', { arti: (r[alan] ?? 0) > 0, eksi: (r[alan] ?? 0) < 0 }]}>
                        {r[alan] === null || r[alan] === undefined
                          ? '—'
                          : degisimli(r[alan], r.degisim_birim)}
                      </td>
                    ))}
                    <td class="sag p-aralik">
                      {r.yil_konum !== null && r.yil_konum !== undefined ? yuzde(Number(r.yil_konum), 0) : '—'}
                    </td>
                    <td class:list={['sag', 'p-sigma', { olagandisi: Math.abs(r.d1_sigma ?? 0) >= 2 }]}>
                      {r.d1_sigma === null || r.d1_sigma === undefined
                        ? '—'
                        : `${isaretli(r.d1_sigma)}σ`}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      {b.piyasa.turetilmis && b.piyasa.turetilmis.length > 0 && (
        <div class="p-grup">
          <h3>Türev büyüklükler — eğri eğimleri, rafineri marjları, oranlar</h3>
          <div class="p-kaydir">
          <table class="p-tablo">
            <caption class="gorunmez">Türev büyüklükler: değer ve bir günlük değişim</caption>
            <tbody>
              {b.piyasa.turetilmis.map((t: any) => (
                <tr>
                  <td class="p-ad">{t.ad}<span class="p-not">{t.aciklama}</span></td>
                  <td class="sag p-son">{tr(t.deger)}<span class="p-birim">{t.birim}</span></td>
                  <td class:list={['sag', 'p-degisim', { arti: (t.d1 ?? 0) > 0, eksi: (t.d1 ?? 0) < 0 }]}>
                    {t.d1 === null || t.d1 === undefined ? '—' : isaretli(t.d1)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </div>
      )}

      {b.piyasa.eksik && b.piyasa.eksik.length > 0 && (
        <p class="uyari">Bu sayıda veri gelmeyen enstrüman: {b.piyasa.eksik.join(', ')}. Satırı yok; önceki sayıdaki kapanış geçerli sayılmaz.</p>
      )}

      {b.piyasa.kaynak_yok && b.piyasa.kaynak_yok.length > 0 && (
        <div class="p-grup kapsam">
          <h3>Kapsam dışı — bu bültenin ölçmediği büyüklükler</h3>
          <p class="alt-not">
            Bir fotoğrafın neyi göstermediğini söylemek, gösterdiği kadar önemlidir.
            Aşağıdakiler izlenmeye değer ama otomatik kaynağı bağlanmamış büyüklükler;
            bültendeki hiçbir yorum bunlara dayanmaz.
          </p>
          <ul class="kapsam-liste">
            {b.piyasa.kaynak_yok.map((k: any) => (
              typeof k === 'string' ? <li><strong>{k}</strong></li> : (
                <li>
                  <strong>{k.ad}</strong>
                  {k.neden && <span class="kapsam-neden">{k.neden}</span>}
                  {k.aday && <span class="kapsam-aday"><em>Aday kaynak.</em> {k.aday}</span>}
                  {k.engel && <span class="kapsam-engel"><em>Engel.</em> {k.engel}</span>}
                </li>
              )
            ))}
          </ul>
        </div>
      )}
    </section>
  )}
  <footer class="kunye">
    <p>
      Ölçüm {istanbulSaat(b.olusturma, 'tam')} İstanbul
      {(b.yazi_zamani || b.yorum_zamani) && ` · yazı ${istanbulSaat(b.yazi_zamani ?? b.yorum_zamani, 'tam') || tarihUzun(b.yorum_zamani)}`}
      {kayit && ` · Sayı ${kayit.sayiNo}`}
    </p>
    <p class="feragat">
      {FERAGAT} Bir büyüklüğün burada yer alması, önceden belirlenmiş bir değişim
      sınırını aştığı anlamına gelir — yorum değil, ölçüm bildirimidir.
    </p>
  </footer>
</article>

<style>
  .bulten { max-width: 74ch; }
  .ust { padding: 2.4rem 0 1.4rem; }
  .kicker { color: var(--claret); margin: 0 0 0.6rem; }
  .kicker-sayi { color: var(--ink-50); }
  .duzeltme-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .duzeltme-liste li { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 0.2rem 1rem; align-items: baseline; }
  .d-tarih { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-50); }
  .d-govde { display: grid; gap: 0.15rem; }
  .d-degerler { font-family: var(--font-mono); font-size: 0.9rem; }
  .d-degerler s { color: var(--ink-50); }
  .d-degerler b { color: var(--claret); }
  .d-sebep { font-size: 0.88rem; color: var(--ink-70); line-height: 1.45; }
  @media (max-width: 640px) { .duzeltme-liste li { grid-template-columns: 1fr; } }
  .ust h1 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 0.5rem; }
  .gun { font-size: 0.5em; color: var(--ink-70); font-variant: small-caps; letter-spacing: 0.05em; }
  .alt { color: var(--ink-70); max-width: 58ch; }

  .yorum {
    border-left: 3px solid var(--claret);
    padding: 0.9rem 0 0.9rem 1.1rem;
    margin: 1.6rem 0 2rem;
    background: color-mix(in srgb, var(--claret) 4%, transparent);
  }
  .yorum .etiket { color: var(--claret); margin: 0 0 0.4rem; }


  .ozet { margin: 0 0 2.4rem; display: grid; gap: 1.3rem; }
  .ozet-parca h2 {
    font-family: var(--font-display); font-size: 1.12rem; margin: 0 0 0.4rem;
  }
  .ozet-parca p { margin: 0; line-height: 1.62; }

  .gosterge-serit {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 0.1rem;
    border: 1px solid var(--ink-30);
    background: var(--ink-30);
    margin: 1.8rem 0 2.4rem;
  }
  .gosterge { background: var(--paper); padding: 0.7rem 0.8rem; display: grid; gap: 0.15rem; }
  .g-ad { font-size: 0.72rem; color: var(--ink-70); line-height: 1.25; }
  .g-deger { font-family: var(--font-mono); font-size: 1.22rem; font-weight: 500; }
  .g-birim { font-size: 0.6em; color: var(--ink-70); margin-left: 0.2em; }
  .g-fark { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-70); }
  .g-fark.arti { color: var(--pozitif); }
  .g-fark.eksi { color: var(--claret); }
  .g-tarih { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-60); }
  .g-kiyas { display: block; font-size: 0.92em; font-style: italic; }

  .blok { margin: 2.6rem 0; }
  .blok h2 {
    font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 0.9rem;
    padding-bottom: 0.35rem; border-bottom: 2px solid var(--ink);
  }
  .blok h3 { font-size: 0.95rem; margin: 1.3rem 0 0.5rem; color: var(--ink-70); font-variant: small-caps; letter-spacing: 0.06em; }
  .adet { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-30); }

