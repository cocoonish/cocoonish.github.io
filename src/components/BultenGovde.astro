            {/* "Son durum" gelişmenin yedeğidir: ikisi aynı rakamları taşıyordu
                (27.09'da dört temanın dördünde). */}
            {!t.gelisme && t.son_gozlem && <p class="tema-gozlem"><strong>Son durum.</strong> {t.son_gozlem}</p>}
          </>
        );
        // GÜNCELLENMEYEN TEMA GÜNLÜK SAYIDA TEK SATIR (01.10.2026): tez, ölçü
        // tablosu, işaretler ve gösterge her gün açık basılıyordu (622 kelime,
        // %79–81 tekrar) ve katlı anlatının 27.09 sayılarıyla yanındaki
        // tablonun 30.09 sayıları aynı kutuda iki ayrı günü gösteriyordu.
        // Haftalık sayıda ve güncellendiği gün tema tam basılır.
        const kompakt = !guncel && !b.haftalik && !!t.son_guncelleme;
        const icerik = (
          <>
            <p class="tema-tez"><strong>Tez.</strong> {t.tez}</p>
            {guncel ? anlati : (t.gelisme || t.son_gozlem) && (
              <details class="tema-kat">
                <summary>Anlatı · son güncelleme {tz(t.son_guncelleme)}</summary>
                {anlati}
              </details>
            )}
            {t.olculer && t.olculer.length > 0 && (
              <div class="p-kaydir" tabindex="0" role="region" aria-label="Kaydırılabilir tablo" data-kaydir>
                <table class="p-tablo p-tema">
                  <caption class="gorunmez">{t.baslik ?? 'Tema'} ölçüleri: son değer, 1 hafta ve yılbaşından değişim</caption>
                  <thead>
                    <tr><th scope="col">Ölçü</th><th class="sag" scope="col">Son</th><th class="sag" scope="col">1 hafta</th><th class="sag" scope="col">Yılbaşından</th></tr>
                  </thead>
                  <tbody>
                    {t.olculer.map((r: any) => (
                      <tr>
                        <td class="p-ad">{r.ad}</td>
                        <td class="sag p-son">{sonYaz(r).govde}{sonYaz(r).birim && <span class="p-birim">{sonYaz(r).birim}</span>}</td>
                        {['h1', 'ybb'].map((alan) => (
                          <td class:list={['sag', 'p-degisim', { arti: (r[alan] ?? 0) > 0, eksi: (r[alan] ?? 0) < 0 }]}>
                            {r[alan] === null || r[alan] === undefined
                              ? '—'
                              : degisimli(r[alan], r.degisim_birim)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            <div class="tema-isaret">
              {t.dogrulayan && t.dogrulayan.length > 0 && (
                <div>
                  <span class="isaret-baslik">Doğrularsa</span>
                  <ul>{t.dogrulayan.map((x: string) => <li>{x}</li>)}</ul>
                </div>
              )}
              {t.curuten && t.curuten.length > 0 && (
                <div>
                  <span class="isaret-baslik">Çürütürse</span>
                  <ul>{t.curuten.map((x: string) => <li>{x}</li>)}</ul>
                </div>
              )}
            </div>
            {t.izlenecek_gosterge && (
              <p class="tema-gosterge">İzlenecek tek gösterge: <strong>{t.izlenecek_gosterge}</strong></p>
            )}
  
          </>
        );
        return kompakt ? (
        <div class:list={['tema', 'tema-kompakt', t.durum]}>
          <h3>
            {t.ad}
            <span class="tema-durum">{t.durum}</span>
            <span class="adet">son güncelleme {tz(t.son_guncelleme)}</span>
          </h3>
          <details class="tema-kat">
            <summary>Tez, ölçüler ve işaretler</summary>
            {icerik}
          </details>
        </div>
        ) : (
        <div class:list={['tema', t.durum]}>
          <h3>
            {t.ad}
            <span class="tema-durum">{t.durum}</span>
          </h3>
          {icerik}
        </div>
        );
      })}
    </section>
  )}

  {b.haberler.bolumler && b.haberler.bolumler.length > 0 && (
    <section class="blok gundem" id="gundem">
      <h2>{bicim3 ? 'Haber akışı' : 'Gündem'}</h2>
      <p class="alt-not">{bicim3
        ? 'Yazının dayandığı kaynak haberler, konuya göre; başlıklar kaynağın kendi dilinde.'
        : kip.gundemNot}</p>
      {haberBolumleri.map((bol: any) => (
        <div class:list={['gundem-bolum', { kilit: bol.id === 'kilit' }]}>
          <h3>{bol.baslik}</h3>
          {bol.id === 'kilit' && !bicim3 && (
            <p class="kilit-not">
              Piyasayı fiilen hareket ettiren gelişmeler: konu ağırlığı, kaynak itibarı
              ve kaç yayının haberi taşıdığı birlikte değerlendirilerek seçildi.
            </p>
          )}
          {b.gundem && b.gundem[bol.id] && (
            <div class="gundem-metin" set:html={sayiBag(String(b.gundem[bol.id]))} />
          )}
          {/* KAYNAK HABERLER KATLANIR. Gündem sayfanın yarısına yakınıydı (390
              pikselde %45) ve bunun çoğu ham haber listesiydi; bölümün yazılı
              özeti zaten o listeden kuruluyor. Kilit gelişmeler açık kalır. */}
          {bol.id === 'kilit' && !bicim3 ? (
            <ul class="haber-liste">
              {bol.maddeler.map((m: any) => (
                <li lang={haberAyir(m).lang}>
                  <a href={m.baglanti} target="_blank" rel="noopener">{haberAyir(m).baslik}</a>
                  {m.ozet && <span class="h-ozet">{m.ozet}</span>}
                  <span class="kaynak-not" lang="tr">
                    {haberAyir(m).kaynak}
                    {m.kaynak_sayisi > 1 && ` · ${m.kaynak_sayisi} yayın taşıdı`}
                  </span>
                </li>
              ))}
            </ul>
          ) : bol.maddeler.length > 0 && (
            <details class="haber-kat" open={!bicim3 && !(b.gundem && b.gundem[bol.id])}>
              <summary>Kaynak haberler · {bol.maddeler.length}</summary>
              <ul class="haber-liste">
                {bol.maddeler.map((m: any) => (
                  <li lang={haberAyir(m).lang}>
                    <a href={m.baglanti} target="_blank" rel="noopener">{haberAyir(m).baslik}</a>
                    {m.ozet && <span class="h-ozet">{m.ozet}</span>}
                    <span class="kaynak-not" lang="tr">{haberAyir(m).kaynak}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      ))}
      {!bicim3 && gundemYetim.map((g) => (
        <div class="gundem-bolum yazi-bolum">
          <h3>{g.baslik}</h3>
          <div class="gundem-metin" set:html={sayiBag(String(b.gundem[g.id]))} />
        </div>
      ))}
      {!bicim3 && b.gundem_yazi_bolumleri && b.gundem_yazi_bolumleri.map((bol: any) => (
        b.gundem && b.gundem[bol.id] ? (
          <div class="gundem-bolum yazi-bolum">
            <h3>{bol.baslik}</h3>
            <div class="gundem-metin" set:html={sayiBag(String(b.gundem[bol.id]))} />
          </div>
        ) : null
      ))}
      {/* "Okunamayan kaynak: …" taramanın beslemesinin durumudur, okurun kararını
          değiştirmez; denetim uyarısında kalır (01.10.2026 incelemesi). */}
    </section>
  )}

  {b.veri_gunlugu.length > 0 && (
    <section class="blok" id="veri-gunlugu">
      <h2>Veri günlüğü</h2>
      {/* Gecikme satırları (dikkat) açık ve üstte; "yeni veri" satırları tek
          özet satırının altında katlı — dokuz satırın sekizi her sabah aynı
          biçimde "hat güncellendi" diyordu. */}
      {(() => {
        const dikkat = b.veri_gunlugu.filter((o: any) => o?.seviye === 'dikkat' || o?.seviye === 'onemli');
        const diger = b.veri_gunlugu.filter((o: any) => !(o?.seviye === 'dikkat' || o?.seviye === 'onemli'));
        const satir = (o: any) => (
          <li class:list={[o.seviye]}>
            <span class="metin">{o.metin}</span>
            {o.aciklama && <span class="dipnot">{o.aciklama}</span>}
          </li>
        );
        return (
          <>
            {dikkat.length > 0 && <ul class="olay-liste kucuk">{dikkat.map(satir)}</ul>}
            {diger.length > 0 && (
              <details class="haber-kat">
                <summary>Güncelleme kayıtları · {diger.length}</summary>
                <ul class="olay-liste kucuk">{diger.map(satir)}</ul>
              </details>
            )}
          </>
        );
      })()}
    </section>
  )}

  {/* KAPSAM NOTU sayfanın sonunda tek satır: ne ölçülmediği adıyla, neden
      önemli olduğu katta. Okura yalnız ad ve neden gider; kaydın "aday
      kaynak" ve "engel" alanları veri hattının yapılacaklar listesiydi
      ("çekme ve önbellek yolu yazılacak") ve her sayıda okura basılıyordu. */}
  {/* Günlük sayıda basılmaz (01.10.2026): metin her sabah birebir aynıydı;
      haftalık sayıda ve hakkında sayfasında durur. */}
  {b.haftalik && b.piyasa.kaynak_yok && b.piyasa.kaynak_yok.length > 0 && (
    <section class="blok kapsam" id="kapsam">
      <p class="kapsam-satir">
        <strong>Bu bültenin ölçmediği büyüklükler:</strong>{' '}
        {b.piyasa.kaynak_yok.map((k: any) => (typeof k === 'string' ? k : k.ad)).join(' · ')}.
        Bültendeki hiçbir yorum bunlara dayanmaz.
      </p>
      {b.piyasa.kaynak_yok.some((k: any) => typeof k !== 'string' && k.neden) && (
        <details class="yontem"><summary>Neden önemliler</summary>
          <dl class="kapsam-liste">
            {b.piyasa.kaynak_yok.filter((k: any) => typeof k !== 'string' && k.neden).map((k: any) => (
              <>
                <dt>{k.ad}</dt>
                <dd>{k.neden}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
    </section>
  )}

  <footer class="kunye">
    <p>
      Ölçüm {istanbulSaat(b.olusturma, 'tam')} İstanbul
      {(b.yazi_zamani || b.yorum_zamani) && ` · yazı ${yaziDamga ? istanbulSaat(yaziDamga, 'tam') : tarihUzun(istanbulIsoGun(b.yorum_zamani ?? b.yazi_zamani))}`}
      {sonDuzenleme && ` · son düzenleme ${istanbulSaat(sonDuzenleme, 'tam')}`}
      {kayit && ` · Sayı ${kayit.sayiNo}`}
      {enstruman > 0 && ` · ${enstruman} enstrüman`}
      {haberSayisi > 0 && ` · ${haberSayisi} taranan haber`}
    </p>
    {/* Feragatın ikinci cümlesi "burada yer almak = eşik aşıldı" diyordu ve
        30.09'da 12 ölçüm maddesinin yalnız 2'si için doğruydu: maddeler ya
        takvimli bir yayımla, ya eşikle, ya sıralamayla girer. */}
    <p class="feragat">
      {FERAGAT} Ölçülen bölümlerde bir büyüklük üç sebepten biriyle yer alır:
      takvimli bir yayımı geldi, tanımlı bir eşiği aştı ya da kendi oynaklığına
      göre en büyük hareketler arasında. Bunlar ölçüm bildirimidir, yorum değil.
    </p>
  </footer>
  </div>
  </div>
</article>

