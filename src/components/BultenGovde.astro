                <tr class:list={[{ kritik: k.onem === 1 }]}>
                  <td class="t-saat">{k.saat || '—'}</td>
                  <td class="t-ulke">{k.ulke}</td>
                  <td class="t-olay">
                    <span title={k.resmi_ad || undefined}>{k.olay}</span>
                    {k.kesinlik && k.kesinlik !== 'kesin' && <span class="damga">tarih kesinleşmedi</span>}
                    {k.beklenti && <span class="beklenti">{k.beklenti}</span>}
                    {k.not_ && <span class="dipnot">{k.not_}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  )}

  {pazarDuzeni && (
    <section class="blok sigma-blok" id="hafta-hareket">
      <h2>{haftaBaslik}</h2>
      <p class="alt-not">Haftalık değişim, her enstrümanın kendi son yirmi haftalık
      oynaklığına (σ) bölünerek sıralandı (en büyük {haftaHareket.length} hareket).
      {haftaAsan > 0
        ? <><strong>{haftaAsan}</strong> satır {sayi(OLAGANDISI_SIGMA, 0)}σ eşiğini aşıyor ve işaretli.</>
        : <>Hiçbir satır {sayi(OLAGANDISI_SIGMA, 0)}σ eşiğini aşmıyor: hafta, oynaklığına göre sıradan.</>}
      {b.piyasa.kapanis_seansi && <> Ölçülen seans: <strong>{anaSeans ? seansEtiketi(anaSeans) : b.piyasa.kapanis_seansi}</strong>.</>}</p>
      <div class="p-kaydir" tabindex="0" role="region" aria-label="Kaydırılabilir tablo" data-kaydir>
        <table class="p-tablo">
          <caption class="gorunmez">Haftanın hareketleri: son değer, haftalık değişim, haftalık σ ve kaç σ</caption>
          <thead>
            <tr><th scope="col">Enstrüman</th><th class="sag" scope="col">Son</th><th class="sag" scope="col">1 hafta</th><th class="sag" scope="col">Haftalık σ</th><th class="sag" scope="col">Kaç σ</th></tr>
          </thead>
          <tbody>
            {haftaHareket.map((r: any) => (
              <tr>
                <td class="p-ad">
                  {r.ad}
                  <span class="p-not">{r.grupBaslik}{r.tarih !== anaSeans && r.tarih ? ` · ${tz(r.tarih)}` : ''}</span>
                </td>
                <td class="sag p-son">{sonYaz(r).govde}{sonYaz(r).birim && <span class="p-birim">{sonYaz(r).birim}</span>}</td>
                <td class:list={['sag', 'p-degisim', { arti: r.h1 > 0, eksi: r.h1 < 0 }]}>
                  {degisimli(r.h1, r.degisim_birim)}
                </td>
                <td class="sag p-son">{birimli(r.sigma_hafta, r.degisim_birim, OYNAKLIK_HANE)}</td>
                <td class:list={['sag', 'p-sigma', { olagandisi: Math.abs(r.h1_sigma) >= OLAGANDISI_SIGMA }]}>
                  {sigmaYaz(r.h1_sigma)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {/* Pazar düzeninde olağandışı bölümü yok; haber tonu burada basılır —
          yoksa ölçülen olay sayfaya ulaşmaz (ölçüt 25 ENGEL, 01.10.2026 incelemesi). */}
      {haberTonu.length > 0 && (
        <>
          <h3>Haber tonu</h3>
          <ul class="olay-liste">
            {haberTonu.map((o: any) => (
              <li class:list={[o.seviye]}><span class="metin">{o.metin}</span></li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}

  {onumuzdekiHafta.length > 0 && (
    <section class="blok kritik-blok" id="onumuzdeki-hafta">
