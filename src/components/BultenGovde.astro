          {g.kiyas && g.kiyas !== 'son yayım' && <span class="g-kiyas">{g.kiyas}</span>}
        </span>
        {g.canli && istanbulSaat(g.canli.zaman) && (
          <span class="g-canli" title="Ölçüm anının son kotasyonu; kapanış ve fark kapanmış seanstan ölçülür">
            {istanbulSaat(g.canli.zaman)} TSİ: {sayi(Number(g.canli.deger), g.ondalik ?? 2)}
          </span>
