        <p class="alt-not">{haftaTabloSatir > 0
          ? 'Bir önceki haftalık sayıdan bu yana cümleye dönüşen bir değişim yok; güncellenen seriler aşağıdaki tabloda.'
          : b.haftalik
            ? 'Bir önceki haftalık sayıdan bu yana izlenen göstergelerde duyurulacak bir yayım yok.'
            : 'Bir önceki sayıdan bu yana izlenen göstergelerde duyurulacak bir yayım yok.'}</p>
      )}
      {gruplarKalan.map((g: any) => (
        <div class="grup">
          <h3>{g.baslik}</h3>
          <ul class="olay-liste">
            {g.olaylar.map((o: any) => (
              <li class:list={[o.seviye]}>
                <span class="metin">{o.metin}</span>
                {o.aciklama && !bicim3 && <span class="dipnot">{o.aciklama}</span>}
