      <p class="fk-kunye">{fikirKunye}</p>
      {TRADELER && <p class="fk-defter">Bütün tradeler ve karnesi: <a href={TRADELER.href}>{TRADELER.ad}</a></p>}
      <p class="fk-uyari">{FIKIR_UYARI}</p>
      {fikirKarne.hata && (
        <p class="uyari">Önceki sayılarda açılan fikirlerin karnesi bu ölçümde kurulamadı.</p>
      )}

      {fikirler.length > 0 && (
        <>
          <h3>Bu sayıda açılan fikirler</h3>
          <div class="fk-liste">
            {fikirler.map((f: any) => {
              const olculemez = f.tur === 'olculemez';
              const opsiyon = f.tur === 'opsiyon';
              const kalan = gunFarki(b.tarih, f.ufuk);
              const dayanak = fkDayanak(f.dayanak);
              const ust = [
                FIKIR_SINIF[String(f.sinif)] ?? '',
                FIKIR_TUR[String(f.tur)] ?? '',
                f.ufuk ? `${opsiyon ? 'vade' : 'ufuk'} ${tz(f.ufuk)}${kalan !== null ? ` (${kalanYaz(kalan)})` : ''}` : '',
                String(f.senaryo ?? '').trim(),
              ].filter(Boolean);
              return (
                <article class="fk-kart">
                  <h3 class="fk-baslik" id={`fikir-${f.kimlik}`}>{f.baslik}</h3>
                  <p class="fk-ust">
                    {ust.join(' · ')}
                    {dayanak && <>{ust.length > 0 && ' · '}Dayanak: <a href={dayanak.href}>{dayanak.ad}</a></>}
                  </p>
                  {f.yapi_metni && <p class="fk-satir"><span class="fk-et">Yapı:</span> {f.yapi_metni}</p>}
                  {f.yon_metni && <p class="fk-satir"><span class="fk-et">Kazanç yönü:</span> {f.yon_metni}</p>}
                  {olculemez ? (
                    <p class="fk-satir fk-olculemez">Karnesi tutulmuyor: {noktali(f.olculemez_sebep)}</p>
                  ) : (
                    <dl class="fk-seviye" aria-label={`${f.baslik}: seviyeler`}>
                      {opsiyon ? (
                        <>
                          <div><dt>Dayanak referansı</dt><dd>{fkSeviye(f.giris, f)}{f.giris_tarih && <span class="fk-alt">{tz(f.giris_tarih)} kapanışı</span>}</dd></div>
                          <div><dt>Kullanım fiyatı</dt><dd>{fkKullanimParca(f).parca.map((x: string, i: number) => <>{i > 0 && fkKullanimParca(f).ayrac}<span class="nb">{x}</span></>)}</dd></div>
                          <div><dt>Vade</dt><dd>{tz(f.opsiyon?.vade ?? f.ufuk)}</dd></div>
                          <div><dt>Prim</dt><dd class="fk-dd-metin">ölçülmedi</dd></div>
                        </>
                      ) : (
                        <>
                          <div><dt>Referans</dt><dd>{fkSeviye(f.giris, f)}{f.giris_tarih && <span class="fk-alt">{tz(f.giris_tarih)} kapanışı</span>}</dd></div>
                          <div><dt>Hedef</dt><dd>{fkSeviye(f.hedef, f)}</dd></div>
                          <div><dt>Stop</dt><dd>{fkSeviye(f.stop, f)}</dd></div>
                          <div><dt>Getiri/risk</dt><dd>{sayiMi(f.getiri_risk) ? sayi(f.getiri_risk, 2) : '—'}</dd></div>
                        </>
                      )}
                    </dl>
                  )}
                  {!olculemez && f.enstruman && (
                    <p class="fk-satir fk-vekil">Enstrüman: {f.enstruman} — karne {f.yapi_metni} ile vekil olarak tutulur.</p>
                  )}
                  {f.gerekce && <p class="fk-metin"><span class="fk-et">Gerekçe.</span> <Fragment set:html={duzNb(f.gerekce)} /></p>}
                  {f.ne_bozar && <p class="fk-metin"><span class="fk-et">Görüşü ne bozar.</span> <Fragment set:html={duzNb(f.ne_bozar)} /></p>}
                </article>
              );
            })}
          </div>
        </>
      )}

      {fikirAcik.length > 0 && (
        <>
          <h3>Açık fikirlerin karnesi</h3>
          <div class="p-kaydir" tabindex="0" role="region" aria-label="Açık fikirlerin karnesi: kaydırılabilir tablo" data-kaydir>
            <table class="p-tablo fk-karne">
              <caption class="gorunmez">Açık fikirler: fikir, fiili giriş ve son değer, sonuç, hedef ve stop, kalan gün</caption>
              <thead><tr>
                <th scope="col">Fikir</th>
                <th scope="col" class="sag">Giriş → son</th>
                <th scope="col" class="sag">Sonuç</th>
                <th scope="col" class="sag">Hedef · stop</th>
                <th scope="col" class="sag">Kalan</th>
              </tr></thead>
              <tbody>
                {fikirAcik.map((k: any) => {
                  const olculemez = k.durum === 'olculemez';
                  const opsiyon = k.tur === 'opsiyon';
                  const bag = fikirAcildigi.get(String(k.kimlik));
                  return (
                    <tr>
                      <td class="p-ad">
                        {bag ? <a href={bag}>{k.baslik}</a> : <span>{k.baslik}</span>}
                        <span class="p-tarih-ic">açılış {gunAy(k.acilis)}{k.yapi_metni && !olculemez ? ` · ${k.yapi_metni}` : ''}</span>
                        {k.degerlenmedi && <span class="p-not p-not-uyari">Bu ölçümde değerlenmedi: {noktali(k.degerlenmedi)}</span>}
                        {(k.cikis_bekleniyor || fikirKapatKimlik.has(String(k.kimlik))) && <span class="p-not p-not-uyari">Çıkış emri verildi; çıkış, emrin yayımından sonraki ilk kapanış.</span>}
                        {k.ufuk_bekleniyor && <span class="p-not">{UFUK_BEKLENIYOR_NOT}</span>}
                        {k.tasima_olculemedi && <span class="p-not p-not-uyari">{tasimaOlculemediNotu(false)}</span>}
                        {Array.isArray(k.devir) && k.devir.length > 0 && (
                          <span class="p-not">son değer giriş kontratı cinsinden (devir {k.devir.map((d: string) => gunAy(d)).join(', ')})</span>
                        )}
                      </td>
                      {olculemez ? (
                        <>
                          <td class="sag">—</td>
                          <td class="sag fk-not-hucre">karnesi tutulmuyor</td>
                          <td class="sag">—</td>
                        </>
                      ) : (
                        <>
                          {/* Sonuç FİİLİ GİRİŞE göredir (yayımdan sonraki ilk kapanış); okur
                              sonucu bu iki sayıdan yeniden kurabilmeli. Referans — yazarın
                              gördüğü bir önceki seansın kapanışı — alt satırda durur. */}
                          <td class="sag p-son fk-sar">
                            {sayiMi(k.giris_fiili)
                              ? <><span class="nb">{fkSeviye(k.giris_fiili, k)}</span> → <span class="nb">{fkSeviye(k.son, k)}</span>
                                  <span class="p-tarih-ic"><span class="nb">giriş {gunAy(k.giris_fiili_tarih)}</span>{k.son_tarih && <> · <span class="nb">son {gunAy(k.son_tarih)}</span></>}</span></>
                              : k.degerlenmedi
                                ? <><span class="fk-not-hucre">değerlenmedi</span><span class="p-tarih-ic">bu ölçümde</span></>
                                : <><span class="fk-not-hucre">{GIRIS_BEKLENIYOR_KISA}</span><span class="p-tarih-ic">{GIRIS_BEKLENIYOR_NE}</span></>}
                            {sayiMi(k.giris) && <span class="p-tarih-ic">referans {fkSeviye(k.giris, k)}{k.giris_tarih ? ` (${gunAy(k.giris_tarih)})` : ''}</span>}
                          </td>
                          {opsiyon
                            ? <td class="sag p-son">{sayiMi(k.ic_deger) ? `içsel ${yuzde(k.ic_deger, 2)}` : '—'}<span class="p-tarih-ic">prim ve zaman değeri hariç</span></td>
                            : <td class="sag">
                                <span class:list={['p-degisim', fkYon(k.sonuc)]}>{fkSonuc(k.sonuc, k)}</span>
                                {fkR(k.sonuc_r) && <span class="p-tarih-ic">{fkR(k.sonuc_r)}</span>}
                                {tasimaAyrisimi(k) && <span class="p-tarih-ic">spot {tasimaAyrisimi(k)?.spot} · taşıma {tasimaAyrisimi(k)?.tasima}</span>}
                              </td>}
                          {opsiyon
                            ? <td class="sag p-son fk-sar">{fkKullanimParca(k).parca.map((x: string, i: number) => <>{i > 0 && fkKullanimParca(k).ayrac}<span class="nb">{x}</span></>)}<span class="p-tarih-ic">kullanım fiyatı</span></td>
                            : <td class="sag p-son">{fkSeviye(k.hedef, k)}<span class="p-tarih-ic">stop {fkSeviye(k.stop, k)}</span></td>}
                        </>
                      )}
                      <td class="sag">{kalanYaz(k.kalan_gun)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}

      {fikirKapanan.length > 0 && (
        <>
          <h3>{fikirPencere !== null ? `Son ${fikirPencere} günde kapananlar` : 'Yeni kapananlar'}</h3>
          <div class="p-kaydir" tabindex="0" role="region" aria-label="Kapanan fikirler: kaydırılabilir tablo" data-kaydir>
            <table class="p-tablo fk-karne">
              <caption class="gorunmez">Kapanan fikirler: fikir, sonuç durumu, kapanış günü, sonuç</caption>
              <thead><tr>
                <th scope="col">Fikir</th>
                <th scope="col">Durum</th>
                <th scope="col" class="sag">Kapanış</th>
                <th scope="col" class="sag">Sonuç</th>
              </tr></thead>
              <tbody>
                {fikirKapanan.map((k: any) => {
                  const opsiyon = k.tur === 'opsiyon';
                  const sonucsuz = FIKIR_SONUCSUZ.has(String(k.durum)) || k.tur === 'olculemez';
                  const bag = fikirAcildigi.get(String(k.kimlik));
                  return (
                    <tr>
                      <td class="p-ad">
                        {bag ? <a href={bag}>{k.baslik}</a> : <span>{k.baslik}</span>}
                        <span class="p-tarih-ic">açılış {gunAy(k.acilis)}{k.yapi_metni && k.tur !== 'olculemez' ? ` · ${k.yapi_metni}` : ''}</span>
                        {Array.isArray(k.devir) && k.devir.length > 0 && (
                          <span class="p-not">son değer giriş kontratı cinsinden (devir {k.devir.map((d: string) => gunAy(d)).join(', ')})</span>
                        )}
                      </td>
                      <td>{FIKIR_DURUM[String(k.durum)] ?? '—'}</td>
                      <td class="sag p-son">{gunAy(k.kapanis_tarih) || '—'}</td>
                      <td class="sag">
                        {sonucsuz ? '—' : opsiyon
                          ? <><span class="p-son">{sayiMi(k.sonuc) ? yuzde(k.sonuc, 2) : '—'}</span><span class="p-tarih-ic">{opsiyonSonucNotu(k)}</span></>
                          : sayiMi(k.sonuc)
                            ? <span class:list={['p-degisim', fkYon(k.sonuc)]}>{fkSonuc(k.sonuc, k)}</span>
                            : '—'}
                        {!sonucsuz && !opsiyon && fkR(k.sonuc_r) && <span class="p-tarih-ic">{fkR(k.sonuc_r)}</span>}
                        {!sonucsuz && tasimaAyrisimi(k) && <span class="p-tarih-ic">spot {tasimaAyrisimi(k)?.spot} · taşıma {tasimaAyrisimi(k)?.tasima}</span>}
                        {!sonucsuz && sayiMi(k.giris_fiili) && sayiMi(k.son) && (
                          <span class="p-tarih-ic">giriş {fkSeviye(k.giris_fiili, k)} → çıkış {fkSeviye(k.son, k)}</span>
                        )}
                        {k.durum === 'giriste_gecersiz' && sayiMi(k.son) && (
                          <span class="p-tarih-ic">giriş kapanışı {fkSeviye(k.son, k)}: seviyelerin ötesinde</span>
                        )}
                        {k.durum === 'geri_cekildi' && k.giris_oncesi && <span class="p-tarih-ic">çıkış emri girişle aynı kapanışa düştü; sonuç yok</span>}
                        {k.tasima_olculemedi && <span class="p-not p-not-uyari">{tasimaOlculemediNotu(true)}</span>}
                        {k.not && <span class="p-tarih-ic">{k.not}</span>}
                        {k.durum === 'geri_cekildi' && k.sebep && <span class="p-not fk-sebep">{noktali(k.sebep)}</span>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}

      {fikirKapat.length > 0 && (
        <>
          <h3>Bu sayıda verilen çıkış emirleri</h3>
          <ul class="fk-emir">
            {fikirKapat.map((x: any) => {
              const bag = fikirAcildigi.get(String(x.kimlik));
              const tr = fikirTrade(x.kimlik);
              const ad = fikirBaslik(x.kimlik);
              const ref = sayiMi(x.cikis) && tr ? `Referans çıkış ${fkSeviye(x.cikis, tr.f)}${x.cikis_tarih ? ` (${tz(x.cikis_tarih)} kapanışı)` : ''}; ` : '';
              return (
                <li>{ad ? (bag ? <a href={bag}>{ad}</a> : <span>{ad}</span>) : <span>açık bir fikir</span>}{x.sebep ? `: ${noktali(x.sebep)}` : '.'} {ref ? `${ref}çıkış` : 'Çıkış'} bu sayının yayımından sonraki ilk kapanıştır.</li>
              );
            })}
          </ul>
        </>
      )}

      {sayiMi(fikirSayim.olculen_kapanan) && fikirSayim.olculen_kapanan > 0 && (
        <p class="fk-sayim">
          Şimdiye kadar ölçülen sonuçla kapanan fikir: {fikirSayim.olculen_kapanan}; kazançla
          kapanan: {sayiMi(fikirSayim.kazanan) ? fikirSayim.kazanan : '—'}.
          {sayiMi(fikirSayim.n_r) && fikirSayim.n_r > 0 && sayiMi(fikirSayim.ortalama_r) &&
            ` Stop mesafesi cinsinden ortalama ${fkR(fikirSayim.ortalama_r)} (${fikirSayim.n_r} fikir).`}
          {' '}Opsiyon fikirleri (prim ölçülmediği için), karnesi tutulmayan fikirler, girişle aynı kapanışta geri
          çekilen fikirler ve taşıması ölçülemeyen dolar/TL sonucu bu sayıma girmez.
        </p>
      )}

      <details class="yontem fk-yontem"><summary>Karnenin yöntemi</summary>
        <p>{FIKIR_YONTEM}</p>
      </details>
    </section>
  ) : (
    <section class:list={['blok', 'yazi-bolumu', `yb-${x.id}`]} id={`y-${x.id}`}>
      <h2>{x.baslik}</h2>
      {x.id === 'karne' && haftaKarne && (haftaKarne.kapanan?.length > 0 || haftaKarne.acilan?.length > 0
        || haftaKarne.yaklasan?.length > 0 || haftaKarne.gecikmis?.length > 0) && (
        <div class="hafta-karne">
          {/* Karne bloğu söz defterinin DİZİNİDİR: konu ve tarih; tam metin
              (söz, sonuç, ne bakılacak) aşağıdaki Söz defteri bölümünde, bağla. */}
          <p class="alt-not">Bir önceki haftalık sayıdan bu yana. Sözlerin tam metni <a href="#soz-defteri">söz defterinde</a>.</p>
          {haftaKarne.kapanan?.length > 0 && (
            <>
              <h3 class="hk-baslik">Bu hafta kapanan sözler
                <span class="hk-sayim">{haftaKarne.tuttu} tuttu · {haftaKarne.kismen} kısmen · {haftaKarne.tutmadi} tutmadı{haftaKarne.notsuz ? ` · ${haftaKarne.notsuz} notsuz` : ''}</span></h3>
              <ul class="hk-liste">
                {haftaKarne.kapanan.map((k: any) => (
                  <li>
                    {k.isabet && <span class:list={['isabet', ISABET_SINIF[k.isabet] ?? '']}>{k.isabet}</span>}
                    {sozGorunen.has(String(k.konu)) ? <a class="hk-konu" href={`#${sozKimlik(k.konu)}`}>{k.konu}</a> : <span class="hk-konu">{k.konu}</span>}
                    {k.acilis && <span class="hk-tarih">açılış {tarihYaz(k.acilis)}</span>}
                  </li>
                ))}
              </ul>
            </>
          )}
          {haftaKarne.acilan?.length > 0 && (
            <>
              <h3 class="hk-baslik">Bu hafta açılan sözler</h3>
              <ul class="hk-liste">
                {haftaKarne.acilan.map((k: any) => (
                  <li>{sozGorunen.has(String(k.konu)) ? <a class="hk-konu" href={`#${sozKimlik(k.konu)}`}>{k.konu}</a> : <span class="hk-konu">{k.konu}</span>}{k.vade && <span class="hk-tarih">vade {tarihYaz(k.vade)}</span>}</li>
                ))}
              </ul>
            </>
          )}
          {haftaKarne.yaklasan?.length > 0 && (
            <>
              <h3 class="hk-baslik">Vadesi önümüzdeki haftaya düşenler</h3>
              <ul class="hk-liste">
                {haftaKarne.yaklasan.map((k: any) => (
                  <li>{sozGorunen.has(String(k.konu)) ? <a class="hk-konu" href={`#${sozKimlik(k.konu)}`}>{k.konu}</a> : <span class="hk-konu">{k.konu}</span>}{k.vade && <span class="hk-tarih">vade {tarihYaz(k.vade)}</span>}</li>
                ))}
              </ul>
            </>
          )}
          {haftaKarne.gecikmis?.length > 0 && (
            <>
              <h3 class="hk-baslik">Vadesi geçmiş, açık kalan sözler</h3>
              <ul class="hk-liste">
                {haftaKarne.gecikmis.map((k: any) => (
                  <li>{sozGorunen.has(String(k.konu)) ? <a class="hk-konu" href={`#${sozKimlik(k.konu)}`}>{k.konu}</a> : <span class="hk-konu">{k.konu}</span>}{k.vade && <span class="hk-tarih gecikti">vade {tarihYaz(k.vade)}{typeof k.gun_kalan === 'number' ? ` · ${-k.gun_kalan} gün geçti` : ''}</span>}</li>
                ))}
              </ul>
            </>
          )}
        </div>
      )}
      <div class="gundem-metin" set:html={sayiBag(String(b.gundem[x.id]))} />
    </section>
  ))}

  {b.rejim?.length > 0 && (
    <section class="blok rejim" id="rejim">
      <h2>Rejim panosu</h2>
      <details class="yontem"><summary>Yöntem</summary>
        <p>Gösterge şeridi seviyeyi verir; bu pano seviyelerin birlikte ne anlama
        geldiğini. Her satır iki ölçülen büyüklüğün farkıdır ve hesabı yanında
        yazar. Etiketler açıkça yazılmış bir eşikten gelir — okur katılmadığı yerde
        kendi çizgisini çekebilsin diye eşik de görünür.</p>
      </details>
      {/* ANA SAYFAYLA AYNI CETVEL. Aynı veri iki ayrı bileşenle basılıyordu:
          ana sayfada hizalı sütunlar, burada değerin ada yapıştığı bir liste ve
          her satırın altında her gün aynı açıklama paragrafı. Açıklamalar
          katlanır; değerin altında bir önceki sayıya göre fark durur. */}
      <RejimSerit satirlar={rejimSatirlari}
        kiyas={b.haftalik && bicim3 ? 'önceki haftalık sayıya göre' : 'önceki ölçüme göre'} />
      {b.rejim.some((r: any) => r.aciklama) && (
        <details class="yontem rejim-anlam"><summary>Satırların anlamı</summary>
          <dl>
            {b.rejim.filter((r: any) => r.aciklama).map((r: any) => (
              <>
                <dt>{r.ad}</dt>
                <dd>{r.aciklama}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
    </section>
  )}

  {!pazarDuzeni && (sigmaSatirlar.length > 0 || haberTonu.length > 0) && (
    <section class="blok sigma-blok" id="olagandisi">
        <h2>{sigmaBaslik}</h2>
        {/* EŞİK AŞILMADIYSA TEK CÜMLE (01.10.2026). Hiçbir hareket 2σ'yı
            aşmadığı günlerde de grafik ve tablo aynı altı satırı iki kez
            gösteriyordu (30.09: en büyüğü −1,5σ); o altı satır piyasa
            fotoğrafında da var. Eşik aşıldığında grafik açık kalır; tablo
            ve yöntem her durumda katlı. */}
        {sigmaSatirlar.length > 0 && (sigmaAsan.length === 0 ? (
          <p class="sigma-ozet">
            Hiçbir hareket {sayi(OLAGANDISI_SIGMA, 0)}σ'yı aşmadı; en büyüğü {sigmaSatirlar[0].ad}{' '}
            <span class="nb">{degisimli(sigmaSatirlar[0].deger, sigmaSatirlar[0].birim)}</span>{' '}
            (<span class="nb">{sigmaYaz(sigmaSatirlar[0].sigma)}</span>).
          </p>
        ) : (
          <SigmaSerit hareketler={sigmaSatirlar} esik={OLAGANDISI_SIGMA}
                      kip={b.piyasa.en_cok_hareket.sigma_kip} />
        ))}
        {sigmaSatirlar.length > 0 && (
        <details class="yontem"><summary>{sigmaAsan.length === 0 ? 'Sıralama ve yöntem' : 'Tablo ve yöntem'}</summary>
          {b.piyasa.kapanis_seansi && (
            <p>Ölçülen seans: <strong>{anaSeans ? seansEtiketi(anaSeans) : b.piyasa.kapanis_seansi}</strong>.</p>
          )}
          <div class="p-kaydir" tabindex="0" role="region" aria-label="Kaydırılabilir tablo" data-kaydir>
            <table class="p-tablo">
              <caption class="gorunmez">En çok hareket edenler: değişim, oynaklık ve kaç standart sapma</caption>
              <thead>
                <tr><th scope="col">Enstrüman</th><th class="sag" scope="col">{sigmaHaftalik ? '1 hafta' : '1 gün'}</th><th class="sag" scope="col">{sigmaHaftalik ? 'Haftalık σ' : 'Günlük σ'}</th><th class="sag" scope="col">Kaç σ</th></tr>
              </thead>
              <tbody>
                {sigmaSatirlar.map((x: any) => (
                  <tr>
                    <td class="p-ad">{x.ad}</td>
                    <td class:list={['sag', 'p-degisim', { arti: x.deger > 0, eksi: x.deger < 0 }]}>
                      {degisimli(x.deger, x.birim)}
                    </td>
                    <td class="sag p-son">{birimli(x.oynaklik, x.birim, OYNAKLIK_HANE)}</td>
                    <td class:list={['sag', 'p-sigma', { olagandisi: Math.abs(x.sigma) >= OLAGANDISI_SIGMA }]}>
                      {sigmaYaz(x.sigma)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>Hareketin büyüklüğü ile olağandışılığı ayrı şeylerdir. Sıralama
          {sigmaHaftalik
            ? ' haftalık hareketi her enstrümanın kendi son yirmi haftalık oynaklığına bölerek kurulur: σ, o enstrüman için normal bir haftanın ölçüsüdür.'
            : ' günlük hareketi her enstrümanın kendi son yirmi günlük oynaklığına bölerek kurulur: σ, o enstrüman için normal bir günün ölçüsüdür.'}
