  @media (max-width: 640px) { .satir-not dl { grid-template-columns: 1fr; } .satir-not dd { margin-bottom: 0.3rem; } }
  .olay-neden { color: var(--ink-60); }
  .gosterge.durgun .g-deger, .gosterge.durgun .g-ad { color: var(--ink-60); }
  .gosterge.durgun .g-deger { font-weight: 400; }
  .serit-not { margin-top: 0.45rem; }
  .g-tarih { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-60); }
  .g-canli { display: block; font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-70); }
  .p-canli { color: var(--ink-70); }
  .g-kiyas { display: block; font-size: 0.92em; font-style: italic; }
  /* BAĞLAM SATIRI — tek günlük okumanın altında, ondan sönük ama okunur
     (--ink-60, üç zeminde de AA); --ink-30 metinde kullanılmaz (1,90:1). */
  .g-baglam {
    display: block; font-size: 0.86rem; color: var(--ink-60);
    margin-top: 0.1rem; font-variant-numeric: tabular-nums;
  }

  .blok { margin: 2.6rem 0; }
  /* Her sayıda aynı basılan yöntem notu katlanır: okur bir kez okur, sonra
     geçer. Güne özgü bilgi (seans, isabet oranı) katın DIŞINDA kalır. */
  .yontem { margin: -0.4rem 0 1rem; font-size: 0.8rem; color: var(--ink-70); max-width: var(--olcu-metin); }
  .yontem summary {
    cursor: pointer; font-family: var(--font-mono); font-size: 0.7rem;
    letter-spacing: 0.04em; color: var(--ink-60); width: max-content;
  }
  .yontem summary:hover { color: var(--claret); }
  .yontem[open] summary { margin-bottom: 0.35rem; }
  .yontem p { margin: 0 0 0.4rem; line-height: 1.5; }
  .blok h2 {
    font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 0.9rem;
    padding-bottom: 0.35rem; border-bottom: 2px solid var(--ink);
  }
  .blok h3 { font-size: 0.95rem; margin: 1.3rem 0 0.5rem; color: var(--ink-70); font-variant: small-caps; letter-spacing: 0.06em; }
  .adet { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-60); }

  .olay-liste { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .olay-liste li { display: grid; gap: 0.15rem; padding-left: 0.9rem; border-left: 2px solid var(--ink-30); }
  .olay-liste.onemli li { border-left-color: var(--claret); }
  .olay-liste li.dikkat { border-left-color: var(--uyari); }
  /* Biçim 3'te "Öne çıkanlar" yok; önemli olay veri listesinde satırın kendi
     sınıfıyla ayrışır — kural yoktu ve önemli satır bilgi satırından ayırt
     edilemiyordu, dikkat satırı ise öne çıkıyordu (01.10.2026 incelemesi). */
  .olay-liste li.onemli { border-left-color: var(--claret); }
  .olay-liste li.onemli .metin { font-weight: 600; }
  .olay-liste .metin { line-height: 1.45; max-width: var(--olcu-metin); }
  .olay-liste.kucuk .metin { font-size: 0.86rem; color: var(--ink-70); }
  .dipnot { font-size: 0.78rem; color: var(--ink-70); font-style: italic; }
  .kaynak-not { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-60); }
  .kaynak-not a { color: inherit; }

  /* SÜTUNLAR TABLODAN TABLOYA AYNI YERDE: her hafta ayrı tablo ve otomatik
     genişlik olunca saat sütunu gruptan gruba 25 piksel kayıyordu. */
  table.takvim { width: 100%; border-collapse: collapse; font-size: 0.87rem; table-layout: fixed; }
  table.takvim col.c-tarih { width: 7.6rem; }
  table.takvim col.c-saat { width: 3.6rem; }
  table.takvim col.c-ulke { width: 3.4rem; }
  table.takvim td.t-olay { overflow-wrap: break-word; }
  /* Pazar sayısının önümüzdeki hafta listesi gün gün okunur: günün ilk satırı
     bir çizgiyle ayrılır, tarih yalnız orada basılır. */
  table.takvim tr.gun-bas:not(:first-child) td { border-top: 1px solid var(--ink-30); }
  @media (max-width: 640px) {
    table.takvim col.c-tarih { width: 5.4rem; }
    table.takvim col.c-saat { width: 3rem; }
    table.takvim col.c-ulke { width: 2.8rem; }
    table.takvim .t-tarih { white-space: normal; }
  }
  .k-not { font-size: 0.79rem; color: var(--ink-70); }
  .bugun-blok h3 { color: var(--claret); }
  table.takvim td { padding: 0.42rem 0.5rem 0.42rem 0; border-bottom: 1px solid var(--ink-30); vertical-align: top; }
  tr.kritik .t-olay { font-weight: 600; }
  tr.kritik td { background: color-mix(in srgb, var(--claret) 4%, transparent); }
  .t-tarih { white-space: nowrap; font-family: var(--font-mono); font-size: 0.78rem; }
  .t-gun { display: block; color: var(--ink-60); font-size: 0.7rem; }
  .t-saat { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-70); white-space: nowrap; }
  .t-ulke { font-family: var(--font-mono); font-size: 0.7rem; color: var(--claret); }
  .t-olay { line-height: 1.35; }
  .beklenti, .damga { display: block; font-size: 0.74rem; color: var(--ink-70); }
  .damga { font-family: var(--font-mono); color: var(--uyari); }

  .haber-liste { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .haber-kat summary, .tema-kat summary {
    cursor: pointer; font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.03em; color: var(--ink-60); width: max-content; margin: 0.2rem 0 0.5rem;
  }
  .haber-kat summary:hover, .tema-kat summary:hover { color: var(--claret); }
  .tema-kat { margin: 0 0 0.6rem; }
  .haber-liste li { display: grid; gap: 0.1rem; }
  .haber-liste a { text-decoration: none; border-bottom: 1px solid var(--ink-30); }
  .uyari { font-size: 0.8rem; color: var(--uyari); margin-top: 0.8rem; }


  .haftalik-rozet {
    display: inline-block; font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--claret); border: 1px solid var(--claret); padding: 0.15rem 0.5rem;
    margin: 0 0 0.6rem;
  }
  .kapsam { border-top: 1px solid var(--ink-30); padding-top: 0.8rem; }
  .kapsam-satir { font-size: 0.86rem; color: var(--ink-70); line-height: 1.5; margin: 0 0 0.5rem; max-width: var(--olcu-metin); }
  .kapsam-satir strong { color: var(--ink); font-weight: 600; }
  .kapsam-liste { margin: 0.3rem 0 0; }
  .kapsam-liste dt { font-weight: 600; color: var(--ink); margin-top: 0.4rem; }
  .kapsam-liste dd { margin: 0; line-height: 1.5; }

  .rejim .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 1rem; max-width: 24rem; }
  .rejim-anlam { margin-top: 0.9rem; }
  .rejim-anlam dl { margin: 0.3rem 0 0; display: grid; gap: 0.15rem 0; }
  .rejim-anlam dt { font-weight: 600; color: var(--ink); margin-top: 0.4rem; }
  .rejim-anlam dd { margin: 0; line-height: 1.5; }

  .sonuclar .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 1rem; max-width: 24rem; }
  .sonuc-liste { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; }
  .sonuc-liste li { padding-left: 0.9rem; border-left: 2px solid var(--ink-30); display: grid; gap: 0.18rem; }
  .sonuc-ust { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .sonuc-olay { font-weight: 600; line-height: 1.35; }
  .sonuc-beklenti, .sonuc-geldi, .sonuc-bekliyor, .sonuc-tepki {
    margin: 0; font-size: 0.86rem; line-height: 1.5; color: var(--ink-70);
  }
  .sonuc-geldi { color: var(--ink); }
  .sonuc-sayi { font-family: var(--font-mono); font-weight: 600; }
  .sonuc-surpriz, .sonuc-hareket { font-family: var(--font-mono); font-size: 0.95em; }
  .sonuc-surpriz.arti, .sonuc-hareket.arti { color: var(--pozitif); }
  .sonuc-surpriz.eksi, .sonuc-hareket.eksi { color: var(--claret); }
  .sonuc-bekliyor { font-style: italic; }

  .kritik-blok .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 0.9rem; max-width: 24rem; }
  ol.kritik { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  ol.kritik li { display: grid; grid-template-columns: 5.4rem 1fr; gap: 0.7rem; align-items: baseline; }
  .k-sayac {
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--claret);
    text-align: right; white-space: nowrap;
  }
  .k-govde { display: grid; gap: 0.1rem; }
  .k-olay { font-weight: 600; line-height: 1.35; }
  .k-zaman { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-70); }
  .k-beklenti { font-size: 0.79rem; color: var(--ink-70); }


  .soz .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 1.1rem; max-width: 24rem; }
  .soz-liste { list-style: none; padding: 0; margin: 0 0 0.4rem; display: grid; gap: 0.9rem; }
  .soz-liste li {
    display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.7rem;
    padding-left: 0.9rem; border-left: 2px solid var(--ink-30);
  }
  .soz-liste li.gecikti { border-left-color: var(--uyari); }
  .soz-liste.kapanan li { border-left-color: var(--pozitif); }
  .soz-vade {
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-70);
    text-align: right; padding-top: 0.15rem; white-space: nowrap;
  }
  .soz-liste li.gecikti .soz-vade { color: var(--uyari); }
  .soz-liste.kapanan .soz-vade { color: var(--pozitif); }
  .soz-govde { display: grid; gap: 0.2rem; }
  .soz-konu { line-height: 1.35; }
  .soz-metin, .soz-sonuc, .soz-bakis { font-size: 0.95rem; color: var(--ink-70); line-height: 1.55; max-width: 31rem; }
  .soz-liste li.kapali { border-left-color: var(--pozitif); }
  /* Duran kayıtlar: tek satır, künye ritmi. Sayfada yer kaplamadan GÖRÜNÜR
     kalırlar — bir sözün sessizce düşmesi, defterin anlamını götürür. */
  .soz-duran { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
  .soz-duran li {
    display: grid; grid-template-columns: 7.5rem 1fr auto; gap: 0.6rem;
    align-items: baseline; padding: 0.3rem 0; border-bottom: 1px solid var(--ink-15);
  }
  .soz-duran .soz-konu { font-weight: 500; }
  .soz-duran li.gecikti .soz-vade { color: var(--uyari); }
  @media (max-width: 640px) {
    .soz-duran li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
  .soz-bakis { font-style: italic; }
  @media (max-width: 640px) {
    .soz-liste li { grid-template-columns: 1fr; gap: 0.25rem; }
    .soz-vade { text-align: left; }
  }

  /* İŞLEM FİKİRLERİ. Kart iskeleti söz defterinden (sol kenarlık, künye satırı);
     seviye ve karne tabloları piyasa tablosunun sözleşmesiyle (.p-tablo, sağa
     hizalı eşit genişlikli rakam). Büyük harf dönüşümü YOK: fikir başlıkları
     "OIS" gibi yabancı adlar taşır (sayfa sınavı 27). */
  .fk-kunye { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-60); margin: -0.4rem 0 0.8rem; }
  .fk-defter { font-size: 0.86rem; color: var(--ink-70); margin: -0.4rem 0 0.9rem; }
  .fk-uyari {
    font-size: 0.8rem; line-height: 1.5; color: var(--ink-70); max-width: var(--olcu-metin);
    margin: 0 0 1.2rem; padding: 0.55rem 0.75rem; border: 1px solid var(--ink-30);
    background: color-mix(in srgb, var(--ink) 3%, transparent);
  }
  .fk-liste { display: grid; gap: 1.5rem; margin: 0 0 0.6rem; }
  .fk-kart { padding-left: 0.9rem; border-left: 2px solid var(--claret); min-width: 0; }
  .fk-kart h3.fk-baslik {
    font-family: var(--font-display); font-size: 1.1rem; font-variant: normal; letter-spacing: 0;
    color: var(--ink); margin: 0 0 0.25rem; line-height: 1.3;
  }
  .fk-ust { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-60); margin: 0 0 0.55rem; line-height: 1.5; }
  .fk-ust a { color: inherit; }
  .fk-satir { margin: 0 0 0.25rem; font-size: 0.95rem; line-height: 1.5; max-width: var(--olcu-metin); }
  .fk-et { font-weight: 600; }
  .fk-olculemez { color: var(--uyari); }
  .fk-vekil { font-size: 0.86rem; color: var(--ink-70); }
  .fk-seviye {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 38rem;
    margin: 0.55rem 0 0.7rem; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink-30);
  }
  .fk-seviye > div { padding: 0.35rem 0.7rem 0.45rem 0; min-width: 0; }
  .fk-seviye > div + div { padding-left: 0.7rem; border-left: 1px solid var(--ink-15); }
  .fk-seviye dt { font-size: 0.74rem; font-weight: 600; color: var(--ink-70); margin: 0 0 0.15rem; }
  .fk-seviye dd {
    margin: 0; font-family: var(--font-mono); font-variant-numeric: tabular-nums;
    font-size: 0.9rem; line-height: 1.35; overflow-wrap: anywhere;
  }
  .fk-seviye dd.fk-dd-metin { font-family: var(--font-body); font-style: italic; color: var(--ink-70); }
  .fk-alt { display: block; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-60); margin-top: 0.1rem; }
  .fk-metin { margin: 0 0 0.35rem; font-size: 0.95rem; line-height: 1.55; color: var(--ink-70); max-width: var(--olcu-metin); }
  .fk-metin .fk-et { color: var(--ink); }
  /* `table.p-tablo td { white-space: nowrap }` özgüllükle `.p-ad`ı eziyor
     (piyasa tablosunda aynı kusur bir kez ölçüldü): ad ve yapı satırı sarar. */
  table.fk-karne td.p-ad { min-width: 11rem; white-space: normal; }
  table.fk-karne td.p-ad a { color: var(--ink); }
  table.fk-karne td.fk-sar { white-space: normal; }
  table.fk-karne th.sag, table.fk-karne td.sag { padding-left: 0.9rem; }
  .fk-not-hucre { color: var(--ink-60); font-style: italic; }
  .fk-sebep { text-align: right; max-width: 16rem; margin-left: auto; }
  .fk-sayim { font-size: 0.86rem; color: var(--ink-70); line-height: 1.5; max-width: var(--olcu-metin); margin: 0.9rem 0 0.6rem; }
  .fk-emir { font-size: 0.92rem; line-height: 1.5; max-width: var(--olcu-metin); margin: 0.4rem 0 0.8rem; padding-left: 1.1rem; }
  .fk-emir li { margin: 0.25rem 0; }
  .fk-yontem { margin: 0.8rem 0 0; }
  @media (max-width: 640px) {
    .fk-kart { padding-left: 0.7rem; }
    .fk-seviye { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* `div + div` özgüllüğünü aşmak için aynı birleştirici (kapsam niteliği her parçaya eklenir). */
    .fk-seviye > div + div:nth-child(3) { padding-left: 0; border-left: 0; }
    .fk-seviye > div:nth-child(n+3) { border-top: 1px solid var(--ink-15); }
  }

  .gundem .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 1.1rem; max-width: 24rem; }
  .gundem-bolum { margin: 1.5rem 0; }
  .gundem-bolum h3 {
    font-size: 0.9rem; color: var(--claret); font-variant: small-caps;
    letter-spacing: 0.07em; margin: 0 0 0.5rem;
    border-bottom: 1px solid var(--ink-30); padding-bottom: 0.2rem;
  }
  /* DÜZYAZI ~72 karakterde tutulur; sütunun kendisi (74ch ≈ 100 karakter)
     tablolar için geniş kalmak zorunda, o yüzden sınır METNE konuyor. */
  .gundem-metin { margin: 0 0 0.7rem; line-height: 1.6; max-width: var(--olcu-metin); }
  .gundem-metin p { margin: 0 0 0.6rem; }
  .yazi-bolum h3 { color: var(--ink); }
  .gundem-bolum.kilit {
    border-left: 3px solid var(--claret); padding-left: 1rem;
    background: color-mix(in srgb, var(--claret) 3%, transparent);
    padding-top: 0.6rem; padding-bottom: 0.6rem;
  }
  .gundem-bolum.kilit h3 { font-size: 1rem; color: var(--claret); }
  .gundem-bolum.kilit .haber-liste a { font-weight: 600; }
  .kilit-not { font-size: 0.76rem; color: var(--ink-70); font-style: italic; margin: -0.2rem 0 0.7rem; }
  /* 44 haber özeti, 9.167 karakter: sayfanın en küçük ve en geniş metniydi
     (13,1px, genişlik sınırı yok → satır başına 129 karakter). */
  .h-ozet { display: block; font-size: 0.95rem; color: var(--ink-70); line-height: 1.55;
            max-width: 29rem; }


  .piyasa .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 1.1rem; max-width: 24rem; }
  .sigma-blok .alt-not { margin: -0.2rem 0 0.7rem; max-width: 24rem; }
  .p-sigma { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-60); white-space: nowrap; }
  .p-sigma.olagandisi { color: var(--claret); font-weight: 600; }
  .p-grup { margin: 1.4rem 0; }
  .p-grup h3 {
    font-size: 0.88rem; color: var(--claret); font-variant: small-caps;
    letter-spacing: 0.07em; margin: 0 0 0.4rem;
  }
  .p-kaydir { overflow-x: auto; position: relative; }
  /* Klavyeyle gezen okur kayan tablonun gizli sütunlarına ulaşabilsin
     (WCAG 2.1.1): kap odak alır, odak halkası markanın bordosu. */
  .p-kaydir:focus-visible { outline: 2px solid var(--claret); outline-offset: 2px; }
  /* PİYASA TABLOLARI ALT ALTA HİZALI: on iki grup on iki ayrı tablo ve her
     biri sütun genişliğini kendi içeriğinden kuruyordu — aynı sütun gruptan
     gruba 60 piksele kadar kayıyordu. Sabit düzen, sütunları bütün gruplarda
     aynı x'e koyar; dar ekranda tablo en az 44rem kalır ve yatay kayar, ad
     sütunu yapışık durur. */
  table.p-piyasa { table-layout: fixed; min-width: 44rem; }
  table.p-piyasa col.c-ad { width: 30%; }
  table.p-piyasa col.c-son { width: 13%; }
  table.p-piyasa col.c-deg { width: 10.5%; }
  table.p-piyasa col.c-konum { width: 7.5%; }
  table.p-piyasa col.c-sigma { width: 7.5%; }
  /* Ad hücresi SARAR: `table.p-tablo td { white-space: nowrap }` özgüllükle
     `.p-ad { white-space: normal }`ı eziyordu; sabit düzende uzun ad ve
     "… kaynakta boş" notu komşu sütunun altına akıyordu. Birim değerin
     ALTINDA: "7.670,84 puan" ve "2,9933 USD/galon" %13'lük sütuna sığmıyor,
     değer sütunun sağ kenarını 15 piksele kadar aşıp "1 gün" hücresine
     biniyordu (34 sayıda 645 hücre). */
  table.p-piyasa td.p-ad { min-width: 0; overflow-wrap: break-word; white-space: normal; }
  table.p-piyasa .p-son .p-birim { display: block; margin-left: 0; line-height: 1.2; }
  /* Tema tabloları dört sütun: telefonda da sığmalı. Piyasa tablolarının
     12rem'lik ad sütunu burada 'yılbaşından' sütununu yarısından kesiyordu. */
  table.p-tema td.p-ad { min-width: 0; white-space: normal; }
  @media (max-width: 640px) {
    table.p-tema th, table.p-tema td { padding-right: 0.35rem; }
  }
  @media (max-width: 760px) {
    table.p-piyasa th:first-child, table.p-piyasa td.p-ad {
      position: sticky; left: 0; z-index: 1; background: var(--paper);
      box-shadow: 1px 0 0 var(--ink-15);
    }
  }
  table.p-tablo { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  /* BAŞLIKTA BÜYÜK HARF DÖNÜŞÜMÜ YOK: `text-transform: uppercase` küçük sigmayı
     (σ, standart sapma) büyük Sigma'ya (Σ, toplam) çeviriyordu — "1 GÜN Σ",
     "KAÇ Σ". Nicel okur için bu başka bir büyüklüğün adıdır. */
  table.p-tablo th {
