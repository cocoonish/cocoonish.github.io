---
/**
 * Günlük bültenin gövdesi. Veri, bulten/uret.py'nin yazdığı JSON'dan gelir
 * (site/src/data/bulten/YYYY-MM-DD.json) ve DERLEME sırasında okunur — sayfada
 * istemci tarafı veri çekme yoktur, bülten statik ve arşivlenebilir.
 *
 * Bölüm sırası bilinçli ve içindekiler (`bolumler`) aynı sıradan kurulur —
 * bir sabah notunun sırası (01.10.2026): düzeltmeler → manşet ve "Bu sabah"
 * maddeleri → gösterge şeridi → dünden bu yana gelen veriler → beklenti ve
 * sonuç → bugünün takvimi → günün okuması → konu bölümleri (biçim 3: Türkiye ·
 * Küresel · Emtia · Takvim · Risk) → işlem fikirleri (biçim 3, yalnız fikir ya
 * da karne varsa; risk bölümünün ardı — haftalıkta "Senaryolar ve risk
 * haritası"nın hemen ardı) → rejim → olağandışı hareketler → piyasa
 * fotoğrafı → söz defteri → takvim → temalar → haber akışı → veri günlüğü →
 * kapsam notu (yalnız haftalık). Sabah beş dakikada bakan biri ilk ekranlardan
 * "ne değişti, hangi veri geldi, bugün ne var" sorularının cevabını almalı;
 * derinlik aşağıda, ek tablolar katlı.
 */
import EgriGrafik from './EgriGrafik.astro';
import SigmaSerit from './SigmaSerit.astro';
import Kunye from './Kunye.astro';
import RejimSerit from './RejimSerit.astro';
import { OLAGANDISI_SIGMA, sigmaBasligi } from '../lib/anaSayfa';
import { sayi, yuzde, degisim, ondalikSay, istanbulSaat, istanbulIsoGun, tarihUzun, tarihYaz, tariheCevir, gunAdi, duzMetin } from '../lib/bicim';
import { type BultenKaydi } from '../lib/yayinlar';
import { bolumBul } from '../lib/bolumler';
import { fikirKartBaglari, defter as tradeDefteri } from '../lib/tradeler';
import {
  FIKIR_SINIF, FIKIR_TUR, FIKIR_DURUM, FIKIR_ACIK, FIKIR_UYARI, FIKIR_YONTEM,
  sayiMi, fkSeviye, fkSonuc, fkYon, kalanYaz, fkKullanimParca, noktali,
  FIKIR_SONUCSUZ, GIRIS_BEKLENIYOR_KISA, GIRIS_BEKLENIYOR_NE, fkR, opsiyonSonucNotu, tasimaAyrisimi,
  tasimaOlculemediNotu, UFUK_BEKLENIYOR_NOT,
} from '../lib/fikir';
import { FERAGAT } from '../consts';
import type { HatSayfa } from '../lib/hatSayfa';

interface Props {
  b: any;
  /** Sayı numarası, ölçüm saati, sayımlar — lib/yayinlar.ts kaydı. */
  kayit?: BultenKaydi;
  /** Hat slug'ı → okura görünen ad ve sayfası (lib/hatSayfa). */
  hatSayfa?: Record<string, HatSayfa>;
  /** Bir önceki yazılmış sayının verisi: rejim panosunda fark için. */
  oncekiB?: any;
  /** Aynı gün yayımlanan öbür yayınlar (analiz, teknik sayı). */
  ayniGun?: { tur: string; ad: string; href: string }[];
}
const { b: ham, kayit, hatSayfa = {}, oncekiB = null, ayniGun = [] } = Astro.props;
// ŞEMA TEK YERDE TOPARLANIR: eksik bir liste bütün /bulten/* sayfalarını ve ana
// sayfayı düşürüp sitenin tamamının yayınını durdururdu. Yokluk boş listedir;
// bölüm başlıkları zaten 'liste doluysa' koşuluyla basılır.
const b: any = {
  gostergeler: [], rejim: [], one_cikanlar: [], sonuclar: [], gruplar: [], veri_gunlugu: [],
  fikirler: [],
  ...(ham ?? {}),
  // İşlem fikirlerinin karnesi (ölçülen katman). Hata hâlinde de liste ve sayım
  // taşır; alanı hiç taşımayan eski sayılarda bölüm basılmaz.
  fikir_karne: { kayitlar: [], sayim: {}, ...(ham?.fikir_karne ?? {}) },
  piyasa: { gruplar: [], turetilmis: [], tr_faizleri: [], ...(ham?.piyasa ?? {}),
            en_cok_hareket: { sigma: [], ...(ham?.piyasa?.en_cok_hareket ?? {}) } },
  haberler: { bolumler: [], okunamayan: [], ...(ham?.haberler ?? {}) },
  izleme: { acik: [], kapanan: [], karne: {}, ...(ham?.izleme ?? {}) },
};
// TAKVİM DİPNOTU RESMÎ ADI TEKRAR ETMEZ (01.10.2026): 30.09'da 22 dipnotun
// 22'si olayın resmî tablo adıydı ("TÜİK: İşgücü (Ağustos 2026) | İşgücü
// İstatistikleri"). Ölçüm katmanı artık adı `resmi_ad`a yazıyor; eski sayılarda
// TÜİK kaynaklı dipnot oraya taşınır ve olay adının ipucunda durur. Önbellek
// notu ("takvim servisi okunamadı") boru hattının durumudur, okura gitmez.
const takvimDuzelt = (k: any) => {
  if (!k || typeof k !== 'object') return k;
  const not = String(k.not_ ?? '').replace(/\s*\(önbellekten; takvim servisi okunamadı\)\s*$/, '').trim();
  // Kendi modelimizin kapsam notu ("doğrudan satış — ihale tahmini yok")
  // beklenti değildir; beklenti yoksa alan boş kalır.
  const beklenti = /ihale tahmini yok$/.test(String(k.beklenti ?? '')) ? '' : k.beklenti;
  if (!k.resmi_ad && String(k.kaynak ?? '').startsWith('TÜİK')) return { ...k, beklenti, resmi_ad: not, not_: '' };
  return { ...k, beklenti, not_: not };
};
b.takvim = (b.takvim ?? []).map((t: any) => ({ ...t, kayitlar: (t?.kayitlar ?? []).map(takvimDuzelt) }));
b.kritik_takvim = (b.kritik_takvim ?? []).map(takvimDuzelt);
// AD ve BAĞ ayrı çözülür ve ikisinin de son çaresi farklı. Ad: pano başlığı →
// kaydın kendi `hat_ad`ı (ölçüm katmanı, bulten/ayar.HAT_ADI) → slug. Bağ:
// sayfası varsa bağ, YOKSA HİÇ — panosu olmayan bir hat için `/projeler/<slug>/`
// yazmak okura 404 verirdi ve koşu yeşil biterdi.
const ad = (o: any) => hatSayfa[o?.hat]?.ad || o?.hat_ad || o?.hat || '';
const sayfa = (o: any) => hatSayfa[o?.hat]?.href ?? null;
// YAZI KATMANININ METİN SÖZLEŞMESİ: alanlar HTML taşır. `yorum`, `gundem.*`
// ve teknikteki `giris` zaten `set:html` ile basılıyordu; `ozet` ise metin
// olarak basılıyor ve yazarın koyduğu <p> okura ETİKET OLARAK görünüyordu
// (dört sayıda, yirmi kaçış). Tek alanı sözleşmenin dışında bırakmak, yazarın
// hangi alanda hangi dili yazacağını bilmesini gerektirir — bilemez.
//
// Düz metin de kabul: etiketle açılmayan bir değer <p> ile sarılır, yani
// sözleşme iki yönde de bozulmaz. Kaynak yazı katmanının kendi dosyasıdır
// (yaz.py kapısından geçer), okur girdisi değil.
// İŞARETLİ SAYI SATIRDA BÖLÜNMEZ. Eksi ile yüzde arasında satır kırılıyordu
// ("WTI −" satır sonunda, "%3,48" alt satırda). Basımda çözülür, veride değil:
// görünmez bir bağlayıcı karakter tweete, aramaya ve kopyalanan metne de
// giderdi. Yalnız metin düğümleri taranır; etiketlere dokunulmaz.
const sayiBag = (html: string): string =>
  html.split(/(<[^>]+>)/).map((parca) => (parca.startsWith('<')
    ? parca
    : parca.replace(/(?<![\p{L}\p{N}])([+−-]%?\d[\d.,]*%?|%\d[\d.,]*)/gu, '<span class="nb">$1</span>'))).join('');
const yaziMetni = (m: unknown) => {
  const t = String(m ?? '').trim();
  return sayiBag(t.startsWith('<') ? t : `<p>${t}</p>`);
};
// SÖZ DEFTERİ HER SABAH BAŞTAN ANLATILMAZ. Ölçüldü (07.09.2026, 13 sayı):
// bültenin düzyazısı günden güne tekrar etmiyor (gündem %0,6 · yorum %0,3),
// ama söz defteri ardışık iki sayı arasında %91,4 birebir örtüşüyordu —
// 4.816 sözcüklük bölüm her gün kelimesi kelimesine yeniden basılıyordu.
// Ölçüm katmanı artık her kaydı `degisti`/`duran` diye işaretliyor; sayfa
// değişeni TAM metniyle, duranı tek satırlık künyesiyle basar. Kayıt
// silinmiyor: duran bir sözün tam metni onu son değiştiren sayıda duruyor.
// Rejim satırlarına bir önceki sayının değeri eklenir (aynı ad); önceki sayı
// ya da satır yoksa fark basılmaz.
const oncekiRejim = new Map<string, number>(
  (Array.isArray(oncekiB?.rejim) ? oncekiB.rejim : [])
    .filter((r: any) => r && typeof r.deger === 'number')
    .map((r: any) => [String(r.ad), r.deger as number] as [string, number]),
);
const rejimSatirlari = (b.rejim ?? []).map((r: any) => ({
  ...r,
  hesap: r.hesap ?? '', etiket: r.etiket ?? '', aciklama: r.aciklama ?? '', konum: r.konum ?? '',
  onceki: oncekiRejim.has(String(r.ad)) ? oncekiRejim.get(String(r.ad)) : undefined,
}));
const sozKayitlari = [...(b.izleme.acik ?? []), ...(b.izleme.kapanan ?? [])];
// GERİYE DÖNÜK EMNİYET: ölçüm katmanı bu alanı yazmadan önce yayımlanmış
// sayılarda `degisti` YOK. O sayılarda ayrım KOŞMAMIŞTIR ve hepsini "duran"
// sayıp tek satıra indirmek, yayımlanmış bir metni sonradan kırpmak olurdu —
// okur o sayıyı tam hâliyle okumuştu. Alanı hiç taşımayan bir defterde bütün
// kayıtlar tam metinle basılır.
const sozAyrimVar = sozKayitlari.some((k: any) => k && 'degisti' in k);
const sozDegisen = sozAyrimVar ? sozKayitlari.filter((k: any) => k?.degisti) : sozKayitlari;
const sozDuran = sozAyrimVar ? sozKayitlari.filter((k: any) => !k?.degisti) : [];
// Rozet neyi saydığını söyler: "4 gün" açılış tarihinin yanında kaydın yaşı
// gibi okunuyordu, oysa vadeye kalan gündü (01.10.2026 incelemesi).
const sozVade = (k: any) =>
  k.durum === 'kapandi' ? (k.isabet || 'kapandı')
  : k.gun_kalan === null ? 'vadesiz'
  : k.gun_kalan < 0 ? `vadesi ${-k.gun_kalan} gün geçti`
  : k.gun_kalan === 0 ? 'vadesi bugün'
  : `vadeye ${k.gun_kalan} gün`;
// Kapanmış kayıtta vade anlamsızdır: "gecikti" rengi yalnız açık kayda verilir
// (kapanmış "tuttu" turuncu basılıyordu — renk "gecikti" diyordu).
const sozGecikti = (k: any): boolean => k?.durum !== 'kapandi' && k?.gun_kalan !== null && k?.gun_kalan < 0;
// Söz kaydının sayfa içi çapası. Konu defterde tekildir; Türkçe harfler ASCII'ye
// indirilir (ı NFKD ile ayrışmaz, elle çevrilir). Haftanın karnesi kaydı bu
// çapayla söz defterindeki tam metnine bağlar — yalnız kayıt sayfada BASILIYORSA:
// pencere dışında kalan bir kapanışa bağ, ölü bir çapa olurdu.
const sozKimlik = (konu: unknown): string =>
  'soz-' + String(konu ?? '').toLocaleLowerCase('tr-TR').replace(/ı/g, 'i')
    .normalize('NFKD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
const sozGorunen = new Set(sozKayitlari.map((k: any) => String(k?.konu ?? '')));
const tz = (t: unknown) => (typeof t === 'string' ? tarihYaz(t) : '');
// HABER KAYNAĞI OKURA YAYINCIYLA YAZILIR. Haber taramasının arama akışından
// gelen maddelerde kaynak alanı iç sorgunun adını taşıyor ("Arama — Fed ve
// ECB") ve yayıncı başlığın sonuna ekleniyordu ("… - Reuters"); okur hem veri
// hattının iç yapısını hem de iki kez kaynak görüyordu. Yayıncı başlık
// sonekinden ayrılır; ayrılamazsa kaynak "haber taraması" yazılır.
const haberAyir = (m: any): { baslik: string; kaynak: string; lang?: string } => {
  const k = String(m?.kaynak ?? '');
  const t = String(m?.baslik ?? '');
  const ek = k.match(/\s*\(\+\d+ kaynak\)$/)?.[0] ?? '';
  let baslik = t, kaynak = k;
  // Ayırıcı BOŞLUKLU tiredir ve en sağdaki alınır: yayıncı adı boşluksuz tire
  // taşıyabilir ("CNBC-e", "Star-Advertiser", "cyprus-mail.com").
  const mm = t.match(/^(.*\S)\s+[-–—]\s+((?:(?!\s[-–—]\s).){2,60})$/);
  if (k.startsWith('Arama')) {
    baslik = mm ? mm[1] : t;
    kaynak = (mm ? mm[2].trim() : 'haber taraması') + ek;
  } else if (mm) {
    // Ek yalnız kaynağın adıyla BİREBİR örtüşüyorsa düşer ("… - Dünya" ·
    // kaynak "Dünya Gazetesi"); örtüşmüyorsa başlığın parçası olabilir.
    const ekAd = mm[2].trim().toLocaleLowerCase('tr');
    const kAd = k.replace(/\s*\(\+\d+ kaynak\)$/, '').toLocaleLowerCase('tr');
    if (ekAd.length >= 3 && (kAd.startsWith(ekAd) || ekAd.startsWith(kAd))) baslik = mm[1];
  }
  // İngilizce başlık ekran okuyucuya İngilizce okunsun (sayfa lang="tr").
  const ingilizce = !/[çğıöşüÇĞİÖŞÜ]/.test(baslik)
    && /\b(the|to|of|for|and|on|in|as|with|after|says|sees)\b/i.test(baslik);
  return { baslik, kaynak, lang: ingilizce ? 'en' : undefined };
};
// AYNI HABER BİR KEZ. Bir haber birden çok bölümün süzgecine takılabiliyor
// (30.09'da üç madde iki bölümde birden); yalnız ilk geçtiği bölümde basılır.
// Anahtar bağlantı; bağlantı yalnız alan köküyse (Resmî Gazete maddelerinin
// hepsi https://www.resmigazete.gov.tr/ taşıyor) ya da yoksa sadeleştirilmiş
// başlık — kök adresle kurulan anahtar aynı günün üç ayrı Resmî Gazete
// maddesinden ikisini düşürüyordu.
const haberAnahtar = (m: any): string => {
  const u = String(m?.baglanti || '').replace(/[?#].*$/, '');
  const yolVar = /^[a-z]+:\/\/[^/]+\/[^/]/i.test(u);
  return yolVar ? u : String(m?.baslik || '').toLocaleLowerCase('tr').replace(/\W+/g, ' ').trim();
};
const haberBolumleri = (() => {
  const gorulen = new Set<string>();
  return (b.haberler?.bolumler ?? []).map((bol: any) => ({
    ...bol,
    maddeler: (bol.maddeler ?? []).filter((m: any) => {
      const a = haberAnahtar(m);
      if (!a || gorulen.has(a)) return !a;
      gorulen.add(a);
      return true;
    }),
  })).filter((bol: any) => bol.maddeler.length > 0 || (b.gundem && b.gundem[bol.id]));
})();
// YAZILMIŞ GÜNDEM METNİ BAŞLIKSIZ KALMAZ. Metin bölüm başlığıyla basılıyor ve
// başlık yalnız o gün haber maddesi olan bölümler için yazılıyordu:
// `kurum_global` maddesiz günlerde başlıksız kaldı ve 17 sayıda hiç basılmadı
// (sayfa sınavı 25b). Başlık ölçüm katmanının ilanından (`bolum_adlari`,
// tek tanım bulten/ayar.HABER_BOLUMLERI); o alanı taşımayan eski sayılarda
// aynı tablonun kopyası — duman ikisini kaynak metninden kıyaslar.
const GUNDEM_ADLARI: Record<string, string> = {
  kilit: 'Kilit gelişmeler',
  kurum: 'Kurum duyuruları — Türkiye',
  kurum_global: 'Kurum duyuruları — ABD Hazinesi ve borç yönetimi',
  tr_makro: 'Türkiye — makro ve veri',
  tr_politika: 'Türkiye — politika ve düzenleme',
  tr_piyasa: 'Türkiye — piyasa',
  global_makro: 'Global — makro ve merkez bankaları',
  global_politika: 'Global — jeopolitik ve ticaret',
  global_piyasa: 'Global — piyasa ve emtia',
};
const gundemBasilan = new Set<string>([
  ...haberBolumleri.map((x: any) => x.id),
  ...(b.gundem_yazi_bolumleri ?? []).map((x: any) => x.id),
]);
const gundemYetim = Object.keys(b.gundem ?? {})
  .filter((id) => !gundemBasilan.has(id) && String(b.gundem[id] ?? '').trim())
  .map((id) => ({ id, baslik: b.haberler?.bolum_adlari?.[id] ?? GUNDEM_ADLARI[id] ?? 'Gündem notu' }));
// BİÇİM 3 (sayının `surum` beyanı, bulten/ayar.YAZI_BOLUMLERI_3): sabah notu.
// Madde özeti ("Bu sabah"), tek okuma ve konu başına TEK ev — Türkiye ·
// Küresel · Emtia · Bugün ve önümüzdeki günler · Risk — okumadan hemen sonra
// kendi bölümleri olarak basılır; haber listeleri yazıdan ayrılıp sonda katlı
// "Haber akışı"na iner. Biçim 2 (arşiv) sayıları eski düzenle basılır.
const bicim3 = Number(b.surum ?? 2) >= 3;
const yaziBolumleri = bicim3
  ? (b.gundem_yazi_bolumleri ?? []).filter((x: any) => String(b.gundem?.[x.id] ?? '').trim())
  : [];
// Kipe bağlı etiketler tek yerde: günlük ve haftaya bakış farklı sözcükler kullanır.
const kip = b.haftalik
  ? { gundemNot: 'Geçen haftanın öne çıkanları: Türkiye ve global taraf, makro ve politika ayrımıyla.' }
  : { gundemNot: 'Dün ve bu sabah öne çıkanlar: Türkiye ve global taraf, makro ve politika ayrımıyla.' };

// ── İŞLEM FİKİRLERİ (karar 04.10.2026, kullanıcı). Yazı katmanı günün okumasını
// yapılandırılmış bir işlem yapısına çevirir: bacaklar, kazanç yönü, referans,
// hedef, stop, ufuk ve görüşü ne bozar (`fikirler` — o sayıda AÇILANLAR;
// bulten/fikir.dogrula). Ölçülen katman önceki sayılarda açılmış fikirlerin
// bugünkü durumunu seriden kurar (`fikir_karne`). Bölüm yalnız biçim 3 sayıda ve
// iki listeden biri doluysa basılır.
//
// YER TEK DEĞİŞKENDE (`yaziAkisi`): risk bölümünün hemen ardı (haftalıkta
// "Senaryolar ve risk haritası", günlükte yazının son bölümü); risk o gün boşsa
// son yazı bölümünün ardı, o da yoksa günün okumasının ardı. Günlük risk bölümü
// zorunlu değil ve boş bölüm süzgeçten düşüyor: koşul iki yerde yazılsaydı
// içindekiler ya ölü bir bağ ya da hiç basılmayan bir bölüm gösterirdi.
// Makine kimlikleri (kimlik, seri, tür, yön, sınıf kodu) okura basılmaz; kimlik
// yalnız kartın çapasıdır.
const nesne = (x: any) => x && typeof x === 'object';
const fikirler: any[] = bicim3 && Array.isArray(b.fikirler) ? b.fikirler.filter(nesne) : [];
const fikirKarne: any = nesne(b.fikir_karne) ? b.fikir_karne : { kayitlar: [], sayim: {} };
const fikirKayit: any[] = bicim3 && Array.isArray(fikirKarne.kayitlar) ? fikirKarne.kayitlar.filter(nesne) : [];
const fikirAcik = fikirKayit.filter((k: any) => FIKIR_ACIK.has(String(k.durum)));
const fikirKapanan = fikirKayit.filter((k: any) => !FIKIR_ACIK.has(String(k.durum)));
// Bu sayıda verilen çıkış emirleri (yazarın erken kapanışı): emir bu sayıda
// verilir, gerçekleşmesi bir sonraki ölçümün karnesinde görünür — sayfa emri
// verildiği sayıda da basar (inceleme 04.10.2026: emir hiçbir sayıda okunmuyordu).
const fikirKapat: any[] = bicim3 && b.gundem_kaynagi === 'yazili' && Array.isArray(b.fikir_kapat)
  ? b.fikir_kapat.filter((x: any) => nesne(x) && x.kimlik) : [];
// Karne kurulamadıysa bölüm yine açılır ve bunu söyler (yeni fikir yokken
// bölüm hiç basılmıyor, kusur görünmüyordu).
const fikirVar = fikirler.length > 0 || fikirKayit.length > 0 || fikirKapat.length > 0
  || (bicim3 && !!fikirKarne.hata);
const FIKIR_BOLUM = { id: 'fikirler', ad: 'İşlem fikirleri', kisa: 'Fikirler' };
const yaziAkisi: any[] = (() => {
  const liste: any[] = yaziBolumleri.map((x: any) => ({ ...x, fikir: false }));
  if (!fikirVar) return liste;
  const r = liste.findIndex((x: any) => x.id === 'risk');
  liste.splice(r >= 0 ? r + 1 : liste.length, 0, { ...FIKIR_BOLUM, fikir: true });
  return liste;
})();
// Sözlükler (sınıf, tür, durum), uyarı ve yöntem metni, seviye ve sonuç yazımı
// TEK yerde: lib/fikir — Tradeler defteri (pages/tradeler) aynı fikri aynı
// sözcüklerle basar; iki yerde yazılsaydı bir gün sessizce ayrışırdı.
// Kartın seviyeleri bir ŞERİTTİR (tanım listesi): dört kalem geniş ekranda yan
// yana, telefonda ikişer — tablo olarak basıldığında 390 pikselde kabının
// içinde kayıyordu ve dört sayının biri her zaman görünmezdi.
const gunAy = (t: unknown): string => tz(t).slice(0, 5);
const gunFarki = (a: unknown, z: unknown): number | null => {
  const x = tariheCevir(a), y = tariheCevir(z);
  return x && y ? Math.round((y.valueOf() - x.valueOf()) / 86400000) : null;
};
// Dayanak bağı yalnız o bölüm bu sayfada BASILIYORSA kurulur (ölü çapa olmasın).
const fkDayanak = (d: unknown): { href: string; ad: string } | null => {
  const id = String(d ?? '').trim();
  if (!id) return null;
  if (id === 'yorum') return b.yorum ? { href: '#yorum', ad: b.haftalik ? 'Haftanın okuması' : 'Günün okuması' } : null;
  const x = yaziBolumleri.find((y: any) => y.id === id);
  return x ? { href: `#y-${x.id}`, ad: x.baslik } : null;
};
// Düz metin alanı (gerekçe, görüşü ne bozar): HTML kaçırılır, işaretli sayı
// satırda bölünmez (sayiBag).
const kacir = (s: unknown) => String(s ?? '').trim()
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const duzNb = (s: unknown) => sayiBag(kacir(s));
// Karnedeki fikir, açıldığı sayının kartına bağlanır — yalnız o kart orada
// gerçekten basılıyorsa (biçim 3, yazılmış sayı, fikir listesinde).
const fikirAcildigi: Map<string, string> = fikirKayit.length > 0 || fikirKapat.length > 0 ? fikirKartBaglari() : new Map();
const fikirTrade = (kimlik: unknown) => tradeDefteri().tradeler.find((t) => t.kimlik === String(kimlik)) ?? null;
const fikirBaslik = (kimlik: unknown): string => String(fikirTrade(kimlik)?.f?.baslik ?? '').trim();
// Bu sayıda emri verilen fikir, karnesinde (ölçüm yazıdan önce kurulduğu için)
// henüz "açık" görünür: satır emri adıyla söyler.
const fikirKapatKimlik = new Set(fikirKapat.map((x: any) => String(x.kimlik)));
// Bütün tradelerin defteri: bölüm adı ve adresi site bölümlerinin tek kaynağından.
const TRADELER = bolumBul('/tradeler/');
const fikirSayim: any = nesne(fikirKarne.sayim) ? fikirKarne.sayim : {};
const fikirPencere = sayiMi(fikirKarne.kapanan_pencere_gun) ? fikirKarne.kapanan_pencere_gun : null;
// Bölüm künyesi: bu sayıda açılan · önceki sayılardan açık · yeni kapanan.
// Karne boşsa tek cümle (sıfırları tek tek saymak "yeni 0 kapanan" basıyordu);
// karne kurulamadıysa (hata) karneye dair hiçbir sayım yazılmaz.
const fikirKunye: string = [
  `bu sayıda ${fikirler.length} yeni`,
  ...(fikirKarne.hata ? []
    : fikirKayit.length === 0 ? ['önceki sayılardan açık ya da yeni kapanan fikir yok']
    : [`önceki sayılardan ${fikirAcik.length} açık`,
       fikirPencere !== null ? `son ${fikirPencere} günde ${fikirKapanan.length} kapanan` : `${fikirKapanan.length} yeni kapanan`]),
].join(' · ');

// Sayı biçimi tek yerden (lib/bicim): eksi işareti U+2212, ondalık virgül,
// yüzde işareti sayının ÖNÜNDE ("−%1,88"), bp sayının ardında ("−6,5 bp").
//
// HANE SÜTUNDA SABİTTİR. Ölçüm katmanı yüzde değişimi iki, baz puanı bir,
// σ'yı bir haneye yuvarlar (bulten/piyasa.py); hane o sözleşmeden okunur.
// `ondalikSay` sayının metin temsilinden sayar ve sondaki sıfırı kaybeder —
// aynı sütunda "−%2,99 · −%2,4 · +%3" basılıyordu ve okur eksik veri sanıyordu.
// Sözleşmesi bilinmeyen birimde kaynağın kendi hanesi korunur.
const HANE: Record<string, number> = { '%': 2, bp: 1 };
const SIGMA_HANE = 1;
const OYNAKLIK_HANE = 2;
const hane = (v: number, birim?: string | null): number => HANE[String(birim ?? '').trim()] ?? ondalikSay(v);
const tr = (v: number | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : sayi(v, ondalik ?? ondalikSay(v));
const isaretli = (v: number | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : sayi(v, ondalik ?? ondalikSay(v), true);
const sigmaYaz = (v: number | null | undefined): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : `${sayi(v, SIGMA_HANE, true)}σ`;
/** Birimli değişim: "%" ise yuzde önde, değilse "sayı birim". */
const degisimli = (v: number | null | undefined, birim: string | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : degisim(v, birim ?? '', ondalik ?? hane(v, birim));
/** Ölçüm katmanının yazdığı hazır metin: eski sayılarda ASCII tire kalmış olabilir. */
const eksiDuzelt = (s: unknown): string => String(s ?? '').replace(/(^|[\s(])-(?=\d)/g, '$1−');
/**
 * Gösterge farkı. BİR ORANIN FARKI PUANDIR: %31,75'ten %31,51'e inen TÜFE'nin
 * farkı 0,24 puan, %0,24 değil — %0,24'lük bir düşüş 31,75'i 31,67'ye indirirdi.
 * Şerit farkı "−%0,24" basıyordu, aynı sayfadaki olay cümlesi aynı hareketi
 * doğru olarak "puan" diye yazıyordu (ölçüm katmanında `olay.FARK_BIRIMI`).
 */
const gostergeFark = (fark: unknown, birim: unknown, sayisal?: unknown, farkBirim?: unknown): string => {
  const f = eksiDuzelt(fark);
  const bir = String(birim ?? '').trim();
  // Sıfır fark "—" basılıyordu ve "veri yok" ile karışıyordu.
  if (!f) return sayisal === 0 ? 'değişmedi' : '—';
  // Farkı YÜZDE yazılan gösterge (kur): ölçüm katmanı `fark_birim: "%"` yazar.
  if (String(farkBirim ?? '').trim() === '%') return yuzdeMetin(f);
  if (bir === '%') return `${f} puan`;
  return bir ? `${f} ${bir}` : f;
};
// BUGÜN İLERLEMEYEN GÖSTERGE (ölçüm katmanı `bugun_yeni: false`, 01.10.2026):
// 30.09 şeridindeki 17 göstergenin 10'u bir önceki sayıdakiyle birebir aynıydı
// ve 18.09 tarihli bir fark beş sayıdır bugünün haberi gibi renkli basılıyordu.
// Değer ve kendi tarihi kalır; fark basılmaz, kart soluk. Alanı taşımayan eski
// sayılarda davranış değişmez.
const gostergeDurgun = (g: any): boolean => g?.bugun_yeni === false;
/** Hazır yüzde metni ("21,4", "−1,2") → sözleşme: işaret önde, % sonra ("−%1,2"). */
const yuzdeMetin = (m: unknown): string => {
  const t = eksiDuzelt(m);
  return t.startsWith('−') || t.startsWith('+') ? `${t[0]}%${t.slice(1)}` : `%${t}`;
};
/** Birimli seviye (işaretsiz): "%1,20" ya da "6,5 bp". */
const birimli = (v: number | null | undefined, birim: string | null | undefined, ondalik?: number): string => {
  if (v === null || v === undefined || typeof v !== 'number') return '—';
  const b = (birim ?? '').trim();
  const n = ondalik ?? ondalikSay(v);
  return b === '%' ? yuzde(v, n) : `${sayi(v, n)}${b ? ` ${b}` : ''}`;
};
/** Piyasa satırının son değeri: yüzde birimi ÖNDE ("%5,255"), öbürleri arkada küçük. */
const sonYaz = (r: any): { govde: string; birim: string } => {
  const b = String(r?.birim ?? '').trim();
  if (typeof r?.son !== 'number') return { govde: '—', birim: '' };
  // Hane sütunun sözleşmesinden (HANE): `ondalik` taşımayan satır (tema
  // tablosundaki TL faizi) "%37" basıyordu, piyasa fotoğrafı aynı değeri "%37,00".
  const n = typeof r.ondalik === 'number' ? r.ondalik : hane(r.son, b);
  return b === '%' ? { govde: yuzde(r.son, n), birim: '' } : { govde: sayi(r.son, n), birim: b };
};

// ── Künye: sayının ölçülen kimliği
const enstruman = kayit?.enstruman
  ?? (b?.piyasa?.gruplar ?? []).reduce((n: number, g: any) => n + (g?.satirlar?.length ?? 0), 0);
const haberSayisi = kayit?.haber ?? (b?.haberler?.haber?.length ?? 0);
const olcumSaati = kayit?.olcumSaati || istanbulSaat(b.olusturma);

// ── Piyasa fotoğrafının seans dağılımı. "Ölçülen seans" en TAZE satırın
// seansıdır; 23.09.2026 sayısında elli bir satırın yirmi üçü bir seans geride
// olduğu hâlde künye yalnız "22.09.2026 Salı kapanışı" diyordu. Dağılım
// satırların kendi tarihinden sayılır — alanı taşımayan eski sayılarda da.
// Sebep (kaynağın boş verdiği seans · son işlem fiyatından kurulan kapanış)
// yalnız ölçüm katmanı onu yazdıysa söylenir; tahmin edilmez.
// 7/24 işlem gören satır (kripto) seans sayımına girmez: farklı tarihi bir
// seans ayrışması değildir ve künye her sabah yalnız Bitcoin yüzünden "50 / 51
// satır · satırlar aynı seansa ait değil" diyordu. Satırın tarih rozeti kalır.
const pSatirlar: any[] = (b?.piyasa?.gruplar ?? []).filter((g: any) => g?.id !== 'kripto')
  .flatMap((g: any) => g?.satirlar ?? []).filter((s: any) => s?.tarih);
const seansSay: [string, number][] = Object.entries(
  pSatirlar.reduce((a: Record<string, number>, s: any) => ((a[s.tarih] = (a[s.tarih] ?? 0) + 1), a), {}),
).sort((x, y) => y[0].localeCompare(x[0])) as [string, number][];
const seansKarma = seansSay.length > 1;
// ANA SEANS satırların ÇOĞUNUN tarihidir, en tazesi değil. 27.09.2026 pazar
// sayısında elli bir satırın ikisi (7/24 işlem gören Bitcoin ve bir kur)
// cumartesi damgalıydı ve künye sayıyı "Cumartesi kapanışı" diye ilan ediyordu;
// kırk dokuz satır cuma kapanışını taşıyordu. Satır içi tarih yalnız ana
// seanstan AYRILAN satırda basılır — elli satırın her birinin altında aynı
// tarihin tekrarı, gerçekten farklı olan tek satırı kalabalıkta gizliyordu.
const anaSeans: string | null = seansSay.length
  ? [...seansSay].sort((x, y) => y[1] - x[1] || y[0].localeCompare(x[0]))[0][0]
  : null;
const anaSeansSay = anaSeans ? (seansSay.find(([t]) => t === anaSeans)?.[1] ?? 0) : 0;
const seansEtiketi = (iso: string): string => `${tarihYaz(iso)} ${gunAdi(iso)} kapanışı`;
// TL faizleri tablosunda da aynı kural: yirmi beş satırın çoğu aynı güne ait;
// tarih yalnız o günden ayrılan satırda yazılır, ortak gün başlıkta.
const tlAnaTarih: string | null = (() => {
  const say: Record<string, number> = {};
  for (const t of b?.piyasa?.tr_faizleri ?? []) if (t?.tarih) say[t.tarih] = (say[t.tarih] ?? 0) + 1;
  const e = Object.entries(say).sort((x, y) => y[1] - x[1] || y[0].localeCompare(x[0]));
  return e.length ? e[0][0] : null;
})();
// 7/24 işlem gören sembol (kripto grubu) için "kaynak kapanışı vermedi"
// paragrafı yazılmaz: 25–30.09 arasında her sabah tek bir Bitcoin satırı için
// aynı 44 kelimelik paragraf basıldı. Satırın tarih rozeti yeter.
const YEDI_YIRMI_DORT = new Set<string>((b?.piyasa?.gruplar ?? [])
  .filter((g: any) => g?.id === 'kripto').flatMap((g: any) => (g?.satirlar ?? []).map((r: any) => String(r?.ad))));
const kaynakBos: any[] = (b?.piyasa?.seans_ozeti?.kaynak_bos ?? [])
  .filter((x: any) => !YEDI_YIRMI_DORT.has(String(x?.ad)));
// SATIR NOTLARI KATLANIR: tanımlar ("S&P 500 örtük oynaklığı", vadeli
// devir notu) her gün birebir aynı basılıyordu (236 kelime, %92 tekrar).
// Satırda yalnız † işareti kalır, metin grubun "Satır notları" katında.
// Döviz satırlarının kapanış anı (İstanbul 18:00 · New York 17:00). Başlıkta
// grubun ÇOĞUNLUK tanımı bir kez yazılır; tanımı ondan ayrılan satır (tek bir
// sembolün saatlik barı gelmedi, satır günlük bardan) kendi tanımını tarih
// rozetinde taşır. Yalnız tek tanım şartı konsaydı karma grupta başlık da
// susar, ayrılan satırın neden bir gün geride olduğu hiçbir yerde yazmazdı.
const kapanisTanimi = (g: any): string => {
  const say = new Map<string, number>();
  for (const r of g?.satirlar ?? []) {
    const t = r?.kapanis_tanimi ? String(r.kapanis_tanimi) : '';
    if (t) say.set(t, (say.get(t) ?? 0) + 1);
  }
  // Eşitlikte saatlik bardan kurulan tanım (kapanış anı olan) başlığa geçer.
  const yedekMi = (t: string) => /alınamadı/.test(t) ? 1 : 0;
  return [...say.entries()].sort((a, b) => b[1] - a[1] || yedekMi(a[0]) - yedekMi(b[0]))[0]?.[0] ?? '';
};
const ayrikTanim = (r: any, g: any): string =>
  r?.kapanis_tanimi && String(r.kapanis_tanimi) !== kapanisTanimi(g) ? String(r.kapanis_tanimi) : '';
const satirNotlari = (satirlar: any[], alan: string): { ad: string; not: string }[] =>
  (satirlar ?? []).filter((r: any) => String(r?.[alan] ?? '').trim()).map((r: any) => ({ ad: r.ad, not: String(r[alan]) }));
// SAYIYI NİTELEYEN NOT KATLANMAZ (01.10.2026 incelemesi): "vade geçişi
// denetlenemedi" ve "değişim yaklaşıktır" satırdaki sayının temiz olmadığını
// söyleyen tek yerdi ve katın içinde görünmez kalıyordu (27.08 Brent/WTI/RBOB).
// Ölçüm katmanı bunu `not_uyari` alanına yazar; alanı taşımayan eski sayılarda
// notun ilgili parçası aynı ölçütle ayrılır.
const NOT_UYARI = /denetlenemedi|yaklaşıktır/;
const notUyari = (r: any): string => {
  if (typeof r?.not_uyari === 'string') return r.not_uyari;
  return String(r?.not ?? '').split('; ').filter((x) => NOT_UYARI.test(x)).join('; ');
};
const sonIslemden: any[] = b?.piyasa?.seans_ozeti?.son_islemden ?? [];
const adlar = (xs: any[]) => xs.map((x) => x.ad).join(', ');
const gunler = (xs: string[]) => [...new Set(xs)].map((g) => tarihYaz(g)).join(', ');
const manset = duzMetin(String(b.manset ?? '')).trim();
// YAZI SAATİ İLK YAZIMDIR ve yalnız saat taşıyan bir damgadan okunur.
// `ilk_yazi_zamani` yoksa `yazi_zamani` sonraki bir düzeltmenin anı olabilir:
// 31.08 sayısının künyesi 8 Eylül'deki düzeltmenin saatini ("22:41") yazı
// saati diye basıyordu. O hâlde yalnız sayının kendi günündeki damga yazı
// sayılır. İlk yazım ertesi güne kaldıysa (geç sayı) saat günüyle basılır.
const yaziDamga: string | null = (b.ilk_yazi_zamani && istanbulSaat(b.ilk_yazi_zamani))
  ? b.ilk_yazi_zamani
  : [b.yazi_zamani, b.yorum_zamani].find((z: any) =>
      z && istanbulSaat(z) && istanbulIsoGun(z) === String(b.tarih)) ?? null;
const yaziBaskaGun = !!yaziDamga && istanbulIsoGun(yaziDamga) !== String(b.tarih);
// Sonraki bir düzeltmenin anı ayrıca ve adıyla yazılır: yazı saati sayılmaz,
// ama sayının sonradan düzenlendiği bilgisi okurdan saklanmaz.
const sonDuzenleme: string | null = b.yazi_zamani && istanbulSaat(b.yazi_zamani)
  && (!yaziDamga || (b.yazi_zamani > yaziDamga
    && istanbulSaat(b.yazi_zamani, 'tam') !== istanbulSaat(yaziDamga, 'tam'))) ? b.yazi_zamani : null;
const kunye = [
  // Tek adlandırma: "Sayı 34" (kicker da öyle yazar); künye "No 34" diyordu.
  kayit ? { deger: String(kayit.sayiNo), etiket: 'Sayı', vurgu: true } : null,
  { deger: olcumSaati, etiket: 'Ölçüm', alt: olcumSaati ? 'İstanbul saati' : undefined },
  // Yazı hücresi SAATİ verir: tarih başlıkta zaten yazıyor ve künye aynı günü
  // ikinci kez basıyordu. Saat çözülemezse tarih kalır.
  (b.yazi_zamani || b.yorum_zamani) ? {
    deger: yaziDamga ? istanbulSaat(yaziDamga) : tarihYaz(istanbulIsoGun(b.yorum_zamani ?? b.yazi_zamani)),
    etiket: 'Yazı',
    alt: yaziDamga ? (yaziBaskaGun ? tarihYaz(istanbulIsoGun(yaziDamga)) : 'İstanbul saati') : undefined,
  } : null,
  // Enstrüman ve taranan haber sayısı ilk ekrandan alt bilgiye indi
  // (01.10.2026): okurun kararını etkilemeyen üretim ölçüleri başlığın
  // altında iki hücre tutuyordu.
  // Değer yalnız TARİH, gün ve satır payı alt satırda: "29.09.2026 Salı
  // kapanışı" tek hücrede üç satıra kırılıyor, künyeyi komşularının üç katı
  // yüksekliğe çıkarıyordu.
  b.piyasa?.kapanis_seansi ? (anaSeans ? {
    deger: tarihYaz(anaSeans), etiket: 'Ölçülen seans',
    alt: `${gunAdi(anaSeans)} kapanışı${seansKarma ? ` · ${anaSeansSay} / ${pSatirlar.length} satır` : ''}`,
  } : { deger: String(b.piyasa.kapanis_seansi), etiket: 'Ölçülen seans' }) : null,
  b.duzeltmeler?.length ? { deger: String(b.duzeltmeler.length), etiket: 'Düzeltme', href: '#duzeltmeler', vurgu: true } : null,
].filter(Boolean) as any[];

// HAFTAYA BAKIŞIN KISA YOLU (01.10.2026). Haftalık sayı 6.000–9.000 kelimedir
// (30–45 dakikalık okuma); uzunluk ancak kısa yol açık tutulursa okunur:
// özet, okuma, senaryolar ve önümüzdeki hafta. Süre yazı katmanının kelime
// sayısından, dakikada ~200 kelime VARSAYIMIYLA hesaplanır (ölçülmedi; künye
// bunu "tahmini" diye yazar) — rehberin ve hakkında sayfasının "6.000–9.000
// kelime, 30–45 dakika" sözüyle aynı oran. Ölçülen tablolar süreye girmez.
const kelimeSay = (h: unknown) => String(h ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const DAKIKA_KELIME = 200;
const haftaYolu = Boolean(b.haftalik) && bicim3;
// Ölçülen takvim tablosunun ADI tek sabitte: başlık, içindekiler (ve dar ekranın
// bölüm şeridi) ve kısa yol aynı adı okur. Haftalıkta yazı katmanının kendi
// "Önümüzdeki hafta — gün gün" bölümü var; tablo orada "Haftanın takvimi"dir.
const onumuzdekiAd = haftaYolu ? 'Haftanın takvimi' : 'Önümüzdeki hafta';
const KISA_YOL_ID = ['risk', 'takvim'];
const kisaYol: { id: string; ad: string; n: number }[] = haftaYolu
  ? [
      ...(b.ozet?.ne_oldu ? [{ id: 'ozet', ad: 'Haftanın özeti', n: kelimeSay(b.ozet.ne_oldu) }] : []),
      ...(b.yorum ? [{ id: 'yorum', ad: 'Haftanın okuması', n: kelimeSay(b.yorum) }] : []),
      ...yaziBolumleri.filter((x: any) => KISA_YOL_ID.includes(x.id))
        .map((x: any) => ({ id: `y-${x.id}`, ad: x.baslik, n: kelimeSay(b.gundem[x.id]) })),
    ]
  : [];
const toplamKelime = haftaYolu
  ? kelimeSay(b.ozet?.ne_oldu) + kelimeSay(b.yorum)
    + yaziBolumleri.reduce((n: number, x: any) => n + kelimeSay(b.gundem[x.id]), 0)
  : 0;
const dakika = (n: number) => Math.max(1, Math.round(n / DAKIKA_KELIME));
if (haftaYolu && toplamKelime > 0) {
  kunye.push({ deger: `~${dakika(toplamKelime)} dk`, etiket: 'Okuma',
               alt: `tahmini · kısa yol ~${dakika(kisaYol.reduce((n, x) => n + x.n, 0))} dk` });
}
// Haftanın karnesi (ölçülen): bir önceki haftalık sayıdan bu yana kapanan,
// açılan ve vadesi önümüzdeki haftaya düşen sözler (bulten/soz.hafta_karnesi).
const haftaKarne: any = haftaYolu ? (b.izleme?.hafta ?? null) : null;
const ISABET_SINIF: Record<string, string> = { 'tuttu': 'tuttu', 'kısmen': 'kismen', 'tutmadı': 'tutmadi' };
// Eşiğin altında kalan haftalık güncellemeler (bulten/olay.hafta_tablosu).
const haftaTablosu: any[] = haftaYolu && Array.isArray(b.hafta_tablosu) ? b.hafta_tablosu : [];
const haftaTabloSatir = haftaTablosu.reduce((n: number, g: any) => n + (g.satirlar?.length ?? 0), 0);


// Takvim eskiden iki kez yazılıyordu: "Kritik takvim" birinci derece verilerin
// geri sayımı, "Takvim" ise haftalara bölünmüş tam liste — aynı olay iki
// bölümde birden görünüyordu. Artık tek bölüm: önce geri sayım, sonra tam
// listenin GERİ KALANI. Eşleştirme olay adı + tarih üzerinden yapılır.
//
// "BUGÜN NE VAR" TEK YERDE CEVAPLANIR. Geri sayım yalnız birinci derece
// verileri taşıdığı için aynı sabahın olayları iki listeye bölünüyordu: 10:00'daki
// İşgücü geri sayımda, aynı saatteki Dış ticaret alttaki haftalık tabloda. Bugünün
// ── AYNI YAYIMIN ALT TABLOLARI TEK SATIRDIR
// Kaynak takvim bir yayımı alt tablolarıyla ayrı ayrı sayıyor (BDDK aylık
// bankacılık verisi on bir, haftalık verisi altı tablo) ve sayfa her birini
// ayrı satır basıyordu: 27.09 sayısının 69 takvim satırının 37'si aynı
// (gün, saat, olay) üçlüsünün tekrarıydı. Satır bir kez basılır; alt
// tabloların adları ortak baş ve son ekleri ayıklanarak dipnotta durur —
// kayıt kaybolmaz, yalnız bir kez okunur.
const ortakBas = (xs: string[]): string => {
  let n = 0;
  while (xs.every((x) => x.length > n && x[n] === xs[0][n])) n++;
  const b = xs[0].slice(0, n);
  return b.includes(' ') && n < Math.min(...xs.map((x) => x.length)) ? b.slice(0, b.lastIndexOf(' ') + 1) : '';
};
const ortakSon = (xs: string[]): string => {
  const ters = ortakBas(xs.map((x) => [...x].reverse().join('')));
  return [...ters].reverse().join('');
};
const tekYayim = (liste: any[]): any[] => {
  const sira: any[] = [];
  const grup = new Map<string, any>();
  for (const k of liste) {
    const a = `${k.tarih}|${k.saat ?? ''}|${k.olay}`;
    const g = grup.get(a);
    if (g) {
      g._notlar.push(String(k.not_ ?? '').trim()); g._resmi.push(String(k.resmi_ad ?? '').trim());
      if ((k.onem ?? 9) < (g.onem ?? 9)) g.onem = k.onem;
      continue;
    }
    const yeni = { ...k, _notlar: [String(k.not_ ?? '').trim()], _resmi: [String(k.resmi_ad ?? '').trim()] };
    grup.set(a, yeni);
    sira.push(yeni);
  }
  for (const k of sira) {
    const resmi = [...new Set(k._resmi.filter(Boolean))] as string[];
    // Dipnot alt tabloları sayar; TÜİK kaydında adlar `resmi_ad`a taşındığı için
    // not boşsa adlar oradan okunur — yoksa "N tablo" yalnız title niteliğinde
    // kalıyor, dokunmatik ekranda ve ekran okuyucuda görünmüyordu.
    const notlarHam = [...new Set(k._notlar.filter(Boolean))] as string[];
    const notlar = notlarHam.length > 0 ? notlarHam : (k._notlar.length > 1 ? resmi : []);
    k.resmi_ad = resmi.join(' · ');
    delete k._resmi;
    if (k._notlar.length > 1 && notlar.length > 0) {
      const bas = notlar.length > 1 ? ortakBas(notlar) : '';
      const son = notlar.length > 1 ? ortakSon(notlar.map((x) => x.slice(bas.length))) : '';
      const parca = notlar.map((x) => x.slice(bas.length, x.length - son.length).trim()).filter(Boolean);
      const cerceve = [bas.trim(), son.trim()].filter(Boolean).join(' … ');
      k.not_ = `${cerceve ? `${cerceve} — ` : ''}${k._notlar.length} tablo${parca.length ? `: ${parca.join(' · ')}` : ''}`;
    }
    delete k._notlar;
  }
  return sira;
};

// ── PAZAR DÜZENİ ("Haftaya bakış")
// Pazar sayısı günlükten yalnız etiketleriyle ayrılıyordu: aynı sıra, haftanın
// hareketi sayfanın ortasında altı satırlık bir listede, önümüzdeki haftanın
// takvimi altıncı ekranda. Haftalık okurun ilk iki sorusu "hafta ne getirdi"
// ve "önümüzdeki hafta ne var"; ikisi de gösterge şeridinin hemen altına çıkar.
// YENİ SAYI ÜRETİLMEZ: tablo ölçüm katmanının satır alanlarından (h1 ·
// sigma_hafta · h1_sigma) olağandışılık listesinin KENDİ kuralıyla kurulur
// (bulten/piyasa.en_cok_hareket: σ taşıyan her satır, |σ|'ya göre) — o liste
// bu tablonun ilk altı satırıdır, tablo onun yerini alır. Alanları taşımayan
// eski sayılar günlük sırayla basılmaya devam eder.
const HAFTA_HAREKET_AZAMI = 15;
const haftaHareket: any[] = b.haftalik && b.piyasa?.en_cok_hareket?.sigma_kip === 'haftalik'
  ? (b.piyasa?.gruplar ?? [])
      .flatMap((g: any) => (g.satirlar ?? []).map((s: any) => ({ ...s, grupBaslik: g.baslik })))
      .filter((s: any) => typeof s.h1_sigma === 'number' && typeof s.h1 === 'number')
      .sort((x: any, y: any) => Math.abs(y.h1_sigma) - Math.abs(x.h1_sigma))
      .slice(0, HAFTA_HAREKET_AZAMI)
  : [];
const pazarDuzeni = haftaHareket.length > 0;
// BÜTÜN kayıtları (derecesi ne olursa olsun) önce ve saat sırasıyla basılır;
// geri sayım ve haftalık tablolar bugünü tekrar etmez.
const takvimAnahtar = (k: any) => `${k.olay}|${k.tr_tarih}|${k.saat ?? ''}|${k.not_ ?? ''}`;
const bugunIso = String(b.tarih ?? '');
const bugunKayitlar: any[] = [];
{
  const gorulen = new Set<string>();
  const adaylar = [
    ...(b.kritik_takvim ?? []).filter((k: any) => k.kalan_gun === 0 || k.tarih === bugunIso),
    ...(b.takvim ?? []).flatMap((t: any) => t.kayitlar ?? []).filter((k: any) => k.tarih === bugunIso),
  ];
  for (const k of adaylar) {
    const a = takvimAnahtar(k);
    if (!gorulen.has(a)) { gorulen.add(a); bugunKayitlar.push(k); }
  }
  bugunKayitlar.sort((x, y) => String(x.saat || '99:99').localeCompare(String(y.saat || '99:99'))
    || (x.onem ?? 9) - (y.onem ?? 9));
}
const bugunAnahtar = new Set(bugunKayitlar.map(takvimAnahtar));
// Önümüzdeki haftanın BÜTÜN kayıtları (birinci derece dahil) tek listede ve
// gün gün; geri sayım ve haftalık tablolar onları tekrar etmez.
const ilkHaftaBaslik = /^Önümüzdeki hafta/i;
const onumuzdekiHafta: any[] = pazarDuzeni
  ? ((b.takvim ?? []).find((t: any) => ilkHaftaBaslik.test(String(t.baslik ?? '')))?.kayitlar ?? [])
      .filter((k: any) => !bugunAnahtar.has(takvimAnahtar(k)))
      .slice()
      .sort((x: any, y: any) => String(x.tarih).localeCompare(String(y.tarih))
        || String(x.saat || '99:99').localeCompare(String(y.saat || '99:99')))
  : [];
// Anahtar kümesi TOPLAMADAN önce kurulur: geri sayım ve haftalık tablolar ham
// kayıtla eşleşir, toplanmış satırın dipnotu anahtarı değiştirir.
const onumuzdekiAnahtar = new Set(onumuzdekiHafta.map(takvimAnahtar));
const onumuzdekiSatirlar = tekYayim(onumuzdekiHafta);
// Günlük sayıda geri sayım iki haftayla sınırlı; daha ötesi haftalık
// tablolarda kalır (kayıt kaybolmaz). Pazar sayısı ufku olduğu gibi basar.
const KRITIK_UFUK_GUN = 14;
const kritikler = (b.kritik_takvim ?? []).filter((k: any) =>
  !bugunAnahtar.has(takvimAnahtar(k)) && !onumuzdekiAnahtar.has(takvimAnahtar(k))
  && (b.haftalik || typeof k.kalan_gun !== 'number' || k.kalan_gun <= KRITIK_UFUK_GUN));
const kritikAnahtar = new Set(kritikler.map((k: any) => `${k.olay}|${k.tr_tarih}`));
const takvimGruplari = (b.takvim ?? [])
  .filter((t: any) => !(onumuzdekiHafta.length > 0 && ilkHaftaBaslik.test(String(t.baslik ?? ''))))
  .map((t: any) => ({
    ...t,
    kayitlar: t.kayitlar.filter((k: any) =>
      !kritikAnahtar.has(`${k.olay}|${k.tr_tarih}`) && !bugunAnahtar.has(takvimAnahtar(k))),
  }))
  .filter((t: any) => t.kayitlar.length > 0);
const takvimVar = kritikler.length > 0 || takvimGruplari.length > 0;

// AYNI OLAY İKİ BÖLÜMDE ANLATILMAZ — takvimdeki kalıbın eşi, bu kez olaylar için.
// Ölçüldü (07.09.2026, 13 sayı): "Öne çıkanlar" bölümündeki maddeler "Hat hat
// değişim"de BİREBİR tekrar ediyordu. Okur aynı cümleyi iki kez okuyor ve
// ikincisinde yeni bir şey öğrenmiyor.
//
// SÜZGEÇ YALNIZ GERÇEKTEN BASILAN BÖLÜMDEN KURULUR. İlk yazımda küme
// `one_cikanlar` ARTI `notlar`dan kuruluyordu ve üstündeki yorum "notlar
// YUKARIDA duruyor" diyordu — oysa bu bileşende `id="notlar"` diye bir bölüm
// HİÇ OLMADI; `b.notlar` dosyaya ilk kez o commit'le, yalnız bu kümenin içinde
// girdi. Sonuç: `dikkat` seviyesindeki olaylar hem hiçbir yerde basılmıyor hem
// de basıldıkları varsayılarak hat hat listesinden SÜZÜLÜYORDU. Ölçüldü
// (10.09.2026, derlenmiş 17 sayı): 108 dikkat olayının 108'i sayfada yok,
// kontrol olarak 37 önemli olayın 37'si var; 08–10.09 sayılarında
// `one_cikanlar` boş olduğu için okura ölçüm cümlesi HİÇ ulaşmıyordu.
// Bir süzgecin dayandığı varsayım yazıldığı gün ölçülmezse, süzgeç kendi
// gerekçesinden bağımsız olarak yaşamaya devam eder.
//
// `notlar` kovası JSON'da duruyor (denetim ve yazı katmanı onu okuyor) ama
// SAYFANIN tek dikkat-seviyesi evi `gruplar`dır: uret.py o kovaya önemli VE
// dikkat olayların hepsini konu konu yazıyor, yani içerik kaybı yok.
// Anahtar hat+anahtar çifti: aynı ölçüden doğan olay tekildir.
const anilanOlay = new Set(
  (b.one_cikanlar ?? [])
    .filter((o: any) => o?.hat && o?.anahtar)
    .map((o: any) => `${o.hat}|${o.anahtar}`),
);
// Biçim 3'te ayrı "Öne çıkanlar" bölümü YOK: önemli maddeler veri bloğunda
// kalın basılır, yani süzgeç uygulanmaz (süzülen olay hiçbir yerde kalmazdı).
const gruplarKalan = (b.gruplar ?? [])
  .map((g: any) => ({
    ...g,
    olaylar: (g.olaylar ?? []).filter(
      (o: any) => bicim3 || !(o?.hat && o?.anahtar && anilanOlay.has(`${o.hat}|${o.anahtar}`)),
    ),
  }))
  .filter((g: any) => g.olaylar.length > 0);

// SONUÇ VEREMEYEN SATIR BASILMAZ (01.10.2026): "takip dışı" ve "hat bu
// büyüklüğü üretmiyor" arşivdeki 155 satırın 74'üydü ve okura bir sonuç
// vermiyordu; ölçüm katmanı artık onları yazmıyor, eski sayılarda da basılmaz.
// "Veri henüz hatta düşmedi" boru hattımızın adıydı: okur diline çevrilir.
const SONUCSUZ = new Set(['takip dışı', 'hat bu büyüklüğü üretmiyor']);
const sonucGoster: any[] = (b.sonuclar ?? []).filter((x: any) => !SONUCSUZ.has(String(x?.durum ?? '')));
// Eski sayılarda bu satır saati gelmemiş bugünkü olaylar için de yazılmıştı;
// "yayımlandı" denemez, yalnız sayının ölçümde olmadığı söylenir.
const durumYaz = (d: unknown): string =>
  String(d ?? '') === 'veri henüz hatta düşmedi' ? 'sayı bu ölçümde yok' : String(d ?? '');
// Etiket durumla birlikte seçilir: "Henüz yok. yayımlandı; sayı bu ölçüme henüz
// girmedi" iki kez "henüz" diyor ve ikinci cümle küçük harfle başlıyordu.
const durumParca = (d: unknown): { etiket: string; metin: string } => {
  const t = durumYaz(d);
  const m = /^yayımlandı;\s*(.*)$/.exec(t);
  return m ? { etiket: 'Yayımlandı.', metin: m[1] ? m[1][0].toLocaleUpperCase('tr-TR') + m[1].slice(1) : '' }
           : { etiket: 'Henüz yok.', metin: t ? t[0].toLocaleUpperCase('tr-TR') + t.slice(1) : '' };
};
// Sayısı gelmemiş BUGÜNKÜ olayın "tepkisi" önceki seansın hareketidir, olayın
// değil: 03.09'da 10:00 TÜFE'nin altına 07:31 ölçümünde dünkü BIST −%1,25
// "Piyasa (1 gün)" diye basılmıştı (arşivde 16 satırın 16'sı).
const tepkiGoster = (x: any): boolean =>
  x?.tepki?.kalemler?.length > 0 && !(x.durum !== 'geldi' && Number(x.yas_gun) === 0);
// İçindekiler: yalnız GERÇEKTEN basılan bölümler listelenir. Koşulları
// bölümlerin kendi koşullarıyla birebir aynı tutmak şart — yoksa boşa çıkan
// bir bağlantı okuru hiçbir yere götürmez.
// Olağandışılık bölümünün penceresi bültenin kipini izler: günlük bültende gün,
// haftaya bakışta HAFTA. Ölçüm katmanı hangi pencereyi kullandığını
// `en_cok_hareket.sigma_kip` ile söylüyor; başlık ve sütun adları ondan türetilir.
// (Eski sürüm haftalık bültende de "Günün olağandışı hareketleri" yazıyor ve
// haftalık σ'yı "günlük σ" diye etiketliyordu.)
const sigmaHaftalik = b.piyasa?.en_cok_hareket?.sigma_kip === 'haftalik';
const sigmaSatirlar: any[] = b.piyasa?.en_cok_hareket?.sigma ?? [];
const sigmaAsan = sigmaSatirlar.filter((x: any) => Math.abs(Number(x?.sigma) || 0) >= OLAGANDISI_SIGMA);
const haberTonu: any[] = Array.isArray(b.haber_tonu) ? b.haber_tonu : [];
const sigmaBaslik = sigmaBasligi(
  (b.piyasa?.en_cok_hareket?.sigma ?? []).map((x: any) => Number(x?.sigma) || 0), sigmaHaftalik);

// On beş satırın çoğu olağandışı DEĞİLDİR: başlık tabloyu anlatır, kaç satırın
// eşiği aştığını alt not söyler (sigmaBasligi'nin "olağandışı" sözü burada
// eşiği aşmayan satırları da kapsardı).
const haftaBaslik = 'Haftanın hareketleri';
const haftaAsan = haftaHareket.filter((x: any) => Math.abs(x.h1_sigma) >= OLAGANDISI_SIGMA).length;
const bolumler = [
  !bicim3 && b.duzeltmeler?.length > 0 && { id: 'duzeltmeler', ad: 'Düzeltmeler' },
  b.ozet && (b.ozet.ne_oldu || b.ozet.ne_bekleniyor) &&
    (bicim3
      ? { id: 'ozet', ad: b.haftalik ? 'Haftanın özeti' : 'Bu sabah' }
      : { id: 'ozet', ad: b.haftalik ? 'Geçen hafta / önümüzdeki hafta' : 'Ne oldu / ne bekleniyor', kisa: 'Özet' }),
  bicim3 && b.duzeltmeler?.length > 0 && { id: 'duzeltmeler', ad: 'Düzeltmeler' },
  b.gostergeler?.length > 0 && { id: 'gostergeler', ad: 'Gösterge şeridi' },
  !bicim3 && b.one_cikanlar?.length > 0 && { id: 'one-cikanlar', ad: 'Öne çıkanlar' },
  (bicim3 || gruplarKalan.length > 0) && (bicim3
    ? { id: 'hat-hat', ad: b.haftalik ? 'Bu hafta gelen veriler' : 'Dünden bu yana gelen veriler', kisa: 'Gelen veriler' }
    : { id: 'hat-hat', ad: 'Hat hat değişim' }),
  sonucGoster.length > 0 && { id: 'sonuclar', ad: 'Ne bekleniyordu, ne geldi', kisa: 'Sonuçlar' },
  bugunKayitlar.length > 0 && { id: 'bugun', ad: 'Bugün' },
  pazarDuzeni && { id: 'hafta-hareket', ad: haftaBaslik },
  onumuzdekiHafta.length > 0 && { id: 'onumuzdeki-hafta', ad: onumuzdekiAd },
  b.yorum && { id: 'yorum', ad: b.haftalik ? 'Haftanın okuması' : 'Günün okuması' },
  // Yazı bölümleri ve işlem fikirleri basımla AYNI diziden (yaziAkisi).
  ...yaziAkisi.map((x: any) => (x.fikir ? FIKIR_BOLUM : { id: `y-${x.id}`, ad: x.baslik })),
  b.rejim?.length > 0 && { id: 'rejim', ad: 'Rejim panosu' },
  !pazarDuzeni && (sigmaSatirlar.length > 0 || haberTonu.length > 0) &&
    { id: 'olagandisi', ad: sigmaBaslik, kisa: 'En büyük hareketler' },
  b.piyasa?.gruplar?.length > 0 && { id: 'piyasa', ad: 'Piyasa fotoğrafı' },
  (b.izleme?.acik?.length > 0 || b.izleme?.kapanan?.length > 0) &&
    { id: 'soz-defteri', ad: 'Söz defteri' },
  takvimVar && { id: 'takvim', ad: 'Takvim' },
  b.temalar?.temalar?.length > 0 && { id: 'temalar', ad: 'İzlenen temalar' },
  b.haberler?.bolumler?.length > 0 && { id: 'gundem', ad: bicim3 ? 'Haber akışı' : 'Gündem' },
  b.veri_gunlugu?.length > 0 && { id: 'veri-gunlugu', ad: 'Veri günlüğü' },
].filter(Boolean) as { id: string; ad: string; kisa?: string }[];
// `kisa`: dar ekranın bölüm ŞERİDİNDE basılan ad. 320 pikselde uzun başlık
// (328 px) şeride (284 px) sığmıyor, etkin bölüm hiçbir kaydırma konumunda
// tam görünmüyordu. Tam ad yan sütunda ve bölümün kendi başlığında durur.

---

<article class="bulten">
  <header class="ust">
    {/* BAŞLIK = GÜNÜN TEZİ. h1 yalnız tarihti ve tez ancak üçüncü ekranda
        başlıyordu. Yazı katmanı `manset` yazdıysa başlık o cümledir ve tarih
        üstteki etikete iner; yazmadıysa (bütün eski sayılar) başlık tarihtir. */}
    <p class="etiket kicker">
      {b.haftalik ? 'Haftaya bakış' : 'Günlük bülten'}
      {kayit && <span class="kicker-sayi"> · Sayı {kayit.sayiNo}</span>}
      {manset && <span class="kicker-sayi"> · {b.tr_tarih} {b.gun}</span>}
    </p>
    {manset
      ? <h1 class="manset-h1">{manset}</h1>
      : <h1>{b.tr_tarih} <span class="gun">{b.gun}</span></h1>}
    {/* Her sayıda birebir aynı basılan tanıtım paragrafı kaldırıldı: okura o
        sayıya dair hiçbir şey söylemiyordu. Haftalık sayının farkı rozetle kalır. */}
    {b.haftalik && <p class="haftalik-rozet">geçen hafta ve önümüzdeki hafta</p>}
    <Kunye hucreler={kunye} genis etiket="Sayı künyesi" />
    {kisaYol.length > 1 && (
      <p class="kisa-yol">
        <span class="ky-etiket">Kısa yol (~{dakika(kisaYol.reduce((n, x) => n + x.n, 0))} dk)</span>
        {kisaYol.map((x, i) => <>{i > 0 && ' · '}<a href={`#${x.id}`}>{x.ad}</a></>)}
        {/* Gün gün bölümün beklenti sayıları ölçülen takvim tablosundadır;
            kısa yol onu da gösterir (tablo okuma süresine girmez). */}
        {onumuzdekiSatirlar.length > 0 && <> · <a href="#onumuzdeki-hafta">{onumuzdekiAd}</a></>}
      </p>
    )}
    {ayniGun.length > 0 && (
      <ul class="ayni-gun" aria-label="Aynı gün yayımlananlar">
        {ayniGun.map((x) => (
          <li><span class="ag-tur">{x.tur}</span> <a href={x.href}>{x.ad}</a></li>
        ))}
      </ul>
    )}
  </header>

  {/* İKİ SÜTUN. 1360 pikselde bülten 74ch'lik tek sütunda duruyor, sağdaki
      ~460 piksel her ekranda boş kalıyordu; 46 ekranlık bir sayfada okur
      nerede olduğunu ve sıradaki bölümü göremiyordu. Geniş ekranda
      içindekiler sağda yapışık bir sütun, dar ekranda üstte yapışık bir
      bölüm şeridi; etkin bölüm işaretlenir. */}
  <div class="bulten-izgara">
  {bolumler.length > 2 && (
    <nav class="icindekiler" aria-label="Bülten bölümleri">
      <p class="ic-baslik">Bu sayıda</p>
      <ol>
        {bolumler.map((x) => (
          <li><a href={`#${x.id}`}>{x.kisa
