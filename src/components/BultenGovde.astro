          bölümü de var: iki başlık aynı adı taşımasın (ölçülen tablo takvimdir). */}
      <h2>{onumuzdekiAd} <span class="adet">{onumuzdekiSatirlar.length} yayım · saatler TSİ</span></h2>
      <div class="takvim-blok">
        <table class="takvim">
          <caption class="gorunmez">Önümüzdeki hafta: tarih, saat, ülke ve olay</caption>
          <colgroup><col class="c-tarih" /><col class="c-saat" /><col class="c-ulke" /><col /></colgroup>
          <thead class="gorunmez">
            <tr><th scope="col">tarih</th><th scope="col">saat</th><th scope="col">ülke</th><th scope="col">olay</th></tr>
          </thead>
          <tbody>
            {onumuzdekiSatirlar.map((k: any, i: number) => (
              <tr class:list={[{ kritik: k.onem === 1, 'gun-bas': i === 0 || onumuzdekiSatirlar[i - 1].tarih !== k.tarih }]}>
                <td class="t-tarih">{i === 0 || onumuzdekiSatirlar[i - 1].tarih !== k.tarih
                  ? <>{k.tr_tarih}<span class="t-gun">{k.gun}</span></> : ''}</td>
                <td class="t-saat">{k.saat || '—'}</td>
                <td class="t-ulke">{k.ulke}</td>
                <td class="t-olay">
                  <span title={k.resmi_ad || undefined}>{k.olay}</span>
                  {k.kesinlik && k.kesinlik !== 'kesin' && <span class="damga">tarih kesinleşmedi</span>}
