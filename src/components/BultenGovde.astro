          cümle olarak yazılmayan seriler. Önceki değer, o sayının ölçüldüğü andaki değerdir; her
          satır kendi dönemini taşır.</p>
          {haftaTablosu.map((g: any) => (
            <div class="ht-grup">
              <h3>{g.baslik}</h3>
              <div class="p-kaydir" tabindex="0" role="region" aria-label={`${g.baslik}: kaydırılabilir tablo`} data-kaydir>
                <table class="ht">
                  <caption class="gorunmez">{g.baslik}: seri, dönem, değer, önceki değer ve fark</caption>
                  <thead><tr><th scope="col">Seri</th><th scope="col">Dönem</th><th scope="col" class="say">Değer</th><th scope="col" class="say">Önceki</th><th scope="col" class="say">Fark</th></tr></thead>
                  <tbody>
                    {g.satirlar.map((r: any) => (
                      <tr>
                        <th scope="row">{r.ad}</th>
                        <td class="nb">{r.donem}</td>
                        <td class="say nb">{r.deger}</td>
                        <td class="say nb">{r.onceki}{r.onceki_donem && <span class="ht-donem"> ({r.onceki_donem})</span>}</td>
                        <td class="say nb">{r.fark || '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </details>
      )}
    </section>
  )}

  {sonucGoster.length > 0 && (
    <section class="blok sonuclar" id="sonuclar">
