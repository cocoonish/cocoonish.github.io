                  <span class="kaynak-not">
                    {ad(o) && (sayfa(o) ? <a href={sayfa(o)!}>{ad(o)}</a> : ad(o))}
                    {o.aciklama && <span class="olay-neden">{ad(o) ? ' · ' : ''}{o.aciklama}</span>}
                  </span>
