  {(bicim3 || gruplarKalan.length > 0) && (
    <section class="blok veriler" id="hat-hat">
      <h2>{bicim3 ? (b.haftalik ? 'Bu hafta gelen veriler' : 'Dünden bu yana gelen veriler') : 'Hat hat değişim'}</h2>
