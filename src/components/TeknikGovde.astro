---
/**
 * Haftalık teknik analiz bülteninin gövdesi — çok zaman dilimli.
 *
 * Ölçülen katman teknik/olc.py'den gelir (1 saatlik / 4 saatlik / günlük
 * dilimlerde göstergeler, seviyeler, yapı ölçümü, grafikler); yorum katmanı
 * bir Claude oturumunca yazılır ve teknik/yaz.py kapısından geçer — andığı
 * her sayı ölçümde birebir vardır.
 */
import GrafikEmbed from './GrafikEmbed.astro';
import Kunye from './Kunye.astro';
import { istanbulSaat, tarihUzun, sayi as bicimSayi, degisim, yuzde } from '../lib/bicim';
import type { TeknikKaydi } from '../lib/yayinlar';
import { xTeknik } from '../lib/x';
import { FERAGAT } from '../consts';

interface Props {
  b: any;
  /** Sayı numarası ve ölçüm kimliği — lib/yayinlar.ts kaydı. */
  kayit?: TeknikKaydi;
}
const { b, kayit } = Astro.props;

const xGonderi = xTeknik(b.tarih);
// Zaman dilimleri veriden: bir enstrümanın dilimi kaynakta yoksa künye onu
// "üç dilim" diye saymaz; ölçülemeyen dilim sayısı ayrıca yazılır.
const DILIM_AD: Record<string, string> = { s1: '1 saatlik', s4: '4 saatlik', gun: 'günlük' };
const dilimSayac: Record<string, number> = {};
let dilimEksik = 0;
for (const e of b.enstrumanlar ?? []) {
  for (const [kod, m] of Object.entries<any>(e.dilimler ?? {})) {
    if (m && !m.eksik) dilimSayac[kod] = (dilimSayac[kod] ?? 0) + 1;
    else dilimEksik += 1;
  }
}
const dilimAdlari = Object.keys(DILIM_AD).filter((k) => dilimSayac[k]).map((k) => DILIM_AD[k]).join(' · ') || '—';

const kunye = [
  kayit ? { deger: `No ${kayit.sayiNo}`, etiket: 'Sayı', vurgu: true } : null,
  { deger: istanbulSaat(b.olcum_zamani), etiket: 'Ölçüm', alt: istanbulSaat(b.olcum_zamani, 'tam').replace(/ \d{2}:\d{2}$/, '') },
  b.veri_ucu ? { deger: tarihUzun(b.veri_ucu), etiket: 'Veri ucu', alt: 'son kapanmış seans' } : null,
  { deger: String((b.enstrumanlar ?? []).length), etiket: 'Enstrüman' },
  { deger: dilimAdlari, etiket: 'Zaman dilimi', alt: dilimEksik ? `${dilimEksik} dilim ölçülemedi` : undefined },
  { deger: 'İstanbul', etiket: 'Saat dilimi', alt: 'bar kapanışları' },
  b.yorum_zamani ? { deger: istanbulSaat(b.yorum_zamani), etiket: 'Yorum', alt: istanbulSaat(b.yorum_zamani, 'tam').replace(/ \d{2}:\d{2}$/, '') } : null,
  b.duzeltmeler?.length ? { deger: String(b.duzeltmeler.length), etiket: 'Düzeltme', href: '#duzeltmeler', vurgu: true } : null,
  xGonderi ? { deger: 'X gönderisi ↗', etiket: 'Paylaşım', href: xGonderi.url } : null,
].filter(Boolean) as any[];

// Şekil numaraları boşluksuz: eksik dilimin grafiği numara tüketmez.
const grafikNo = new Map<string, string>();
let sayac = 0;
for (const e of b.enstrumanlar ?? [])
  for (const d of ['s1', 's4', 'gun'])
    if (e.grafikler?.[d]) grafikNo.set(`${e.slug}:${d}`, String(++sayac).padStart(2, '0'));

const DILIMLER = [
  { kod: 's1', ad: '1 saatlik' },
  { kod: 's4', ad: '4 saatlik' },
  { kod: 'gun', ad: 'Günlük' },
];

// Sayı ve tarih biçimi lib/bicim'den: eksi U+2212, yüzde önde, İstanbul saati.
const sayi = (x: number | null | undefined, ondalik = 2) =>
  x === null || x === undefined ? '—' : bicimSayi(x, Math.min(Math.max(ondalik, 0), 4));

const isaretli = (x: number | null | undefined, birim: string) =>
  x === null || x === undefined ? '—' : degisim(x, birim.trim(), 2);

const tarihTr = (t: string | null) => (t ? tarihUzun(t) : '—');

// Bar zamanı İstanbul saatiyle: "28 Ağu 21:20"; günlük barlarda yalnız gün.
const kisaZaman = (t: string | null) => {
  if (!t) return '—';
  if (t.length <= 10) return new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(t + 'T00:00:00Z'));
  const d = new Date(/(Z|[+-]\d{2}:\d{2})$/.test(t) ? t : t + 'Z');
  return new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Istanbul' }).format(d);
};
---

<article class="teknik">
  <header class="kunye">
    <p class="etiket kicker">Haftalık teknik analiz{kayit && <span class="kicker-sayi"> · Sayı {kayit.sayiNo}</span>}</p>
    <h1>{b.tr_tarih}</h1>
    <Kunye hucreler={kunye} genis etiket="Sayı künyesi" />
    <p class="metodoloji">
      Her enstrüman üç zaman diliminde (1 saatlik, 4 saatlik, günlük) ayrı ayrı
      ölçülür: göstergeler, pivot destek/direnç bölgeleri, regresyon kanalı ve
      piyasa yapısı (salınım tepeleri/dipleri, sıkışma, çift tepe/dip) —
      hepsi kapanmış barlardan, deterministik hesapla. Yorum ve senaryolar
      yapay zekâ tarafından bu ölçümün üzerine yazılır ve dilimler ortak bir
      görüşte birleştirilir; yorumda anılan her sayının ölçümde karşılığı
      vardır. Bu sayfa analizdir, yatırım tavsiyesi değildir.
    </p>
  </header>

  {b.duzeltmeler?.length > 0 && (
    <section class="duzeltmeler" id="duzeltmeler">
      <h2>Düzeltmeler</h2>
      <ul class="duzeltme-liste">
        {b.duzeltmeler.map((d: any) => (
          <li>
            <span class="d-tarih">{tarihUzun(d.tarih)}</span>
            <span class="d-govde">
              <strong>{d.alan}</strong>
              <span class="d-degerler">yayımlanan <s>{d.eski}</s> yerine <b>{d.yeni}</b></span>
              {d.sebep && <span class="d-sebep">{d.sebep}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {b.giris && <div class="giris" set:html={b.giris} />}

  {
    b.enstrumanlar.map((e: any, i: number) => (
      <section class="enstruman">
        <div class="baslik">
          <h2>{e.ad}</h2>
          <span class="son">
            {sayi(e.son, e.ondalik)}
            {e.birim && <small> {e.birim}</small>}
            <small class="bar-tarih"> · {tarihTr(e.bar_tarihi)}</small>
          </span>
        </div>

        {/* Şema toleransı: 30.08 dağıtımında eski (tek dilimli) yazılmış JSON
            ile yeni bileşen çakıştı ve BÜTÜN site derlemesi düştü. Alan
            eksikse satır atlanır; bir sayının yokluğu siteyi indiremez. */}
        <p class="degisim etiket">
          1 hafta {isaretli(e.degisim?.h1, e.tip === 'getiri' ? 'bp' : '%')} · 1 ay{' '}
          {isaretli(e.degisim?.a1, e.tip === 'getiri' ? 'bp' : '%')} · 3 ay{' '}
          {isaretli(e.degisim?.a3, e.tip === 'getiri' ? 'bp' : '%')} · yılbaşından{' '}
          {isaretli(e.degisim?.ybb, e.tip === 'getiri' ? 'bp' : '%')} · 52 haftalık aralık{' '}
          {sayi(e.aralik52?.dusuk, e.ondalik)}–{sayi(e.aralik52?.yuksek, e.ondalik)}
          {e.aralik52?.konum_pct !== undefined && e.aralik52?.konum_pct !== null && ` (konum ${yuzde(e.aralik52.konum_pct, 0)})`}
          {e.haftalik?.h10 && ` · haftalık ortalamalar: 10 haftalık ${sayi(e.haftalik.h10, e.ondalik)} · 40 haftalık ${sayi(e.haftalik.h40, e.ondalik)} · haftalık RSI ${sayi(e.haftalik.rsi14, 1)}`}
        </p>

        <div class="tablo-sar">
          <table class="olcum">
            <caption class="gorunmez">{e.ad} — üç zaman diliminde göstergeler, oynaklık, kanal ve yapı</caption>
            <thead>
              <tr>
                <th scope="col">Dilim</th>
                <th scope="col">Son</th>
                <th scope="col">RSI</th>
                <th scope="col">MACD hist</th>
                <th scope="col">SMA50</th>
                <th scope="col">SMA200</th>
                <th scope="col"><abbr title="14 barlık ortalama gerçek aralık, fiyata oranı">ATR14</abbr></th>
                <th scope="col"><abbr title="Bollinger bandı alt–üst">Bant</abbr></th>
                <th scope="col"><abbr title="Regresyon kanalı alt–üst ve fiyatın kanaldaki konumu">Kanal</abbr></th>
                <th scope="col">Yapı</th>
              </tr>
            </thead>
            <tbody>
              {DILIMLER.map((d) => {
                const m = e.dilimler?.[d.kod];
                return m && !m.eksik ? (
                  <tr>
                    <th scope="row">{d.ad}<small class="alt-zaman">{kisaZaman(m.bar_zamani)}</small></th>
                    <td>{sayi(m.son, e.ondalik)}</td>
                    <td>{sayi(m.momentum?.rsi14, 1)}</td>
                    <td>{sayi(m.momentum?.macd_hist, e.ondalik + 1)}</td>
                    <td>{sayi(m.hareketli?.g50, e.ondalik)}</td>
                    <td>{sayi(m.hareketli?.g200, e.ondalik)}</td>
                    <td>{m.oynaklik?.atr14_pct !== undefined ? yuzde(m.oynaklik.atr14_pct, 2) : '—'}</td>
                    <td>{m.bant ? `${sayi(m.bant.alt, e.ondalik)}–${sayi(m.bant.ust, e.ondalik)}` : '—'}</td>
                    <td>{m.kanal ? `${sayi(m.kanal.alt, e.ondalik)}–${sayi(m.kanal.ust, e.ondalik)} · ${yuzde(m.kanal.konum_pct, 0)}` : '—'}</td>
                    <td class="yapi">
                      {m.yapi?.karakter ?? '—'}
                      {m.yapi?.cift_tepe && ` · çift tepe ${sayi(m.yapi.cift_tepe.seviye, e.ondalik)}`}
                      {m.yapi?.cift_dip && ` · çift dip ${sayi(m.yapi.cift_dip.seviye, e.ondalik)}`}
                      {m.yapi?.sikisma && ' · sıkışma'}
                      {(m.yapi?.tepeler?.length || m.yapi?.dipler?.length) ? (
                        <small class="salinim">
                          {m.yapi.tepeler?.slice(-2).map((t: any) => `tepe ${sayi(t.seviye, e.ondalik)} (${kisaZaman(t.zaman)})`).join(' · ')}
                          {m.yapi.tepeler?.length && m.yapi.dipler?.length ? ' · ' : ''}
                          {m.yapi.dipler?.slice(-2).map((t: any) => `dip ${sayi(t.seviye, e.ondalik)} (${kisaZaman(t.zaman)})`).join(' · ')}
                        </small>
                      ) : null}
                    </td>
                  </tr>
                ) : (
                  <tr>
                    <th scope="row">{d.ad}</th>
                    <td colspan="9" class="eksik">{m?.eksik ?? 'ölçülmedi'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <div class="tablo-sar">
          <table class="seviyeler">
            <caption class="gorunmez">{e.ad} — dilim başına destek ve direnç bölgeleri (dokunuş sayısı ve son dokunuş) ile 52 haftalık Fibonacci seviyeleri</caption>
            <thead>
              <tr>
                {DILIMLER.map((d) => (
                  <th scope="col">{d.ad} seviyeler</th>
                ))}
                <th scope="col">Fibonacci (52 hafta)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                {DILIMLER.map((d) => {
                  const m = e.dilimler?.[d.kod];
                  return (
                    <td>
                      {m && !m.eksik ? (
                        <>
                          {m.seviyeler.direnc.map((s: any) => (
                            <div class="direnc" title={s.son_dokunus ? `son dokunuş ${kisaZaman(s.son_dokunus)}` : undefined}>
                              <span class="yon" aria-hidden="true">▲</span><span class="gorunmez">direnç </span>
                              {sayi(s.seviye, e.ondalik)} <small>({s.dokunus}×{s.son_dokunus ? ` · ${kisaZaman(s.son_dokunus)}` : ''})</small>
                            </div>
                          ))}
                          <div class="simdi"><span aria-label="son kapanış">◈</span> {sayi(m.son, e.ondalik)}</div>
                          {m.seviyeler.destek.map((s: any) => (
                            <div class="destek" title={s.son_dokunus ? `son dokunuş ${kisaZaman(s.son_dokunus)}` : undefined}>
                              <span class="yon" aria-hidden="true">▼</span><span class="gorunmez">destek </span>
                              {sayi(s.seviye, e.ondalik)} <small>({s.dokunus}×{s.son_dokunus ? ` · ${kisaZaman(s.son_dokunus)}` : ''})</small>
                            </div>
                          ))}
                        </>
                      ) : (
                        '—'
                      )}
                    </td>
                  );
                })}
                <td>
                  <div>%38,2 → {sayi(e.fib?.s382, e.ondalik)}</div>
                  <div>%50 → {sayi(e.fib?.s500, e.ondalik)}</div>
                  <div>%61,8 → {sayi(e.fib?.s618, e.ondalik)}</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        {DILIMLER.map(
          (d, j) =>
            e.grafikler?.[d.kod] && (
              <GrafikEmbed
                src={e.grafikler[d.kod]}
                baslik={`${e.ad} — ${d.ad.toLowerCase()} mum, SMA50/200, regresyon kanalı, pivot seviyeleri, RSI, MACD`}
                no={grafikNo.get(`${e.slug}:${d.kod}`) ?? String(i * 3 + j + 1).padStart(2, '0')}
              />
            )
        )}

        {/* Başlık hiyerarşisi: sayfa h1 → enstrüman h2 → yorum bölümleri h3.
            Yazı katmanı rehber gereği <h4> yazar; burada bir düzey yükseltilir. */}
        {e.yorum && <div class="yorum" set:html={String(e.yorum).replace(/<(\/?)h4>/g, '<$1h3>')} />}
      </section>
    ))
  }
  <footer class="altbilgi">
    <p>
      Ölçüm {istanbulSaat(b.olcum_zamani, 'tam')} İstanbul
      {b.yorum_zamani && ` · yorum ${istanbulSaat(b.yorum_zamani, 'tam')}`}
      {kayit && ` · Sayı ${kayit.sayiNo}`}
      {b.enstrumanlar?.length && ` · kaynak: kamuya açık kapanış verileri (${b.enstrumanlar.map((e: any) => e.kod).join(', ')})`}
    </p>
    <p class="feragat">{FERAGAT}</p>
  </footer>
</article>

<style>
  .teknik { max-width: 72rem; }
  .kunye { padding-top: 2.4rem; }
  .kicker { color: var(--claret); margin: 0 0 0.6rem; }
  .kicker-sayi { color: var(--ink-50); }
  .kunye h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0 0 0.4rem;
  }
  .metodoloji {
    margin-top: 1.2rem;
    font-size: 0.88rem; color: var(--ink-70);
    border-left: 3px solid var(--claret);
    padding-left: 0.8rem; max-width: 46rem;
  }
  .giris { font-size: 1.02rem; max-width: 46rem; margin: 1.4rem 0 2rem; }
  .enstruman { border-top: 1px solid var(--ink-30); padding-top: 1.4rem; margin-top: 2.2rem; }
  .baslik { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .baslik h2 { font-family: var(--font-display); margin: 0; }
  .son { font-family: var(--font-mono); font-size: 1.25rem; }
  .son .bar-tarih { color: var(--ink-70); font-size: 0.75rem; }
  .degisim { margin: 0.3rem 0 0.8rem; }
  .tablo-sar { overflow-x: auto; margin: 0.9rem 0; }
  table { border-collapse: collapse; font-family: var(--font-mono); font-size: 0.8rem; min-width: 40rem; }
  th, td { text-align: left; padding: 0.32rem 0.85rem 0.32rem 0; vertical-align: top; white-space: nowrap; }
  thead th { border-bottom: 1px solid var(--ink-30); color: var(--ink-70); font-weight: 500; }
  .olcum tbody th { font-weight: 600; }
  .alt-zaman { display: block; font-weight: 400; color: var(--ink-70); font-size: 0.68rem; }
  .yapi { white-space: normal; max-width: 16rem; }
  .eksik { color: var(--ink-70); font-style: italic; }
  .seviyeler .direnc { color: var(--negatif); }
  .seviyeler .destek { color: var(--pozitif); }
  .seviyeler .yon { font-size: 0.7em; margin-right: 0.25rem; }
  .seviyeler .simdi { color: var(--ink-70); border-top: 1px dotted var(--ink-30); border-bottom: 1px dotted var(--ink-30); margin: 0.15rem 0; }
  .seviyeler small { color: var(--ink-70); }
  .yorum { max-width: 46rem; margin: 1.2rem 0 0.6rem; }
  .duzeltmeler { max-width: 46rem; margin: 1.2rem 0 1.6rem; border: 1px solid var(--ink-30); border-left: 3px solid var(--claret); background: var(--paper-2); padding: 0.8rem 1.1rem; }
  .duzeltmeler h2 { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 0.6rem; }
  .duzeltme-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .duzeltme-liste li { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 0.2rem 1rem; align-items: baseline; }
  .d-tarih { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-50); }
  .d-govde { display: grid; gap: 0.15rem; }
  .d-degerler { font-family: var(--font-mono); font-size: 0.9rem; }
  .d-degerler s { color: var(--ink-50); }
  .d-degerler b { color: var(--claret); }
  .d-sebep { font-size: 0.88rem; color: var(--ink-70); line-height: 1.45; }
  .altbilgi { margin-top: 2.5rem; border-top: 1px solid var(--ink-30); padding-top: 0.8rem; font-size: 0.82rem; color: var(--ink-70); max-width: 60rem; }
  .altbilgi .feragat { font-style: italic; color: var(--ink-50); }
  .seviyeler .direnc, .seviyeler .destek { cursor: default; }
  @media (max-width: 640px) { .duzeltme-liste li { grid-template-columns: 1fr; } }
  .yorum :global(h3) { font-family: var(--font-display); font-size: 1.05rem; margin: 1.1rem 0 0.3rem; }
  .salinim { display: block; color: var(--ink-70); font-size: 0.68rem; white-space: normal; }
</style>
