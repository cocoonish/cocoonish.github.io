---
/**
 * Haftalık teknik analiz bülteninin gövdesi — çok zaman dilimli.
 *
 * Ölçülen katman teknik/olc.py'den gelir (1 saatlik / 4 saatlik / günlük
 * dilimlerde göstergeler, seviyeler, yapı ölçümü, grafikler); yorum katmanı
 * bir Claude oturumunca yazılır ve teknik/yaz.py kapısından geçer — andığı
 * her sayı ölçümde birebir vardır.
 */
import GrafikEmbed from './GrafikEmbed.astro';

interface Props {
  b: any;
}
const { b } = Astro.props;

const DILIMLER = [
  { kod: 's1', ad: '1 saatlik' },
  { kod: 's4', ad: '4 saatlik' },
  { kod: 'gun', ad: 'Günlük' },
];

const sayi = (x: number | null, ondalik = 2) =>
  x === null || x === undefined
    ? '—'
    : x.toLocaleString('tr-TR', {
        minimumFractionDigits: Math.min(ondalik, 4),
        maximumFractionDigits: Math.min(Math.max(ondalik, 2), 4),
      });

const isaretli = (x: number | null, birim: string) =>
  x === null || x === undefined
    ? '—'
    : `${x > 0 ? '+' : ''}${x.toLocaleString('tr-TR', { maximumFractionDigits: 2 })}${birim}`;

const tarihTr = (t: string | null) =>
  t
    ? new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(t.length > 10 ? t + 'Z' : t)
      ) + (t.length > 10 ? ` ${t.slice(11, 16)} UTC` : '')
    : '—';

const kisaZaman = (t: string | null) => (t ? (t.length > 10 ? t.slice(5, 16).replace('T', ' ') : t.slice(5)) : '—');
---

<article class="teknik">
  <header class="kunye">
    <h1>Haftalık Teknik Analiz</h1>
    <p class="etiket satir">
      <span>{b.tr_tarih}</span>
      <span>veri ucu: {tarihTr(b.veri_ucu)} kapanışı</span>
      <span>6 enstrüman · 1S / 4S / G</span>
    </p>
    <p class="metodoloji">
      Her enstrüman üç zaman diliminde (1 saatlik, 4 saatlik, günlük) ayrı ayrı
      ölçülür: göstergeler, pivot destek/direnç bölgeleri, regresyon kanalı ve
      piyasa yapısı (salınım tepeleri/dipleri, sıkışma, çift tepe/dip) —
      hepsi kapanmış barlardan, deterministik hesapla. Yorum ve senaryolar
      yapay zekâ tarafından bu ölçümün üzerine yazılır ve dilimler ortak bir
      görüşte birleştirilir; yorumda anılan her sayının ölçümde karşılığı
      vardır. Bu sayfa analizdir, yatırım tavsiyesi değildir.
    </p>
  </header>

  {b.giris && <div class="giris" set:html={b.giris} />}

  {
    b.enstrumanlar.map((e: any, i: number) => (
      <section class="enstruman">
        <div class="baslik">
          <h2>{e.ad}</h2>
          <span class="son">
            {sayi(e.son, e.ondalik)}
            {e.birim && <small> {e.birim}</small>}
            <small class="bar-tarih"> · {tarihTr(e.bar_tarihi)}</small>
          </span>
        </div>

        <p class="degisim etiket">
          1h {isaretli(e.degisim.h1, e.tip === 'getiri' ? ' bp' : '%')} · 1a{' '}
          {isaretli(e.degisim.a1, e.tip === 'getiri' ? ' bp' : '%')} · 3a{' '}
          {isaretli(e.degisim.a3, e.tip === 'getiri' ? ' bp' : '%')} · YBB{' '}
          {isaretli(e.degisim.ybb, e.tip === 'getiri' ? ' bp' : '%')} · 52h aralık{' '}
          {sayi(e.aralik52.dusuk, e.ondalik)}–{sayi(e.aralik52.yuksek, e.ondalik)} (konum %
          {sayi(e.aralik52.konum_pct, 0)})
        </p>

        <div class="sarici">
          <table class="olcum">
            <thead>
              <tr>
                <th>Dilim</th>
                <th>Son</th>
                <th>RSI</th>
                <th>MACD hist</th>
                <th>SMA50</th>
                <th>SMA200</th>
                <th>Kanal</th>
                <th>Yapı</th>
              </tr>
            </thead>
            <tbody>
              {DILIMLER.map((d) => {
                const m = e.dilimler?.[d.kod];
                return m && !m.eksik ? (
                  <tr>
                    <th>{d.ad}<small class="alt-zaman">{kisaZaman(m.bar_zamani)}</small></th>
                    <td>{sayi(m.son, e.ondalik)}</td>
                    <td>{sayi(m.momentum.rsi14, 1)}</td>
                    <td>{sayi(m.momentum.macd_hist, e.ondalik + 1)}</td>
                    <td>{sayi(m.hareketli.g50, e.ondalik)}</td>
                    <td>{sayi(m.hareketli.g200, e.ondalik)}</td>
                    <td>{m.kanal ? `%${sayi(m.kanal.konum_pct, 0)}` : '—'}</td>
                    <td class="yapi">
                      {m.yapi.karakter ?? '—'}
                      {m.yapi.cift_tepe && ` · çift tepe ${sayi(m.yapi.cift_tepe.seviye, e.ondalik)}`}
                      {m.yapi.cift_dip && ` · çift dip ${sayi(m.yapi.cift_dip.seviye, e.ondalik)}`}
                    </td>
                  </tr>
                ) : (
                  <tr>
                    <th>{d.ad}</th>
                    <td colspan="7" class="eksik">{m?.eksik ?? 'ölçülmedi'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <div class="sarici">
          <table class="seviyeler">
            <thead>
              <tr>
                {DILIMLER.map((d) => (
                  <th>{d.ad} seviyeler</th>
                ))}
                <th>Fibonacci (52h)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                {DILIMLER.map((d) => {
                  const m = e.dilimler?.[d.kod];
                  return (
                    <td>
                      {m && !m.eksik ? (
                        <>
                          {m.seviyeler.direnc.map((s: any) => (
                            <div class="direnc">
                              {sayi(s.seviye, e.ondalik)} <small>({s.dokunus}×)</small>
                            </div>
                          ))}
                          <div class="simdi">◈ {sayi(m.son, e.ondalik)}</div>
                          {m.seviyeler.destek.map((s: any) => (
                            <div class="destek">
                              {sayi(s.seviye, e.ondalik)} <small>({s.dokunus}×)</small>
                            </div>
                          ))}
                        </>
                      ) : (
                        '—'
                      )}
                    </td>
                  );
                })}
                <td>
                  <div>%38,2 → {sayi(e.fib.s382, e.ondalik)}</div>
                  <div>%50 → {sayi(e.fib.s500, e.ondalik)}</div>
                  <div>%61,8 → {sayi(e.fib.s618, e.ondalik)}</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        {DILIMLER.map(
          (d, j) =>
            e.grafikler?.[d.kod] && (
              <GrafikEmbed
                src={e.grafikler[d.kod]}
                baslik={`${e.ad} — ${d.ad.toLowerCase()} mum, SMA50/200, regresyon kanalı, pivot seviyeleri, RSI, MACD`}
                no={String(i * 3 + j + 1).padStart(2, '0')}
              />
            )
        )}

        {e.yorum && <div class="yorum" set:html={e.yorum} />}
      </section>
    ))
  }
</article>

<style>
  .teknik { max-width: 72rem; }
  .kunye h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0 0 0.4rem;
  }
  .kunye .satir { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .metodoloji {
    font-size: 0.88rem; color: var(--ink-70, #555);
    border-left: 3px solid var(--claret, #7a1f2b);
    padding-left: 0.8rem; max-width: 46rem;
  }
  .giris { font-size: 1.02rem; max-width: 46rem; margin: 1.4rem 0 2rem; }
  .enstruman { border-top: 1px solid var(--ink-30, #bbb); padding-top: 1.4rem; margin-top: 2.2rem; }
  .baslik { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .baslik h2 { font-family: var(--font-serif); margin: 0; }
  .son { font-family: var(--font-mono); font-size: 1.25rem; }
  .son .bar-tarih { color: var(--ink-70, #666); font-size: 0.75rem; }
  .degisim { margin: 0.3rem 0 0.8rem; }
  .sarici { overflow-x: auto; margin: 0.9rem 0; }
  table { border-collapse: collapse; font-family: var(--font-mono); font-size: 0.8rem; min-width: 40rem; }
  th, td { text-align: left; padding: 0.32rem 0.85rem 0.32rem 0; vertical-align: top; white-space: nowrap; }
  thead th { border-bottom: 1px solid var(--ink-30, #bbb); color: var(--ink-70, #666); font-weight: 500; }
  .olcum tbody th { font-weight: 600; }
  .alt-zaman { display: block; font-weight: 400; color: var(--ink-70, #888); font-size: 0.68rem; }
  .yapi { white-space: normal; max-width: 16rem; }
  .eksik { color: var(--ink-70, #888); font-style: italic; }
  .seviyeler .direnc { color: var(--claret, #9d2235); }
  .seviyeler .destek { color: #2d6a4f; }
  .seviyeler .simdi { color: var(--ink-70, #555); border-top: 1px dotted var(--ink-30, #ccc); border-bottom: 1px dotted var(--ink-30, #ccc); margin: 0.15rem 0; }
  .seviyeler small { color: var(--ink-70, #777); }
  .yorum { max-width: 46rem; margin: 1.2rem 0 0.6rem; }
  .yorum :global(h4) { font-family: var(--font-serif); margin: 1.1rem 0 0.3rem; }
</style>
