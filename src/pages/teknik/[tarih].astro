---
import Base from '../../layouts/Base.astro';
import TeknikGovde from '../../components/TeknikGovde.astro';
import SayiGezinme from '../../components/SayiGezinme.astro';
import { teknikler, type TeknikKaydi } from '../../lib/yayinlar';

export async function getStaticPaths() {
  // Yalnız YAZILMIŞ sayıların sayfası üretilir; ileri/geri gezinme sayılar arasında.
  const sirali = [...teknikler()].reverse();          // eskiden yeniye
  return sirali.map((x, i) => ({
    params: { tarih: x.tarih },
    props: { kayit: x, onceki: i > 0 ? sirali[i - 1] : null, sonraki: i < sirali.length - 1 ? sirali[i + 1] : null },
  }));
}

interface Props { kayit: TeknikKaydi; onceki: TeknikKaydi | null; sonraki: TeknikKaydi | null }
const { kayit, onceki, sonraki } = Astro.props;
---

<Base
  title={`Teknik analiz · Sayı ${kayit.sayiNo} · ${kayit.trTarih}`}
  description={kayit.aciklama}
  tur="article"
  yayinTarihi={kayit.olcumZamani}
  guncellemeTarihi={kayit.yayinZamani ?? kayit.olcumZamani}
>
  <SayiGezinme konum="ust" bolumHref="/teknik/" />
  <TeknikGovde b={kayit.t} kayit={kayit} />
  <SayiGezinme konum="alt" bolumHref="/teknik/" onceki={onceki} sonraki={sonraki} />
</Base>
