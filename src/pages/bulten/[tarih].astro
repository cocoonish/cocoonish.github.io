---
import Base from '../../layouts/Base.astro';
import BultenGovde from '../../components/BultenGovde.astro';
import SayiGezinme from '../../components/SayiGezinme.astro';
import { bultenler, rejimKiyasi, type BultenKaydi } from '../../lib/yayinlar';
import { ayniGunYayimlar } from '../../lib/ayniGun';
import { hatSayfalari } from '../../lib/hatSayfa';

export async function getStaticPaths() {
  // Yalnız YAZILMIŞ sayıların sayfası üretilir (lib/yayinlar.ts yayın kapısı).
  // Sayılar arasında ileri/geri gezinme: arşive dönmeden gün gün okunabilsin.
  const sirali = [...bultenler()].reverse();          // eskiden yeniye
  return sirali.map((x, i) => ({
    params: { tarih: x.tarih },
    props: {
      kayit: x,
      onceki: i > 0 ? sirali[i - 1] : null,
      sonraki: i < sirali.length - 1 ? sirali[i + 1] : null,
    },
  }));
}

interface Props { kayit: BultenKaydi; onceki: BultenKaydi | null; sonraki: BultenKaydi | null }
const { kayit, onceki, sonraki } = Astro.props;
const b = kayit.b;
// Öne çıkanlar hattın ADINI basar ve sayfasına bağlar; ikisini de
// lib/hatSayfa çözer — panosu olmayan hat (ölçümünü bir yazıya besleyen)
// slug'a ya da 404'e düşmesin.
const hatSayfa = await hatSayfalari();
const tur = kayit.haftalik ? 'Haftaya bakış' : 'Günlük bülten';
// AYNI GÜN yayımlananlar: 30.09 bülteni aynı gün çıkan borçlanma analizine,
// pazar sayısı aynı günün teknik sayısına gövdede hiç bağ vermiyordu.
const ayniGun = await ayniGunYayimlar(kayit.tarih);
---

<Base
  title={`${tur} · Sayı ${kayit.sayiNo} · ${kayit.trTarih}`}
  description={kayit.aciklama}
  tur="article"
  yayinTarihi={kayit.olcumZamani}
  guncellemeTarihi={kayit.yaziTarihi || kayit.olcumZamani}
>
  <SayiGezinme konum="ust" bolumHref="/bulten/" onceki={onceki} sonraki={sonraki} />
  <BultenGovde b={b} kayit={kayit} hatSayfa={hatSayfa} oncekiB={rejimKiyasi(kayit)?.b ?? null} ayniGun={ayniGun} />
  <SayiGezinme konum="alt" bolumHref="/bulten/" onceki={onceki} sonraki={sonraki} />
</Base>
