---
/**
 * Bülten dizini — en yeni sayı bu sayfada, geri kalanı arşivde.
 * Yayın kapısı (yalnız YAZILMIŞ sayı) lib/yayinlar.ts'te, bir kez.
 */
import Base from '../../layouts/Base.astro';
import BultenGovde from '../../components/BultenGovde.astro';
import { bultenler } from '../../lib/yayinlar';
import { getCollection } from 'astro:content';

// Öne çıkanlar ve veri günlüğü hattın ADINI basar, slug'ını değil; adlar
// proje sayfalarının başlığından gelir.
const hatAd = Object.fromEntries((await getCollection('projeler')).map((p) => [p.id, p.data.title]));
const hepsi = bultenler();
const son = hepsi[0];
const sonGunluk = hepsi.find((x) => !x.haftalik);
const sonHaftalik = hepsi.find((x) => x.haftalik);
const arsiv = hepsi.slice(1, 12);
---

<Base
  title={son ? `Bülten · Sayı ${son.sayiNo} · ${son.trTarih}` : 'Günlük bülten'}
  description={son ? son.aciklama : 'Veri hatlarının ölçtüğü değişimler, eşiği aşan olaylar ve önümüzdeki üç haftanın ekonomik takvimi — her sabah otomatik derlenir.'}
  tur={son ? 'article' : 'website'}
  yayinTarihi={son?.olcumZamani}
>
  {son ? (
    <>
      <nav class="bulten-nav" aria-label="Bülten sayıları">
        <span class="nav-etiket">Bülten</span>
        {sonGunluk && (sonGunluk.tarih === son.tarih ? (
          <span class="nav-oge aktif" aria-current="page">Son günlük <span class="nav-tarih">{sonGunluk.trTarih}</span></span>
        ) : (
          <a href={sonGunluk.href} class="nav-oge">Son günlük <span class="nav-tarih">{sonGunluk.trTarih}</span></a>
        ))}
        {sonHaftalik && (sonHaftalik.tarih === son.tarih ? (
          <span class="nav-oge aktif" aria-current="page">Son haftaya bakış <span class="nav-tarih">{sonHaftalik.trTarih}</span></span>
        ) : (
          <a href={sonHaftalik.href} class="nav-oge">Son haftaya bakış <span class="nav-tarih">{sonHaftalik.trTarih}</span></a>
        ))}
        <a href="/bulten/rss.xml" class="nav-oge rss-link" title="RSS beslemesi">RSS</a>
        <a href="/bulten/arsiv/" class="nav-oge arsiv-link">Tüm arşiv ({hepsi.length})</a>
      </nav>
      <BultenGovde b={son.b} kayit={son} hatAd={hatAd} />
      <section class="arsiv">
        <h2>Önceki sayılar <a class="tumu" href="/bulten/arsiv/">tümü →</a></h2>
        {arsiv.length > 0 ? (
          <ul>
            {arsiv.map((x) => (
              <li>
                <a href={x.href}><span class="no">No {x.sayiNo}</span> {x.trTarih}</a>
                {x.haftalik && <span class="rozet">haftaya bakış</span>}
                <span class="ozet">{x.aciklama}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="ilk">
            Bu ilk sayı. Hafta içi her sabah günlük, pazar akşamı haftaya bakış yayımlanır;
            hepsi <a href="/bulten/arsiv/">arşivde</a> birikir.
          </p>
        )}
      </section>
    </>
  ) : (
    <section class="bos-durum">
      <h1>Günlük bülten</h1>
      <p>Bugünün bülteni henüz hazırlanmadı. Kısa süre içinde burada olacak.</p>
    </section>
  )}
</Base>

<style>
  .bulten-nav {
    display: flex; flex-wrap: wrap; gap: 0.9rem; align-items: baseline;
    border-bottom: 1px solid var(--ink-30); padding: 1.4rem 0 0.7rem; margin-bottom: 0.4rem;
    font-family: var(--font-mono); font-size: 0.78rem;
  }
  .nav-etiket {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-30);
  }
  .nav-oge { text-decoration: none; border-bottom: 1px solid var(--ink-30); }
  .nav-oge.aktif { border-bottom: 2px solid var(--claret); color: var(--claret); }
  .nav-tarih { color: var(--ink-30); font-size: 0.9em; margin-left: 0.3em; }
  .rss-link { margin-left: auto; font-size: 0.68rem; letter-spacing: 0.1em; }
  .arsiv-link { }
  .rozet {
    font-family: var(--font-mono); font-size: 0.64rem; color: var(--claret);
    border: 1px solid var(--claret); padding: 0.02rem 0.32rem;
  }
  .ilk { font-size: 0.85rem; color: var(--ink-70); margin: 0; }
  .arsiv { margin: 3rem 0 1rem; border-top: 4px double var(--ink); padding-top: 1.2rem; }
  .arsiv h2 { font-family: var(--font-display); font-size: 1.15rem; margin: 0 0 0.8rem; }
  .arsiv .tumu { font-family: var(--font-mono); font-size: 0.72rem; margin-left: 0.6rem; }
  .arsiv ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .arsiv li { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 0.2rem 0.9rem; align-items: baseline; }
  .arsiv a { font-family: var(--font-mono); font-size: 0.88rem; text-decoration: none; }
  .arsiv .no { color: var(--claret); font-size: 0.72rem; margin-right: 0.3rem; }
  .ozet { font-size: 0.82rem; color: var(--ink-70); line-height: 1.45; }
  .bos-durum { padding: 3rem 0; }
  .bos-durum h1 { font-family: var(--font-display); }
  @media (max-width: 640px) {
    .arsiv li { grid-template-columns: 1fr; }
    .rss-link { margin-left: 0; }
  }
</style>
