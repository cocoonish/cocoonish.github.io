---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { olcuYaz } from '../../lib/bicim';
import GrafikPanel from '../../components/GrafikPanel.astro';
import { BASLIKLAR, seriler, setler, type KurulmusSeri } from '../../lib/grafikVeri';
import { degisimOndalik, tarihEtiketi } from '../../lib/grafikDonusum';
import type { SayfaVeri } from '../../lib/grafikSayfa';
import { bolumBul } from '../../lib/bolumler';
import { kesimAdi, sayfaOlaylari } from '../../lib/grafikOlay';

export function getStaticPaths() {
  // Çözülemeyen seri için sayfa ÜRETİLMEZ: boş bir grafik sayfası, kartın
  // "şu an gösterilemiyor" notundan kötüdür (sayfa sınavı 30 adıyla listeler).
  return seriler()
    .filter((s) => !s.sorun)
    .map((s) => ({ params: { id: s.id }, props: { s } }));
}

const { s } = Astro.props as { s: KurulmusSeri };
const baslik = BASLIKLAR.find((b) => b.kod === s.baslik)!;
const panolar = new Map((await getCollection('projeler')).map((p) => [p.id, p.data.title]));
const panoAdi = s.kaynak.tur === 'figur' || s.kaynak.tur === 'hat' ? panolar.get(s.kaynak.proje) ?? null : null;
const kaynakYazi =
  s.kaynak.tur === 'evds' ? `TCMB EVDS, seri ${s.kaynak.kod}`
  : s.kaynak.tur === 'yahoo' ? `Yahoo Finance, ${s.kaynak.kod}`
  : null;

// Kıyas AYNI türdeki serilerle: tek eksen, tek dönüşüm birimi. Oranda ve farkta
// birim de aynı olmalı; seviyede başka birimdeki seri de seçilebilir, ama yalnız
// birimsiz gösterimde (yüzde değişim · 100'e endeks) çizilir.
const kiyaslar = seriler()
  .filter((x) => !x.sorun && x.id !== s.id && x.tur === s.tur && (s.tur === 'seviye' || x.birim === s.birim))
  .sort((a, b) => Number(b.birim === s.birim) - Number(a.birim === s.birim))
  .map((x) => ({ id: x.id, ad: x.ad, frekans: x.frekans, birim: x.birim }));
const kod = s.piyasaKodu ?? undefined;
const olay = sayfaOlaylari(s.baslik, s.gecis, kesimAdi(kod));
const tabanSeri = s.kaynak.tur === 'seri' ? seriler().find((x) => x.id === (s.kaynak as { seri: string }).seri) ?? null : null;
const veri: SayfaVeri = {
  id: s.id, birim: s.birim, tur: s.tur, ondalik: s.ondalik,
  seriler: [{ id: s.id, ad: s.ad, frekans: s.frekans, t: s.seri.t, v: s.seri.v }],
  kiyaslar,
  ...(olay ? { olaylar: olay.olaylar, olayAdi: olay.ad } : {}),
};
// Bu seriyi içeren hazır grafikler: aynı seriyi komşularıyla birlikte görmek için.
const iceren = setler().filter((h) => !h.sorun && h.uyeler.some((u) => u.id === s.id));
const aciklama = `${s.ad}: ${s.aciklama}`;
// Aynı hattın ölçümünü kullanan analizler: yazı hattın figürünü gömüyor ya da sayısını
// çağırıyorsa (`/projeler/<hat>/` · `proje="<hat>"`). Eşleşme HAT düzeyindedir, seri
// düzeyinde değil — başlık bunu söyler. En yeni dört yazı.
const hat = s.kaynak.tur === 'figur' || s.kaynak.tur === 'hat' ? s.kaynak.proje : null;
const yazilar = hat
  ? (await getCollection('analiz'))
      .filter((a) => (a.body ?? '').match(new RegExp(`/projeler/${hat}/|proje="${hat}"`)))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 4)
  : [];
---

<Base title={`${s.ad} — Grafik`} description={aciklama}>
  <header class="seri-baslik yuksel">
    <p class="etiket kicker">
      <a href="/grafikler/">{bolumBul('/grafikler/')?.no} — Grafikler</a>
      <span aria-hidden="true"> · </span>
      <a href={`/grafikler/#${baslik.kod}`}>{baslik.ad}</a>
    </p>
    <h1>{s.ad}</h1>
    <p class="alt">{s.aciklama}</p>
  </header>

  <dl class="ozet yuksel" style="--d: 60ms">
    <div><dt>Son değer</dt><dd class="sayi">{olcuYaz(s.sonDeger!, s.birim, s.ondalik)}</dd></div>
    <div><dt>Tarih</dt><dd>{tarihEtiketi(s.sonTarih!, s.frekans)}</dd></div>
    <div>
      <dt>1 yılda</dt>
      <dd class="sayi">{s.yillikDegisim === null ? '—' : olcuYaz(s.yillikDegisim, s.yillikBirim, degisimOndalik(s.tur, s.ondalik), true)}</dd>
    </div>
    <div><dt>Kaynak</dt><dd>{s.kurum}</dd></div>
  </dl>

  <GrafikPanel veri={veri} ad={s.ad} frekans={s.frekans} />

  <section class="hesap-blok yuksel" style="--d: 140ms">
    <div class="bolum-baslik"><h2>Bu seri nasıl hesaplanıyor</h2></div>
    <p>{s.aciklama}</p>
    {panoAdi && s.kaynak.tur === 'figur' && (
      <p>
        Seri <a href={`/projeler/${s.kaynak.proje}/`}>{panoAdi}</a> panosunun yayımlanmış grafiğinden okunur ve
        panodaki sayının kendisidir; verinin kaynağı, formülü ve varsayımları panonun ilgili şeklinin altında
        anlatılır. Pano tazelendiğinde bu grafik de tazelenir.
      </p>
    )}
    {panoAdi && s.kaynak.tur === 'hat' && (
      <p>
        Seri <a href={`/projeler/${s.kaynak.proje}/`}>{panoAdi}</a> panosunu besleyen ölçümün kendisidir; panonun
        grafiği son yılları çizdiği için tam tarihçe burada gösterilir. Verinin kaynağı, formülü ve varsayımları
        panoda anlatılır; pano tazelendiğinde bu grafik de tazelenir.
        {s.turet === 'yillik_yuzde' && ' Grafikteki değer, endeksin bir yıl önceki aynı döneme göre yüzde değişimidir; bu sayfada hesaplanır.'}
      </p>
    )}
    {kaynakYazi && (
      <p>
        Veri: {kaynakYazi}. {s.turet === 'yillik_yuzde'
          ? 'Grafikteki değer, kaynağın yayımladığı endeksin bir yıl önceki aynı döneme göre yüzde değişimidir; bu sayfada hesaplanır.'
          : 'Değer kaynağın yayımladığı hâliyle gösterilir.'}
      </p>
    )}
    {tabanSeri && (
      <p>
        Seri bu bölümdeki <a href={`/grafikler/${tabanSeri.id}/`}>{tabanSeri.ad}</a> serisinden, aynı kapanışlarla
        bu sayfada hesaplanır; ikinci bir veri çekimi yoktur.
      </p>
    )}
    {s.gecis && (
      <p>
        Döviz kapanışı {tarihEtiketi(s.gecis, 'gunluk')} tarihinden itibaren saatlik bardan ({kesimAdi(kod)}),
        öncesi Yahoo'nun günlük barından düzeltilerek (Londra gece yarısı) kurulur; grafikte ◆ ile işaretlidir.
        {s.turet === 'oynaklik' && ' İki kapanışın gerçekleşen oynaklığı aynı değildir: gece yarısı kapanışına akşam ve gece saatlerinin sığ kotasyonları da girer ve ertesi gün geri dönen bu gürültü ölçülen oynaklığı yükseltir. Geçiş gününden önceki ve sonraki düzeyler bu yüzden doğrudan kıyaslanmaz.'}
      </p>
    )}
    {veri.olaylar && veri.olaylar.some((o) => o.yon !== 0) && (
      <p>
        Grafikteki dikey kesikli çizgiler TCMB'nin politika faizini değiştirdiği Para Politikası Kurulu
        kararlarıdır (▲ artırım, ▼ indirim); sabit bırakılan kararlar işaretlenmez. İşaretler Haziran 2018'de
        başlar: o güne kadar fonlama koridor ve geç likidite penceresiyle yönlendiriliyordu ve tek bir politika
        faizi değişikliği yazılamaz. Kararın tarihi, eski ve yeni oran imleç o güne geldiğinde yazılır.
      </p>
    )}
    <p class="kunye">
      Gözlem: {s.seri.t.length} · ilk {tarihEtiketi(s.seri.t[0], s.frekans)} · son {tarihEtiketi(s.sonTarih!, s.frekans)}.
      "Yıllık" ve "aylık" gösterimde her gözlem, takvimde bir yıl ya da bir ay önceki son gözlemle kıyaslanır;
      oranlarda fark puan, seviyelerde değişim yüzde olarak yazılır.
      {s.tur === 'seviye' && ` "100'e endeksli" gösterimde taban, görünen dönemde kıyaslanan serilerin hepsinin ölçüldüğü ilk gündür ve her seri o gün 100 olur; birimi farklı iki seviye ancak böyle tek eksende kıyaslanır.`}
    </p>
  </section>

  {yazilar.length > 0 && panoAdi && (
    <section class="hesap-blok">
      <div class="bolum-baslik"><h2>{panoAdi} ölçümünü kullanan analizler</h2></div>
      <ul class="iceren">
        {yazilar.map((a) => <li><a href={`/analiz/${a.id}/`}>{a.data.title}</a></li>)}
      </ul>
    </section>
  )}

  {iceren.length > 0 && (
    <section class="hesap-blok">
      <div class="bolum-baslik"><h2>Bu seriyi içeren hazır grafikler</h2></div>
      <ul class="iceren">
        {iceren.map((h) => <li><a href={`/grafikler/hazir/${h.id}/`}>{h.ad}</a></li>)}
      </ul>
    </section>
  )}
</Base>


<style>
  .seri-baslik { padding: 2.6rem 0 1.2rem; max-width: 62ch; }
  .kicker { margin: 0 0 0.8rem; color: var(--claret); }
  .kicker a { text-decoration: none; color: inherit; }
  .kicker a:hover { text-decoration: underline; }
  h1 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 60;
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    font-weight: 540;
    letter-spacing: -0.015em;
    line-height: 1.1;
    margin: 0 0 0.8rem;
  }
  .alt { color: var(--ink-70); margin: 0; font-size: 1.02rem; }

  .ozet {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.6rem 1.6rem;
    margin: 0 0 1.4rem;
    border-top: 1px solid var(--ink);
    padding-top: 0.7rem;
  }
  .ozet dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
  }
  .ozet dd { margin: 0.15rem 0 0; font-size: 1.05rem; }
  .ozet .sayi { font-family: var(--font-mono); font-size: 1.3rem; }

  .hesap-blok { max-width: var(--olcu-metin); }
  .hesap-blok .bolum-baslik { margin-top: 2.6rem; }
  .hesap-blok p { line-height: 1.65; }
  .kunye { font-size: 0.92rem; color: var(--ink-70); }

  .iceren { padding-left: 1.1rem; line-height: 1.7; }
  @media (max-width: 640px) {
    .ozet dt { font-size: 0.75rem; }
  }
</style>
