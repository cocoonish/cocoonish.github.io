---
import Base from '../../layouts/Base.astro';
import { kicker, bolumBul } from '../../lib/bolumler';
import { istanbulIsoGun, olcuYaz } from '../../lib/bicim';
import { BASLIKLAR, kisaAdlar, seriler, setler } from '../../lib/grafikVeri';
import { RENK, kesikMi } from '../../lib/grafikSayfa';
import { degisimOndalik, donemBasi, kes, seyrelt, tarihEtiketi } from '../../lib/grafikDonusum';
import defter from '../../data/grafikler/guncelleme.json';

// Başlık başlık kart ızgarası. Kartın kıvılcım çizgisi son beş yılın (seri daha
// kısaysa tamamının) seyreltilmiş hâlidir ve derleme anında çizilir; sekmeler ve
// arama tarayıcıda yalnız GÖRÜNÜRLÜĞÜ değiştirir — betik kapalıyken bütün
// başlıklar alt alta okunur.
const hepsi = seriler();
const hazirlar = setler();
const gruplar = BASLIKLAR.map((b) => ({
  ...b,
  kartlar: hepsi.filter((s) => s.baslik === b.kod),
  hazir: hazirlar.filter((h) => h.baslik === b.kod),
})).filter((g) => g.kartlar.length > 0 || g.hazir.length > 0);
const no = (i: number) => String(i + 1).padStart(2, '0');

// SON YEDİ GÜNDE GELEN VERİ: güncelleme defterinde (Aktarılacak Projeler/Grafikler/
// guncelleme.py) son gözlemi bu bölümde son yedi günde ilk kez görülen seriler.
// Günlük seriler girmez — her iş günü yenilenirler ve şeridi doldururlar; şerit
// takvimli yayımları (haftalık, aylık, çeyreklik) gösterir. Görülme anı ölçülmemiş
// (defterde null) seri girmez: "yeni" etiketi uydurulmaz. Pencere derleme anına
// göredir; site her veri tazelemesinden sonra yeniden derlenir.
const YENI_GUN = 7;
const kayitlar = defter as Record<string, { son: string; gorulme: string | null }>;
const esik = Date.now() - YENI_GUN * 864e5;
const yeniler = hepsi
  .filter((s) => !s.sorun && s.frekans !== 'gunluk')
  .map((s) => ({ s, k: kayitlar[s.id] }))
  .filter(({ s, k }) => k && k.gorulme && k.son === s.sonTarih && Date.parse(k.gorulme) >= esik)
  .sort((a, b) => (a.k!.gorulme! < b.k!.gorulme! ? 1 : a.k!.gorulme! > b.k!.gorulme! ? -1 : a.s.ad.localeCompare(b.s.ad, 'tr')));
// Geliş gününe göre (İstanbul günü) gruplar, en yeni gün başta; ilk YENI_ACIK satırdan
// sonrası katlanır — şerit dizinin üstünde duruyor, sayfayı itmemeli.
const YENI_ACIK = 10;
const yeniGunler = [...new Set(yeniler.map(({ k }) => istanbulIsoGun(k!.gorulme!)))].map((g) => ({
  gun: g,
  satirlar: yeniler.filter(({ k }) => istanbulIsoGun(k!.gorulme!) === g),
}));

const G = 220;
const H = 48;
function kivilcim(t: string[], v: number[]): string {
  const s = seyrelt(kes({ t, v }, donemBasi({ t, v }, 60)), 120);
  if (s.v.length < 2) return '';
  const lo = Math.min(...s.v);
  const hi = Math.max(...s.v);
  const y = (x: number) => (H - 3 - ((x - lo) / (hi - lo || 1)) * (H - 6)).toFixed(1);
  return s.v.map((x, i) => `${i ? 'L' : 'M'}${((i / (s.v.length - 1)) * (G - 4) + 2).toFixed(1)},${y(x)}`).join('');
}

// Hazır grafiğin kıvılcımı: üyeler ORTAK eksende (aynı birim), son beş yıl, zaman ekseni ortak.
const GH = 64;
function cokluKivilcim(uyeler: { seri: { t: string[]; v: number[] } }[]): string[] {
  const son = uyeler.reduce((m, u) => (u.seri.t[u.seri.t.length - 1] > m ? u.seri.t[u.seri.t.length - 1] : m), '');
  const bas = donemBasi({ t: [son], v: [0] }, 60);
  const ss = uyeler.map((u) => seyrelt(kes(u.seri, bas), 120));
  const tum = ss.flatMap((s) => s.v);
  if (!tum.length) return [];
  const lo = Math.min(...tum);
  const hi = Math.max(...tum);
  const ms = (t: string) => Date.UTC(+t.slice(0, 4), +t.slice(5, 7) - 1, +t.slice(8, 10));
  const t0 = Math.min(...ss.filter((s) => s.t.length).map((s) => ms(s.t[0])));
  const t1 = ms(son);
  const x = (t: string) => (((ms(t) - t0) / Math.max(1, t1 - t0)) * (G - 4) + 2).toFixed(1);
  const y = (v: number) => (GH - 3 - ((v - lo) / (hi - lo || 1)) * (GH - 6)).toFixed(1);
  return ss.map((s) => s.v.map((v, i) => `${i ? 'L' : 'M'}${x(s.t[i])},${y(v)}`).join(''));
}
---

<Base title="Grafikler" description={bolumBul('/grafikler/')?.aciklama ?? ''}>
  <header class="liste-baslik yuksel">
    <p class="etiket kicker">{kicker('/grafikler/')}</p>
    <h1>Grafikler</h1>
    <p class="alt">
      Panoların ölçtüğü, TCMB EVDS'ten ve piyasadan çekilen {hepsi.length} seri ve bunları yan yana koyan
      {hazirlar.filter((h) => !h.sorun).length} hazır grafik, tek yerde. Her kart serinin son değerini, tarihini ve
      bir yıl önceye göre değişimini taşır; karta tıklayınca dönem seçilebilen, yıllık ve aylık değişime
      çevrilebilen, 100'e endekslenebilen, başka bir seriyle kıyaslanabilen ve indirilebilen büyük grafik açılır.
      Oranların değişimi puan, seviyelerinki yüzde olarak yazılır.
    </p>
  </header>

  <div class="denetim yuksel" style="--d: 60ms">
    <label class="ara">
      <span class="etiket">Seri ara</span>
      <input type="search" id="seri-ara" placeholder="ör. enflasyon, rezerv, kredi faizi" autocomplete="off" />
    </label>
    <div class="sekmeler" role="tablist" aria-label="Başlıklar">
      <button type="button" role="tab" aria-selected="true" data-sekme="">Tümü <span>{hepsi.length}</span></button>
      {gruplar.map((g) => (
        <button type="button" role="tab" aria-selected="false" data-sekme={g.kod}>
          {g.ad} <span>{g.kartlar.length}</span>
        </button>
      ))}
    </div>
  </div>
  {yeniler.length > 0 && (
    <section class="yeniler yuksel" style="--d: 90ms" aria-labelledby="yeniler-baslik" data-grafik-yeniler>
      <h2 id="yeniler-baslik">Son {YENI_GUN} günde gelen veriler <span>{yeniler.length} seri</span></h2>
      {(() => {
        let sira = 0;
        const satir = ({ s }: (typeof yeniler)[number]) => (
          <li data-grafik-yeni={s.id}>
            <a href={`/grafikler/${s.id}/`}>{s.ad}</a>
            <span class="yeni-donem" title="Son gözlemin dönemi">{tarihEtiketi(s.sonTarih!, s.frekans)}</span>
            <b>{olcuYaz(s.sonDeger!, s.birim, s.ondalik)}</b>
          </li>
        );
        const acik: any[] = [];
        const kapali: any[] = [];
        for (const g of yeniGunler) {
          const a = g.satirlar.filter(() => sira++ < YENI_ACIK);
          const k = g.satirlar.slice(a.length);
          const baslik = (n: number) => <h3><time datetime={g.gun}>{tarihEtiketi(g.gun, 'gunluk')}</time> geldi <span>{n} seri</span></h3>;
          if (a.length) acik.push(<div class="yeni-gun">{baslik(g.satirlar.length)}<ul>{a.map(satir)}</ul></div>);
          if (k.length) kapali.push(<div class="yeni-gun">{!a.length && baslik(g.satirlar.length)}<ul>{k.map(satir)}</ul></div>);
        }
        return <>{acik}{kapali.length > 0 && (
          <details class="yeni-devam"><summary>Diğer {yeniler.length - YENI_ACIK} seri</summary>{kapali}</details>
        )}</>;
      })()}
      <p class="yeni-not">Haftalık, aylık ve çeyreklik seriler; her satırda son gözlemin dönemi ve değeri. Gün, yeni gözlemin bu bölüme geldiği gündür. Günlük seriler her iş günü yenilendiği için listede yer almaz.</p>
    </section>
  )}
  <p class="sonucsuz" id="sonucsuz" hidden>Aramaya uyan seri yok.</p>

  {gruplar.map((g, gi) => (
    <section class="grup" id={g.kod} data-baslik={g.kod}>
      <div class="bolum-baslik">
        <span class="no">{no(gi)}</span>
        <h2>{g.ad}</h2>
        <span class="grup-olcu">{g.kartlar.length} seri{g.hazir.length > 0 && ` · ${g.hazir.length} hazır grafik`}</span>
      </div>
      <p class="grup-aciklama">{g.aciklama}</p>
      {g.hazir.length > 0 && (
        <ul class="kartlar hazirlar" aria-label={`${g.ad} — hazır grafikler`}>
          {g.hazir.map((h) => {
            const ara = `${h.ad} ${h.uyeler.map((u) => u.ad).join(' ')} ${g.ad} hazır`.toLocaleLowerCase('tr-TR');
            if (h.sorun) {
              return (
                <li class="kart kart--yok kart--hazir" data-ara={ara} data-grafik-hazir-sorun={h.id}>
                  <span class="kart-ad">{h.ad}</span>
                  <span class="kart-not">Bu hazır grafik şu an gösterilemiyor.</span>
                </li>
              );
            }
            const yollar = cokluKivilcim(h.uyeler);
            const kisa = kisaAdlar(h.uyeler.map((u) => u.ad));
            return (
              <li class="kart kart--hazir" data-ara={ara} data-grafik-hazir={h.id}>
                <a href={`/grafikler/hazir/${h.id}/`}>
                  <span class="kart-tur">Hazır grafik · {h.uyeler.length} seri</span>
                  <span class="kart-ad">{h.ad}</span>
                  <svg class="kivilcim kivilcim--cok" viewBox={`0 0 ${G} ${GH}`} preserveAspectRatio="none" aria-hidden="true">
                    {yollar.map((d, i) => (
                      <path d={d} style={`stroke: ${RENK[i]}`} stroke-dasharray={kesikMi(i) ? '5 3' : undefined} />
                    ))}
                  </svg>
                  <span class="kart-uyeler">
                    {h.uyeler.map((u, i) => (
                      <span class="kart-uye">
                        <span class:list={['im', { kesik: kesikMi(i) }]} style={`--renk: ${RENK[i]}`}></span>
                        {kisa[i]} <b>{olcuYaz(u.sonDeger!, u.birim, u.ondalik)}</b>
                      </span>
                    ))}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
      <ul class="kartlar">
        {g.kartlar.map((s) => {
          const ara = `${s.ad} ${s.kurum} ${g.ad}`.toLocaleLowerCase('tr-TR');
          if (s.sorun) {
            return (
              <li class="kart kart--yok" data-ara={ara} data-grafik-sorun={s.id}>
                <span class="kart-ad">{s.ad}</span>
                <span class="kart-not">Bu seri şu an gösterilemiyor.</span>
              </li>
            );
          }
          const d = kivilcim(s.seri.t, s.seri.v);
          return (
            <li class="kart" data-ara={ara} data-grafik-seri={s.id}>
              <a href={`/grafikler/${s.id}/`}>
                <span class="kart-ad">{s.ad}</span>
                <span class="kart-deger">{olcuYaz(s.sonDeger!, s.birim, s.ondalik)}</span>
                <span class="kart-alt">
                  <time datetime={s.sonTarih!}>{tarihEtiketi(s.sonTarih!, s.frekans)}</time>
                  {s.yillikDegisim !== null && (
                    <span class="kart-degisim">1 yılda {olcuYaz(s.yillikDegisim, s.yillikBirim, degisimOndalik(s.tur, s.ondalik), true)}</span>
                  )}
                </span>
                <svg class="kivilcim" viewBox={`0 0 ${G} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                  <path d={d} />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>

<script>
  const ara = document.getElementById('seri-ara') as HTMLInputElement | null;
  const sekmeler = [...document.querySelectorAll<HTMLButtonElement>('[data-sekme]')];
  const gruplar = [...document.querySelectorAll<HTMLElement>('[data-baslik]')];
  const sonucsuz = document.getElementById('sonucsuz');
  let secili = '';

  function uygula() {
    const q = (ara?.value ?? '').trim().toLocaleLowerCase('tr-TR');
    let gorunen = 0;
    for (const g of gruplar) {
      const sekmede = !secili || g.dataset.baslik === secili;
      let n = 0;
      for (const k of g.querySelectorAll<HTMLElement>('[data-ara]')) {
        const uyar = sekmede && (!q || (k.dataset.ara ?? '').includes(q));
        k.hidden = !uyar;
        if (uyar) n++;
      }
      g.hidden = n === 0;
      gorunen += n;
    }
    if (sonucsuz) sonucsuz.hidden = gorunen > 0;
  }

  for (const b of sekmeler) {
    b.addEventListener('click', () => {
      secili = b.dataset.sekme ?? '';
      for (const x of sekmeler) x.setAttribute('aria-selected', String(x === b));
      uygula();
    });
  }
  ara?.addEventListener('input', uygula);
</script>

<style>
  .liste-baslik { padding: 3rem 0 1.4rem; max-width: 60ch; }
  .kicker { color: var(--claret); margin: 0 0 0.8rem; }
  h1 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 540;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 0.9rem;
  }
  .alt { font-size: 1.05rem; color: var(--ink-70); margin: 0; }

  /* Denetimler grafiklerin üstünde tek blok: önce arama, sonra başlıklar. */
  .denetim {
    border-top: 1px solid var(--ink);
    padding-top: 0.8rem;
    display: grid;
    gap: 0.8rem;
  }
  .ara { display: grid; gap: 0.3rem; max-width: 26rem; }
  .ara .etiket { color: var(--claret); }
  .ara input {
    font: inherit;
    font-size: 1rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--ink-30);
    background: var(--paper);
    color: var(--ink);
    border-radius: 2px;
  }
  .ara input:focus { outline: 2px solid var(--claret); outline-offset: 1px; }
  .sekmeler { display: flex; flex-wrap: wrap; gap: 0.35rem 0.4rem; }
  .sekmeler button {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--ink-30);
    background: transparent;
    color: var(--ink-70);
    border-radius: 2px;
    cursor: pointer;
    min-height: 2rem;
  }
  .sekmeler button span { color: var(--ink-60); margin-left: 0.2rem; }
  .sekmeler button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .sekmeler button[aria-selected='true'] span { color: var(--paper); }
  .sekmeler button:focus-visible { outline: 2px solid var(--claret); outline-offset: 1px; }
  .sonucsuz { margin: 2rem 0; color: var(--ink-70); }

  .yeniler { margin: 1.6rem 0 0.4rem; border: 1px solid var(--ink-15); padding: 0.8rem 1rem 0.6rem; }
  .yeniler h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--claret);
    margin: 0 0 0.5rem;
  }
  .yeniler h2 span { color: var(--ink-60); margin-left: 0.4rem; }
  .yeni-gun h3 { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; color: var(--ink-70); margin: 0.6rem 0 0.2rem; }
  .yeni-gun h3 span { color: var(--ink-60); margin-left: 0.3rem; }
  .yeni-devam summary { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-70); cursor: pointer; margin-top: 0.5rem; }
  .yeniler ul { list-style: none; margin: 0; padding: 0; columns: 2 22rem; column-gap: 2rem; }
  .yeniler li {
    break-inside: avoid;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0 0.7rem;
    align-items: baseline;
    padding: 0.22rem 0;
    border-bottom: 1px solid var(--ink-15);
    font-size: 0.92rem;
  }
  .yeniler li a { color: inherit; }
  .yeniler .yeni-donem { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-60); }
  .yeniler b { font-family: var(--font-mono); font-weight: 500; font-size: 0.85rem; }
  .yeni-not { font-size: 0.8rem; color: var(--ink-60); margin: 0.5rem 0 0; }
  @media (max-width: 560px) {
    .yeniler li { grid-template-columns: minmax(0, 1fr) auto; }
    .yeniler .yeni-donem { grid-column: 1; }
  }
  .grup { scroll-margin-top: 2rem; }
  .grup .bolum-baslik { flex-wrap: wrap; row-gap: 0.2rem; margin: 2.6rem 0 0.6rem; }
  .grup-olcu {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
    margin-left: auto;
  }
  .grup-aciklama { max-width: 68ch; margin: 0 0 1rem; color: var(--ink-70); line-height: 1.6; }

  .kartlar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.9rem 1.4rem;
  }
  .kart { border-top: 1px solid var(--ink-15); }
  .kart a, .kart--yok {
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  .kart a:hover .kart-ad, .kart a:focus-visible .kart-ad { color: var(--claret); }
  .kart a:focus-visible { outline: 2px solid var(--claret); outline-offset: 2px; }
  .kart-ad {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24;
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.25;
    transition: color 0.15s ease;
  }
  .kart-deger {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-top: 0.15rem;
  }
  .kart-alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-60);
  }
  .kivilcim { width: 100%; height: 48px; margin-top: 0.35rem; overflow: visible; }
  .kivilcim path { fill: none; stroke: var(--claret); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .kart-not { font-size: 0.9rem; color: var(--ink-70); font-style: italic; }

  .hazirlar { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-bottom: 1.4rem; }
  .kart--hazir { border-top: 2px solid var(--ink); }
  .kart-tur {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--claret);
  }
  .kivilcim--cok { height: 64px; }
  .kivilcim--cok path { stroke-width: 1.6; }
  .kart-uyeler { display: grid; gap: 0.1rem; font-size: 0.85rem; color: var(--ink-70); margin-top: 0.3rem; }
  .kart-uye { display: flex; align-items: center; gap: 0.4rem; }
  .kart-uye b { font-family: var(--font-mono); font-weight: 500; color: var(--ink); margin-left: auto; padding-left: 0.6rem; white-space: nowrap; }
  .im { display: inline-block; width: 14px; height: 3px; border-radius: 2px; background: var(--renk); flex: none; }
  .im.kesik { background: repeating-linear-gradient(90deg, var(--renk) 0 5px, transparent 5px 8px); }
</style>
