---
/**
 * Ana sayfa — dizin değil, MANŞET.
 *
 * Siteye ilk gelen profesyonel okur beş saniyede üç soruya cevap arar:
 * bu ne, güncel mi, ciddi mi? Rejim panosu üçünü birden cevaplar; bir
 * içindekiler listesi hiçbirini cevaplamaz. Bu yüzden sayfa bugünün
 * ÖLÇÜMÜYLE açılır, arşiv altına iner.
 *
 * Üstteki her şey ölçülen katmandan gelir — yazı katmanından tek cümle
 * alınmaz. Yazı katmanı bir sabah koşmasa da (ya da hafta sonu) manşet
 * doğru kalır; yanındaki tarih zaten neye ait olduğunu söyler.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KayitKarti from '../components/KayitKarti.astro';
import RejimSerit from '../components/RejimSerit.astro';
import HatlarTablosu from '../components/HatlarTablosu.astro';
import { dersleriTopla } from '../lib/dersListesi';
import { SEVIYE_ETIKET } from '../lib/dersGruplari';
import { sonBulten, sayi } from '../lib/anaSayfa';

const sirala = <T extends { data: { pubDate: Date; durum: string } }>(liste: T[]) =>
  liste
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .sort((a, b) => (a.data.durum === 'arsiv' ? 1 : 0) - (b.data.durum === 'arsiv' ? 1 : 0));

const projeler = sirala(await getCollection('projeler'));
const analizler = sirala(await getCollection('analiz'));
const { gruplar, toplam } = await dersleriTopla();

const b = sonBulten();
const hatlar = projeler.map((p) => ({
  slug: p.id,
  baslik: p.data.title,
  durum: p.data.durum,
}));
const vurgu = b.manset?.parcalar.map((r) => r.ad) ?? [];
// σ eşiği: bültenin yazı katmanına verdiği eşikle aynı. Ana sayfada yalnız
// gerçekten olağandışı olanlar görünür, sıralamanın tamamı değil.
const olagandisi = b.sigma.filter((s) => Math.abs(s.sigma) >= 1.3).slice(0, 5);
// Olağandışılığın penceresi son bültenin kipini izler: hafta içi gün, pazar
// haftaya bakış yayımlandığında HAFTA. Başlık ve oynaklık etiketi sabit
// "günlük" yazıyordu ve pazar günü haftalık oynaklıkları "20g" diye
// etiketliyordu (30.08.2026).
const sigmaHaftalik = b.sigmaKip === 'haftalik';
const sigmaBaslik = sigmaHaftalik
  ? 'Haftanın olağandışı hareketleri'
  : 'Günün olağandışı hareketleri';
const oynaklikEtiketi = sigmaHaftalik ? '20h oynaklık' : '20g oynaklık';
const olcumSaati = b.olusturma ? b.olusturma.slice(11, 16) : '';

/**
 * Yüzde işareti Türkçede sayıdan ÖNCE gelir ve işaret onun da önünde durur:
 * "−%1,88". Baz puan bir birimdir, sayıdan sonra yazılır: "−6,5 bp".
 */
const yuzdeliYaz = (v: number, birim: string) =>
  birim === 'bp' ? sayi(v, 1, true) : `${v < 0 ? '−' : '+'}%${sayi(Math.abs(v), 2)}`;
---

<Base>
  {
    b.var ? (
      <section class="ana-ust yuksel">
        <p class="ana-kunye">
          <span>{b.trTarih}</span>
          <span>{b.gun}</span>
          {olcumSaati && <span>ölçüm {olcumSaati}'da kuruldu</span>}
          <span>{hatlar.length} hat</span>
          <span>{b.enstruman} enstrüman</span>
        </p>
        {b.manset ? (
          <h1 class="ana-manset">{b.manset.metin}</h1>
        ) : (
          <h1 class="ana-manset">Türkiye makrosunu ölçülmüş verilerle okumak.</h1>
        )}
        <p class="ana-manset-alt">
          Yukarıdaki cümle bir yorum değil: rejim panosunun iki satırından kuruldu ve
          ikisi de aşağıda kendi hesabıyla duruyor. Türkiye makro verisi her sabah
          yeniden ölçülüyor, her sayı kendi tarihini taşıyor.
          <a class="ana-bulten-bag" href={b.bultenHref}>Günün bülteni →</a>
        </p>
      </section>
    ) : (
      <section class="ana-ust yuksel">
        <h1 class="ana-manset">
          Türkiye makrosunu <em>koddan</em> geçirilmiş verilerle okumak.
        </h1>
        <p class="ana-manset-alt">
          TCMB rezervlerinden Hazine ihalelerine, reel kurdan faiz eğrisine — her başlık
          düzenli aralıklarla yeniden hesaplanan canlı grafikler ve tarayıcıda çalışan
          hesap araçlarıyla sunulur.
        </p>
      </section>
    )
  }

  {
    b.rejim.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">01</span>
          <h2>Rejim</h2>
          <a class="tumu" href={b.bultenHref}>
            Bültende →
          </a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          Gösterge şeridi seviyeyi verir; bu pano seviyelerin <b>birlikte</b> ne anlama
          geldiğini. Her satır iki ölçülen büyüklüğün farkıdır, hesabı yanında yazar ve
          etiketi açıkça ilan edilmiş bir eşikten gelir — okur katılmadığı yerde kendi
          çizgisini çekebilsin diye.
        </p>
        <div class="yuksel" style="--d: 140ms">
          <RejimSerit satirlar={b.rejim} vurgu={vurgu} />
        </div>
      </section>
    )
  }

  {
    olagandisi.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">02</span>
          <h2>{sigmaBaslik}</h2>
          <a class="tumu" href={b.bultenHref}>
            Tümü →
          </a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          Hareketler kendi oynaklıklarına bölünerek sıralanır: bir varlığın
          {sigmaHaftalik ? ' haftalık değişimi, son 20 haftanın' : ' günlük değişimi, son 20 günün'}
          standart sapmasının kaç katı? Yüzdesi küçük bir hareket olağandışı, büyük bir
          hareket sıradan olabilir — ham yüzde bunu söylemez.
        </p>
        <ul class="sg-liste yuksel" style="--d: 140ms">
          {olagandisi.map((s) => (
            <li>
              <span class="sg-ad">{s.ad}</span>
              <span class="sg-deger">
                {yuzdeliYaz(s.deger, s.birim)}
                {s.birim === 'bp' && <span class="sg-birim">bp</span>}
              </span>
              <span class="sg-sigma">{sayi(s.sigma, 1, true)}σ</span>
              <span class="sg-oynaklik">{oynaklikEtiketi} {sayi(s.oynaklik, 2)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <div class="bolum-baslik yuksel" style="--d: 80ms">
      <span class="no">{b.rejim.length > 0 ? '03' : '01'}</span>
      <h2>Hatlar</h2>
      <a class="tumu" href="/projeler/">Tümü →</a>
    </div>
    <p class="bolum-giris yuksel" style="--d: 100ms">
      Her hat kendi kaynağından besleniyor ve kendi ritminde tazeleniyor. Tarih sütunu
      hattın değil, <b>yanındaki büyüklüğün</b> saatini gösterir: aynı dosyada günlük bir
      seri ile aylık bir seri yan yana durabilir ve ikisi aynı güne ait değildir.
    </p>
    <div class="yuksel" style="--d: 140ms">
      <HatlarTablosu hatlar={hatlar} />
    </div>
  </section>

  {
    analizler.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">{b.rejim.length > 0 ? '04' : '02'}</span>
          <h2>Analiz</h2>
          <a class="tumu" href="/analiz/">
            Tümü →
          </a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          Tek bir piyasa gelişmesini mekanizmasına, tarihsel emsaline ve fiyat etkisine
          kadar açan uzun yazılar.
        </p>
        <div class="kayit-izgara">
          {analizler.map((y, i) => (
            <KayitKarti href={`/analiz/${y.id}/`} sira={i + 1} gecikme={120 + i * 60} {...y.data} />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <div class="bolum-baslik yuksel" style="--d: 160ms">
      <span class="no">{b.rejim.length > 0 ? (analizler.length > 0 ? '05' : '04') : '03'}</span>
      <h2>Dersler</h2>
      <a class="tumu" href="/arastirma/">Tümü →</a>
    </div>

    <p class="bolum-giris yuksel" style="--d: 180ms">
      Ders formatında uzun notlar: önce teori ve türetim, sonra gerçek verilerle adım adım
      sayısal hesap. <b>{toplam.ders} ders</b> · <b>{toplam.sure}</b> okuma ·
      <b>{toplam.grafik} grafik</b> · <b>{toplam.arac} hesap aracı</b> ·
      <b>{toplam.pratik} pratik bloğu</b> ({toplam.alistirma} çözümlü alıştırma).
    </p>

    <div class="konu-bloklari">
      {
        gruplar.map((g, gi) => (
          <section class="konu-blok yuksel" style={`--d: ${220 + gi * 60}ms`}>
            <div class="konu-ust">
              <span class="konu-no">{g.grup.no}</span>
              <h3>
                <a href={`/arastirma/#${g.grup.id}`}>{g.grup.baslik}</a>
              </h3>
              <span class="konu-olcu">
                {g.dersler.length} ders · {g.toplamSure}
              </span>
            </div>
            <p class="konu-aciklama">{g.grup.aciklama}</p>
            <ol class="konu-dersler">
              {g.dersler.map((d) => (
                <li>
                  <a class="ders-ad" href={d.href}>
                    {d.data.title}
                  </a>
                  {d.data.ozet && <span class="ders-ozet">{d.data.ozet}</span>}
                  <span class="ders-olcu">
                    {d.olcuMetni}
                    {d.data.seviye && ` · ${SEVIYE_ETIKET[d.data.seviye]} seviye`}
                  </span>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* ── Üst blok: künye + manşet ──────────────────────────────
     Manşet ölçüden kurulduğu için üstünde künye durur: tarih, gün, ölçümün
     kurulduğu saat, hat ve enstrüman sayısı. Okur daha kaydırmadan hem
     tazeliği hem ölçeği görür. */
  .ana-ust {
    padding: 2.6rem 0 0.5rem;
    max-width: 58ch;
  }
  .ana-kunye {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  /* Ayraç, parçanın SONUNA konur — başına değil. Künye manşetin ölçü
     genişliğine sığmayıp ikinci satıra kırıldığında, öne konan ayraç satır
     başında yalnız bir nokta olarak asılı kalıyordu. Sona konunca nokta
     önceki satırın sonunda kalır ve kırılma göze batmaz. */
  .ana-kunye span:not(:last-child)::after {
    content: '·';
    margin-left: 0.9rem;
    color: var(--ink-30);
  }
  .ana-kunye span:first-child {
    color: var(--claret);
    font-weight: 600;
  }

  .ana-manset {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.85rem, 4.6vw, 2.85rem);
    font-weight: 480;
    line-height: 1.14;
    letter-spacing: -0.021em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .ana-manset em {
    font-style: italic;
    color: var(--claret);
  }

  .ana-manset-alt {
    font-size: 1.05rem;
    line-height: 1.62;
    color: var(--ink-70);
    margin: 0;
    max-width: 62ch;
  }
  .ana-bulten-bag {
    display: inline-block;
    margin-left: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--claret);
    white-space: nowrap;
  }
  .ana-bulten-bag:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* ── Ortak bölüm girişi ────────────────────────────────────── */
  .bolum-giris {
    max-width: 66ch;
    margin: 0 0 1.6rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-70);
  }
  .bolum-giris b {
    color: var(--ink);
    font-weight: 600;
  }

  /* ── σ listesi ─────────────────────────────────────────────── */
  .sg-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink-30);
  }
  .sg-liste li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem 5rem 10rem;
    align-items: baseline;
    gap: 0 1.2rem;
    padding: 0.6rem 0;
    border-bottom: 1px dotted var(--ink-15);
  }
  .sg-ad {
    font-family: var(--font-body);
    font-size: 0.98rem;
  }
  .sg-deger,
  .sg-sigma {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .sg-deger {
    font-size: 1rem;
    font-weight: 500;
  }
  .sg-birim {
    font-size: 0.64rem;
    color: var(--ink-50);
    margin-left: 0.25rem;
  }
  /* σ bordo: sayfadaki asıl bilgi bu sütun — ham yüzde değil. */
  .sg-sigma {
    font-size: 1rem;
    font-weight: 600;
    color: var(--claret);
  }
  .sg-oynaklik {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--ink-50);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .sg-liste li {
      grid-template-columns: minmax(0, 1fr) 5.5rem 4rem;
      gap: 0.15rem 0.8rem;
    }
    .sg-oynaklik {
      grid-column: 1 / -1;
    }
  }

  /* ── Dersler bölümü ────────────────────────────────────────── */
  .konu-bloklari {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 2rem 2.5rem;
  }
  .konu-blok {
    border-top: 1px solid var(--ink-30);
    padding-top: 0.9rem;
  }
  .konu-ust {
    margin-bottom: 0.55rem;
  }
  .konu-no {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--claret);
    margin-right: 0.5rem;
  }
  .konu-ust h3 {
    display: inline;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 30;
    font-size: 1.16rem;
    font-weight: 580;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .konu-ust h3 a {
    text-decoration: none;
  }
  .konu-olcu {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  .konu-aciklama {
    margin: 0 0 0.9rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink-70);
  }
  .konu-dersler {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: ders;
  }
  .konu-dersler li {
    counter-increment: ders;
    position: relative;
    padding: 0.55rem 0 0.6rem 1.8rem;
    border-top: 1px dotted var(--ink-15);
  }
  .konu-dersler li::before {
    content: counter(ders, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.72rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--claret);
  }
  .ders-ad {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 20;
    font-size: 1.02rem;
    font-weight: 560;
    line-height: 1.3;
    text-decoration: none;
  }
  .ders-ozet {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-70);
  }
  .ders-olcu {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: var(--ink-50);
  }
</style>
