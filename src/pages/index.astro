---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KayitKarti from '../components/KayitKarti.astro';
import { dersleriTopla } from '../lib/dersListesi';
import { SEVIYE_ETIKET } from '../lib/dersGruplari';

const sirala = <T extends { data: { pubDate: Date; durum: string } }>(liste: T[]) =>
  liste
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .sort((a, b) => (a.data.durum === 'arsiv' ? 1 : 0) - (b.data.durum === 'arsiv' ? 1 : 0));

const projeler = sirala(await getCollection('projeler'));
const analizler = sirala(await getCollection('analiz'));

// Araştırma bölümü: /arastirma/ ile aynı gruplama ve aynı ölçümler.
const { gruplar, toplam } = await dersleriTopla();
---

<Base>
  <section class="giris yuksel">
    <h1>
      Türkiye makrosunu <em>koddan</em> geçirilmiş verilerle okumak.
    </h1>
    <p class="giris-alt">
      TCMB rezervlerinden Hazine ihalelerine, reel kurdan faiz eğrisine — her başlık
      düzenli aralıklarla yeniden hesaplanan canlı grafikler ve tarayıcıda çalışan
      hesap araçlarıyla sunulur.
    </p>
  </section>

  {
    analizler.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">01</span>
          <h2>Analiz</h2>
          <a class="tumu" href="/analiz/">Tümü →</a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          Tek bir piyasa gelişmesini mekanizmasına, tarihsel emsaline ve fiyat etkisine
          kadar açan uzun yazılar.
        </p>
        <div class="kayit-izgara">
          {analizler.map((y, i) => (
            <KayitKarti href={`/analiz/${y.id}/`} sira={i + 1} gecikme={120 + i * 60} {...y.data} />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <div class="bolum-baslik yuksel" style="--d: 80ms">
      <span class="no">02</span>
      <h2>Projeler</h2>
      <a class="tumu" href="/projeler/">Tümü →</a>
    </div>
    <div class="kayit-izgara">
      {
        projeler.map((p, i) => (
          <KayitKarti
            href={`/projeler/${p.id}/`}
            sira={i + 1}
            gecikme={120 + i * 60}
            {...p.data}
          />
        ))
      }
    </div>
  </section>

  <section>
    <div class="bolum-baslik yuksel" style="--d: 160ms">
      <span class="no">03</span>
      <h2>Dersler</h2>
      <a class="tumu" href="/arastirma/">Tümü →</a>
    </div>

    <p class="bolum-giris yuksel" style="--d: 180ms">
      Ders formatında uzun notlar: önce teori ve türetim, sonra gerçek verilerle adım adım
      sayısal hesap. <b>{toplam.ders} ders</b> · <b>{toplam.sure}</b> okuma ·
      <b>{toplam.grafik} grafik</b> · <b>{toplam.arac} hesap aracı</b> ·
      <b>{toplam.pratik} pratik bloğu</b> ({toplam.alistirma} çözümlü alıştırma).
    </p>

    <div class="konu-bloklari">
      {
        gruplar.map((g, gi) => (
          <section class="konu-blok yuksel" style={`--d: ${220 + gi * 60}ms`}>
            <div class="konu-ust">
              <span class="konu-no">{g.grup.no}</span>
              <h3><a href={`/arastirma/#${g.grup.id}`}>{g.grup.baslik}</a></h3>
              <span class="konu-olcu">
                {g.dersler.length} ders · {g.toplamSure}
              </span>
            </div>
            <p class="konu-aciklama">{g.grup.aciklama}</p>
            <ol class="konu-dersler">
              {g.dersler.map((d) => (
                <li>
                  <a class="ders-ad" href={d.href}>{d.data.title}</a>
                  {d.data.ozet && <span class="ders-ozet">{d.data.ozet}</span>}
                  <span class="ders-olcu">
                    {d.olcuMetni}
                    {d.data.seviye && ` · ${SEVIYE_ETIKET[d.data.seviye]} seviye`}
                  </span>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .giris {
    padding: 3.2rem 0 1rem;
    max-width: 46ch;
  }
  .giris h1 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-size: clamp(2rem, 5.5vw, 3.1rem);
    font-weight: 480;
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 1rem;
  }
  .giris h1 em {
    font-style: italic;
    color: var(--claret);
  }
  .giris-alt {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--ink-70);
    margin: 0;
  }

  /* ── Araştırma bölümü ──────────────────────────────────── */
  .bolum-giris {
    max-width: 66ch;
    margin: 0 0 2rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-70);
  }
  .bolum-giris b {
    color: var(--ink);
    font-weight: 600;
  }

  .konu-bloklari {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 2rem 2.5rem;
  }
  .konu-blok {
    border-top: 1px solid var(--ink-30);
    padding-top: 0.9rem;
  }
  .konu-ust {
    margin-bottom: 0.55rem;
  }
  .konu-no {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--claret);
    margin-right: 0.5rem;
  }
  .konu-ust h3 {
    display: inline;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 30;
    font-size: 1.16rem;
    font-weight: 580;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .konu-ust h3 a {
    text-decoration: none;
  }
  .konu-olcu {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  .konu-aciklama {
    margin: 0 0 0.9rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink-70);
  }

  .konu-dersler {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: ders;
  }
  .konu-dersler li {
    counter-increment: ders;
    position: relative;
    padding: 0.55rem 0 0.6rem 1.8rem;
    border-top: 1px dotted var(--ink-15);
  }
  .konu-dersler li::before {
    content: counter(ders, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.72rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--claret);
  }
  .ders-ad {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 20;
    font-size: 1.02rem;
    font-weight: 560;
    line-height: 1.3;
    text-decoration: none;
  }
  .ders-ozet {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-70);
  }
  .ders-olcu {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: var(--ink-50);
  }
</style>
