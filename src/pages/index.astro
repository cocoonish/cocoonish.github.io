---
/**
 * Ana sayfa — dizin değil, MANŞET.
 *
 * Siteye ilk gelen profesyonel okur beş saniyede üç soruya cevap arar:
 * bu ne, güncel mi, ciddi mi? Rejim panosu üçünü birden cevaplar; bir
 * içindekiler listesi hiçbirini cevaplamaz. Bu yüzden sayfa bugünün
 * ÖLÇÜMÜYLE açılır, arşiv altına iner.
 *
 * Üstteki her şey ölçülen katmandan gelir — yazı katmanından tek cümle
 * alınmaz. Yazı katmanı bir sabah koşmasa da (ya da hafta sonu) manşet
 * doğru kalır; yanındaki tarih zaten neye ait olduğunu söyler.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KayitKarti from '../components/KayitKarti.astro';
import RejimSerit from '../components/RejimSerit.astro';
import HatlarTablosu from '../components/HatlarTablosu.astro';
import { dersleriTopla } from '../lib/dersListesi';
import { sonBulten, sayi, OLAGANDISI_SIGMA, sigmaBasligi } from '../lib/anaSayfa';
import { kartlar as analizKartlari } from '../lib/analizListesi';
import { istanbulSaat, degisim, olcuYaz, tarihYaz, isoGun, istanbulGunu } from '../lib/bicim';
import { bultenler, teknikler } from '../lib/yayinlar';

const sirala = <T extends { data: { pubDate: Date; durum: string } }>(liste: T[]) =>
  liste
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .sort((a, b) => (a.data.durum === 'arsiv' ? 1 : 0) - (b.data.durum === 'arsiv' ? 1 : 0));

const projeler = sirala(await getCollection('projeler'));
// Ana sayfa manşettir, dizin değil: en yeni dört analiz; hepsi /analiz/ altında.
const analizler = analizKartlari(await getCollection('analiz')).reverse().slice(0, 4);
const { gruplar, toplam } = await dersleriTopla();

const b = sonBulten();
const hatlar = projeler.map((p) => ({
  slug: p.id,
  baslik: p.data.title,
  durum: p.data.durum,
}));
const vurgu = b.manset?.parcalar.map((r) => r.ad) ?? [];
// Ana sayfa listesi 1,3σ üstünü gösterir (sıralamanın tamamı değil).
// "Olağandışı" başlığının eşiği ayrıdır ve tek tanımdır (OLAGANDISI_SIGMA, 2σ):
// eski yorum 1,3σ'yı "yazı katmanına verilen eşikle aynı" diye anlatıyordu,
// oysa YAZIM.md 2σ diyor.
const olagandisi = b.sigma.filter((s) => Math.abs(s.sigma) >= 1.3).slice(0, 5);
// Olağandışılığın penceresi son bültenin kipini izler: hafta içi gün, pazar
// haftaya bakış yayımlandığında HAFTA. Başlık ve oynaklık etiketi sabit
// "günlük" yazıyordu ve pazar günü haftalık oynaklıkları "20g" diye
// etiketliyordu (30.08.2026).
const sigmaHaftalik = b.sigmaKip === 'haftalik';
const sigmaBaslik = sigmaBasligi(olagandisi.map((s) => s.sigma), sigmaHaftalik);
const oynaklikEtiketi = sigmaHaftalik ? '20h oynaklık' : '20g oynaklık';
// Ölçüm damgası koşucuda UTC ile atılıyor ve dilim taşımıyor; okura İstanbul
// saati yazılır (eskiden ham "04:30" basılıyordu — 07:30'un UTC hâli).
const olcumSaati = istanbulSaat(b.olusturma);
// Yazılmış son sayının numarası (ölçülen katman yazıdan bağımsızdır; numara
// yalnız yazılmış sayılar arasında sayılır, o yüzden ayrı okunur).
const sonYazili = bultenler()[0];
const sonTeknik = teknikler()[0];
const sayiNo = sonYazili && sonYazili.tarih === b.tarih ? sonYazili.sayiNo : null;

// Yüzde ÖNDE, bp ARKADA — kural lib/bicim'de tek yerde.
const yuzdeliYaz = (v: number, birim: string) => degisim(v, birim, birim === 'bp' ? 1 : 2);
---

<Base>
  {
    b.var ? (
      <section class="ana-ust yuksel">
        <div class="ana-bas">
          {/* İlk ekranda uzun tarih dört kez geçiyordu (üst şerit, künye, takvim
              başlığı, bülten bağı). Künye tarihi kısa ve saatle birlikte yazar;
              ek saate göre değiştiği için ("07:20'de") ek kullanılmaz. */}
          <p class="ana-kunye">
            <span>ölçüm {tarihYaz(b.tarih)}{olcumSaati && ` · ${olcumSaati}`}</span>
            {sayiNo && <span>Sayı {sayiNo}</span>}
            <span>{hatlar.length} hat</span>
            <span>{b.enstruman} enstrüman</span>
          </p>
          {b.manset ? (
            <h1 class="ana-manset">{b.manset.metin}</h1>
          ) : (
            <h1 class="ana-manset">Türkiye makrosunu ölçülmüş verilerle okumak.</h1>
          )}
          {/* Manşetin altında sitenin kendi kuruluşunu anlatan bir paragraf
              duruyordu ("Yukarıdaki cümle bir yorum değil…"); okurun kararını
              değiştirmiyordu. Yerinde yayınlara giden bağlar var. */}
          <ul class="ana-yayinlar">
            <li>
              <a href={b.bultenHref}>
                <span class="ay-tur">{b.bultenHaftalik ? 'Haftaya bakış' : 'Günlük bülten'}</span>
                <span class="ay-ad">{b.bultenYazili
                  ? `${b.bultenTrTarih}${sonYazili ? ` · Sayı ${sonYazili.sayiNo}` : ''}`
                  : (b.bultenTrTarih ? `Son yazılmış sayı · ${b.bultenTrTarih}` : 'Bülten arşivi')}</span>
              </a>
            </li>
            {sonTeknik && (
              <li>
                <a href={sonTeknik.href}>
                  <span class="ay-tur">Haftalık teknik analiz</span>
                  <span class="ay-ad">Sayı {sonTeknik.sayiNo}</span>
                </a>
              </li>
            )}
            {analizler[0] && (
              <li>
                <a href={`/analiz/${analizler[0].yazi.id}/`}>
                  <span class="ay-tur">Son analiz</span>
                  <span class="ay-ad">{analizler[0].yazi.data.title}</span>
                </a>
              </li>
            )}
          </ul>
        </div>
        {(b.takvimGunu.length > 0 || b.siradaki.length > 0) && (
          <aside class="ana-gun" aria-label="Takvim">
            {b.takvimGunu.length > 0 && (
              <>
                <h2 class="ag-baslik etiket">{isoGun(istanbulGunu()) === b.tarih ? 'Bugün' : b.trTarih} · takvim · saatler TSİ</h2>
                <ol class="ag-liste">
                  {b.takvimGunu.map((k) => (
                    <li class:list={{ birinci: k.onem === 1 }}>
                      <span class="ag-saat">{k.saat || '—'}</span>
                      <span class="ag-ulke">{k.ulke}</span>
                      <span class="ag-olay">{k.olay}</span>
                    </li>
                  ))}
                </ol>
              </>
            )}
            {b.siradaki.length > 0 && (
              <>
                <h2 class="ag-baslik etiket">Sıradaki birinci derece veriler</h2>
                <ol class="ag-liste">
                  {b.siradaki.map((k) => (
                    <li>
                      <span class="ag-saat">{k.trTarih.replace(/ \d{4}$/, '')}</span>
                      <span class="ag-ulke">{k.ulke}</span>
                      <span class="ag-olay">{k.olay}</span>
                    </li>
                  ))}
                </ol>
              </>
            )}
            <a class="ag-tumu" href={`${b.bultenHref}#takvim`}>Takvimin tamamı →</a>
          </aside>
        )}
      </section>
    ) : (
      <section class="ana-ust yuksel">
        <h1 class="ana-manset">
          Türkiye makrosunu <em>koddan</em> geçirilmiş verilerle okumak.
        </h1>
        <p class="ana-manset-alt">
          TCMB rezervlerinden Hazine ihalelerine, reel kurdan faiz eğrisine — her başlık
          düzenli aralıklarla yeniden hesaplanan canlı grafikler ve tarayıcıda çalışan
          hesap araçlarıyla sunulur.
        </p>
      </section>
    )
  }

  {
    b.rejim.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">01</span>
          <h2>Rejim</h2>
          <a class="tumu" href={b.bultenHref}>
            Bültende →
          </a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          Her satır iki ölçülen büyüklüğün farkı; etiket, hesabın yanında yazan açık bir
          eşikten gelir. Değer hareket ettiyse altında bir önceki ölçüme göre farkı yazar.
        </p>
        <div class="yuksel" style="--d: 140ms">
          <RejimSerit satirlar={b.rejim} vurgu={vurgu} />
        </div>
      </section>
    )
  }

  {
    olagandisi.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">02</span>
          <h2>{sigmaBaslik}</h2>
          <a class="tumu" href={b.bultenHref}>
            Tümü →
          </a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          {sigmaHaftalik ? 'Haftalık değişim, son 20 haftanın' : 'Günlük değişim, son 20 günün'}
          standart sapmasına bölünür: yüzdesi küçük bir hareket olağandışı, büyük bir
          hareket sıradan olabilir.
          {Math.max(...olagandisi.map((s) => Math.abs(s.sigma))) < OLAGANDISI_SIGMA &&
            " Bu listede 2σ'yı aşan hareket yok; 1,3σ üstündekiler gösteriliyor."}
        </p>
        <ul class="sg-liste yuksel" style="--d: 140ms">
          {olagandisi.map((s) => (
            <li>
              <span class="sg-ad">{s.ad}</span>
              {/* bp satırında birim iki kez basılıyordu: degisim() "bp"yi zaten
                  yazıyor, ardından ayrı bir "bp" etiketi geliyordu. */}
              <span class="sg-deger">
                {s.birim === 'bp' ? sayi(s.deger, 1, true) : yuzdeliYaz(s.deger, s.birim)}
                {s.birim === 'bp' && <span class="sg-birim">bp</span>}
              </span>
              <span class:list={['sg-sigma', { arti: s.sigma > 0, eksi: s.sigma < 0 }]}>{sayi(s.sigma, 1, true)}σ</span>
              <span class="sg-oynaklik">{oynaklikEtiketi} {olcuYaz(s.oynaklik, s.birim, 2)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <div class="bolum-baslik yuksel" style="--d: 80ms">
      <span class="no">{b.rejim.length > 0 ? '03' : '01'}</span>
      <h2>Hatlar</h2>
      <a class="tumu" href="/projeler/">Tümü →</a>
    </div>
    <p class="bolum-giris yuksel" style="--d: 100ms">
      Her hat kendi kaynağından, kendi yayım ritminde tazelenir. Tarih sütunu
      <b>yanındaki büyüklüğün</b> tarihidir: aynı hatta günlük ve aylık seriler yan yana
      durur ve aynı güne ait değildir.
    </p>
    <div class="yuksel" style="--d: 140ms">
      <HatlarTablosu hatlar={hatlar} />
    </div>
  </section>

  {
    analizler.length > 0 && (
      <section>
        <div class="bolum-baslik yuksel" style="--d: 80ms">
          <span class="no">{b.rejim.length > 0 ? '04' : '02'}</span>
          <h2>Analiz</h2>
          <a class="tumu" href="/analiz/">
            Tümü →
          </a>
        </div>
        <p class="bolum-giris yuksel" style="--d: 100ms">
          Tek bir piyasa gelişmesini mekanizmasına, tarihsel emsaline ve fiyat etkisine
          kadar açan uzun yazılar.
        </p>
        {/* İki sütun: üç sütunlu genel ızgarada dört kart 3 + 1 diziliyor,
            dördüncü kart tek başına bir satır açıyordu. */}
        <div class="kayit-izgara ana-analiz">
          {analizler.map((k, i) => (
            <KayitKarti href={`/analiz/${k.yazi.id}/`} sira={k.no} gecikme={120 + i * 60} {...k.yazi.data} ekBilgi={k.ekBilgi} tur="analiz" etiketler={false} />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <div class="bolum-baslik yuksel" style="--d: 160ms">
      <span class="no">{b.rejim.length > 0 ? (analizler.length > 0 ? '05' : '04') : '03'}</span>
      <h2>Dersler</h2>
      <a class="tumu" href="/arastirma/">Tümü →</a>
    </div>

    <p class="bolum-giris yuksel" style="--d: 180ms">
      Ders formatında uzun notlar: önce teori ve türetim, sonra gerçek verilerle adım adım
      sayısal hesap. <b>{toplam.ders} ders</b> · <b>{toplam.sure}</b> okuma ·
      <b>{toplam.grafik} grafik</b> · <b>{toplam.arac} hesap aracı</b> ·
      <b>{toplam.pratik} pratik bloğu</b> ({toplam.alistirma} çözümlü alıştırma).
    </p>

    <div class="konu-bloklari">
      {
        gruplar.map((g, gi) => (
          <section class="konu-blok yuksel" style={`--d: ${220 + gi * 60}ms`}>
            <div class="konu-ust">
              <span class="konu-no">{g.grup.no}</span>
              <h3>
                <a href={`/arastirma/#${g.grup.id}`}>{g.grup.baslik}</a>
              </h3>
              <span class="konu-olcu">
                {g.dersler.length} ders · {g.toplamSure}
              </span>
            </div>
            {/* Ana sayfa manşettir, katalog değil: her konu tek satır (ad ·
                ders sayısı · süre). Tam liste açıklamalarıyla /arastirma/
                sayfasında; ana sayfanın yarısını katalog kaplıyordu. */}
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* ── Üst blok: künye + manşet ──────────────────────────────
     Manşet ölçüden kurulduğu için üstünde künye durur: tarih, gün, ölçümün
     kurulduğu saat, hat ve enstrüman sayısı. Okur daha kaydırmadan hem
     tazeliği hem ölçeği görür. */
  /* İlk ekran iki sütun: solda manşet ve yayınlar, sağda ölçüm gününün
     takvimi. Blok 58ch'e kilitliyken 1360 pikselde sağ yarı boş kalıyordu ve
     "bugün ne var" sorusunun cevabı ana sayfada hiç yoktu. */
  .ana-ust {
    padding: 2.6rem 0 0.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 3.2rem;
  }
  .ana-bas { max-width: 40rem; }
  @media (min-width: 1000px) {
    .ana-ust { grid-template-columns: minmax(0, 1.6fr) minmax(17rem, 1fr); align-items: start; }
  }

  .ana-yayinlar {
    list-style: none; margin: 1.3rem 0 0; padding: 0;
    display: grid; gap: 0; border-top: 1px solid var(--ink-30);
  }
  .ana-yayinlar li { border-bottom: 1px dotted var(--ink-15); }
  .ana-yayinlar a {
    display: grid; grid-template-columns: 11.5rem minmax(0, 1fr); gap: 0.2rem 1rem;
    align-items: baseline; padding: 0.55rem 0; text-decoration: none;
  }
  .ana-yayinlar a:hover .ay-ad { color: var(--claret); }
  .ay-tur {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--claret);
  }
  .ay-ad { font-size: 1rem; line-height: 1.35; color: var(--ink); }
  .ay-ad::after { content: ' →'; color: var(--claret); }
  @media (max-width: 640px) {
    .ana-yayinlar a { grid-template-columns: 1fr; }
  }

  .ana-gun {
    border-top: 2px solid var(--ink);
    padding-top: 0.7rem;
  }
  .ag-baslik {
    display: block; margin: 0 0 0.45rem; font-size: 0.7rem; color: var(--ink-70);
  }
  .ag-baslik:not(:first-child) { margin-top: 1.2rem; }
  .ag-liste { list-style: none; margin: 0; padding: 0; }
  .ag-liste li {
    display: grid; grid-template-columns: 4.6rem 2.6rem minmax(0, 1fr); gap: 0 0.6rem;
    align-items: baseline; padding: 0.38rem 0; border-bottom: 1px dotted var(--ink-15);
    font-size: 0.9rem; line-height: 1.35;
  }
  .ag-liste li.birinci .ag-olay { font-weight: 600; }
  .ag-saat, .ag-ulke {
    font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-70);
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .ag-ulke { color: var(--claret); }
  .ag-tumu {
    display: inline-block; margin-top: 0.7rem; font-family: var(--font-mono);
    font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;
    text-decoration: none; color: var(--claret);
  }
  .ag-tumu:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .ana-kunye {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  /* Ayraç, parçanın SONUNA konur — başına değil. Künye manşetin ölçü
     genişliğine sığmayıp ikinci satıra kırıldığında, öne konan ayraç satır
     başında yalnız bir nokta olarak asılı kalıyordu. Sona konunca nokta
     önceki satırın sonunda kalır ve kırılma göze batmaz. */
  .ana-kunye span:not(:last-child)::after {
    content: '·';
    margin-left: 0.9rem;
    color: var(--ink-60);
  }
  .ana-kunye span:first-child {
    color: var(--claret);
    font-weight: 600;
  }

  .ana-manset {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.85rem, 4.6vw, 2.85rem);
    font-weight: 480;
    line-height: 1.14;
    letter-spacing: -0.021em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .ana-manset em {
    font-style: italic;
    color: var(--claret);
  }

  .ana-manset-alt {
    font-size: 1.05rem;
    line-height: 1.62;
    color: var(--ink-70);
    margin: 0;
    max-width: 62ch;
  }
  .ana-bulten-bag {
    display: inline-block;
    margin-left: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--claret);
    white-space: nowrap;
  }
  .ana-bulten-bag:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ana-analiz { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 820px) {
    .ana-analiz { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ── Ortak bölüm girişi ────────────────────────────────────── */
  .bolum-giris {
    max-width: 66ch;
    margin: 0 0 1.6rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-70);
  }
  .bolum-giris b {
    color: var(--ink);
    font-weight: 600;
  }

  /* ── σ listesi ─────────────────────────────────────────────── */
  .sg-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink-30);
  }
  .sg-liste li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem 5rem 10rem;
    align-items: baseline;
    gap: 0 1.2rem;
    padding: 0.6rem 0;
    border-bottom: 1px dotted var(--ink-15);
  }
  .sg-ad {
    font-family: var(--font-body);
    font-size: 0.98rem;
  }
  .sg-deger,
  .sg-sigma {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .sg-deger {
    font-size: 1rem;
    font-weight: 500;
  }
  .sg-birim {
    font-size: 0.64rem;
    color: var(--ink-50);
    margin-left: 0.25rem;
  }
  /* σ sayfadaki asıl bilgi — ham yüzde değil. Renk YÖNÜ taşır, bültenle aynı
     sözleşme: artı yeşil, eksi bordo. İşaretten bağımsız bordo, +2σ'lık bir
     yükselişi de "düşüş" renginde gösterirdi. */
  .sg-sigma {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .sg-sigma.arti { color: var(--pozitif); }
  .sg-sigma.eksi { color: var(--claret); }
  .sg-oynaklik {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--ink-50);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .sg-liste li {
      grid-template-columns: minmax(0, 1fr) 5.5rem 4rem;
      gap: 0.15rem 0.8rem;
    }
    .sg-oynaklik {
      grid-column: 1 / -1;
    }
  }

  /* ── Dersler bölümü ────────────────────────────────────────── */
  .konu-bloklari {
    display: grid;
