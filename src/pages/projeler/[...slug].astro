---
import { getCollection, render } from 'astro:content';
import Yazi from '../../layouts/Yazi.astro';
import { projeSaati } from '../../lib/anaSayfa';

export async function getStaticPaths() {
  const projeler = await getCollection('projeler');
  return projeler.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Yazi {...entry.data} tur="proje" slug={entry.id} veriZamani={projeSaati(entry.id)}>
  <Content />
</Yazi>
